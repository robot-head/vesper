// Module insn of @vesper/ebpf (see lib.ves): src/insn.rs, the instruction
// codec. Registers are `u8` numbers in `0..=10` here; the Rust wrapper turns
// them into `Reg`. `DecodeError.ReservedFieldSet.field` is 0 dst, 1 src,
// 2 off, 3 imm.

// The opcode fields of src/insn.rs (`class`, `op`, `jmp`, `source`, `size`,
// `mode`, `atomic`, `pseudo`), named after the kernel's `BPF_*` macros
// (include/uapi/linux/bpf.h, RFC 9669). Constants are not patterns, so the
// decoders below compare instead of matching.

// Instruction classes (`BPF_CLASS`, low three bits).
const CLASS_LD: u8 = 0;
const CLASS_LDX: u8 = 1;
const CLASS_ST: u8 = 2;
const CLASS_STX: u8 = 3;
const CLASS_ALU: u8 = 4;
const CLASS_JMP: u8 = 5;
const CLASS_JMP32: u8 = 6;
const CLASS_ALU64: u8 = 7;
const CLASS_MASK: u8 = 7;
// ALU operation codes (`BPF_OP`, high four bits).
const OP_ADD: u8 = 0;
const OP_SUB: u8 = 16;
const OP_MUL: u8 = 32;
const OP_DIV: u8 = 48;
const OP_OR: u8 = 64;
const OP_AND: u8 = 80;
const OP_LSH: u8 = 96;
const OP_RSH: u8 = 112;
const OP_NEG: u8 = 128;
const OP_MOD: u8 = 144;
const OP_XOR: u8 = 160;
const OP_MOV: u8 = 176;
const OP_ARSH: u8 = 192;
const OP_END: u8 = 208;
const OP_MASK: u8 = 240;
// Jump operation codes (`BPF_OP`).
const JMP_JA: u8 = 0;
const JMP_JEQ: u8 = 16;
const JMP_JGT: u8 = 32;
const JMP_JGE: u8 = 48;
const JMP_JSET: u8 = 64;
const JMP_JNE: u8 = 80;
const JMP_JSGT: u8 = 96;
const JMP_JSGE: u8 = 112;
const JMP_CALL: u8 = 128;
const JMP_EXIT: u8 = 144;
const JMP_JLT: u8 = 160;
const JMP_JLE: u8 = 176;
const JMP_JSLT: u8 = 192;
const JMP_JSLE: u8 = 208;
// The source bit (`BPF_K` immediate, `BPF_X` register; `BPF_TO_BE` on END).
const SRC_K: u8 = 0;
const SRC_X: u8 = 8;
const SRC_TO_BE: u8 = 8;
// Access sizes (`BPF_SIZE`).
const SIZE_W: u8 = 0;
const SIZE_H: u8 = 8;
const SIZE_B: u8 = 16;
const SIZE_DW: u8 = 24;
const SIZE_MASK: u8 = 24;
// Load and store modes (`BPF_MODE`).
const MODE_IMM: u8 = 0;
const MODE_ABS: u8 = 32;
const MODE_IND: u8 = 64;
const MODE_MEM: u8 = 96;
const MODE_MEMSX: u8 = 128;
const MODE_ATOMIC: u8 = 192;
const MODE_MASK: u8 = 224;
// `BPF_ATOMIC` `imm` values: an ALU op, optionally `BPF_FETCH`, or an
// exchange (`BPF_XCHG` = 0xe0 | FETCH, `BPF_CMPXCHG` = 0xf0 | FETCH).
const ATOMIC_ADD: i32 = 0;
const ATOMIC_OR: i32 = 64;
const ATOMIC_AND: i32 = 80;
const ATOMIC_XOR: i32 = 160;
const ATOMIC_FETCH: i32 = 1;
const ATOMIC_XCHG: i32 = 225;
const ATOMIC_CMPXCHG: i32 = 241;
// `LD_IMM64` and `CALL` source-register pseudo values.
const PSEUDO_MAP_FD: u8 = 1;
const PSEUDO_MAP_VALUE: u8 = 2;
const PSEUDO_MAP_IDX_VALUE: u8 = 6;
const PSEUDO_CALL: u8 = 1;
const PSEUDO_KFUNC_CALL: u8 = 2;
// The largest register number (R10, the frame pointer).
const MAX_REG: u8 = 10;
// A register field is a nibble of byte 1.
const REG_NIBBLE: u8 = 15;
// Bytes per slot.
const SLOT_BYTES: usize = 8;
// `DecodeError.ReservedFieldSet.field` codes.
const FIELD_DST: u8 = 0;
const FIELD_SRC: u8 = 1;
const FIELD_OFF: u8 = 2;
const FIELD_IMM: u8 = 3;

pub copy struct RawInsn {
    code: u8,
    dst: u8,
    src: u8,
    off: i16,
    imm: i32
}

pub copy enum Operand {
    Reg(u8),
    Imm(i32)
}

pub copy enum AluOp {
    Add,
    Sub,
    Mul,
    Div,
    SDiv,
    Or,
    And,
    Lsh,
    Rsh,
    Neg,
    Mod,
    SMod,
    Xor,
    Mov,
    MovSx(u8),
    Arsh
}

pub copy enum Endian {
    ToLe,
    ToBe,
    Swap
}

pub copy enum JmpOp {
    Eq,
    Gt,
    Ge,
    Set,
    Ne,
    SGt,
    SGe,
    Lt,
    Le,
    SLt,
    SLe
}

pub copy enum Size {
    B,
    H,
    W,
    DW
}

pub copy enum AtomicOp {
    Add {
        fetch: bool
    },
    Or {
        fetch: bool
    },
    And {
        fetch: bool
    },
    Xor {
        fetch: bool
    },
    Xchg,
    CmpXchg
}

pub copy enum Imm64 {
    Value(u64),
    MapFd(i32),
    Pseudo {
        src: u8,
        imm_lo: i32,
        imm_hi: i32
    }
}

pub copy enum CallTarget {
    Helper(i32),
    Local(i32),
    Kfunc(i32)
}

pub copy enum Insn {
    Alu {
        wide: bool,
        op: AluOp,
        dst: u8,
        src: Operand
    },
    Endian {
        kind: Endian,
        bits: u8,
        dst: u8
    },
    Ja {
        off: i32
    },
    Jcond {
        wide: bool,
        op: JmpOp,
        dst: u8,
        src: Operand,
        off: i16
    },
    Call(CallTarget),
    Exit,
    LdImm64 {
        dst: u8,
        imm: Imm64
    },
    Ldx {
        size: Size,
        dst: u8,
        src: u8,
        off: i16,
        sign_extend: bool
    },
    St {
        size: Size,
        dst: u8,
        off: i16,
        imm: i32
    },
    Stx {
        size: Size,
        dst: u8,
        src: u8,
        off: i16
    },
    Atomic {
        size: Size,
        op: AtomicOp,
        dst: u8,
        src: u8,
        off: i16
    },
    LdLegacy {
        size: Size,
        indirect: bool,
        src: u8,
        imm: i32
    }
}

pub copy enum DecodeError {
    TruncatedProgram {
        len: usize
    },
    BadRegister {
        pc: usize,
        reg: u8
    },
    InvalidOpcode {
        pc: usize,
        code: u8
    },
    ReservedFieldSet {
        pc: usize,
        field: u8
    },
    BrokenLdImm64 {
        pc: usize
    }
}

// One or two encoded slots (`n` is 1 or 2).
pub copy struct Encoded {
    n: u64,
    lo: RawInsn,
    hi: RawInsn
}

fn raw(code: u8, dst: u8, src: u8, off: i16, imm: i32) -> RawInsn {
    RawInsn {
        code: code,
        dst: dst,
        src: src,
        off: off,
        imm: imm
    }
}

pub fn raw_zero() -> RawInsn {
    raw(0, 0, 0, 0, 0)
}

fn bad(pc: usize, code: u8) -> Never eff [Fail[DecodeError]] {
    Fail::raise(
        DecodeError::InvalidOpcode {
            pc: pc,
            code: code
        }
    )
}

fn reserved(pc: usize, field: u8) -> Never eff [Fail[DecodeError]] {
    Fail::raise(
        DecodeError::ReservedFieldSet {
            pc: pc,
            field: field
        }
    )
}

fn broken(pc: usize) -> Never eff [Fail[DecodeError]] {
    Fail::raise(
        DecodeError::BrokenLdImm64 {
            pc: pc
        }
    )
}

fn reg(pc: usize, n: u8) -> u8 eff [Fail[DecodeError]] {
    if n > MAX_REG {
        Fail::raise(
            DecodeError::BadRegister {
                pc: pc,
                reg: n
            }
        );
    }
    n
}

fn zero_u8(pc: usize, v: u8, field: u8) eff [Fail[DecodeError]] {
    if v != 0 {
        reserved(pc, field);
    }
}

fn zero_i16(pc: usize, v: i16, field: u8) eff [Fail[DecodeError]] {
    if v != 0 {
        reserved(pc, field);
    }
}

fn zero_i32(pc: usize, v: i32, field: u8) eff [Fail[DecodeError]] {
    if v != 0 {
        reserved(pc, field);
    }
}

fn size_from_code(c: u8) -> Size {
    let m = c & SIZE_MASK;
    if m == SIZE_W {
        Size::W
    } else if m == SIZE_H {
        Size::H
    } else if m == SIZE_B {
        Size::B
    } else {
        Size::DW
    }
}

fn size_code(s: Size) -> u8 {
    match s {
        Size::W => SIZE_W,
        Size::H => SIZE_H,
        Size::B => SIZE_B,
        Size::DW => SIZE_DW,
    }
}

fn is_dw(s: Size) -> bool {
    match s {
        Size::DW => true,
        _ => false,
    }
}

fn jmp_from_code(op: u8) -> Option[JmpOp] {
    if op == JMP_JEQ {
        return Option::Some(JmpOp::Eq);
    }
    if op == JMP_JGT {
        return Option::Some(JmpOp::Gt);
    }
    if op == JMP_JGE {
        return Option::Some(JmpOp::Ge);
    }
    if op == JMP_JSET {
        return Option::Some(JmpOp::Set);
    }
    if op == JMP_JNE {
        return Option::Some(JmpOp::Ne);
    }
    if op == JMP_JSGT {
        return Option::Some(JmpOp::SGt);
    }
    if op == JMP_JSGE {
        return Option::Some(JmpOp::SGe);
    }
    if op == JMP_JLT {
        return Option::Some(JmpOp::Lt);
    }
    if op == JMP_JLE {
        return Option::Some(JmpOp::Le);
    }
    if op == JMP_JSLT {
        return Option::Some(JmpOp::SLt);
    }
    if op == JMP_JSLE {
        return Option::Some(JmpOp::SLe);
    }
    Option::None
}

fn jmp_code(op: JmpOp) -> u8 {
    match op {
        JmpOp::Eq => JMP_JEQ,
        JmpOp::Gt => JMP_JGT,
        JmpOp::Ge => JMP_JGE,
        JmpOp::Set => JMP_JSET,
        JmpOp::Ne => JMP_JNE,
        JmpOp::SGt => JMP_JSGT,
        JmpOp::SGe => JMP_JSGE,
        JmpOp::Lt => JMP_JLT,
        JmpOp::Le => JMP_JLE,
        JmpOp::SLt => JMP_JSLT,
        JmpOp::SLe => JMP_JSLE,
    }
}

// (opcode high nibble, off) of an ALU op.
fn alu_code(op: AluOp) -> (u8, i16) {
    match op {
        AluOp::Add => (OP_ADD, 0),
        AluOp::Sub => (OP_SUB, 0),
        AluOp::Mul => (OP_MUL, 0),
        AluOp::Div => (OP_DIV, 0),
        AluOp::SDiv => (OP_DIV, 1),
        AluOp::Or => (OP_OR, 0),
        AluOp::And => (OP_AND, 0),
        AluOp::Lsh => (OP_LSH, 0),
        AluOp::Rsh => (OP_RSH, 0),
        AluOp::Neg => (OP_NEG, 0),
        AluOp::Mod => (OP_MOD, 0),
        AluOp::SMod => (OP_MOD, 1),
        AluOp::Xor => (OP_XOR, 0),
        AluOp::Mov => (OP_MOV, 0),
        AluOp::MovSx(b) => (OP_MOV, widen_i16(b)),
        AluOp::Arsh => (OP_ARSH, 0),
    }
}

fn atomic_from_imm(imm: i32) -> Option[AtomicOp] {
    if imm == ATOMIC_XCHG {
        return Option::Some(AtomicOp::Xchg);
    }
    if imm == ATOMIC_CMPXCHG {
        return Option::Some(AtomicOp::CmpXchg);
    }
    let fetch = (imm & ATOMIC_FETCH) != 0;
    let code = imm & ~ATOMIC_FETCH;
    if code == ATOMIC_ADD {
        return Option::Some(
            AtomicOp::Add {
                fetch: fetch
            }
        );
    }
    if code == ATOMIC_OR {
        return Option::Some(
            AtomicOp::Or {
                fetch: fetch
            }
        );
    }
    if code == ATOMIC_AND {
        return Option::Some(
            AtomicOp::And {
                fetch: fetch
            }
        );
    }
    if code == ATOMIC_XOR {
        return Option::Some(
            AtomicOp::Xor {
                fetch: fetch
            }
        );
    }
    Option::None
}

fn fetch_bit(f: bool) -> i32 {
    if f {
        ATOMIC_FETCH
    } else {
        0
    }
}

fn atomic_imm(op: AtomicOp) -> i32 {
    match op {
        AtomicOp::Add {
            fetch
        }
        => ATOMIC_ADD | fetch_bit(fetch),
        AtomicOp::Or {
            fetch
        }
        => ATOMIC_OR | fetch_bit(fetch),
        AtomicOp::And {
            fetch
        }
        => ATOMIC_AND | fetch_bit(fetch),
        AtomicOp::Xor {
            fetch
        }
        => ATOMIC_XOR | fetch_bit(fetch),
        AtomicOp::Xchg => ATOMIC_XCHG,
        AtomicOp::CmpXchg => ATOMIC_CMPXCHG,
    }
}

// The ALU op of opcode nibble `opc` with offset `off` (ISA v4 signed and
// sign-extending forms), or None.
fn alu_op(opc: u8, off: i16, wide: bool) -> Option[AluOp] {
    if off == 0 {
        if opc == OP_ADD {
            return Option::Some(AluOp::Add);
        }
        if opc == OP_SUB {
            return Option::Some(AluOp::Sub);
        }
        if opc == OP_MUL {
            return Option::Some(AluOp::Mul);
        }
        if opc == OP_DIV {
            return Option::Some(AluOp::Div);
        }
        if opc == OP_OR {
            return Option::Some(AluOp::Or);
        }
        if opc == OP_AND {
            return Option::Some(AluOp::And);
        }
        if opc == OP_LSH {
            return Option::Some(AluOp::Lsh);
        }
        if opc == OP_RSH {
            return Option::Some(AluOp::Rsh);
        }
        if opc == OP_NEG {
            return Option::Some(AluOp::Neg);
        }
        if opc == OP_MOD {
            return Option::Some(AluOp::Mod);
        }
        if opc == OP_XOR {
            return Option::Some(AluOp::Xor);
        }
        if opc == OP_MOV {
            return Option::Some(AluOp::Mov);
        }
        if opc == OP_ARSH {
            return Option::Some(AluOp::Arsh);
        }
        return Option::None;
    }
    if off == 1 && opc == OP_DIV {
        return Option::Some(AluOp::SDiv);
    }
    if off == 1 && opc == OP_MOD {
        return Option::Some(AluOp::SMod);
    }
    if opc == OP_MOV && (off == 8 || off == 16 || (off == 32 && wide)) {
        return Option::Some(AluOp::MovSx(wrapping_u8(off)));
    }
    Option::None
}

fn decode_alu(pc: usize, r: RawInsn) -> Insn eff [Fail[DecodeError]] {
    let wide = (r.code & CLASS_MASK) == CLASS_ALU64;
    let x = r.code & SRC_X != 0;
    let dst = reg(pc, r.dst);
    let opc = r.code & OP_MASK;
    if opc == OP_END {
        let kind = if !wide && !x {
            Endian::ToLe
        } else if !wide {
            Endian::ToBe
        } else if !x {
            Endian::Swap
        } else {
            bad(pc, r.code)
        };
        zero_u8(pc, r.src, FIELD_SRC);
        zero_i16(pc, r.off, FIELD_OFF);
        let width: u8 = if r.imm == 16 {
            16
        } else if r.imm == 32 {
            32
        } else if r.imm == 64 {
            64
        } else {
            bad(pc, r.code)
        };
        return Insn::Endian {
            kind: kind,
            bits: width,
            dst: dst
        };
    }
    let op = match alu_op(opc, r.off, wide) {
        Option::Some(o) => o,
        Option::None => if opc <= OP_ARSH {
            reserved(pc, 2)
        } else {
            bad(pc, r.code)
        },
    };
    let is_neg = match op {
        AluOp::Neg => true,
        _ => false,
    };
    let src = if is_neg {
        if x {
            bad(pc, r.code);
        }
        zero_u8(pc, r.src, FIELD_SRC);
        zero_i32(pc, r.imm, FIELD_IMM);
        Operand::Imm(0)
    } else if x {
        zero_i32(pc, r.imm, FIELD_IMM);
        Operand::Reg(reg(pc, r.src))
    } else {
        zero_u8(pc, r.src, FIELD_SRC);
        Operand::Imm(r.imm)
    };
    let is_movsx = match op {
        AluOp::MovSx(b) => true,
        _ => false,
    };
    if is_movsx && !x {
        bad(pc, r.code);
    }
    Insn::Alu {
        wide: wide,
        op: op,
        dst: dst,
        src: src
    }
}

fn decode_jmp(pc: usize, r: RawInsn) -> Insn eff [Fail[DecodeError]] {
    let wide = (r.code & CLASS_MASK) == CLASS_JMP;
    let x = r.code & SRC_X != 0;
    let opc = r.code & OP_MASK;
    if opc == JMP_JA {
        if x {
            bad(pc, r.code);
        }
        zero_u8(pc, r.dst, FIELD_DST);
        zero_u8(pc, r.src, FIELD_SRC);
        if wide {
            zero_i32(pc, r.imm, FIELD_IMM);
            return Insn::Ja {
                off: widen_i32(r.off)
            };
        }
        zero_i16(pc, r.off, FIELD_OFF);
        return Insn::Ja {
            off: r.imm
        };
    }
    if opc == JMP_CALL && wide {
        if x {
            bad(pc, r.code);
        }
        zero_u8(pc, r.dst, FIELD_DST);
        zero_i16(pc, r.off, FIELD_OFF);
        let t = if r.src == 0 {
            CallTarget::Helper(r.imm)
        } else if r.src == 1 {
            CallTarget::Local(r.imm)
        } else if r.src == 2 {
            CallTarget::Kfunc(r.imm)
        } else {
            bad(pc, r.code)
        };
        return Insn::Call(t);
    }
    if opc == JMP_EXIT && wide {
        if x {
            bad(pc, r.code);
        }
        zero_u8(pc, r.dst, FIELD_DST);
        zero_u8(pc, r.src, FIELD_SRC);
        zero_i16(pc, r.off, FIELD_OFF);
        zero_i32(pc, r.imm, FIELD_IMM);
        return Insn::Exit;
    }
    let op = match jmp_from_code(opc) {
        Option::Some(o) => o,
        Option::None => bad(pc, r.code),
    };
    let dst = reg(pc, r.dst);
    let src = if x {
        zero_i32(pc, r.imm, FIELD_IMM);
        Operand::Reg(reg(pc, r.src))
    } else {
        zero_u8(pc, r.src, FIELD_SRC);
        Operand::Imm(r.imm)
    };
    Insn::Jcond {
        wide: wide,
        op: op,
        dst: dst,
        src: src,
        off: r.off
    }
}

fn decode_ld(pc: usize, r: RawInsn, has_hi: bool, hi: RawInsn) -> Insn eff [Fail[DecodeError]] {
    let size = size_from_code(r.code);
    let mode = r.code & MODE_MASK;
    if mode == MODE_IMM && is_dw(size) {
        let dst = reg(pc, r.dst);
        zero_i16(pc, r.off, FIELD_OFF);
        if !has_hi {
            broken(pc);
        }
        if hi.code != 0 || hi.dst != 0 || hi.src != 0 || hi.off != 0 {
            broken(pc);
        }
        let imm = if r.src == 0 {
            let lo = widen_u64(wrapping_u32(r.imm));
            let up = widen_u64(wrapping_u32(hi.imm));
            Imm64::Value(lo | (up << 32))
        } else if r.src == PSEUDO_MAP_FD {
            if hi.imm != 0 {
                broken(pc);
            }
            Imm64::MapFd(r.imm)
        } else if r.src >= PSEUDO_MAP_VALUE && r.src <= PSEUDO_MAP_IDX_VALUE {
            Imm64::Pseudo {
                src: r.src,
                imm_lo: r.imm,
                imm_hi: hi.imm
            }
        } else {
            bad(pc, r.code)
        };
        return Insn::LdImm64 {
            dst: dst,
            imm: imm
        };
    }
    if (mode == MODE_ABS || mode == MODE_IND) && !is_dw(size) {
        zero_u8(pc, r.dst, FIELD_DST);
        zero_i16(pc, r.off, FIELD_OFF);
        let indirect = mode == MODE_IND;
        let src = if indirect {
            reg(pc, r.src)
        } else {
            zero_u8(pc, r.src, FIELD_SRC);
            0
        };
        return Insn::LdLegacy {
            size: size,
            indirect: indirect,
            src: src,
            imm: r.imm
        };
    }
    bad(pc, r.code)
}

fn decode_mem(pc: usize, r: RawInsn) -> Insn eff [Fail[DecodeError]] {
    let cls = r.code & CLASS_MASK;
    let size = size_from_code(r.code);
    let mode = r.code & MODE_MASK;
    if cls == CLASS_LDX {
        let sign_extend = if mode == MODE_MEM {
            false
        } else if mode == MODE_MEMSX && !is_dw(size) {
            true
        } else {
            bad(pc, r.code)
        };
        zero_i32(pc, r.imm, FIELD_IMM);
        let dst = reg(pc, r.dst);
        let src = reg(pc, r.src);
        return Insn::Ldx {
            size: size,
            dst: dst,
            src: src,
            off: r.off,
            sign_extend: sign_extend
        };
    }
    if cls == 2 {
        if mode != MODE_MEM {
            bad(pc, r.code);
        }
        zero_u8(pc, r.src, FIELD_SRC);
        return Insn::St {
            size: size,
            dst: reg(pc, r.dst),
            off: r.off,
            imm: r.imm
        };
    }
    // STX
    if mode == MODE_MEM {
        zero_i32(pc, r.imm, FIELD_IMM);
        let dst = reg(pc, r.dst);
        let src = reg(pc, r.src);
        return Insn::Stx {
            size: size,
            dst: dst,
            src: src,
            off: r.off
        };
    }
    let atomic_size = match size {
        Size::W => true,
        Size::DW => true,
        _ => false,
    };
    if mode == MODE_ATOMIC && atomic_size {
        let op = match atomic_from_imm(r.imm) {
            Option::Some(o) => o,
            Option::None => bad(pc, r.code),
        };
        let dst = reg(pc, r.dst);
        let src = reg(pc, r.src);
        return Insn::Atomic {
            size: size,
            op: op,
            dst: dst,
            src: src,
            off: r.off
        };
    }
    bad(pc, r.code)
}

// Decode the instruction at slot `pc` of a program of `len` slots; `lo` is
// slot `pc` and `hi` slot `pc + 1` (zero when absent).
pub fn decode(pc: usize, len: usize, lo: RawInsn, hi: RawInsn) -> Insn eff [Fail[DecodeError]] {
    if pc >= len {
        Fail::raise(
            DecodeError::TruncatedProgram {
                len: wrapping_mul(len, SLOT_BYTES)
            }
        );
    }
    decode_slot(pc, lo, wrapping_add(pc, 1) < len, hi)
}

fn decode_slot(pc: usize, r: RawInsn, has_hi: bool, hi: RawInsn) -> Insn eff [Fail[DecodeError]] {
    let cls = r.code & CLASS_MASK;
    if cls == CLASS_ALU || cls == CLASS_ALU64 {
        decode_alu(pc, r)
    } else if cls == CLASS_JMP || cls == CLASS_JMP32 {
        decode_jmp(pc, r)
    } else if cls == CLASS_LD {
        decode_ld(pc, r, has_hi, hi)
    } else {
        decode_mem(pc, r)
    }
}

fn slot_at(in slots: Slice[RawInsn], i: usize) -> RawInsn {
    match slots.try_get(widen_u64(i)) {
        Option::Some(r) => r,
        Option::None => raw_zero(),
    }
}

fn is_ld_imm64(i: Insn) -> bool {
    match i {
        Insn::LdImm64 {
            dst,
            imm
        }
        => true,
        _ => false,
    }
}

// Every instruction of the program, in order (the Rust wrapper adds the
// `None` entry after each `LD_IMM64`).
pub fn decode_all(in slots: Slice[RawInsn]) -> ChunkSeq[Insn] eff [Fail[DecodeError]] {
    let mut out: ChunkSeq[Insn] = ChunkSeq::with_capacity[Insn](slots.len());
    let n = narrow_usize(slots.len());
    let mut pc: usize = 0;
    loop {
        if !(pc < n) {
            break;
        }
        let next = wrapping_add(pc, 1);
        let i = decode_slot(pc, slot_at(in slots, pc), next < n, slot_at(in slots, next));
        out.push(i);
        if is_ld_imm64(i) {
            pc = wrapping_add(pc, 2);
        } else {
            pc = next;
        }
    }
    out
}

// `decode_all` straight into the interpreter's per-slot tables: the second
// slot of a wide load gets `Exit` and a false `start`.
pub fn decode_slots(
    in slots: Slice[RawInsn],
    inout out: ChunkSeq[Insn],
    inout start: ChunkSeq[bool]
) eff [Fail[DecodeError]] {
    let n = narrow_usize(slots.len());
    let mut pc: usize = 0;
    loop {
        if !(pc < n) {
            break;
        }
        let next = wrapping_add(pc, 1);
        let i = decode_slot(pc, slot_at(in slots, pc), next < n, slot_at(in slots, next));
        out.push(i);
        start.push(true);
        if is_ld_imm64(i) {
            out.push(Insn::Exit);
            start.push(false);
            pc = wrapping_add(pc, 2);
        } else {
            pc = next;
        }
    }
}

fn one(r: RawInsn) -> Encoded {
    Encoded {
        n: 1,
        lo: r,
        hi: raw_zero()
    }
}

fn op_src(o: Operand) -> (u8, u8, i32) {
    match o {
        Operand::Imm(i) => (SRC_K, 0, i),
        Operand::Reg(s) => (SRC_X, s, 0),
    }
}

// Encode one instruction into one or two slots.
pub fn encode(i: Insn) -> Encoded {
    match i {
        Insn::Alu {
            wide,
            op,
            dst,
            src
        }
        => {
            let cls: u8 = if wide {
                CLASS_ALU64
            } else {
                CLASS_ALU
            };
            let (opc, off) = alu_code(op);
            let (x, sreg, imm) = op_src(src);
            one(raw(cls | opc | x, dst, sreg, off, imm))
        },
        Insn::Endian {
            kind,
            bits,
            dst
        }
        => {
            let code: u8 = match kind {
                Endian::ToLe => CLASS_ALU | OP_END,
                Endian::ToBe => CLASS_ALU | OP_END | SRC_TO_BE,
                Endian::Swap => CLASS_ALU64 | OP_END,
            };
            one(raw(code, dst, 0, 0, widen_i32(bits)))
        },
        Insn::Ja {
            off
        }
        => if off >= -32768 && off <= 32767 {
            one(raw(CLASS_JMP | JMP_JA, 0, 0, wrapping_i16(off), 0))
        } else {
            one(raw(CLASS_JMP32 | JMP_JA, 0, 0, 0, off))
        },
        Insn::Jcond {
            wide,
            op,
            dst,
            src,
            off
        }
        => {
            let cls: u8 = if wide {
                CLASS_JMP
            } else {
                CLASS_JMP32
            };
            let (x, sreg, imm) = op_src(src);
            one(raw(cls | jmp_code(op) | x, dst, sreg, off, imm))
        },
        Insn::Call(t) => match t {
            CallTarget::Helper(n) => one(raw(CLASS_JMP | JMP_CALL, 0, 0, 0, n)),
            CallTarget::Local(n) => one(raw(CLASS_JMP | JMP_CALL, 0, PSEUDO_CALL, 0, n)),
            CallTarget::Kfunc(n) => one(raw(CLASS_JMP | JMP_CALL, 0, PSEUDO_KFUNC_CALL, 0, n)),
        },
        Insn::Exit => one(raw(CLASS_JMP | JMP_EXIT, 0, 0, 0, 0)),
        Insn::LdImm64 {
            dst,
            imm
        }
        => {
            let (src, lo, up): (u8, i32, i32) = match imm {
                Imm64::Value(v) => (0, wrapping_i32(v), wrapping_i32(v >> 32)),
                Imm64::MapFd(fd) => (PSEUDO_MAP_FD, fd, 0),
                Imm64::Pseudo {
                    src,
                    imm_lo,
                    imm_hi
                }
                => (src, imm_lo, imm_hi),
            };
            Encoded {
                n: 2,
                lo: raw(CLASS_LD | MODE_IMM | SIZE_DW, dst, src, 0, lo),
                hi: raw(0, 0, 0, 0, up)
            }
        },
        Insn::Ldx {
            size,
            dst,
            src,
            off,
            sign_extend
        }
        => {
            let mode: u8 = if sign_extend {
                MODE_MEMSX
            } else {
                MODE_MEM
            };
            one(raw(CLASS_LDX | mode | size_code(size), dst, src, off, 0))
        },
        Insn::St {
            size,
            dst,
            off,
            imm
        }
        => one(raw(CLASS_ST | MODE_MEM | size_code(size), dst, 0, off, imm)),
        Insn::Stx {
            size,
            dst,
            src,
            off
        }
        => one(raw(CLASS_STX | MODE_MEM | size_code(size), dst, src, off, 0)),
        Insn::Atomic {
            size,
            op,
            dst,
            src,
            off
        }
        => one(raw(CLASS_STX | MODE_ATOMIC | size_code(size), dst, src, off, atomic_imm(op))),
        Insn::LdLegacy {
            size,
            indirect,
            src,
            imm
        }
        => {
            let mode: u8 = if indirect {
                MODE_IND
            } else {
                MODE_ABS
            };
            let s: u8 = if indirect {
                src
            } else {
                0
            };
            one(raw(CLASS_LD | mode | size_code(size), 0, s, 0, imm))
        },
    }
}

// Little-endian wire bytes of every slot (insn::slots_to_bytes).
pub fn slots_to_bytes(in slots: Slice[RawInsn]) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..slots.len() {
        let r = slot_at(in slots, narrow_usize(i));
        let off = wrapping_u16(r.off);
        let imm = wrapping_u32(r.imm);
        out.push(r.code);
        out.push((r.dst & REG_NIBBLE) | ((r.src & REG_NIBBLE) << 4));
        out.push(wrapping_u8(off));
        out.push(wrapping_u8(off >> 8));
        out.push(wrapping_u8(imm));
        out.push(wrapping_u8(imm >> 8));
        out.push(wrapping_u8(imm >> 16));
        out.push(wrapping_u8(imm >> 24));
    }
    out
}

fn byte(in b: Slice[u8], i: u64) -> u8 {
    match b.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// Slots of `bytes`, whose length must be a multiple of eight
// (insn::slots_from_bytes).
pub fn slots_from_bytes(in bytes: Slice[u8]) -> ChunkSeq[RawInsn] eff [Fail[DecodeError]] {
    let n = bytes.len();
    if n & 7 != 0 {
        Fail::raise(
            DecodeError::TruncatedProgram {
                len: narrow_usize(n)
            }
        );
    }
    let mut out: ChunkSeq[RawInsn] = ChunkSeq::new[RawInsn]();
    let mut at: u64 = 0;
    loop {
        if !(at < n) {
            break;
        }
        let b1 = byte(in bytes, wrapping_add(at, 1));
        let off = widen_u16(byte(in bytes, wrapping_add(at, 2))) | (
            widen_u16(byte(in bytes, wrapping_add(at, 3))) << 8
        );
        let imm = widen_u32(byte(in bytes, wrapping_add(at, 4))) | (
            widen_u32(byte(in bytes, wrapping_add(at, 5))) << 8
        ) | (widen_u32(byte(in bytes, wrapping_add(at, 6))) << 16) | (
            widen_u32(byte(in bytes, wrapping_add(at, 7))) << 24
        );
        out.push(raw(byte(in bytes, at), b1 & 15, b1 >> 4, wrapping_i16(off), wrapping_i32(imm)));
        at = wrapping_add(at, 8);
    }
    out
}
