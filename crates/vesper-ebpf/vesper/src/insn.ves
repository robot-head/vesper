// Module insn of @vesper/ebpf (see lib.ves): src/insn.rs, the instruction
// codec. Registers are `u8` numbers in `0..=10` here; the Rust wrapper turns
// them into `Reg`. `DecodeError.ReservedFieldSet.field` is 0 dst, 1 src,
// 2 off, 3 imm.

// The opcode fields of src/insn.rs (`class`, `op`, `jmp`, `source`, `size`,
// `mode`, `atomic`, `pseudo`), named after the kernel's `BPF_*` macros
// (include/uapi/linux/bpf.h, RFC 9669), grouped as value enums.

// Instruction classes (`BPF_CLASS`, low three bits).
pub enum BpfClass: u8 {
    Ld = 0,
    Ldx = 1,
    St = 2,
    Stx = 3,
    Alu = 4,
    Jmp = 5,
    Jmp32 = 6,
    Alu64 = 7,
    Mask = 7,
}

// ALU operation codes (`BPF_OP`, high four bits).
pub enum BpfAlu: u8 {
    Add = 0,
    Sub = 16,
    Mul = 32,
    Div = 48,
    Or = 64,
    And = 80,
    Lsh = 96,
    Rsh = 112,
    Neg = 128,
    Mod = 144,
    Xor = 160,
    Mov = 176,
    Arsh = 192,
    End = 208,
    Mask = 240,
}

// Jump operation codes (`BPF_OP`).
pub enum BpfJmp: u8 {
    Ja = 0,
    Jeq = 16,
    Jgt = 32,
    Jge = 48,
    Jset = 64,
    Jne = 80,
    Jsgt = 96,
    Jsge = 112,
    Call = 128,
    Exit = 144,
    Jlt = 160,
    Jle = 176,
    Jslt = 192,
    Jsle = 208,
}

// The source bit (`BPF_K` immediate, `BPF_X` register; `BPF_TO_BE` on END).
pub enum BpfSrc: u8 {
    K = 0,
    X = 8,
    ToBe = 8,
}

// Access sizes (`BPF_SIZE`).
pub enum BpfSize: u8 {
    W = 0,
    H = 8,
    B = 16,
    Dw = 24,
    Mask = 24,
}

// Load and store modes (`BPF_MODE`).
pub enum BpfMode: u8 {
    Imm = 0,
    Abs = 32,
    Ind = 64,
    Mem = 96,
    Memsx = 128,
    Atomic = 192,
    Mask = 224,
}

// `BPF_ATOMIC` `imm` values: an ALU op, optionally `BPF_FETCH`, or an
// exchange (`BPF_XCHG` = 0xe0 | FETCH, `BPF_CMPXCHG` = 0xf0 | FETCH).
pub enum BpfAtomic: i32 {
    Add = 0,
    Or = 64,
    And = 80,
    Xor = 160,
    Fetch = 1,
    Xchg = 225,
    Cmpxchg = 241,
}

// `LD_IMM64` source-register pseudo values (`BPF_PSEUDO_MAP_*`).
pub enum PseudoLd: u8 {
    Fd = 1,
    Value = 2,
    IdxValue = 6,
}

// `CALL` source-register pseudo values (`BPF_PSEUDO_CALL`, `BPF_PSEUDO_KFUNC_CALL`).
pub enum PseudoCall: u8 {
    Call = 1,
    KfuncCall = 2,
}
// The largest register number (R10, the frame pointer).
const MAX_REG: u8 = 10;
// A register field is a nibble of byte 1.
const REG_NIBBLE: u8 = 15;
// Bytes per slot.
const SLOT_BYTES: usize = 8;
// `DecodeError.ReservedFieldSet.field` codes.
const FIELD_DST: u8 = 0;
const FIELD_SRC: u8 = 1;
const FIELD_OFF: u8 = 2;
const FIELD_IMM: u8 = 3;

pub copy struct RawInsn {
    code: u8,
    dst: u8,
    src: u8,
    off: i16,
    imm: i32
}

pub copy enum Operand {
    Reg(u8),
    Imm(i32)
}

pub copy enum AluOp {
    Add,
    Sub,
    Mul,
    Div,
    SDiv,
    Or,
    And,
    Lsh,
    Rsh,
    Neg,
    Mod,
    SMod,
    Xor,
    Mov,
    MovSx(u8),
    Arsh
}

pub copy enum Endian {
    ToLe,
    ToBe,
    Swap
}

pub copy enum JmpOp {
    Eq,
    Gt,
    Ge,
    Set,
    Ne,
    SGt,
    SGe,
    Lt,
    Le,
    SLt,
    SLe
}

pub copy enum Size {
    B,
    H,
    W,
    DW
}

pub copy enum AtomicOp {
    Add {
        fetch: bool
    },
    Or {
        fetch: bool
    },
    And {
        fetch: bool
    },
    Xor {
        fetch: bool
    },
    Xchg,
    CmpXchg
}

pub copy enum Imm64 {
    Value(u64),
    MapFd(i32),
    Pseudo {
        src: u8,
        imm_lo: i32,
        imm_hi: i32
    }
}

pub copy enum CallTarget {
    Helper(i32),
    Local(i32),
    Kfunc(i32)
}

pub copy enum Insn {
    Alu {
        wide: bool,
        op: AluOp,
        dst: u8,
        src: Operand
    },
    Endian {
        kind: Endian,
        bits: u8,
        dst: u8
    },
    Ja {
        off: i32
    },
    Jcond {
        wide: bool,
        op: JmpOp,
        dst: u8,
        src: Operand,
        off: i16
    },
    Call(CallTarget),
    Exit,
    LdImm64 {
        dst: u8,
        imm: Imm64
    },
    Ldx {
        size: Size,
        dst: u8,
        src: u8,
        off: i16,
        sign_extend: bool
    },
    St {
        size: Size,
        dst: u8,
        off: i16,
        imm: i32
    },
    Stx {
        size: Size,
        dst: u8,
        src: u8,
        off: i16
    },
    Atomic {
        size: Size,
        op: AtomicOp,
        dst: u8,
        src: u8,
        off: i16
    },
    LdLegacy {
        size: Size,
        indirect: bool,
        src: u8,
        imm: i32
    }
}

pub copy enum DecodeError {
    TruncatedProgram {
        len: usize
    },
    BadRegister {
        pc: usize,
        reg: u8
    },
    InvalidOpcode {
        pc: usize,
        code: u8
    },
    ReservedFieldSet {
        pc: usize,
        field: u8
    },
    BrokenLdImm64 {
        pc: usize
    }
}

// One or two encoded slots (`n` is 1 or 2).
pub copy struct Encoded {
    n: u64,
    lo: RawInsn,
    hi: RawInsn
}

fn raw(code: u8, dst: u8, src: u8, off: i16, imm: i32) -> RawInsn {
    RawInsn {
        code: code,
        dst: dst,
        src: src,
        off: off,
        imm: imm
    }
}

pub fn raw_zero() -> RawInsn {
    raw(0, 0, 0, 0, 0)
}

fn bad(pc: usize, code: u8) -> Never eff [Fail[DecodeError]] {
    Fail::raise(
        DecodeError::InvalidOpcode {
            pc: pc,
            code: code
        }
    )
}

fn reserved(pc: usize, field: u8) -> Never eff [Fail[DecodeError]] {
    Fail::raise(
        DecodeError::ReservedFieldSet {
            pc: pc,
            field: field
        }
    )
}

fn broken(pc: usize) -> Never eff [Fail[DecodeError]] {
    Fail::raise(
        DecodeError::BrokenLdImm64 {
            pc: pc
        }
    )
}

fn reg(pc: usize, n: u8) -> u8 eff [Fail[DecodeError]] {
    if n > MAX_REG {
        Fail::raise(
            DecodeError::BadRegister {
                pc: pc,
                reg: n
            }
        );
    }
    n
}

fn zero_u8(pc: usize, v: u8, field: u8) eff [Fail[DecodeError]] {
    if v != 0 {
        reserved(pc, field);
    }
}

fn zero_i16(pc: usize, v: i16, field: u8) eff [Fail[DecodeError]] {
    if v != 0 {
        reserved(pc, field);
    }
}

fn zero_i32(pc: usize, v: i32, field: u8) eff [Fail[DecodeError]] {
    if v != 0 {
        reserved(pc, field);
    }
}

fn size_from_code(c: u8) -> Size {
    let m = c & BpfSize::Mask;
    if m == BpfSize::W {
        Size::W
    } else if m == BpfSize::H {
        Size::H
    } else if m == BpfSize::B {
        Size::B
    } else {
        Size::DW
    }
}

fn size_code(s: Size) -> u8 {
    match s {
        Size::W => BpfSize::W,
        Size::H => BpfSize::H,
        Size::B => BpfSize::B,
        Size::DW => BpfSize::Dw,
    }
}

fn is_dw(s: Size) -> bool {
    match s {
        Size::DW => true,
        _ => false,
    }
}

fn jmp_from_code(op: u8) -> Option[JmpOp] {
    if op == BpfJmp::Jeq {
        return Option::Some(JmpOp::Eq);
    }
    if op == BpfJmp::Jgt {
        return Option::Some(JmpOp::Gt);
    }
    if op == BpfJmp::Jge {
        return Option::Some(JmpOp::Ge);
    }
    if op == BpfJmp::Jset {
        return Option::Some(JmpOp::Set);
    }
    if op == BpfJmp::Jne {
        return Option::Some(JmpOp::Ne);
    }
    if op == BpfJmp::Jsgt {
        return Option::Some(JmpOp::SGt);
    }
    if op == BpfJmp::Jsge {
        return Option::Some(JmpOp::SGe);
    }
    if op == BpfJmp::Jlt {
        return Option::Some(JmpOp::Lt);
    }
    if op == BpfJmp::Jle {
        return Option::Some(JmpOp::Le);
    }
    if op == BpfJmp::Jslt {
        return Option::Some(JmpOp::SLt);
    }
    if op == BpfJmp::Jsle {
        return Option::Some(JmpOp::SLe);
    }
    Option::None
}

fn jmp_code(op: JmpOp) -> u8 {
    match op {
        JmpOp::Eq => BpfJmp::Jeq,
        JmpOp::Gt => BpfJmp::Jgt,
        JmpOp::Ge => BpfJmp::Jge,
        JmpOp::Set => BpfJmp::Jset,
        JmpOp::Ne => BpfJmp::Jne,
        JmpOp::SGt => BpfJmp::Jsgt,
        JmpOp::SGe => BpfJmp::Jsge,
        JmpOp::Lt => BpfJmp::Jlt,
        JmpOp::Le => BpfJmp::Jle,
        JmpOp::SLt => BpfJmp::Jslt,
        JmpOp::SLe => BpfJmp::Jsle,
    }
}

// (opcode high nibble, off) of an ALU op.
fn alu_code(op: AluOp) -> (u8, i16) {
    match op {
        AluOp::Add => (BpfAlu::Add, 0),
        AluOp::Sub => (BpfAlu::Sub, 0),
        AluOp::Mul => (BpfAlu::Mul, 0),
        AluOp::Div => (BpfAlu::Div, 0),
        AluOp::SDiv => (BpfAlu::Div, 1),
        AluOp::Or => (BpfAlu::Or, 0),
        AluOp::And => (BpfAlu::And, 0),
        AluOp::Lsh => (BpfAlu::Lsh, 0),
        AluOp::Rsh => (BpfAlu::Rsh, 0),
        AluOp::Neg => (BpfAlu::Neg, 0),
        AluOp::Mod => (BpfAlu::Mod, 0),
        AluOp::SMod => (BpfAlu::Mod, 1),
        AluOp::Xor => (BpfAlu::Xor, 0),
        AluOp::Mov => (BpfAlu::Mov, 0),
        AluOp::MovSx(b) => (BpfAlu::Mov, widen_i16(b)),
        AluOp::Arsh => (BpfAlu::Arsh, 0),
    }
}

fn atomic_from_imm(imm: i32) -> Option[AtomicOp] {
    if imm == BpfAtomic::Xchg {
        return Option::Some(AtomicOp::Xchg);
    }
    if imm == BpfAtomic::Cmpxchg {
        return Option::Some(AtomicOp::CmpXchg);
    }
    let fetch = (imm & BpfAtomic::Fetch) != 0;
    let code = imm & ~BpfAtomic::Fetch;
    if code == BpfAtomic::Add {
        return Option::Some(
            AtomicOp::Add {
                fetch: fetch
            }
        );
    }
    if code == BpfAtomic::Or {
        return Option::Some(
            AtomicOp::Or {
                fetch: fetch
            }
        );
    }
    if code == BpfAtomic::And {
        return Option::Some(
            AtomicOp::And {
                fetch: fetch
            }
        );
    }
    if code == BpfAtomic::Xor {
        return Option::Some(
            AtomicOp::Xor {
                fetch: fetch
            }
        );
    }
    Option::None
}

fn fetch_bit(f: bool) -> i32 {
    if f {
        BpfAtomic::Fetch
    } else {
        0
    }
}

fn atomic_imm(op: AtomicOp) -> i32 {
    match op {
        AtomicOp::Add {
            fetch
        }
        => BpfAtomic::Add | fetch_bit(fetch),
        AtomicOp::Or {
            fetch
        }
        => BpfAtomic::Or | fetch_bit(fetch),
        AtomicOp::And {
            fetch
        }
        => BpfAtomic::And | fetch_bit(fetch),
        AtomicOp::Xor {
            fetch
        }
        => BpfAtomic::Xor | fetch_bit(fetch),
        AtomicOp::Xchg => BpfAtomic::Xchg,
        AtomicOp::CmpXchg => BpfAtomic::Cmpxchg,
    }
}

// The ALU op of opcode nibble `opc` with offset `off` (ISA v4 signed and
// sign-extending forms), or None.
fn alu_op(opc: u8, off: i16, wide: bool) -> Option[AluOp] {
    if off == 0 {
        if opc == BpfAlu::Add {
            return Option::Some(AluOp::Add);
        }
        if opc == BpfAlu::Sub {
            return Option::Some(AluOp::Sub);
        }
        if opc == BpfAlu::Mul {
            return Option::Some(AluOp::Mul);
        }
        if opc == BpfAlu::Div {
            return Option::Some(AluOp::Div);
        }
        if opc == BpfAlu::Or {
            return Option::Some(AluOp::Or);
        }
        if opc == BpfAlu::And {
            return Option::Some(AluOp::And);
        }
        if opc == BpfAlu::Lsh {
            return Option::Some(AluOp::Lsh);
        }
        if opc == BpfAlu::Rsh {
            return Option::Some(AluOp::Rsh);
        }
        if opc == BpfAlu::Neg {
            return Option::Some(AluOp::Neg);
        }
        if opc == BpfAlu::Mod {
            return Option::Some(AluOp::Mod);
        }
        if opc == BpfAlu::Xor {
            return Option::Some(AluOp::Xor);
        }
        if opc == BpfAlu::Mov {
            return Option::Some(AluOp::Mov);
        }
        if opc == BpfAlu::Arsh {
            return Option::Some(AluOp::Arsh);
        }
        return Option::None;
    }
    if off == 1 && opc == BpfAlu::Div {
        return Option::Some(AluOp::SDiv);
    }
    if off == 1 && opc == BpfAlu::Mod {
        return Option::Some(AluOp::SMod);
    }
    if opc == BpfAlu::Mov && (off == 8 || off == 16 || (off == 32 && wide)) {
        return Option::Some(AluOp::MovSx(wrapping_u8(off)));
    }
    Option::None
}

fn decode_alu(pc: usize, r: RawInsn) -> Insn eff [Fail[DecodeError]] {
    let wide = (r.code & BpfClass::Mask) == BpfClass::Alu64;
    let x = r.code & BpfSrc::X != 0;
    let dst = reg(pc, r.dst);
    let opc = r.code & BpfAlu::Mask;
    if opc == BpfAlu::End {
        let kind = if !wide && !x {
            Endian::ToLe
        } else if !wide {
            Endian::ToBe
        } else if !x {
            Endian::Swap
        } else {
            bad(pc, r.code)
        };
        zero_u8(pc, r.src, FIELD_SRC);
        zero_i16(pc, r.off, FIELD_OFF);
        let width: u8 = if r.imm == 16 {
            16
        } else if r.imm == 32 {
            32
        } else if r.imm == 64 {
            64
        } else {
            bad(pc, r.code)
        };
        return Insn::Endian {
            kind: kind,
            bits: width,
            dst: dst
        };
    }
    let op = match alu_op(opc, r.off, wide) {
        Option::Some(o) => o,
        Option::None => if opc <= BpfAlu::Arsh {
            reserved(pc, 2)
        } else {
            bad(pc, r.code)
        },
    };
    let is_neg = match op {
        AluOp::Neg => true,
        _ => false,
    };
    let src = if is_neg {
        if x {
            bad(pc, r.code);
        }
        zero_u8(pc, r.src, FIELD_SRC);
        zero_i32(pc, r.imm, FIELD_IMM);
        Operand::Imm(0)
    } else if x {
        zero_i32(pc, r.imm, FIELD_IMM);
        Operand::Reg(reg(pc, r.src))
    } else {
        zero_u8(pc, r.src, FIELD_SRC);
        Operand::Imm(r.imm)
    };
    let is_movsx = match op {
        AluOp::MovSx(b) => true,
        _ => false,
    };
    if is_movsx && !x {
        bad(pc, r.code);
    }
    Insn::Alu {
        wide: wide,
        op: op,
        dst: dst,
        src: src
    }
}

fn decode_jmp(pc: usize, r: RawInsn) -> Insn eff [Fail[DecodeError]] {
    let wide = (r.code & BpfClass::Mask) == BpfClass::Jmp;
    let x = r.code & BpfSrc::X != 0;
    let opc = r.code & BpfAlu::Mask;
    if opc == BpfJmp::Ja {
        if x {
            bad(pc, r.code);
        }
        zero_u8(pc, r.dst, FIELD_DST);
        zero_u8(pc, r.src, FIELD_SRC);
        if wide {
            zero_i32(pc, r.imm, FIELD_IMM);
            return Insn::Ja {
                off: widen_i32(r.off)
            };
        }
        zero_i16(pc, r.off, FIELD_OFF);
        return Insn::Ja {
            off: r.imm
        };
    }
    if opc == BpfJmp::Call && wide {
        if x {
            bad(pc, r.code);
        }
        zero_u8(pc, r.dst, FIELD_DST);
        zero_i16(pc, r.off, FIELD_OFF);
        let t = if r.src == 0 {
            CallTarget::Helper(r.imm)
        } else if r.src == 1 {
            CallTarget::Local(r.imm)
        } else if r.src == 2 {
            CallTarget::Kfunc(r.imm)
        } else {
            bad(pc, r.code)
        };
        return Insn::Call(t);
    }
    if opc == BpfJmp::Exit && wide {
        if x {
            bad(pc, r.code);
        }
        zero_u8(pc, r.dst, FIELD_DST);
        zero_u8(pc, r.src, FIELD_SRC);
        zero_i16(pc, r.off, FIELD_OFF);
        zero_i32(pc, r.imm, FIELD_IMM);
        return Insn::Exit;
    }
    let op = match jmp_from_code(opc) {
        Option::Some(o) => o,
        Option::None => bad(pc, r.code),
    };
    let dst = reg(pc, r.dst);
    let src = if x {
        zero_i32(pc, r.imm, FIELD_IMM);
        Operand::Reg(reg(pc, r.src))
    } else {
        zero_u8(pc, r.src, FIELD_SRC);
        Operand::Imm(r.imm)
    };
    Insn::Jcond {
        wide: wide,
        op: op,
        dst: dst,
        src: src,
        off: r.off
    }
}

fn decode_ld(pc: usize, r: RawInsn, has_hi: bool, hi: RawInsn) -> Insn eff [Fail[DecodeError]] {
    let size = size_from_code(r.code);
    let mode = r.code & BpfMode::Mask;
    if mode == BpfMode::Imm && is_dw(size) {
        let dst = reg(pc, r.dst);
        zero_i16(pc, r.off, FIELD_OFF);
        if !has_hi {
            broken(pc);
        }
        if hi.code != 0 || hi.dst != 0 || hi.src != 0 || hi.off != 0 {
            broken(pc);
        }
        let imm = if r.src == 0 {
            let lo = widen_u64(wrapping_u32(r.imm));
            let up = widen_u64(wrapping_u32(hi.imm));
            Imm64::Value(lo | (up << 32))
        } else if r.src == PseudoLd::Fd {
            if hi.imm != 0 {
                broken(pc);
            }
            Imm64::MapFd(r.imm)
        } else if r.src >= PseudoLd::Value && r.src <= PseudoLd::IdxValue {
            Imm64::Pseudo {
                src: r.src,
                imm_lo: r.imm,
                imm_hi: hi.imm
            }
        } else {
            bad(pc, r.code)
        };
        return Insn::LdImm64 {
            dst: dst,
            imm: imm
        };
    }
    if (mode == BpfMode::Abs || mode == BpfMode::Ind) && !is_dw(size) {
        zero_u8(pc, r.dst, FIELD_DST);
        zero_i16(pc, r.off, FIELD_OFF);
        let indirect = mode == BpfMode::Ind;
        let src = if indirect {
            reg(pc, r.src)
        } else {
            zero_u8(pc, r.src, FIELD_SRC);
            0
        };
        return Insn::LdLegacy {
            size: size,
            indirect: indirect,
            src: src,
            imm: r.imm
        };
    }
    bad(pc, r.code)
}

fn decode_mem(pc: usize, r: RawInsn) -> Insn eff [Fail[DecodeError]] {
    let cls = r.code & BpfClass::Mask;
    let size = size_from_code(r.code);
    let mode = r.code & BpfMode::Mask;
    if cls == BpfClass::Ldx {
        let sign_extend = if mode == BpfMode::Mem {
            false
        } else if mode == BpfMode::Memsx && !is_dw(size) {
            true
        } else {
            bad(pc, r.code)
        };
        zero_i32(pc, r.imm, FIELD_IMM);
        let dst = reg(pc, r.dst);
        let src = reg(pc, r.src);
        return Insn::Ldx {
            size: size,
            dst: dst,
            src: src,
            off: r.off,
            sign_extend: sign_extend
        };
    }
    if cls == 2 {
        if mode != BpfMode::Mem {
            bad(pc, r.code);
        }
        zero_u8(pc, r.src, FIELD_SRC);
        return Insn::St {
            size: size,
            dst: reg(pc, r.dst),
            off: r.off,
            imm: r.imm
        };
    }
    // STX
    if mode == BpfMode::Mem {
        zero_i32(pc, r.imm, FIELD_IMM);
        let dst = reg(pc, r.dst);
        let src = reg(pc, r.src);
        return Insn::Stx {
            size: size,
            dst: dst,
            src: src,
            off: r.off
        };
    }
    let atomic_size = match size {
        Size::W => true,
        Size::DW => true,
        _ => false,
    };
    if mode == BpfMode::Atomic && atomic_size {
        let op = match atomic_from_imm(r.imm) {
            Option::Some(o) => o,
            Option::None => bad(pc, r.code),
        };
        let dst = reg(pc, r.dst);
        let src = reg(pc, r.src);
        return Insn::Atomic {
            size: size,
            op: op,
            dst: dst,
            src: src,
            off: r.off
        };
    }
    bad(pc, r.code)
}

// Decode the instruction at slot `pc` of a program of `len` slots; `lo` is
// slot `pc` and `hi` slot `pc + 1` (zero when absent).
pub fn decode(pc: usize, len: usize, lo: RawInsn, hi: RawInsn) -> Insn eff [Fail[DecodeError]] {
    if pc >= len {
        Fail::raise(
            DecodeError::TruncatedProgram {
                len: wrapping_mul(len, SLOT_BYTES)
            }
        );
    }
    decode_slot(pc, lo, wrapping_add(pc, 1) < len, hi)
}

fn decode_slot(pc: usize, r: RawInsn, has_hi: bool, hi: RawInsn) -> Insn eff [Fail[DecodeError]] {
    let cls = r.code & BpfClass::Mask;
    if cls == BpfClass::Alu || cls == BpfClass::Alu64 {
        decode_alu(pc, r)
    } else if cls == BpfClass::Jmp || cls == BpfClass::Jmp32 {
        decode_jmp(pc, r)
    } else if cls == BpfClass::Ld {
        decode_ld(pc, r, has_hi, hi)
    } else {
        decode_mem(pc, r)
    }
}

fn slot_at(in slots: Slice[RawInsn], i: usize) -> RawInsn {
    match slots.try_get(widen_u64(i)) {
        Option::Some(r) => r,
        Option::None => raw_zero(),
    }
}

fn is_ld_imm64(i: Insn) -> bool {
    match i {
        Insn::LdImm64 {
            dst,
            imm
        }
        => true,
        _ => false,
    }
}

// Every instruction of the program, in order (the Rust wrapper adds the
// `None` entry after each `LD_IMM64`).
pub fn decode_all(in slots: Slice[RawInsn]) -> ChunkSeq[Insn] eff [Fail[DecodeError]] {
    let mut out: ChunkSeq[Insn] = ChunkSeq::with_capacity[Insn](slots.len());
    let n = narrow_usize(slots.len());
    let mut pc: usize = 0;
    loop {
        if !(pc < n) {
            break;
        }
        let next = wrapping_add(pc, 1);
        let i = decode_slot(pc, slot_at(in slots, pc), next < n, slot_at(in slots, next));
        out.push(i);
        if is_ld_imm64(i) {
            pc = wrapping_add(pc, 2);
        } else {
            pc = next;
        }
    }
    out
}

// `decode_all` straight into the interpreter's per-slot tables: the second
// slot of a wide load gets `Exit` and a false `start`.
pub fn decode_slots(
    in slots: Slice[RawInsn],
    inout out: ChunkSeq[Insn],
    inout start: ChunkSeq[bool]
) eff [Fail[DecodeError]] {
    let n = narrow_usize(slots.len());
    let mut pc: usize = 0;
    loop {
        if !(pc < n) {
            break;
        }
        let next = wrapping_add(pc, 1);
        let i = decode_slot(pc, slot_at(in slots, pc), next < n, slot_at(in slots, next));
        out.push(i);
        start.push(true);
        if is_ld_imm64(i) {
            out.push(Insn::Exit);
            start.push(false);
            pc = wrapping_add(pc, 2);
        } else {
            pc = next;
        }
    }
}

fn one(r: RawInsn) -> Encoded {
    Encoded {
        n: 1,
        lo: r,
        hi: raw_zero()
    }
}

fn op_src(o: Operand) -> (u8, u8, i32) {
    match o {
        Operand::Imm(i) => (BpfSrc::K, 0, i),
        Operand::Reg(s) => (BpfSrc::X, s, 0),
    }
}

// Encode one instruction into one or two slots.
pub fn encode(i: Insn) -> Encoded {
    match i {
        Insn::Alu {
            wide,
            op,
            dst,
            src
        }
        => {
            let cls: u8 = if wide {
                BpfClass::Alu64
            } else {
                BpfClass::Alu
            };
            let (opc, off) = alu_code(op);
            let (x, sreg, imm) = op_src(src);
            one(raw(cls | opc | x, dst, sreg, off, imm))
        },
        Insn::Endian {
            kind,
            bits,
            dst
        }
        => {
            let code: u8 = match kind {
                Endian::ToLe => BpfClass::Alu | BpfAlu::End,
                Endian::ToBe => BpfClass::Alu | BpfAlu::End | BpfSrc::ToBe,
                Endian::Swap => BpfClass::Alu64 | BpfAlu::End,
            };
            one(raw(code, dst, 0, 0, widen_i32(bits)))
        },
        Insn::Ja {
            off
        }
        => if off >= -32768 && off <= 32767 {
            one(raw(BpfClass::Jmp | BpfJmp::Ja, 0, 0, wrapping_i16(off), 0))
        } else {
            one(raw(BpfClass::Jmp32 | BpfJmp::Ja, 0, 0, 0, off))
        },
        Insn::Jcond {
            wide,
            op,
            dst,
            src,
            off
        }
        => {
            let cls: u8 = if wide {
                BpfClass::Jmp
            } else {
                BpfClass::Jmp32
            };
            let (x, sreg, imm) = op_src(src);
            one(raw(cls | jmp_code(op) | x, dst, sreg, off, imm))
        },
        Insn::Call(t) => match t {
            CallTarget::Helper(n) => one(raw(BpfClass::Jmp | BpfJmp::Call, 0, 0, 0, n)),
            CallTarget::Local(n) => one(
                raw(BpfClass::Jmp | BpfJmp::Call, 0, PseudoCall::Call, 0, n)
            ),
            CallTarget::Kfunc(n) => one(
                raw(BpfClass::Jmp | BpfJmp::Call, 0, PseudoCall::KfuncCall, 0, n)
            ),
        },
        Insn::Exit => one(raw(BpfClass::Jmp | BpfJmp::Exit, 0, 0, 0, 0)),
        Insn::LdImm64 {
            dst,
            imm
        }
        => {
            let (src, lo, up): (u8, i32, i32) = match imm {
                Imm64::Value(v) => (0, wrapping_i32(v), wrapping_i32(v >> 32)),
                Imm64::MapFd(fd) => (PseudoLd::Fd, fd, 0),
                Imm64::Pseudo {
                    src,
                    imm_lo,
                    imm_hi
                }
                => (src, imm_lo, imm_hi),
            };
            Encoded {
                n: 2,
                lo: raw(BpfClass::Ld | BpfMode::Imm | BpfSize::Dw, dst, src, 0, lo),
                hi: raw(0, 0, 0, 0, up)
            }
        },
        Insn::Ldx {
            size,
            dst,
            src,
            off,
            sign_extend
        }
        => {
            let mode: u8 = if sign_extend {
                BpfMode::Memsx
            } else {
                BpfMode::Mem
            };
            one(raw(BpfClass::Ldx | mode | size_code(size), dst, src, off, 0))
        },
        Insn::St {
            size,
            dst,
            off,
            imm
        }
        => one(raw(BpfClass::St | BpfMode::Mem | size_code(size), dst, 0, off, imm)),
        Insn::Stx {
            size,
            dst,
            src,
            off
        }
        => one(raw(BpfClass::Stx | BpfMode::Mem | size_code(size), dst, src, off, 0)),
        Insn::Atomic {
            size,
            op,
            dst,
            src,
            off
        }
        => one(
            raw(BpfClass::Stx | BpfMode::Atomic | size_code(size), dst, src, off, atomic_imm(op))
        ),
        Insn::LdLegacy {
            size,
            indirect,
            src,
            imm
        }
        => {
            let mode: u8 = if indirect {
                BpfMode::Ind
            } else {
                BpfMode::Abs
            };
            let s: u8 = if indirect {
                src
            } else {
                0
            };
            one(raw(BpfClass::Ld | mode | size_code(size), 0, s, 0, imm))
        },
    }
}

// Little-endian wire bytes of every slot (insn::slots_to_bytes).
pub fn slots_to_bytes(in slots: Slice[RawInsn]) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    for i in 0..slots.len() {
        let r = slot_at(in slots, narrow_usize(i));
        let off = wrapping_u16(r.off);
        let imm = wrapping_u32(r.imm);
        out.push(r.code);
        out.push((r.dst & REG_NIBBLE) | ((r.src & REG_NIBBLE) << 4));
        out.push(wrapping_u8(off));
        out.push(wrapping_u8(off >> 8));
        out.push(wrapping_u8(imm));
        out.push(wrapping_u8(imm >> 8));
        out.push(wrapping_u8(imm >> 16));
        out.push(wrapping_u8(imm >> 24));
    }
    out
}

fn byte(in b: Slice[u8], i: u64) -> u8 {
    match b.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// Slots of `bytes`, whose length must be a multiple of eight
// (insn::slots_from_bytes).
pub fn slots_from_bytes(in bytes: Slice[u8]) -> ChunkSeq[RawInsn] eff [Fail[DecodeError]] {
    let n = bytes.len();
    if n & 7 != 0 {
        Fail::raise(
            DecodeError::TruncatedProgram {
                len: narrow_usize(n)
            }
        );
    }
    let mut out: ChunkSeq[RawInsn] = ChunkSeq::new[RawInsn]();
    let mut at: u64 = 0;
    loop {
        if !(at < n) {
            break;
        }
        let b1 = byte(in bytes, wrapping_add(at, 1));
        let off = widen_u16(byte(in bytes, wrapping_add(at, 2))) | (
            widen_u16(byte(in bytes, wrapping_add(at, 3))) << 8
        );
        let imm = widen_u32(byte(in bytes, wrapping_add(at, 4))) | (
            widen_u32(byte(in bytes, wrapping_add(at, 5))) << 8
        ) | (widen_u32(byte(in bytes, wrapping_add(at, 6))) << 16) | (
            widen_u32(byte(in bytes, wrapping_add(at, 7))) << 24
        );
        out.push(raw(byte(in bytes, at), b1 & 15, b1 >> 4, wrapping_i16(off), wrapping_i32(imm)));
        at = wrapping_add(at, 8);
    }
    out
}
