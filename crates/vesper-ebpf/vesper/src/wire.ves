// Module wire of @vesper/ebpf (see lib.ves): src/wire.rs, the §27.2 wire
// structs. The six-byte MAC addresses cross as the low 48 bits of a word,
// first byte most significant.
use self::common::{
    shl,
    shr
};

// The frame of `EthIpv4TcpWire`: field byte offsets and size (src/wire.rs
// `eth_ipv4_tcp`).
const DST_MAC: u64 = 0;
const SRC_MAC: u64 = 6;
const ETHER_TYPE: u64 = 12;
const VER_IHL: u64 = 14;
const TOS: u64 = 15;
const TOTAL_LEN: u64 = 16;
const IDENT: u64 = 18;
const FRAG_OFF: u64 = 20;
const TTL: u64 = 22;
const PROTO: u64 = 23;
const IP_CHECKSUM: u64 = 24;
const SRC_IPV4: u64 = 26;
const DST_IPV4: u64 = 30;
const SRC_PORT: u64 = 34;
const DST_PORT: u64 = 36;
const SEQ_NUM: u64 = 38;
const ACK_NUM: u64 = 42;
const DATA_OFFSET_FLAGS: u64 = 46;
const WINDOW_SIZE: u64 = 48;
const TCP_CHECKSUM: u64 = 50;
const URGENT_PTR: u64 = 52;
const ETH_FRAME_SIZE: u64 = 54;

// `SynDropAlertWire`: offsets (`syn_drop_alert`) and size.
const ALERT_SRC_IPV4: u64 = 0;
const ALERT_DST_PORT: u64 = 4;
const ALERT_TCP_FLAGS: u64 = 6;
const ALERT_OBSERVED_PPS: u64 = 8;
const ALERT_SIZE: u64 = 16;

pub copy enum WireError {
    Short {
        need: usize,
        got: usize
    }
}

pub copy struct EthIpv4TcpWire {
    dst_mac: u64,
    src_mac: u64,
    ether_type: u16,
    ver_ihl: u8,
    tos: u8,
    total_len: u16,
    ident: u16,
    frag_off: u16,
    ttl: u8,
    proto: u8,
    ip_checksum: u16,
    src_ipv4: u32,
    dst_ipv4: u32,
    src_port: u16,
    dst_port: u16,
    seq_num: u32,
    ack_num: u32,
    data_offset_flags: u16,
    window_size: u16,
    tcp_checksum: u16,
    urgent_ptr: u16
}

pub copy struct SynDropAlertWire {
    src_ipv4: u32,
    dst_port: u16,
    tcp_flags: u16,
    observed_pps: u64
}

fn put_be(inout out: ChunkSeq[u8], v: u64, n: u64) {
    let mut i = n;
    loop {
        if !(i > 0) {
            break;
        }
        i = wrapping_sub(i, 1);
        out.push(wrapping_u8(shr(v, wrapping_mul(i, 8))));
    }
}

fn b(in s: Slice[u8], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => widen_u64(v),
        Option::None => 0,
    }
}

fn be(in s: Slice[u8], at: u64, n: u64) -> u64 {
    let mut v: u64 = 0;
    for i in 0..n {
        v = (v << 8) | b(in s, wrapping_add(at, i));
    }
    v
}

fn short(need: u64, got: u64) -> Never eff [Fail[WireError]] {
    Fail::raise(
        WireError::Short {
            need: narrow_usize(need),
            got: narrow_usize(got)
        }
    )
}

pub fn eth_encode(w: EthIpv4TcpWire) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put_be(inout out, w.dst_mac, 6);
    put_be(inout out, w.src_mac, 6);
    put_be(inout out, widen_u64(w.ether_type), 2);
    out.push(w.ver_ihl);
    out.push(w.tos);
    put_be(inout out, widen_u64(w.total_len), 2);
    put_be(inout out, widen_u64(w.ident), 2);
    put_be(inout out, widen_u64(w.frag_off), 2);
    out.push(w.ttl);
    out.push(w.proto);
    put_be(inout out, widen_u64(w.ip_checksum), 2);
    put_be(inout out, widen_u64(w.src_ipv4), 4);
    put_be(inout out, widen_u64(w.dst_ipv4), 4);
    put_be(inout out, widen_u64(w.src_port), 2);
    put_be(inout out, widen_u64(w.dst_port), 2);
    put_be(inout out, widen_u64(w.seq_num), 4);
    put_be(inout out, widen_u64(w.ack_num), 4);
    put_be(inout out, widen_u64(w.data_offset_flags), 2);
    put_be(inout out, widen_u64(w.window_size), 2);
    put_be(inout out, widen_u64(w.tcp_checksum), 2);
    put_be(inout out, widen_u64(w.urgent_ptr), 2);
    out
}

pub fn eth_decode(in s: Slice[u8]) -> EthIpv4TcpWire eff [Fail[WireError]] {
    if s.len() < ETH_FRAME_SIZE {
        short(ETH_FRAME_SIZE, s.len());
    }
    EthIpv4TcpWire {
        dst_mac: be(in s, DST_MAC, 6),
        src_mac: be(in s, SRC_MAC, 6),
        ether_type: wrapping_u16(be(in s, ETHER_TYPE, 2)),
        ver_ihl: wrapping_u8(b(in s, VER_IHL)),
        tos: wrapping_u8(b(in s, TOS)),
        total_len: wrapping_u16(be(in s, TOTAL_LEN, 2)),
        ident: wrapping_u16(be(in s, IDENT, 2)),
        frag_off: wrapping_u16(be(in s, FRAG_OFF, 2)),
        ttl: wrapping_u8(b(in s, TTL)),
        proto: wrapping_u8(b(in s, PROTO)),
        ip_checksum: wrapping_u16(be(in s, IP_CHECKSUM, 2)),
        src_ipv4: wrapping_u32(be(in s, SRC_IPV4, 4)),
        dst_ipv4: wrapping_u32(be(in s, DST_IPV4, 4)),
        src_port: wrapping_u16(be(in s, SRC_PORT, 2)),
        dst_port: wrapping_u16(be(in s, DST_PORT, 2)),
        seq_num: wrapping_u32(be(in s, SEQ_NUM, 4)),
        ack_num: wrapping_u32(be(in s, ACK_NUM, 4)),
        data_offset_flags: wrapping_u16(be(in s, DATA_OFFSET_FLAGS, 2)),
        window_size: wrapping_u16(be(in s, WINDOW_SIZE, 2)),
        tcp_checksum: wrapping_u16(be(in s, TCP_CHECKSUM, 2)),
        urgent_ptr: wrapping_u16(be(in s, URGENT_PTR, 2))
    }
}

pub fn alert_encode(w: SynDropAlertWire) -> ChunkSeq[u8] {
    let mut out: ChunkSeq[u8] = ChunkSeq::new[u8]();
    put_be(inout out, widen_u64(w.src_ipv4), 4);
    put_be(inout out, widen_u64(w.dst_port), 2);
    put_be(inout out, widen_u64(w.tcp_flags), 2);
    let eight: u64 = 8;
    for i in 0..eight {
        out.push(wrapping_u8(shr(w.observed_pps, wrapping_mul(i, 8))));
    }
    out
}

pub fn alert_decode(in s: Slice[u8]) -> SynDropAlertWire eff [Fail[WireError]] {
    if s.len() < ALERT_SIZE {
        short(ALERT_SIZE, s.len());
    }
    let mut pps: u64 = 0;
    let eight: u64 = 8;
    for i in 0..eight {
        pps = pps | shl(b(in s, wrapping_add(ALERT_OBSERVED_PPS, i)), wrapping_mul(i, 8));
    }
    SynDropAlertWire {
        src_ipv4: wrapping_u32(be(in s, ALERT_SRC_IPV4, 4)),
        dst_port: wrapping_u16(be(in s, ALERT_DST_PORT, 2)),
        tcp_flags: wrapping_u16(be(in s, ALERT_TCP_FLAGS, 2)),
        observed_pps: pps
    }
}
