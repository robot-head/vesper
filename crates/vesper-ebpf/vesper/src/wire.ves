// Module wire of @vesper/ebpf (see lib.ves): src/wire.rs, the §27.2 wire
// structs. The six-byte MAC addresses cross as the low 48 bits of a word,
// first byte most significant.
use self::common::{shl, shr};

// The frame of `EthIpv4TcpWire` (src/wire.rs `eth_ipv4_tcp`) as seven
// big-endian words, by byte offset: W0 dst_mac + src_mac[0..2], W8
// src_mac[2..6] + ether_type + ver_ihl + tos, W16 total_len + ident +
// frag_off + ttl + proto, W24 ip_checksum + src_ipv4 + dst_ipv4[0..2], W32
// dst_ipv4[2..4] + src_port + dst_port + seq_num[0..2], W40 seq_num[2..4] +
// ack_num + data_offset_flags, W46 data_offset_flags + window_size +
// tcp_checksum + urgent_ptr.
const W0: u64 = 0;
const W8: u64 = 8;
const W16: u64 = 16;
const W24: u64 = 24;
const W32: u64 = 32;
const W40: u64 = 40;
const W46: u64 = 46;
const ETH_FRAME_SIZE: u64 = 54;

// `SynDropAlertWire` (`syn_drop_alert`): src_ipv4 + dst_port + tcp_flags
// big-endian at 0, observed_pps little-endian at 8.
const ALERT_HEAD: u64 = 0;
const ALERT_OBSERVED_PPS: u64 = 8;
const ALERT_SIZE: u64 = 16;

// Bit position of each field's lowest byte inside its word (`*_AT`), and
// how a field split across two words divides: the low `*_LOW_BITS` bits
// open the next word, the rest close the previous one.
const DST_MAC_AT: u64 = 16;
const SRC_MAC_LOW_BITS: u64 = 32;
const SRC_MAC_HIGH_MASK: u64 = 0xffff;
const ETHER_TYPE_AT: u64 = 16;
const VER_IHL_AT: u64 = 8;
const TOTAL_LEN_AT: u64 = 48;
const IDENT_AT: u64 = 32;
const FRAG_OFF_AT: u64 = 16;
const TTL_AT: u64 = 8;
const IP_CHECKSUM_AT: u64 = 48;
const SRC_IPV4_AT: u64 = 16;
const DST_IPV4_LOW_BITS: u64 = 16;
const SRC_PORT_AT: u64 = 32;
const DST_PORT_AT: u64 = 16;
const SEQ_NUM_LOW_BITS: u64 = 16;
const ACK_NUM_AT: u64 = 16;
const WINDOW_SIZE_AT: u64 = 32;
const TCP_CHECKSUM_AT: u64 = 16;
const DATA_OFFSET_FLAGS_AGAIN_AT: u64 = 48;
const ALERT_SRC_IPV4_AT: u64 = 32;
const ALERT_DST_PORT_AT: u64 = 16;

const WORD_BITS: u64 = 64;

// A field that opens its word with `low_bits` of its bits sits at
// `WORD_BITS - low_bits`.
fn opens_at(low_bits: u64) -> u64 {
    wrapping_sub(WORD_BITS, low_bits)
}

pub copy enum WireError {
    Short {
        need: usize,
        got: usize
    }
}

pub copy struct EthIpv4TcpWire {
    dst_mac: u64,
    src_mac: u64,
    ether_type: u16,
    ver_ihl: u8,
    tos: u8,
    total_len: u16,
    ident: u16,
    frag_off: u16,
    ttl: u8,
    proto: u8,
    ip_checksum: u16,
    src_ipv4: u32,
    dst_ipv4: u32,
    src_port: u16,
    dst_port: u16,
    seq_num: u32,
    ack_num: u32,
    data_offset_flags: u16,
    window_size: u16,
    tcp_checksum: u16,
    urgent_ptr: u16
}

pub copy struct SynDropAlertWire {
    src_ipv4: u32,
    dst_port: u16,
    tcp_flags: u16,
    observed_pps: u64
}

// The codecs move whole big-endian words: the 54-byte frame is the words at
// 0, 8, .., 40 plus the word at 46 (overlapping the one at 40 by two bytes),
// the 16-byte alert one big-endian word and the little-endian rate. A
// caller has checked the length, so the reads never miss; the encoders
// write into a buffer the caller lends (no sequence is built on the Vesper
// side and nothing is copied back across the port), and a shorter buffer
// is left as it is.

fn rd(in s: Slice[u8], at: u64) -> u64 {
    s.try_read_u64_be(at).unwrap_or(0)
}

fn wr(inout out: Slice[u8], at: u64, v: u64) {
    let _ = out.try_write_u64_be(at, v);
}

fn short(need: u64, got: u64) -> Never eff [Fail[WireError]] {
    Fail::raise(WireError::Short { need: narrow_usize(need), got: narrow_usize(got) })
}

pub fn eth_encode_into(w: EthIpv4TcpWire, inout out: Slice[u8]) {
    // One length check covers every word store below (#2226).
    if out.len() < ETH_FRAME_SIZE {
        return;
    }
    let dst_ipv4 = widen_u64(w.dst_ipv4);
    let seq_num = widen_u64(w.seq_num);
    let data_offset_flags = widen_u64(w.data_offset_flags);
    wr(inout out, W0, shl(w.dst_mac, DST_MAC_AT) | shr(w.src_mac, SRC_MAC_LOW_BITS));
    wr(
        inout out,
        W8,
        shl(w.src_mac, opens_at(SRC_MAC_LOW_BITS))
            | shl(widen_u64(w.ether_type), ETHER_TYPE_AT)
            | shl(widen_u64(w.ver_ihl), VER_IHL_AT)
            | widen_u64(w.tos)
    );
    wr(
        inout out,
        W16,
        shl(widen_u64(w.total_len), TOTAL_LEN_AT)
            | shl(widen_u64(w.ident), IDENT_AT)
            | shl(widen_u64(w.frag_off), FRAG_OFF_AT)
            | shl(widen_u64(w.ttl), TTL_AT)
            | widen_u64(w.proto)
    );
    wr(
        inout out,
        W24,
        shl(widen_u64(w.ip_checksum), IP_CHECKSUM_AT)
            | shl(widen_u64(w.src_ipv4), SRC_IPV4_AT)
            | shr(dst_ipv4, DST_IPV4_LOW_BITS)
    );
    wr(
        inout out,
        W32,
        shl(dst_ipv4, opens_at(DST_IPV4_LOW_BITS))
            | shl(widen_u64(w.src_port), SRC_PORT_AT)
            | shl(widen_u64(w.dst_port), DST_PORT_AT)
            | shr(seq_num, SEQ_NUM_LOW_BITS)
    );
    wr(
        inout out,
        W40,
        shl(seq_num, opens_at(SEQ_NUM_LOW_BITS))
            | shl(widen_u64(w.ack_num), ACK_NUM_AT)
            | data_offset_flags
    );
    // W46 overlaps the end of W40, so it opens with data_offset_flags again.
    wr(
        inout out,
        W46,
        shl(data_offset_flags, DATA_OFFSET_FLAGS_AGAIN_AT)
            | shl(widen_u64(w.window_size), WINDOW_SIZE_AT)
            | shl(widen_u64(w.tcp_checksum), TCP_CHECKSUM_AT)
            | widen_u64(w.urgent_ptr)
    );
}

pub fn eth_decode(in s: Slice[u8]) -> EthIpv4TcpWire eff [Fail[WireError]] {
    let got = s.len();
    if got < ETH_FRAME_SIZE {
        short(ETH_FRAME_SIZE, got);
    }
    let w0 = rd(in s, W0);
    let w1 = rd(in s, W8);
    let w2 = rd(in s, W16);
    let w3 = rd(in s, W24);
    let w4 = rd(in s, W32);
    let w5 = rd(in s, W40);
    let w6 = rd(in s, W46);
    EthIpv4TcpWire {
        dst_mac: shr(w0, DST_MAC_AT),
        src_mac: shl(w0 & SRC_MAC_HIGH_MASK, SRC_MAC_LOW_BITS)
            | shr(w1, opens_at(SRC_MAC_LOW_BITS)),
        ether_type: wrapping_u16(shr(w1, ETHER_TYPE_AT)),
        ver_ihl: wrapping_u8(shr(w1, VER_IHL_AT)),
        tos: wrapping_u8(w1),
        total_len: wrapping_u16(shr(w2, TOTAL_LEN_AT)),
        ident: wrapping_u16(shr(w2, IDENT_AT)),
        frag_off: wrapping_u16(shr(w2, FRAG_OFF_AT)),
        ttl: wrapping_u8(shr(w2, TTL_AT)),
        proto: wrapping_u8(w2),
        ip_checksum: wrapping_u16(shr(w3, IP_CHECKSUM_AT)),
        src_ipv4: wrapping_u32(shr(w3, SRC_IPV4_AT)),
        dst_ipv4: wrapping_u32(shl(w3, DST_IPV4_LOW_BITS) | shr(w4, opens_at(DST_IPV4_LOW_BITS))),
        src_port: wrapping_u16(shr(w4, SRC_PORT_AT)),
        dst_port: wrapping_u16(shr(w4, DST_PORT_AT)),
        seq_num: wrapping_u32(shl(w4, SEQ_NUM_LOW_BITS) | shr(w5, opens_at(SEQ_NUM_LOW_BITS))),
        ack_num: wrapping_u32(shr(w5, ACK_NUM_AT)),
        data_offset_flags: wrapping_u16(w5),
        window_size: wrapping_u16(shr(w6, WINDOW_SIZE_AT)),
        tcp_checksum: wrapping_u16(shr(w6, TCP_CHECKSUM_AT)),
        urgent_ptr: wrapping_u16(w6)
    }
}

pub fn alert_encode_into(w: SynDropAlertWire, inout out: Slice[u8]) {
    if out.len() < ALERT_SIZE {
        return;
    }
    wr(
        inout out,
        ALERT_HEAD,
        shl(widen_u64(w.src_ipv4), ALERT_SRC_IPV4_AT)
            | shl(widen_u64(w.dst_port), ALERT_DST_PORT_AT)
            | widen_u64(w.tcp_flags)
    );
    let _ = out.try_write_u64_le(ALERT_OBSERVED_PPS, w.observed_pps);
}

pub fn alert_decode(in s: Slice[u8]) -> SynDropAlertWire eff [Fail[WireError]] {
    let got = s.len();
    if got < ALERT_SIZE {
        short(ALERT_SIZE, got);
    }
    let w0 = rd(in s, ALERT_HEAD);
    SynDropAlertWire {
        src_ipv4: wrapping_u32(shr(w0, ALERT_SRC_IPV4_AT)),
        dst_port: wrapping_u16(shr(w0, ALERT_DST_PORT_AT)),
        tcp_flags: wrapping_u16(w0),
        observed_pps: s.try_read_u64_le(ALERT_OBSERVED_PPS).unwrap_or(0)
    }
}
