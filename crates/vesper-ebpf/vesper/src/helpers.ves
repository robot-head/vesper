// Module helpers of @vesper/ebpf (see lib.ves): src/helpers.rs, which helper
// ids each program type may call and the GPL-compatible licenses. The id
// constants are mirrored below; the `SUPPORTED` name table and `KFUNCS`
// stay Rust data.
use self::program::{
    ProgramType
};

// Helper ids, `enum bpf_func_id` (src/helpers.rs).
const MAP_LOOKUP_ELEM: i32 = 1;
const MAP_UPDATE_ELEM: i32 = 2;
const MAP_DELETE_ELEM: i32 = 3;
const KTIME_GET_NS: i32 = 5;
const GET_PRANDOM_U32: i32 = 7;
const GET_SMP_PROCESSOR_ID: i32 = 8;
const TAIL_CALL: i32 = 12;
const GET_CURRENT_PID_TGID: i32 = 14;
const GET_CURRENT_UID_GID: i32 = 15;
const GET_CURRENT_COMM: i32 = 16;
const XDP_ADJUST_HEAD: i32 = 44;
const SK_LOOKUP_TCP: i32 = 84;
const SK_RELEASE: i32 = 86;
const RINGBUF_OUTPUT: i32 = 130;
const RINGBUF_RESERVE: i32 = 131;
const RINGBUF_SUBMIT: i32 = 132;
const RINGBUF_DISCARD: i32 = 133;
const LOOP: i32 = 181;

// Whether `prog_type` may call helper `id` (helpers::allowed).
pub fn allowed(prog_type: ProgramType, id: i32) -> bool {
    let common = id
        == MAP_LOOKUP_ELEM
        || id
        == MAP_UPDATE_ELEM
        || id
        == MAP_DELETE_ELEM
        || id
        == KTIME_GET_NS
        || id
        == GET_PRANDOM_U32
        || id
        == GET_SMP_PROCESSOR_ID
        || id
        == TAIL_CALL
        || id
        == RINGBUF_OUTPUT
        || id
        == RINGBUF_RESERVE
        || id
        == RINGBUF_SUBMIT
        || id
        == RINGBUF_DISCARD
        || id
        == LOOP;
    if common {
        return true;
    }
    match prog_type {
        ProgramType::Xdp => id == XDP_ADJUST_HEAD || id == SK_LOOKUP_TCP || id == SK_RELEASE,
        ProgramType::SchedCls => id == SK_LOOKUP_TCP || id == SK_RELEASE,
        ProgramType::Tracepoint => id
            == GET_CURRENT_PID_TGID
            || id
            == GET_CURRENT_UID_GID
            || id
            == GET_CURRENT_COMM,
        ProgramType::Kprobe => id
            == GET_CURRENT_PID_TGID
            || id
            == GET_CURRENT_UID_GID
            || id
            == GET_CURRENT_COMM,
    }
}

// `license_is_gpl_compatible` (helpers::gpl_compatible).
pub fn gpl_compatible(in license: Str) -> bool {
    license
        == "GPL"
        || license
        == "GPL v2"
        || license
        == "GPL and additional rights"
        || license
        == "Dual BSD/GPL"
        || license
        == "Dual MIT/GPL"
        || license
        == "Dual MPL/GPL"
}
