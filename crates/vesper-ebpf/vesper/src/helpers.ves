// Module helpers of @vesper/ebpf (see lib.ves): src/helpers.rs, which helper
// ids each program type may call and the GPL-compatible licenses. The id
// constants are mirrored below; the `SUPPORTED` name table and `KFUNCS`
// stay Rust data.
use self::program::{
    ProgramType
};

// Kernel helper ids (`enum bpf_func_id`, src/helpers.rs), untyped so the
// interpreter's `u64` ids and this module's `i32` ids share them.
pub enum Helper: _ {
    MapLookupElem = 1,
    MapUpdateElem = 2,
    MapDeleteElem = 3,
    KtimeGetNs = 5,
    GetPrandomU32 = 7,
    GetSmpProcessorId = 8,
    TailCall = 12,
    GetCurrentPidTgid = 14,
    GetCurrentUidGid = 15,
    GetCurrentComm = 16,
    XdpAdjustHead = 44,
    SkLookupTcp = 84,
    SkRelease = 86,
    RingbufOutput = 130,
    RingbufReserve = 131,
    RingbufSubmit = 132,
    RingbufDiscard = 133,
    Loop = 181,
}

// Whether `prog_type` may call helper `id` (helpers::allowed).
pub fn allowed(prog_type: ProgramType, id: i32) -> bool {
    let common = id == Helper::MapLookupElem
        || id == Helper::MapUpdateElem
        || id == Helper::MapDeleteElem
        || id == Helper::KtimeGetNs
        || id == Helper::GetPrandomU32
        || id == Helper::GetSmpProcessorId
        || id == Helper::TailCall
        || id == Helper::RingbufOutput
        || id == Helper::RingbufReserve
        || id == Helper::RingbufSubmit
        || id == Helper::RingbufDiscard
        || id == Helper::Loop;
    if common {
        return true;
    }
    match prog_type {
        ProgramType::Xdp => id == Helper::XdpAdjustHead
            || id == Helper::SkLookupTcp
            || id == Helper::SkRelease,
        ProgramType::SchedCls => id == Helper::SkLookupTcp || id == Helper::SkRelease,
        ProgramType::Tracepoint => id == Helper::GetCurrentPidTgid
            || id == Helper::GetCurrentUidGid
            || id == Helper::GetCurrentComm,
        ProgramType::Kprobe => id == Helper::GetCurrentPidTgid
            || id == Helper::GetCurrentUidGid
            || id == Helper::GetCurrentComm,
    }
}

// `license_is_gpl_compatible` (helpers::gpl_compatible).
pub fn gpl_compatible(in license: Str) -> bool {
    license == "GPL"
        || license == "GPL v2"
        || license == "GPL and additional rights"
        || license == "Dual BSD/GPL"
        || license == "Dual MIT/GPL"
        || license == "Dual MPL/GPL"
}
