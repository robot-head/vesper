{
  "notes": [
    "The flip gate for vesper-vault (aspect ci flip-gate --, SH6 lane 17, #1412).",
    "The port is @vesper/vault over @vesper/crypto (`vesper-crypto-sys`); the",
    "frozen Rust baseline is the seed package `vesper-vault-seed` (`src/reference/`),",
    "which the compiler links until self-hosting Stage 2."
  ],
  "name": "vesper-vault",
  "lane": "SH6-17",
  "rust": [
    "crates/vesper-vault/src/reference/aead.rs",
    "crates/vesper-vault/src/reference/kem.rs",
    "crates/vesper-vault/src/reference/secret.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0"
  },
  "build": [
    ["cargo", "build", "--locked", "--release", "-p", "vesper-vault", "--example", "abba"]
  ],
  "tests": [
    {
      "run": ["cargo", "test", "--locked", "--release", "-p", "vesper-vault", "-p", "vesper-vault-seed"]
    }
  ],
  "differential": {
    "run": ["cargo", "test", "--locked", "--release", "-p", "vesper-vault", "--lib", "differential", "--", "--nocapture"]
  },
  "abba": [
    {
      "workload": "aead-aes",
      "run": {
        "cargo_target": "release/examples/abba",
        "args": ["flip-gate", "aead-aes", "16"]
      }
    },
    {
      "workload": "aead-chacha",
      "run": {
        "cargo_target": "release/examples/abba",
        "args": ["flip-gate", "aead-chacha", "16"]
      }
    },
    {
      "workload": "kem-hybrid",
      "run": {
        "cargo_target": "release/examples/abba",
        "args": ["flip-gate", "kem-hybrid", "256"]
      }
    }
  ]
}
