// Module num of @vesper/tensor (see lib.ves): IEEE binary16 and BF16
// codecs and the float predicates every module shares. An f32 crosses the
// boundary, and is stored in slices, as its bit pattern (`to_bits_f32`).

// IEEE 754 binary32 and binary16 bit fields (IEEE 754-2019 §3.4); src/host.rs
// `ieee` names the same values.
// Binary32 sign bit.
const F32_SIGN: u32 = 2147483648;
// Binary32 biased-exponent field, in place (all ones = Inf/NaN).
const F32_EXP_MASK: u32 = 2139095040;
// Binary32 trailing significand field (23 bits).
const F32_MANT_MASK: u32 = 8388607;
// The implicit leading significand bit of a normal binary32.
const F32_IMPLICIT_BIT: u32 = 8388608;
// Width of the binary32 trailing significand.
const F32_MANT_BITS: u32 = 23;
// Binary32 exponent field after shifting down.
const F32_EXP_FIELD: u32 = 255;
const F32_EXP_FIELD_I: i32 = 255;
// Binary16 sign bit.
const F16_SIGN: u16 = 32768;
// Width of the binary16 trailing significand.
const F16_MANT_BITS: u16 = 10;
// Binary16 trailing significand field.
const F16_MANT_MASK: u16 = 1023;
// Binary16 exponent field after shifting down (all ones = Inf/NaN).
const F16_EXP_FIELD: u16 = 31;
const F16_EXP_FIELD_I: i32 = 31;
// Binary16 positive infinity.
const F16_INFINITY: u16 = 31744;
// Binary16 canonical quiet NaN (infinity plus the quiet bit).
const F16_QUIET_NAN: u16 = 32256;
// Binary32 bias minus binary16 bias (127 - 15).
const F32_TO_F16_REBIAS: i32 = 112;
const F32_TO_F16_REBIAS_U: u32 = 112;
// Significand bits dropped going from binary32 to binary16 (23 - 10).
const F32_TO_F16_SHIFT: u32 = 13;
// Leading zeros of a 32-bit word whose top set bit is the binary16 implicit
// bit position (32 - 10 - 1).
const F16_SUBNORMAL_CLZ: u32 = 21;
// Biased binary32 exponent of a binary16 subnormal with its top fraction bit
// moved up to the implicit bit (`F32_TO_F16_REBIAS + 1`).
const F16_SUBNORMAL_EXP: u32 = 113;
// The smallest rebiased exponent that does not round to zero (-10).
const F16_MIN_SUBNORMAL_E: i32 = -10;
// Shift of a subnormal result with rebiased exponent 0 (`F32_TO_F16_SHIFT + 1`).
const F16_SUBNORMAL_SHIFT: i32 = 14;
// BF16 keeps the high half of a binary32.
const BF16_SHIFT: u32 = 16;
// The low half BF16 drops, and half of its range.
const BF16_DROPPED_MASK: u32 = 65535;
const BF16_HALF: u32 = 32768;
// BF16 quiet bit (the top trailing significand bit).
const BF16_QUIET_BIT: u16 = 64;

// The number of leading zero bits of `x`.
pub fn clz32(x: u32) -> u32 eff [Fail[ArithOverflow]] {
    if x == 0 {
        return 32;
    }
    let mut n: u32 = 0;
    let mut v = x;
    loop {
        if v & F32_SIGN != 0 {
            break;
        }
        v = v << 1;
        n = n + 1;
    }
    n
}

// Whether the f32 with bits `b` is finite.
pub fn finite_bits(b: u32) -> bool {
    b & F32_EXP_MASK != F32_EXP_MASK
}

pub fn is_finite(v: f32) -> bool {
    finite_bits(to_bits_f32(v))
}

pub fn is_nan(v: f32) -> bool {
    let b = to_bits_f32(v);
    b & F32_EXP_MASK == F32_EXP_MASK && b & F32_MANT_MASK != 0
}

pub fn decode_fp16(bits: u16) -> f32 eff [Fail[ArithOverflow]] {
    let sign = widen_u32(bits & F16_SIGN) << BF16_SHIFT;
    let exponent = widen_u32((bits >> F16_MANT_BITS) & F16_EXP_FIELD);
    let fraction = widen_u32(bits & F16_MANT_MASK);
    let out = if exponent == 0 {
        if fraction == 0 {
            sign
        } else {
            let shift = clz32(fraction) - F16_SUBNORMAL_CLZ;
            let normalized = fraction << shift;
            sign | ((F16_SUBNORMAL_EXP - shift) << F32_MANT_BITS) | (
                (normalized & widen_u32(F16_MANT_MASK)) << F32_TO_F16_SHIFT
            )
        }
    } else if exponent == widen_u32(F16_EXP_FIELD) {
        sign | F32_EXP_MASK | (fraction << F32_TO_F16_SHIFT)
    } else {
        sign | ((exponent + F32_TO_F16_REBIAS_U) << F32_MANT_BITS) | (fraction << F32_TO_F16_SHIFT)
    };
    from_bits_f32(out)
}

// Round `value >> shift` to nearest, ties to even (`1 <= shift < 32`).
fn round_shift(value: u32, shift: u32) -> u32 eff [Fail[ArithOverflow]] {
    let kept = value >> shift;
    let one: u32 = 1;
    let rest = value & ((one << shift) - 1);
    let half = one << (shift - 1);
    if rest > half || (rest == half && kept & 1 == 1) {
        kept + 1
    } else {
        kept
    }
}

pub fn encode_fp16(value: f32) -> u16 eff [Fail[ArithOverflow]] {
    let bits = to_bits_f32(value);
    let sign = wrapping_u16((bits >> BF16_SHIFT) & widen_u32(F16_SIGN));
    let exponent = wrapping_i32((bits >> F32_MANT_BITS) & F32_EXP_FIELD);
    let mantissa = bits & F32_MANT_MASK;
    if exponent == F32_EXP_FIELD_I {
        if mantissa == 0 {
            return sign | F16_INFINITY;
        }
        return sign | F16_QUIET_NAN | wrapping_u16(mantissa >> F32_TO_F16_SHIFT);
    }
    let e = exponent - F32_TO_F16_REBIAS;
    if e >= F16_EXP_FIELD_I {
        return sign | F16_INFINITY;
    }
    if e <= 0 {
        // Below half the smallest subnormal: rounds to zero.
        if e < F16_MIN_SUBNORMAL_E {
            return sign;
        }
        let m = mantissa | F32_IMPLICIT_BIT;
        let shift = wrapping_u32(F16_SUBNORMAL_SHIFT - e);
        return sign | wrapping_u16(round_shift(m, shift));
    }
    sign | wrapping_u16(
        round_shift((wrapping_u32(e) << F32_MANT_BITS) | mantissa, F32_TO_F16_SHIFT)
    )
}

pub fn encode_bf16(value: f32) -> u16 eff [Fail[ArithOverflow]] {
    let bits = to_bits_f32(value);
    if is_nan(value) {
        return wrapping_u16(bits >> BF16_SHIFT) | BF16_QUIET_BIT;
    }
    let kept = bits >> BF16_SHIFT;
    let rest = bits & BF16_DROPPED_MASK;
    let rounded = if rest > BF16_HALF || (rest == BF16_HALF && kept & 1 == 1) {
        kept + 1
    } else {
        kept
    };
    wrapping_u16(rounded)
}

pub fn decode_bf16(bits: u16) -> f32 eff [Fail[ArithOverflow]] {
    from_bits_f32(widen_u32(bits) << BF16_SHIFT)
}

// A little-endian binary16 at `at` of `b`.
pub fn half_at(in b: Slice[u8], at: u64) -> f32 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    decode_fp16(widen_u16(b[at]) | (widen_u16(b[at + 1]) << 8))
}

// `0: u64`, so that `for i in u64_zero()..4` counts in u64 (a literal range
// is i64).
pub fn u64_zero() -> u64 {
    0
}
