// Module llama of @vesper/tensor (see lib.ves): the checks of src/llama.rs
// that are pure over bytes and numbers: `Config::validate`, the llama2.c
// checkpoint and `tokenizer.bin` readers, and the bytes `Tokenizer::decode`
// prints. The Rust wrapper builds the model's vectors and the tokenizer's
// pieces from the checked input.
//
// Every function returns a code: 0 on success, else
// - 1 + f: Malformed(field f), 10 + f: Limit(field f), with fields 0 dim,
//   1 hidden_dim, 2 layers, 3 heads, 4 kv_heads, 5 vocab, 6 seq_len;
// - 20 Shape("dim must be a multiple of heads"), 21 Shape("invalid GQA
//   ratio"), 22 Shape("RoPE needs an even head width"), 23 Shape("rope
//   base"), 24 InvalidEpsilon;
// - 30 Malformed("truncated input"), 31 NonFinite, 33 Malformed("trailing
//   bytes after checkpoint"), 34 Limit("checkpoint bytes"), 35
//   Malformed("vocab");
// - 37 Malformed("max_token_length"), 38 Limit("max_token_length"), 39
//   Malformed("token length"), 40 Limit("token length"), 41
//   Malformed("trailing bytes after tokenizer").
use self::num::{
    finite_bits,
    u64_zero
};

// Ceilings (src/llama.rs `MAX_DIM`, `MAX_LAYERS`, `MAX_VOCAB`, `MAX_SEQ_LEN`,
// `MAX_CHECKPOINT_BYTES`, `MAX_TOKEN_LENGTH`).
const MAX_DIM: u64 = 8192;
const MAX_LAYERS: u64 = 256;
const MAX_VOCAB: u64 = 1048576;
const MAX_SEQ_LEN: u64 = 65536;
const MAX_CHECKPOINT_BYTES: u64 = 1073741824;
const MAX_TOKEN_LENGTH: u32 = 1024;
// The llama2.c header: seven little-endian `i32` fields.
const HEADER_BYTES: u64 = 28;
// `i32` fields read as `u32`: values at or above the sign bit are negative.
const I32_SIGN: u32 = 2147483648;
const U32_RANGE: u64 = 4294967296;
// `hex_digit`'s result for a byte that is not a hex digit.
const NOT_HEX: u64 = 16;
// ASCII bytes.
const SPACE: u8 = 32;
const DIGIT_0: u8 = 48;
const DIGIT_9: u8 = 57;
const LESS: u8 = 60;
const GREATER: u8 = 62;
const UPPER_A: u8 = 65;
const UPPER_F: u8 = 70;
const LOWER_A: u8 = 97;
const LOWER_F: u8 = 102;
const LOWER_X: u8 = 120;
// `is_ascii_graphic` is '!' (33) through '~' (126); `is_ascii_whitespace` is
// tab, line feed, form feed, carriage return and space.
const GRAPHIC_FIRST: u64 = 33;
const GRAPHIC_LAST: u64 = 126;
const TAB: u64 = 9;
const LF: u64 = 10;
const FF: u64 = 12;
const CR: u64 = 13;
const SPACE_U64: u64 = 32;

fn max_dim() -> u64 {
    MAX_DIM
}

// The ceiling of field `f` (`MAX_DIM`, `MAX_LAYERS`, `MAX_VOCAB`,
// `MAX_SEQ_LEN`).
fn ceiling(f: u64) -> u64 eff [Fail[ArithOverflow]] {
    if f == 1 {
        return 4 * max_dim();
    }
    if f == 2 {
        return MAX_LAYERS;
    }
    if f == 5 {
        return MAX_VOCAB;
    }
    if f == 6 {
        return MAX_SEQ_LEN;
    }
    max_dim()
}

// `Config::validate`: `dims` holds the seven fields in order.
pub fn validate(in dims: Slice[u64], rope_base: u32, rms_epsilon: u32)
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    for f in u64_zero()..7 {
        if dims[f] == 0 {
            return 1 + f;
        }
        if dims[f] > ceiling(f) {
            return 10 + f;
        }
    }
    let dim = dims[0];
    let heads = dims[3];
    let kv_heads = dims[4];
    if dim % heads != 0 {
        return 20;
    }
    if heads % kv_heads != 0 {
        return 21;
    }
    if (dim / heads) % 2 != 0 {
        return 22;
    }
    let base = from_bits_f32(rope_base);
    if !(finite_bits(rope_base) && base > 1.0) {
        return 23;
    }
    let epsilon = from_bits_f32(rms_epsilon);
    if !(finite_bits(rms_epsilon) && epsilon > 0.0) {
        return 24;
    }
    0
}

// A positive `i32` field read as `u32`: the code of `positive(v, f)`, or 0.
fn positive(v: u32, f: u64) -> u64 eff [Fail[ArithOverflow]] {
    if v == 0 || v >= I32_SIGN {
        return 1 + f;
    }
    if widen_u64(v) > ceiling(f) {
        return 10 + f;
    }
    0
}

// A run of `n` floats at `at`: 30 when it does not fit, 31 when one is not
// finite.
// Two binary32 exponent fields, the low bit of each 32-bit half and the
// high bit of each half, for the two-at-a-time finiteness test.
const EXPONENTS_2: u64 = 0x7f8000007f800000;
const LOW_BITS_2: u64 = 0x0000000100000001;
const HIGH_BITS_2: u64 = 0x8000000080000000;

// Whether one of the two little-endian binary32 values in `x` is infinite
// or NaN: `z` has a zero half exactly where the exponent is all ones, and
// the borrow of `z - LOW_BITS_2` starts only at a zero half.
fn pair_not_finite(x: u64) -> bool {
    let z = (x & EXPONENTS_2) ^ EXPONENTS_2;
    wrapping_sub(z, LOW_BITS_2) & (z ^ 0xffffffffffffffff) & HIGH_BITS_2 != 0
}

fn floats(in b: Slice[u8], at: u64, n: u64) -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    if 4 * n > b.len() - at {
        return 30;
    }
    // The run fits, so its offsets cannot wrap: test two floats per read.
    let pairs = n / 2;
    for j in u64_zero()..pairs {
        if pair_not_finite(b.read_u64_le(wrapping_add(at, wrapping_mul(8, j)))) {
            return 31;
        }
    }
    if n % 2 == 1 && !finite_bits(b.read_u32_le(wrapping_add(at, wrapping_mul(8, pairs)))) {
        return 31;
    }
    0
}

// `Model::from_llama2c`'s checks, in the Rust build's order: the header,
// `Config::validate`, every weight run (present, then finite), the legacy
// RoPE tables and the exact length. Writes the seven fields and whether
// the classifier is shared to `out`.
pub fn check_checkpoint(in b: Slice[u8], rope_base: u32, rms_epsilon: u32, inout out: Slice[u64])
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    if b.len() > MAX_CHECKPOINT_BYTES {
        return 34;
    }
    let mut shared = false;
    for f in u64_zero()..7 {
        if 4 * f + 4 > b.len() {
            return 30;
        }
        let mut v = b.read_u32_le(4 * f);
        if f == 5 {
            if v == I32_SIGN {
                return 35;
            }
            if v > I32_SIGN {
                // A negative vocabulary size means an unshared classifier.
                v = wrapping_u32(U32_RANGE - widen_u64(v));
            } else {
                shared = v > 0;
            }
        }
        let code = positive(v, f);
        if code != 0 {
            return code;
        }
        out.set(f, widen_u64(v));
    }
    let code = validate(in out[0..7], rope_base, rms_epsilon);
    if code != 0 {
        return code;
    }
    out
        .set(
        7,
        if shared {
            1
        } else {
            0
        }
    );
    let dim = out[0];
    let hidden = out[1];
    let layers = out[2];
    let kv_dim = out[4] * (dim / out[3]);
    let vocab = out[5];
    let mut at: u64 = HEADER_BYTES;
    let embedding = floats(in b, at, vocab * dim);
    if embedding != 0 {
        return embedding;
    }
    at = at + 4 * vocab * dim;
    // Per layer: rms_attention, wq, wk, wv, wo, rms_ffn, w1, w2, w3.
    for s in u64_zero()..9 {
        let n = if s == 0 || s == 5 {
            dim
        } else if s == 1 || s == 4 {
            dim * dim
        } else if s == 2 || s == 3 {
            kv_dim * dim
        } else {
            hidden * dim
        };
        for l in u64_zero()..layers {
            let code = floats(in b, at, n);
            if code != 0 {
                return code;
            }
            at = at + 4 * n;
        }
    }
    let last = floats(in b, at, dim);
    if last != 0 {
        return last;
    }
    at = at + 4 * dim;
    let rope = out[6] * (dim / out[3]) * 4;
    if rope > b.len() - at {
        return 30;
    }
    at = at + rope;
    if !shared {
        let classifier = floats(in b, at, vocab * dim);
        if classifier != 0 {
            return classifier;
        }
        at = at + 4 * vocab * dim;
    }
    if at != b.len() {
        return 33;
    }
    0
}

// `Tokenizer::from_llama2c`'s checks: writes the maximum token length to
// `out[0]`, then each entry's score bits, piece offset and length.
pub fn check_tokenizer(in b: Slice[u8], vocab: u64, inout out: Slice[u64])
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    if vocab == 0 || vocab > MAX_VOCAB {
        return 15;
    }
    if b.len() < 4 {
        return 30;
    }
    let max_len = b.read_u32_le(0);
    if max_len == 0 || max_len >= I32_SIGN {
        return 37;
    }
    if max_len > MAX_TOKEN_LENGTH {
        return 38;
    }
    out.set(0, widen_u64(max_len));
    let mut at: u64 = 4;
    for e in u64_zero()..vocab {
        if 4 > b.len() - at {
            return 30;
        }
        let score = b.read_u32_le(at);
        if !finite_bits(score) {
            return 31;
        }
        if 4 > b.len() - at - 4 {
            return 30;
        }
        let len = b.read_u32_le(at + 4);
        if len == 0 || len >= I32_SIGN {
            return 39;
        }
        if len > max_len {
            return 40;
        }
        let n = widen_u64(len);
        if n > b.len() - at - 8 {
            return 30;
        }
        out.set(1 + 3 * e, widen_u64(score));
        out.set(2 + 3 * e, at + 8);
        out.set(3 + 3 * e, n);
        at = at + 8 + n;
    }
    if at != b.len() {
        return 41;
    }
    0
}

fn hex_digit(c: u8) -> u64 eff [Fail[ArithOverflow]] {
    if c >= DIGIT_0 && c <= DIGIT_9 {
        return widen_u64(c - DIGIT_0);
    }
    if c >= UPPER_A && c <= UPPER_F {
        return widen_u64(c - UPPER_A) + 10;
    }
    if c >= LOWER_A && c <= LOWER_F {
        return widen_u64(c - LOWER_A) + 10;
    }
    NOT_HEX
}

// What `Tokenizer::decode` prints for `piece`: 0 for the piece from `out[1]`
// with length `out[2]`, 1 for the single byte `out[1]`, 2 for nothing.
pub fn decode_piece(in piece: Slice[u8], after_bos: bool, inout out: Slice[u64])
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let len = piece.len();
    let mut start: u64 = 0;
    if after_bos && len > 0 && piece[0] == SPACE {
        start = 1;
    }
    let n = wrapping_sub(len, start);
    // Most pieces are neither `<0xHH>` nor one byte: answer them first.
    if n != 6 && n != 1 {
        out.set(1, start);
        out.set(2, n);
        return 0;
    }
    if n == 1 {
        return single(widen_u64(piece[start]), inout out);
    }
    // `<0xHH>` (`start + 5 < len`, so the offsets cannot wrap).
    if piece[start]
        == LESS
        && piece[wrapping_add(start, 1)]
        == DIGIT_0
        && piece[wrapping_add(start, 2)]
        == LOWER_X
        && piece[wrapping_add(start, 5)]
        == GREATER {
        // `u8::from_str_radix` also takes a leading `+`.
        let lo = hex_digit(piece[wrapping_add(start, 4)]);
        let h = piece[wrapping_add(start, 3)];
        if h == 43 && lo < NOT_HEX {
            return single(lo, inout out);
        }
        let hi = hex_digit(h);
        if hi < NOT_HEX && lo < NOT_HEX {
            return single(wrapping_add(wrapping_mul(16, hi), lo), inout out);
        }
    }
    out.set(1, start);
    out.set(2, n);
    0
}

// A one-byte piece: printed if graphic or whitespace (`is_ascii_graphic`,
// `is_ascii_whitespace`: tab, newline, form feed, carriage return, space).
fn single(b: u64, inout out: Slice[u64]) -> u64 eff [Fail[RuntimeError]] {
    if (b >= GRAPHIC_FIRST && b <= GRAPHIC_LAST)
        || b
        == TAB
        || b
        == LF
        || b
        == FF
        || b
        == CR
        || b
        == SPACE_U64 {
        out.set(1, b);
        return 1;
    }
    2
}
