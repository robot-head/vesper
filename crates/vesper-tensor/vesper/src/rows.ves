// Module rows of @vesper/tensor (see lib.ves): GGML Q8_0 / Q4_0 and OCP
// MXFP4 blocks (src/quant.rs, src/formats.rs), FP8 matrices, and the row
// decoder behind `Matrix::row_chunks`.
use self::{
    Fault
};
use self::num::{
    decode_bf16,
    decode_fp16,
    encode_fp16,
    finite_bits,
    half_at,
    is_finite,
    u64_zero
};
use self::ocp::{
    e8m0_half,
    floor_log2,
    fp8_decode,
    fp8_encode,
    max_finite
};
use self::qk::{
    check_block,
    dequantize_block
};

// Block geometry (src/quant.rs, src/formats.rs): Q8_0, Q4_0 and MXFP4 blocks
// hold `BLOCK` elements, Q4_K super-blocks `QK_K`.
const BLOCK: u64 = 32;
const Q8_0_BYTES: u64 = 34;
const Q4_0_BYTES: u64 = 18;
const QK_K: u64 = 256;
const Q4_K_BYTES: u64 = 144;
const MXFP4_BYTES: u64 = 17;
// The port's `WeightFormat` codes (src/quant.rs `port_format`); 7 is F8E4M3.
const FORMAT_F32: u8 = 0;
const FORMAT_F16: u8 = 1;
const FORMAT_BF16: u8 = 2;
const FORMAT_Q8_0: u8 = 3;
const FORMAT_Q4_0: u8 = 4;
const FORMAT_Q4_K: u8 = 5;
const FORMAT_MXFP4: u8 = 6;
const FORMAT_F8E5M2: u8 = 8;
// Binary32 exponent field in place (its bits are +Inf) and exponent bias.
const F32_EXP_MASK: u32 = 2139095040;
const F32_BIAS: i32 = 127;
// E8M0 (OCP MX v1.0) reserves 255 for NaN; 254 is the largest scale.
const E8M0_NAN: u8 = 255;
const E8M0_MAX_FINITE: i32 = 254;
const E8M0_MAX_FINITE_U8: u8 = 254;
// The largest Q8_0 magnitude and Q4_0 nibble.
const Q8_MAX: f32 = 127.0;
const Q4_MAX: i8 = 15;
const Q4_MAX_U8: u8 = 15;
// The low nibble of a packed pair, and the Q4_0 nibble bias.
const NIBBLE: u8 = 15;
const Q4_0_BIAS: i16 = 8;

fn f(in s: Slice[u32], i: u64) -> f32 eff [Fail[RuntimeError]] {
    from_bits_f32(s[i])
}

pub fn dequantize_q8_0(in block: Slice[u8], inout out: Slice[u32], at: u64) eff [
    Fail[ArithOverflow],
    Fail[RuntimeError]
] {
    let d = half_at(in block, 0);
    for i in u64_zero()..BLOCK {
        let q = wrapping_i8(block[2 + i]);
        out.set(at + i, to_bits_f32(d * widen_f32(q)));
    }
}

pub fn dequantize_q4_0(in block: Slice[u8], inout out: Slice[u32], at: u64) eff [
    Fail[ArithOverflow],
    Fail[RuntimeError]
] {
    let d = half_at(in block, 0);
    for i in u64_zero()..16 {
        let packed = block[2 + i];
        let lo = widen_i16(packed & NIBBLE) - Q4_0_BIAS;
        let hi = widen_i16(packed >> 4) - Q4_0_BIAS;
        out.set(at + i, to_bits_f32(d * widen_f32(lo)));
        out.set(at + 16 + i, to_bits_f32(d * widen_f32(hi)));
    }
}

// GGML `kvalues_mxfp4`: E2M1 code values, doubled.
pub fn e2m1_doubled(code: u8) -> i8 {
    if code == 0 {
        0
    } else if code == 1 {
        1
    } else if code == 2 {
        2
    } else if code == 3 {
        3
    } else if code == 4 {
        4
    } else if code == 5 {
        6
    } else if code == 6 {
        8
    } else if code == 7 {
        12
    } else if code == 8 {
        0
    } else if code == 9 {
        -1
    } else if code == 10 {
        -2
    } else if code == 11 {
        -3
    } else if code == 12 {
        -4
    } else if code == 13 {
        -6
    } else if code == 14 {
        -8
    } else {
        -12
    }
}

pub fn dequantize_mxfp4(in block: Slice[u8], inout out: Slice[u32], at: u64) eff [
    Fail[ArithOverflow],
    Fail[RuntimeError]
] {
    let d = e8m0_half(block[0]);
    for j in u64_zero()..16 {
        let b = block[1 + j];
        out.set(at + j, to_bits_f32(d * widen_f32(e2m1_doubled(b & NIBBLE))));
        out.set(at + j + 16, to_bits_f32(d * widen_f32(e2m1_doubled(b >> 4))));
    }
}

// Decodes the `out.len()` elements of one row piece `raw` in format `format`
// (WeightFormat order: F32 0, F16 1, Bf16 2, Q8_0 3, Q4_0 4, Q4K 5,
// Mxfp4 6, F8E4M3 7, F8E5M2 8). `scale` is the FP8 matrix scale.
pub fn decode_piece(format: u8, scale: f32, in raw: Slice[u8], inout out: Slice[u32]) eff [
    Fail[ArithOverflow],
    Fail[RuntimeError]
] {
    let n = out.len();
    if format == FORMAT_F32 {
        for i in 0..n {
            out.set(i, raw.read_u32_le(4 * i));
        }
    } else if format == FORMAT_F16 {
        for i in 0..n {
            out.set(i, to_bits_f32(decode_fp16(raw.read_u16_le(2 * i))));
        }
    } else if format == FORMAT_BF16 {
        for i in 0..n {
            out.set(i, to_bits_f32(decode_bf16(raw.read_u16_le(2 * i))));
        }
    } else if format == FORMAT_Q8_0 {
        for b in u64_zero()..n / BLOCK {
            dequantize_q8_0(
                in raw[b * Q8_0_BYTES..b * Q8_0_BYTES + Q8_0_BYTES],
                inout out,
                BLOCK * b
            );
        }
    } else if format == FORMAT_Q4_0 {
        for b in u64_zero()..n / BLOCK {
            dequantize_q4_0(
                in raw[b * Q4_0_BYTES..b * Q4_0_BYTES + Q4_0_BYTES],
                inout out,
                BLOCK * b
            );
        }
    } else if format == FORMAT_Q4_K {
        for b in u64_zero()..n / QK_K {
            dequantize_block(
                in raw[b * Q4_K_BYTES..b * Q4_K_BYTES + Q4_K_BYTES],
                inout out,
                QK_K * b
            );
        }
    } else if format == FORMAT_MXFP4 {
        for b in u64_zero()..n / BLOCK {
            dequantize_mxfp4(
                in raw[b * MXFP4_BYTES..b * MXFP4_BYTES + MXFP4_BYTES],
                inout out,
                BLOCK * b
            );
        }
    } else {
        let e5m2 = format == FORMAT_F8E5M2;
        for i in 0..n {
            out.set(i, to_bits_f32(fp8_decode(e5m2, raw[i]) * scale));
        }
    }
}

// `check_rows`: whole blocks of `block` elements and finite values.
pub fn check_rows(in data: Slice[u32], cols: u64, block: u64) eff [
    Fail[ArithOverflow],
    Fail[RuntimeError],
    Fail[Fault]
] {
    if cols == 0 || cols % block != 0 || data.len() % cols != 0 {
        Fail::raise(Fault::Shape);
    }
    for i in 0..data.len() {
        if data[i] & F32_EXP_MASK == F32_EXP_MASK {
            Fail::raise(Fault::NonFinite);
        }
    }
}

fn push_half(inout out: ChunkSeq[u8], bits: u16) {
    out.push(wrapping_u8(bits));
    out.push(wrapping_u8(bits >> 8));
}

// GGML reference Q8_0.
pub fn quantize_q8_0(in data: Slice[u32], cols: u64)
    -> ChunkSeq[u8] eff [Fail[ArithOverflow], Fail[RuntimeError], Fail[Fault]] {
    check_rows(in data, cols, BLOCK);
    let blocks = data.len() / BLOCK;
    let mut out = ChunkSeq::with_capacity[u8](blocks * Q8_0_BYTES);
    for b in 0..blocks {
        let mut amax: f32 = 0.0;
        for i in u64_zero()..BLOCK {
            amax = max(amax, abs(f(in data, BLOCK * b + i)));
        }
        let d = amax / Q8_MAX;
        let id: f32 = if d != 0.0 {
            1.0 / d
        } else {
            0.0
        };
        push_half(inout out, encode_fp16(d));
        for i in u64_zero()..BLOCK {
            out.push(wrapping_u8(saturating_i8(round(f(in data, BLOCK * b + i) * id))));
        }
    }
    out
}

fn q4(v: f32, id: f32) -> u8 eff [Fail[ArithOverflow]] {
    let q = saturating_i8(v * id + 8.5);
    if q < Q4_MAX {
        wrapping_u8(q)
    } else {
        Q4_MAX_U8
    }
}

// GGML reference Q4_0.
pub fn quantize_q4_0(in data: Slice[u32], cols: u64)
    -> ChunkSeq[u8] eff [Fail[ArithOverflow], Fail[RuntimeError], Fail[Fault]] {
    check_rows(in data, cols, BLOCK);
    let blocks = data.len() / BLOCK;
    let mut out = ChunkSeq::with_capacity[u8](blocks * Q4_0_BYTES);
    for b in 0..blocks {
        let mut amax: f32 = 0.0;
        let mut mx: f32 = 0.0;
        for i in u64_zero()..BLOCK {
            let v = f(in data, BLOCK * b + i);
            if amax < abs(v) {
                amax = abs(v);
                mx = v;
            }
        }
        let d = mx / -8.0;
        let id: f32 = if d != 0.0 {
            1.0 / d
        } else {
            0.0
        };
        push_half(inout out, encode_fp16(d));
        for j in u64_zero()..16 {
            let lo = q4(f(in data, BLOCK * b + j), id);
            let hi = q4(f(in data, BLOCK * b + j + 16), id);
            out.push(lo | (hi << 4));
        }
    }
    out
}

fn mxfp4_code(d: f32, x: f32) -> u8 eff [Fail[ArithOverflow]] {
    let mut best: u8 = 0;
    let mut best_err = from_bits_f32(F32_EXP_MASK);
    for i in u64_zero()..16 {
        let k = wrapping_u8(i);
        let e = abs(d * widen_f32(e2m1_doubled(k)) - x);
        if e < best_err {
            best = k;
            best_err = e;
        }
    }
    best
}

// GGML / gguf-py MXFP4 quantization with an exact exponent.
pub fn quantize_mxfp4(in data: Slice[u32], cols: u64)
    -> ChunkSeq[u8] eff [Fail[ArithOverflow], Fail[RuntimeError], Fail[Fault]] {
    check_rows(in data, cols, BLOCK);
    let blocks = data.len() / BLOCK;
    let mut out = ChunkSeq::with_capacity[u8](blocks * MXFP4_BYTES);
    for b in 0..blocks {
        let mut amax: f32 = 0.0;
        for i in u64_zero()..BLOCK {
            amax = max(amax, abs(f(in data, BLOCK * b + i)));
        }
        let e: u8 = if amax > 0.0 {
            let raw = floor_log2(amax) - 2 + F32_BIAS;
            if raw < 0 {
                0
            } else if raw > E8M0_MAX_FINITE {
                E8M0_MAX_FINITE_U8
            } else {
                wrapping_u8(raw)
            }
        } else {
            0
        };
        let d = e8m0_half(e);
        out.push(e);
        for j in u64_zero()..16 {
            let lo = mxfp4_code(d, f(in data, BLOCK * b + j));
            let hi = mxfp4_code(d, f(in data, BLOCK * b + j + 16));
            out.push(lo | (hi << 4));
        }
    }
    out
}

// The per-tensor FP8 scale `amax / max_finite` (1 for all zeros), as bits.
pub fn fp8_scale(in data: Slice[u32], e5m2: bool) -> f32 eff [Fail[RuntimeError], Fail[Fault]] {
    let mut amax: f32 = 0.0;
    for i in 0..data.len() {
        let v = f(in data, i);
        if !is_finite(v) {
            Fail::raise(Fault::NonFinite);
        }
        amax = max(amax, abs(v));
    }
    let scale: f32 = if amax > 0.0 {
        amax / max_finite(e5m2)
    } else {
        1.0
    };
    if !(is_finite(scale) && scale > 0.0) {
        Fail::raise(Fault::NonFinite);
    }
    scale
}

pub fn fp8_codes(in data: Slice[u32], e5m2: bool, scale: f32)
    -> ChunkSeq[u8] eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let mut out = ChunkSeq::with_capacity[u8](data.len());
    for i in 0..data.len() {
        out.push(fp8_encode(e5m2, f(in data, i) / scale));
    }
    out
}

// `Matrix::from_bytes`: whether every element or block scale of a payload
// of whole blocks is finite (format codes as in `decode_piece`).
pub fn finite_payload(format: u8, in raw: Slice[u8])
    -> bool eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let n = raw.len();
    if format == FORMAT_F32 {
        for i in u64_zero()..n / 4 {
            if !finite_bits(raw.read_u32_le(4 * i)) {
                return false;
            }
        }
    } else if format == FORMAT_F16 || format == FORMAT_BF16 {
        for i in u64_zero()..n / 2 {
            let h = raw.read_u16_le(2 * i);
            let v = if format == FORMAT_F16 {
                decode_fp16(h)
            } else {
                decode_bf16(h)
            };
            if !is_finite(v) {
                return false;
            }
        }
    } else if format == FORMAT_Q8_0 || format == FORMAT_Q4_0 {
        let width: u64 = if format == FORMAT_Q8_0 {
            Q8_0_BYTES
        } else {
            Q4_0_BYTES
        };
        for b in u64_zero()..n / width {
            if !is_finite(half_at(in raw, width * b)) {
                return false;
            }
        }
    } else if format == FORMAT_Q4_K {
        for b in u64_zero()..n / Q4_K_BYTES {
            if !check_block(in raw[b * Q4_K_BYTES..b * Q4_K_BYTES + Q4_K_BYTES]) {
                return false;
            }
        }
    } else if format == FORMAT_MXFP4 {
        for b in u64_zero()..n / MXFP4_BYTES {
            if raw[b * MXFP4_BYTES] == E8M0_NAN {
                return false;
            }
        }
    } else {
        let e5m2 = format == FORMAT_F8E5M2;
        for i in 0..n {
            if !is_finite(fp8_decode(e5m2, raw[i])) {
                return false;
            }
        }
    }
    true
}
