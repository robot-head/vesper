// Module text of @vesper/tensor (see lib.ves): the strict, bounded JSON
// reader of src/json.rs, which reads safetensors headers.
//
// `parse_json` checks the whole document and writes it as a tape of words
// that src/json.rs turns into `Value`s: the low four bits are the kind
// (`Null` 0, `true` 1, `false` 2, an integer 3 followed by its value word,
// a string 4, an object key 5, `[` 6, `]` 7, `{` 8, `}` 9), and a string
// or key keeps its decoded bytes' offset in `strs` in bits 4..32 and their
// length in bits 32..60. It returns the tape length, or a failure code
// (see `json_failure`) as `code << 60`. Codes 11 and 12 ask the caller to
// retry with a larger tape (`tape.len()` words) and key table
// (`keys.len() / 2` slots, a power of two).
use self::num::{
    u64_zero
};

// ASCII bytes the JSON grammar (RFC 8259) uses.
const TAB: u8 = 9;
const LF: u8 = 10;
const CR: u8 = 13;
const SPACE: u8 = 32;
const QUOTE: u8 = 34;
const COMMA: u8 = 44;
const MINUS: u8 = 45;
const DOT: u8 = 46;
const SLASH: u8 = 47;
const DIGIT_0: u8 = 48;
const DIGIT_9: u8 = 57;
const COLON: u8 = 58;
const UPPER_A: u8 = 65;
const UPPER_E: u8 = 69;
const UPPER_F: u8 = 70;
const LEFT_BRACKET: u8 = 91;
const BACKSLASH: u8 = 92;
const RIGHT_BRACKET: u8 = 93;
const LOWER_A: u8 = 97;
const LOWER_B: u8 = 98;
const LOWER_E: u8 = 101;
const LOWER_F: u8 = 102;
const LOWER_L: u8 = 108;
const LOWER_N: u8 = 110;
const LOWER_R: u8 = 114;
const LOWER_S: u8 = 115;
const LOWER_T: u8 = 116;
const LOWER_U: u8 = 117;
const LEFT_BRACE: u8 = 123;
const RIGHT_BRACE: u8 = 125;
// What the `\b` and `\f` escapes decode to: backspace and form feed.
const BS: u8 = 8;
const FF: u8 = 12;
// `hex_value` of a non-hex byte, and `hex4` of a run that is not four hex
// digits.
const NOT_HEX: u64 = 16;
const NO_HEX4: u64 = 65536;
// UTF-16 surrogates (Unicode §3.8): a high one in [`HIGH_SURROGATE`,
// `LOW_SURROGATE`) pairs with a low one in [`LOW_SURROGATE`,
// `SURROGATE_END`) to give a code point from `SUPPLEMENTARY_BASE` up.
const HIGH_SURROGATE: u64 = 55296;
const LOW_SURROGATE: u64 = 56320;
const SURROGATE_END: u64 = 57344;
const SUPPLEMENTARY_BASE: u64 = 65536;
// UTF-8 encoding (RFC 3629 §3): code points below `UTF8_ONE_END` take one
// byte and below `UTF8_TWO_END` two; lead bytes carry these prefixes and
// continuation bytes `10xxxxxx`.
const UTF8_ONE_END: u64 = 128;
const UTF8_TWO_END: u64 = 2048;
const UTF8_TWO_PREFIX: u64 = 192;
const UTF8_THREE_PREFIX: u64 = 224;
const UTF8_FOUR_PREFIX: u64 = 240;
const UTF8_CONT_PREFIX: u64 = 128;
const UTF8_CONT_BITS: u64 = 63;
// Well-formed UTF-8 byte sequences (Unicode §3.9, Table 3-7): the lead byte
// ranges and the second-byte bounds that exclude overlong forms, surrogates
// and code points above U+10FFFF.
const UTF8_CONT_MIN: u8 = 128;
const UTF8_CONT_MAX: u8 = 191;
const UTF8_LEAD2_MIN: u8 = 194;
const UTF8_LEAD2_MAX: u8 = 223;
const UTF8_LEAD_E0: u8 = 224;
const UTF8_E0_SECOND_MIN: u8 = 160;
const UTF8_LEAD_E1: u8 = 225;
const UTF8_LEAD_EC: u8 = 236;
const UTF8_LEAD_ED: u8 = 237;
const UTF8_ED_SECOND_MAX: u8 = 159;
const UTF8_LEAD_EE: u8 = 238;
const UTF8_LEAD_EF: u8 = 239;
const UTF8_LEAD_F0: u8 = 240;
const UTF8_F0_SECOND_MIN: u8 = 144;
const UTF8_LEAD_F1: u8 = 241;
const UTF8_LEAD_F3: u8 = 243;
const UTF8_LEAD_F4: u8 = 244;
const UTF8_F4_SECOND_MAX: u8 = 143;
// 64-bit FNV-1a for the duplicate-key table.
const FNV_OFFSET: u64 = 14695981039346656037;
const FNV_PRIME: u64 = 1099511628211;
// A string tape word holds its start in bits 4..32.
const WORD_START_MASK: u64 = 268435455;
// The deepest nesting `parse_json` accepts.
const MAX_DEPTH: u64 = 8;

// Failure codes, in src/json.rs's messages: 1 "JSON header", 2 "trailing
// bytes after JSON header", 3 nesting limit, 4 "duplicate JSON key", 5
// negative number, 6 "JSON number with a leading zero", 7 non-integer
// number, 8 "unpaired JSON surrogate", 9 "control character in JSON
// string", 10 "JSON string is not UTF-8", 11 tape full, 12 key table full.
fn json_failure(code: u64) -> u64 eff [Fail[ArithOverflow]] {
    code << 60
}

fn skip_ws(in b: Slice[u8], at: u64) -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let mut i = at;
    loop {
        if i >= b.len() {
            break;
        }
        let c = b[i];
        if c != SPACE && c != TAB && c != LF && c != CR {
            break;
        }
        i = i + 1;
    }
    i
}

// Whether `b[at..]` starts with the ASCII bytes `word` (a 4- or 5-letter
// literal, given as its letters).
fn starts(in b: Slice[u8], at: u64, c0: u8, c1: u8, c2: u8, c3: u8, c4: u8, n: u64)
    -> bool eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    if at + n > b.len() {
        return false;
    }
    if b[at] != c0 || b[at + 1] != c1 || b[at + 2] != c2 || b[at + 3] != c3 {
        return false;
    }
    n == 4 || b[at + 4] == c4
}

fn hex_value(c: u8) -> u64 eff [Fail[ArithOverflow]] {
    if c >= DIGIT_0 && c <= DIGIT_9 {
        widen_u64(c - DIGIT_0)
    } else if c >= LOWER_A && c <= LOWER_F {
        widen_u64(c - LOWER_A) + 10
    } else if c >= UPPER_A && c <= UPPER_F {
        widen_u64(c - UPPER_A) + 10
    } else {
        NOT_HEX
    }
}

// The four hex digits at `b[at..at + 4]`, or `NO_HEX4` when they are not.
fn hex4(in b: Slice[u8], at: u64) -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    if at + 4 > b.len() {
        return NO_HEX4;
    }
    let mut v: u64 = 0;
    for i in u64_zero()..4 {
        let d = hex_value(b[at + i]);
        if d == NOT_HEX {
            return NO_HEX4;
        }
        v = v * 16 + d;
    }
    v
}

// Writes `code` as UTF-8 at `strs[sp..]`; returns the new end.
fn put_utf8(inout strs: Slice[u8], sp: u64, code: u64)
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    if code < UTF8_ONE_END {
        strs.set(sp, wrapping_u8(code));
        return sp + 1;
    }
    if code < UTF8_TWO_END {
        strs.set(sp, wrapping_u8(UTF8_TWO_PREFIX | (code >> 6)));
        strs.set(sp + 1, wrapping_u8(UTF8_CONT_PREFIX | (code & UTF8_CONT_BITS)));
        return sp + 2;
    }
    if code < SUPPLEMENTARY_BASE {
        strs.set(sp, wrapping_u8(UTF8_THREE_PREFIX | (code >> 12)));
        strs.set(sp + 1, wrapping_u8(UTF8_CONT_PREFIX | ((code >> 6) & UTF8_CONT_BITS)));
        strs.set(sp + 2, wrapping_u8(UTF8_CONT_PREFIX | (code & UTF8_CONT_BITS)));
        return sp + 3;
    }
    strs.set(sp, wrapping_u8(UTF8_FOUR_PREFIX | (code >> 18)));
    strs.set(sp + 1, wrapping_u8(UTF8_CONT_PREFIX | ((code >> 12) & UTF8_CONT_BITS)));
    strs.set(sp + 2, wrapping_u8(UTF8_CONT_PREFIX | ((code >> 6) & UTF8_CONT_BITS)));
    strs.set(sp + 3, wrapping_u8(UTF8_CONT_PREFIX | (code & UTF8_CONT_BITS)));
    sp + 4
}

// Whether `s[start..end]` is UTF-8 as `String::from_utf8` accepts it: no
// overlong forms, surrogates or code points above U+10FFFF.
pub fn utf8_ok(in s: Slice[u8], start: u64, end: u64)
    -> bool eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let mut i = start;
    loop {
        if i >= end {
            return true;
        }
        let c = s[i];
        if c < UTF8_CONT_MIN {
            i = i + 1;
        } else {
            let mut n: u64 = 0;
            let mut lo: u8 = UTF8_CONT_MIN;
            let mut hi: u8 = UTF8_CONT_MAX;
            if c >= UTF8_LEAD2_MIN && c <= UTF8_LEAD2_MAX {
                n = 1;
            } else if c == UTF8_LEAD_E0 {
                n = 2;
                lo = UTF8_E0_SECOND_MIN;
            } else if (c >= UTF8_LEAD_E1 && c <= UTF8_LEAD_EC)
                || c == UTF8_LEAD_EE
                || c == UTF8_LEAD_EF {
                n = 2;
            } else if c == UTF8_LEAD_ED {
                n = 2;
                hi = UTF8_ED_SECOND_MAX;
            } else if c == UTF8_LEAD_F0 {
                n = 3;
                lo = UTF8_F0_SECOND_MIN;
            } else if c >= UTF8_LEAD_F1 && c <= UTF8_LEAD_F3 {
                n = 3;
            } else if c == UTF8_LEAD_F4 {
                n = 3;
                hi = UTF8_F4_SECOND_MAX;
            } else {
                return false;
            }
            if i + n >= end {
                return false;
            }
            let first = s[i + 1];
            if first < lo || first > hi {
                return false;
            }
            for k in u64_zero()..n - 1 {
                let x = s[i + 2 + k];
                if x < UTF8_CONT_MIN || x > UTF8_CONT_MAX {
                    return false;
                }
            }
            i = i + n + 1;
        }
    }
}

// Reads the string starting at the quote `b[at]` into `strs[sp..]`.
// Returns (failure code or 0, the index after the closing quote, the new
// end of `strs`).
fn read_string(in b: Slice[u8], at: u64, inout strs: Slice[u8], sp: u64)
    -> (u64, u64, u64) eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    if at >= b.len() || b[at] != QUOTE {
        return (1, at, sp);
    }
    let start = sp;
    let mut i = at + 1;
    let mut o = sp;
    loop {
        if i >= b.len() {
            return (1, i, o);
        }
        let c = b[i];
        i = i + 1;
        if c == QUOTE {
            break;
        }
        if c == BACKSLASH {
            if i >= b.len() {
                return (1, i, o);
            }
            let e = b[i];
            i = i + 1;
            if e == LOWER_U {
                let high = hex4(in b, i);
                if high == NO_HEX4 {
                    return (1, i, o);
                }
                i = i + 4;
                let mut code = high;
                if high >= HIGH_SURROGATE && high < LOW_SURROGATE {
                    if i + 2 > b.len() || b[i] != BACKSLASH || b[i + 1] != LOWER_U {
                        return (1, i, o);
                    }
                    i = i + 2;
                    let low = hex4(in b, i);
                    if low == NO_HEX4 {
                        return (1, i, o);
                    }
                    i = i + 4;
                    if low < LOW_SURROGATE || low >= SURROGATE_END {
                        return (8, i, o);
                    }
                    code = SUPPLEMENTARY_BASE
                        + ((high - HIGH_SURROGATE) << 10)
                        + (low - LOW_SURROGATE);
                } else if high >= LOW_SURROGATE && high < SURROGATE_END {
                    return (8, i, o);
                }
                o = put_utf8(inout strs, o, code);
            } else {
                let mut d: u8 = 0;
                if e == QUOTE || e == BACKSLASH || e == SLASH {
                    d = e;
                } else if e == LOWER_B {
                    d = BS;
                } else if e == LOWER_F {
                    d = FF;
                } else if e == LOWER_N {
                    d = LF;
                } else if e == LOWER_R {
                    d = CR;
                } else if e == LOWER_T {
                    d = TAB;
                } else {
                    return (1, i, o);
                }
                strs.set(o, d);
                o = o + 1;
            }
        } else if c < SPACE {
            return (9, i, o);
        } else {
            strs.set(o, c);
            o = o + 1;
        }
    }
    if !utf8_ok(in strs, start, o) {
        return (10, i, o);
    }
    (0, i, o)
}

// The tape word of a string or key.
fn string_word(kind: u64, start: u64, end: u64) -> u64 eff [Fail[ArithOverflow]] {
    kind | (start << 4) | ((end - start) << 32)
}

// Records key `word` of object `object`; returns 0, 4 on a duplicate, or
// 12 when the table is half full.
fn add_key(inout keys: Slice[u64], in strs: Slice[u8], object: u64, word: u64, count: u64)
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let slots = keys.len() / 2;
    if 2 * (count + 1) > slots {
        return 12;
    }
    let start = (word >> 4) & WORD_START_MASK;
    let len = word >> 32;
    let mut h: u64 = FNV_OFFSET ^ object;
    for i in u64_zero()..len {
        h = wrapping_mul(h ^ widen_u64(strs[start + i]), FNV_PRIME);
    }
    let mask = slots - 1;
    let mut s = h & mask;
    loop {
        let tag = keys[2 * s];
        if tag == 0 {
            keys.set(2 * s, object + 1);
            keys.set(2 * s + 1, word);
            return 0;
        }
        let other = keys[2 * s + 1];
        if tag == object + 1 && other >> 32 == len {
            let o = (other >> 4) & WORD_START_MASK;
            let mut same = true;
            for i in u64_zero()..len {
                if same && strs[o + i] != strs[start + i] {
                    same = false;
                }
            }
            if same {
                return 4;
            }
        }
        s = (s + 1) & mask;
    }
}

// Appends `word` to the tape; returns the new length, or 0 when the tape
// is full.
fn push(inout tape: Slice[u64], n: u64, word: u64)
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    if n >= tape.len() {
        return 0;
    }
    tape.set(n, word);
    n + 1
}

pub fn parse_json(
    in b: Slice[u8],
    inout tape: Slice[u64],
    inout keys: Slice[u64],
    inout strs: Slice[u8],
    inout levels: Slice[u64]
) -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let mut at = skip_ws(in b, 0);
    let mut n: u64 = 0;
    let mut sp: u64 = 0;
    let mut depth: u64 = 0;
    let mut objects: u64 = 0;
    let mut key_count: u64 = 0;
    // 0: a value is next; 1: a key is next; 2: a value just ended.
    let mut step: u64 = 0;
    loop {
        if step == 1 {
            at = skip_ws(in b, at);
            let (code, next, end) = read_string(in b, at, inout strs, sp);
            if code != 0 {
                return json_failure(code);
            }
            let word = string_word(5, sp, end);
            at = next;
            sp = end;
            let added = add_key(inout keys, in strs, levels[depth - 1] >> 1, word, key_count);
            if added != 0 {
                return json_failure(added);
            }
            key_count = key_count + 1;
            n = push(inout tape, n, word);
            if n == 0 {
                return json_failure(11);
            }
            at = skip_ws(in b, at);
            if at >= b.len() || b[at] != COLON {
                return json_failure(1);
            }
            at = skip_ws(in b, at + 1);
            step = 0;
        } else if step == 0 {
            if depth > MAX_DEPTH {
                return json_failure(3);
            }
            if at >= b.len() {
                return json_failure(1);
            }
            let c = b[at];
            if c == LEFT_BRACE || c == LEFT_BRACKET {
                let object = c == LEFT_BRACE;
                at = at + 1;
                n = push(
                    inout tape,
                    n,
                    if object {
                        8
                    } else {
                        6
                    }
                );
                if n == 0 {
                    return json_failure(11);
                }
                at = skip_ws(in b, at);
                let close: u8 = if object {
                    125
                } else {
                    93
                };
                if at < b.len() && b[at] == close {
                    at = at + 1;
                    n = push(
                        inout tape,
                        n,
                        if object {
                            9
                        } else {
                            7
                        }
                    );
                    if n == 0 {
                        return json_failure(11);
                    }
                    if object {
                        objects = objects + 1;
                    }
                    step = 2;
                } else {
                    if object {
                        levels.set(depth, (objects << 1) | 1);
                        objects = objects + 1;
                        step = 1;
                    } else {
                        levels.set(depth, 0);
                        step = 0;
                    }
                    depth = depth + 1;
                }
            } else if c == QUOTE {
                let (code, next, end) = read_string(in b, at, inout strs, sp);
                if code != 0 {
                    return json_failure(code);
                }
                n = push(inout tape, n, string_word(4, sp, end));
                if n == 0 {
                    return json_failure(11);
                }
                at = next;
                sp = end;
                step = 2;
            } else if c == LOWER_T || c == LOWER_F || c == LOWER_N {
                let mut kind: u64 = 0;
                let mut width: u64 = 4;
                let mut ok = false;
                if c == LOWER_T {
                    kind = 1;
                    ok = starts(in b, at, LOWER_T, LOWER_R, LOWER_U, LOWER_E, 0, 4);
                } else if c == LOWER_F {
                    kind = 2;
                    width = 5;
                    ok = starts(in b, at, LOWER_F, LOWER_A, LOWER_L, LOWER_S, LOWER_E, 5);
                } else {
                    ok = starts(in b, at, LOWER_N, LOWER_U, LOWER_L, LOWER_L, 0, 4);
                }
                if !ok {
                    return json_failure(1);
                }
                at = at + width;
                n = push(inout tape, n, kind);
                if n == 0 {
                    return json_failure(11);
                }
                step = 2;
            } else if c >= DIGIT_0 && c <= DIGIT_9 {
                let start = at;
                loop {
                    if at >= b.len() || b[at] < DIGIT_0 || b[at] > DIGIT_9 {
                        break;
                    }
                    at = at + 1;
                }
                if at - start > 1 && b[start] == DIGIT_0 {
                    return json_failure(6);
                }
                if at < b.len() && (b[at] == DOT || b[at] == LOWER_E || b[at] == UPPER_E) {
                    return json_failure(7);
                }
                let mut v: u64 = 0;
                for i in start..at {
                    v = v * 10 + widen_u64(b[i] - DIGIT_0);
                }
                n = push(inout tape, n, 3);
                if n == 0 {
                    return json_failure(11);
                }
                n = push(inout tape, n, v);
                if n == 0 {
                    return json_failure(11);
                }
                step = 2;
            } else if c == MINUS {
                return json_failure(5);
            } else {
                return json_failure(1);
            }
        } else {
            if depth == 0 {
                at = skip_ws(in b, at);
                if at != b.len() {
                    return json_failure(2);
                }
                return n;
            }
            let object = levels[depth - 1] & 1 == 1;
            at = skip_ws(in b, at);
            if at >= b.len() {
                return json_failure(1);
            }
            let c = b[at];
            let close: u8 = if object {
                RIGHT_BRACE
            } else {
                RIGHT_BRACKET
            };
            if c == COMMA {
                at = at + 1;
                if object {
                    step = 1;
                } else {
                    at = skip_ws(in b, at);
                    step = 0;
                }
            } else if c == close {
                at = at + 1;
                n = push(
                    inout tape,
                    n,
                    if object {
                        9
                    } else {
                        7
                    }
                );
                if n == 0 {
                    return json_failure(11);
                }
                depth = depth - 1;
            } else {
                return json_failure(1);
            }
        }
    }
}
