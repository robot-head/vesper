// Module tokens of @vesper/tensor (see lib.ves): the llama2.c /
// SentencePiece-BPE prompt encoder of src/tokenizer.rs.
//
// The vocabulary crosses as flat slices: `bytes` holds every piece back to
// back, piece `id` is `bytes[offsets[id]..offsets[id + 1]]`, and `scores`
// holds each piece's score as f32 bits. `table` is an open-addressing hash
// table (64-bit FNV-1a, linear probing, a power-of-two length) whose entries are
// `id + 1`, or 0 when empty; `build_table` fills it with the lowest id of
// each distinct piece, the Rust build's `HashMap` `or_insert` order.
//
// `encode` keeps the Rust build's merge order: a max-heap of candidate pairs
// keyed by (score in `f32::total_cmp` order, leftmost first), with lazy
// invalidation by node versions.
use self::{
    Fault
};
use self::num::{
    u64_zero
};

// The FNV-1a hash of `s[start..start + len]`.
fn fnv(in s: Slice[u8], start: u64, len: u64) -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let mut h: u64 = 14695981039346656037;
    for i in u64_zero()..len {
        h = wrapping_mul(h ^ widen_u64(s[start + i]), 1099511628211);
    }
    h
}

// Whether piece `id` equals `s[start..start + len]`.
fn piece_eq(
    in bytes: Slice[u8],
    in offsets: Slice[u64],
    id: u64,
    in s: Slice[u8],
    start: u64,
    len: u64
) -> bool eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let at = offsets[id];
    if offsets[id + 1] - at != len {
        return false;
    }
    for i in u64_zero()..len {
        if bytes[at + i] != s[start + i] {
            return false;
        }
    }
    true
}

// `id + 1` of the piece equal to `s[start..start + len]`, or 0.
pub fn lookup(
    in bytes: Slice[u8],
    in offsets: Slice[u64],
    in table: Slice[u32],
    in s: Slice[u8],
    start: u64,
    len: u64
) -> u32 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let mask = table.len() - 1;
    let mut h = fnv(in s, start, len) & mask;
    loop {
        let e = table[h];
        if e == 0 {
            return 0;
        }
        if piece_eq(in bytes, in offsets, widen_u64(e - 1), in s, start, len) {
            return e;
        }
        h = (h + 1) & mask;
    }
}

// Fills the empty `table` with every piece, keeping the lowest id of
// duplicate pieces.
pub fn build_table(in bytes: Slice[u8], in offsets: Slice[u64], inout table: Slice[u32]) eff [
    Fail[ArithOverflow],
    Fail[RuntimeError]
] {
    let mask = table.len() - 1;
    let vocab = offsets.len() - 1;
    for id in u64_zero()..vocab {
        let start = offsets[id];
        let len = offsets[id + 1] - start;
        let mut h = fnv(in bytes, start, len) & mask;
        loop {
            let e = table[h];
            if e == 0 {
                table.set(h, wrapping_u32(id + 1));
                break;
            }
            if piece_eq(in bytes, in offsets, widen_u64(e - 1), in bytes, start, len) {
                break;
            }
            h = (h + 1) & mask;
        }
    }
}

fn hex_digit(d: u8) -> u8 eff [Fail[ArithOverflow]] {
    if d < 10 {
        48 + d
    } else {
        55 + d
    }
}

// The id of the byte-fallback piece `<0xHH>` for `b`.
fn byte_token(
    in bytes: Slice[u8],
    in offsets: Slice[u64],
    in table: Slice[u32],
    inout key: Slice[u8],
    b: u8
) -> u32 eff [Fail[ArithOverflow], Fail[RuntimeError], Fail[Fault]] {
    key.set(0, 60);
    key.set(1, 48);
    key.set(2, 120);
    key.set(3, hex_digit(b >> 4));
    key.set(4, hex_digit(b & 15));
    key.set(5, 62);
    let e = lookup(in bytes, in offsets, in table, in key, 0, 6);
    if e == 0 {
        Fail::raise(Fault::NoBytePiece);
    }
    e - 1
}

// `f32::total_cmp` order of f32 bits as an unsigned key.
fn total_order(b: u32) -> u32 {
    if b & 2147483648 != 0 {
        ~b
    } else {
        b | 2147483648
    }
}

// Node `i` of the merge list is three words at `3 * i`: the token with the
// node's version in the high half, then `prev` and `next` (`NONE` at the
// ends). A merged-away node's `prev` is `DEAD`.
fn none() -> u64 {
    4294967295
}

fn dead() -> u64 {
    4294967296
}

fn token_of(in w: Slice[u64], i: u64) -> u32 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    wrapping_u32(w[3 * i] & 4294967295)
}

fn version_of(in w: Slice[u64], i: u64) -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    w[3 * i] >> 32
}

// A heap entry is four words at `heap + 4 * k`: the order key
// `(total_order(score) << 32) | (NONE - left)`, `(left << 32) | right`,
// `(left version << 32) | right version`, and the merged id.
fn swap_entries(inout w: Slice[u64], a: u64, b: u64) eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    for t in u64_zero()..4 {
        let x = w[a + t];
        let y = w[b + t];
        w.set(a + t, y);
        w.set(b + t, x);
    }
}

fn heap_push(
    inout w: Slice[u64],
    heap: u64,
    count: u64,
    order: u64,
    pair: u64,
    versions: u64,
    id: u64
) -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let at = heap + 4 * count;
    w.set(at, order);
    w.set(at + 1, pair);
    w.set(at + 2, versions);
    w.set(at + 3, id);
    let mut c = count;
    loop {
        if c == 0 {
            break;
        }
        let p = (c - 1) / 2;
        if w[heap + 4 * p] >= w[heap + 4 * c] {
            break;
        }
        swap_entries(inout w, heap + 4 * p, heap + 4 * c);
        c = p;
    }
    count + 1
}

// Removes the top entry (copied to `heap - 4 ..`, the scratch entry) and
// returns the new count.
fn heap_pop(inout w: Slice[u64], heap: u64, count: u64)
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    for t in u64_zero()..4 {
        let x = w[heap + t];
        w.set(heap - 4 + t, x);
    }
    let n = count - 1;
    if n > 0 {
        for t in u64_zero()..4 {
            let x = w[heap + 4 * n + t];
            w.set(heap + t, x);
        }
    }
    let mut r: u64 = 0;
    loop {
        let c = 2 * r + 1;
        if c >= n {
            break;
        }
        let mut m = c;
        if c + 1 < n && w[heap + 4 * (c + 1)] > w[heap + 4 * c] {
            m = c + 1;
        }
        if w[heap + 4 * r] >= w[heap + 4 * m] {
            break;
        }
        swap_entries(inout w, heap + 4 * r, heap + 4 * m);
        r = m;
    }
    n
}

// Pushes the merge of node `i` with its successor when that pair is a
// piece that may merge; returns the new heap count.
fn candidate(
    in bytes: Slice[u8],
    in offsets: Slice[u64],
    in scores: Slice[u32],
    in table: Slice[u32],
    inout key: Slice[u8],
    inout w: Slice[u64],
    heap: u64,
    count: u64,
    i: u64
) -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let j = w[3 * i + 2];
    if j == none() {
        return count;
    }
    let a = widen_u64(token_of(in w, i));
    let b = widen_u64(token_of(in w, j));
    let a_at = offsets[a];
    let a_len = offsets[a + 1] - a_at;
    let b_at = offsets[b];
    let b_len = offsets[b + 1] - b_at;
    for t in u64_zero()..a_len {
        key.set(t, bytes[a_at + t]);
    }
    for t in u64_zero()..b_len {
        key.set(a_len + t, bytes[b_at + t]);
    }
    let e = lookup(in bytes, in offsets, in table, in key, 0, a_len + b_len);
    if e == 0 {
        return count;
    }
    let id = widen_u64(e - 1);
    let score = scores[id];
    let never: f32 = -10000000000.0;
    if !(from_bits_f32(score) > never) {
        return count;
    }
    let order = (widen_u64(total_order(score)) << 32) | (none() - i);
    let versions = (version_of(in w, i) << 32) | version_of(in w, j);
    heap_push(inout w, heap, count, order, (i << 32) | j, versions, id)
}

// Encodes `text` into `out` (at least `text.len() + 3` slots) and returns
// the token count. `w` has at least `15 * (text.len() + 1) + 4` words and
// `key` at least twice the longest piece, and 6, bytes.
pub fn encode(
    in text: Slice[u8],
    in bytes: Slice[u8],
    in offsets: Slice[u64],
    in scores: Slice[u32],
    in table: Slice[u32],
    bos: u32,
    eos: u32,
    inout out: Slice[u32],
    inout w: Slice[u64],
    inout key: Slice[u8]
) -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError], Fail[Fault]] {
    let len = text.len();
    if len > 1048576 {
        Fail::raise(Fault::Limit);
    }
    let cap = len + 1;
    let heap = 3 * cap + 4;
    // The initial tokens, as nodes.
    let mut n: u64 = 0;
    if len > 0 {
        key.set(0, 32);
        let e = lookup(in bytes, in offsets, in table, in key, 0, 1);
        if e == 0 {
            Fail::raise(Fault::NoSpacePiece);
        }
        w.set(0, widen_u64(e - 1));
        n = 1;
    }
    let mut start: u64 = 0;
    let mut unit: u64 = 0;
    for i in u64_zero()..len {
        let b = text[i];
        if b & 192 != 128 || unit == 0 {
            start = i;
            unit = 0;
        }
        unit = unit + 1;
        let continues = i + 1 < len && text[i + 1] & 192 == 128;
        if !(continues && unit < 4) {
            let e = lookup(in bytes, in offsets, in table, in text, start, unit);
            if e != 0 {
                w.set(3 * n, widen_u64(e - 1));
                n = n + 1;
            } else {
                for t in u64_zero()..unit {
                    let id = byte_token(in bytes, in offsets, in table, inout key, text[start + t]);
                    w.set(3 * n, widen_u64(id));
                    n = n + 1;
                }
            }
            unit = 0;
        }
    }
    for i in u64_zero()..n {
        w
            .set(
            3 * i + 1,
            if i == 0 {
                none()
            } else {
                i - 1
            }
        );
        w
            .set(
            3 * i + 2,
            if i + 1 == n {
                none()
            } else {
                i + 1
            }
        );
    }
    // Merge.
    let mut count: u64 = 0;
    for i in u64_zero()..n {
        count = candidate(
            in bytes,
            in offsets,
            in scores,
            in table,
            inout key,
            inout w,
            heap,
            count,
            i
        );
    }
    loop {
        if count == 0 {
            break;
        }
        count = heap_pop(inout w, heap, count);
        let pair = w[heap - 3];
        let versions = w[heap - 2];
        let id = w[heap - 1];
        let i = pair >> 32;
        let j = pair & 4294967295;
        let fresh = w[3 * i + 1]
            != dead()
            && w[3 * j + 1]
            != dead()
            && w[3 * i + 2]
            == j
            && version_of(in w, i)
            == versions
            >> 32
            && version_of(in w, j)
            == versions
            & 4294967295;
        if fresh {
            let merged = ((version_of(in w, i) + 1) << 32) | id;
            w.set(3 * i, merged);
            w.set(3 * j + 1, dead());
            let after = w[3 * j + 2];
            w.set(3 * i + 2, after);
            if after != none() {
                w.set(3 * after + 1, i);
            }
            let before = w[3 * i + 1];
            if before != none() {
                count = candidate(
                    in bytes,
                    in offsets,
                    in scores,
                    in table,
                    inout key,
                    inout w,
                    heap,
                    count,
                    before
                );
            }
            count = candidate(
                in bytes,
                in offsets,
                in scores,
                in table,
                inout key,
                inout w,
                heap,
                count,
                i
            );
        }
    }
    // Emit.
    let mut k: u64 = 0;
    if bos != 0 {
        out.set(0, 1);
        k = 1;
    }
    if n > 0 {
        let mut i: u64 = 0;
        loop {
            out.set(k, token_of(in w, i));
            k = k + 1;
            i = w[3 * i + 2];
            if i == none() {
                break;
            }
        }
    }
    if eos != 0 {
        out.set(k, 2);
        k = k + 1;
    }
    k
}
