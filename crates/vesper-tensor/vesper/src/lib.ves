pub fn parse_gguf(
    in bytes: Slice[u8],
    in alignment_key: Slice[u8],
    inout tape: Slice[u64],
    inout names: Slice[u64],
    inout status: Slice[u64]
) -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError], Fail[Fault]] {
    g_parse_gguf(in bytes, in alignment_key, inout tape, inout names, inout status)
}

// The safetensors header reader (src/json.rs); see text.ves for the tape.
pub fn parse_json(
    in bytes: Slice[u8],
    inout tape: Slice[u64],
    inout keys: Slice[u64],
    inout strs: Slice[u8],
    inout levels: Slice[u64]
) -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    j_parse_json(in bytes, inout tape, inout keys, inout strs, inout levels)
}

// Prompt encoding (src/tokenizer.rs); see tokens.ves for the layout.
pub fn vocab_table(in bytes: Slice[u8], in offsets: Slice[u64], inout table: Slice[u32]) eff [
    Fail[ArithOverflow],
    Fail[RuntimeError]
] {
    t_build_table(in bytes, in offsets, inout table);
}

pub fn vocab_lookup(
    in bytes: Slice[u8],
    in offsets: Slice[u64],
    in table: Slice[u32],
    in piece: Slice[u8]
) -> u32 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    t_lookup(in bytes, in offsets, in table, in piece, 0, piece.len())
}

pub fn encode_prompt(
    in text: Slice[u8],
    in bytes: Slice[u8],
    in offsets: Slice[u64],
    in scores: Slice[u32],
    in table: Slice[u32],
    bos: u32,
    eos: u32,
    inout out: Slice[u32],
    inout work: Slice[u64],
    inout key: Slice[u8]
) -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError], Fail[Fault]] {
    t_encode(
        in text,
        in bytes,
        in offsets,
        in scores,
        in table,
        bos,
        eos,
        inout out,
        inout work,
        inout key
    )
}

// Sampling (src/sampling.rs).
pub fn rng_next_u32(seed: u64) -> (u64, u32) eff [Fail[ArithOverflow]] {
    rng_next(seed)
}

pub fn rng_next_f32(seed: u64) -> (u64, u32) eff [Fail[ArithOverflow]] {
    let (s, v) = rng_f32(seed);
    (s, to_bits_f32(v))
}

pub fn sample_mult(in probs: Slice[u32], coin: u32)
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    s_sample_mult(in probs, from_bits_f32(coin))
}

pub fn sample_top_p(in probs: Slice[u32], top_p: u32, coin: u32, inout scratch: Slice[u64])
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    s_sample_top_p(in probs, from_bits_f32(top_p), from_bits_f32(coin), inout scratch)
}

// FP32 kernels (src/ops.rs).
pub fn argmax(in x: Slice[u32]) -> u64 eff [Fail[RuntimeError], Fail[Fault]] {
    s_argmax(in x)
}

pub fn rms_norm(inout out: Slice[u32], in x: Slice[u32], in weight: Slice[u32], epsilon: u32) eff [
    Fail[RuntimeError],
    Fail[Fault]
] {
    s_rms_norm(inout out, in x, in weight, from_bits_f32(epsilon));
}

pub fn silu(v: u32) -> u32 eff [Ffi[Libm]] {
    to_bits_f32(silu_f(from_bits_f32(v)))
}

pub fn add_assign(inout acc: Slice[u32], in x: Slice[u32]) eff [Fail[RuntimeError], Fail[Fault]] {
    s_add_assign(inout acc, in x);
}

// The FP32 kernels that call the platform `exp` (`f32::exp`, through the
// `Libm` shim in src/port.rs), so their results equal the Rust build's bit
// for bit; a `.vsys` library is visible only in this root module.
fn f(in s: Slice[u32], i: u64) -> f32 eff [Fail[RuntimeError]] {
    from_bits_f32(s[i])
}

fn expf(v: f32) -> f32 eff [Ffi[Libm]] {
    from_bits_f32(Libm::vesper_tensor_expf(to_bits_f32(v)))
}

pub fn softmax(inout x: Slice[u32]) eff [Ffi[Libm], Fail[RuntimeError], Fail[Fault]] {
    let n = x.len();
    if n == 0 {
        Fail::raise(Fault::Shape);
    }
    let mut mx = from_bits_f32(4286578688);
    for i in 0..n {
        let v = f(in x, i);
        if is_nan(v) {
            Fail::raise(Fault::NonFinite);
        }
        if v > mx {
            mx = v;
        }
    }
    if !is_finite(mx) {
        Fail::raise(Fault::NonFinite);
    }
    let mut sum: f32 = 0.0;
    for i in 0..n {
        let e = expf(f(in x, i) - mx);
        x.set(i, to_bits_f32(e));
        sum = sum + e;
    }
    for i in 0..n {
        let v = f(in x, i) / sum;
        x.set(i, to_bits_f32(v));
    }
}

// `Sampler::sample` after the length check: the token and the new seed.
pub fn sample(
    inout probs: Slice[u32],
    in logits: Slice[u32],
    temperature_bits: u32,
    top_p_bits: u32,
    rng: u64,
    inout scratch: Slice[u64]
) -> (u64, u64) eff [Ffi[Libm], Fail[ArithOverflow], Fail[RuntimeError], Fail[Fault]] {
    let temperature = from_bits_f32(temperature_bits);
    let top_p = from_bits_f32(top_p_bits);
    if temperature == 0.0 {
        return (s_argmax(in logits), rng);
    }
    for i in 0..logits.len() {
        probs.set(i, to_bits_f32(f(in logits, i) / temperature));
    }
    softmax(inout probs);
    let (seed, coin) = rng_f32(rng);
    if top_p <= 0.0 || top_p >= 1.0 {
        return (s_sample_mult(in probs, coin), seed);
    }
    (s_sample_top_p(in probs, top_p, coin, inout scratch), seed)
}

fn silu_f(v: f32) -> f32 eff [Ffi[Libm]] {
    v * (1.0 / (1.0 + expf(-v)))
}

pub fn swiglu(inout gate: Slice[u32], in up: Slice[u32]) eff [
    Ffi[Libm],
    Fail[RuntimeError],
    Fail[Fault]
] {
    if gate.len() != up.len() || gate.len() == 0 {
        Fail::raise(Fault::Shape);
    }
    for i in 0..gate.len() {
        let g = silu_f(f(in gate, i)) * f(in up, i);
        gate.set(i, to_bits_f32(g));
    }
}
