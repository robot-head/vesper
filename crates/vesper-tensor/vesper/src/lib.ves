    s_add_assign(inout acc, in x);
}

// The FP32 kernels that call the platform `exp` (`f32::exp`, through the
// `Libm` shim in src/port.rs), so their results equal the Rust build's bit
// for bit; a `.vsys` library is visible only in this root module.
fn f(in s: Slice[u32], i: u64) -> f32 eff [Fail[RuntimeError]] {
    from_bits_f32(s[i])
}

fn expf(v: f32) -> f32 eff [Ffi[Libm]] {
    from_bits_f32(Libm::vesper_tensor_expf(to_bits_f32(v)))
}

pub fn softmax(inout x: Slice[u32]) eff [Ffi[Libm], Fail[RuntimeError], Fail[Fault]] {
    let n = x.len();
    if n == 0 {
        Fail::raise(Fault::Shape);
    }
    let mut mx = from_bits_f32(F32_NEG_INFINITY);
    for i in 0..n {
        let v = f(in x, i);
        if is_nan(v) {
            Fail::raise(Fault::NonFinite);
        }
        if v > mx {
            mx = v;
        }
    }
    if !is_finite(mx) {
        Fail::raise(Fault::NonFinite);
    }
    let mut sum: f32 = 0.0;
    for i in 0..n {
        let e = expf(f(in x, i) - mx);
        x.set(i, to_bits_f32(e));
        sum = sum + e;
    }
    for i in 0..n {
        let v = f(in x, i) / sum;
        x.set(i, to_bits_f32(v));
    }
}

// `Sampler::sample` after the length check: the token and the new seed.
pub fn sample(
    inout probs: Slice[u32],
    in logits: Slice[u32],
    temperature_bits: u32,
    top_p_bits: u32,
    rng: u64,
    inout scratch: Slice[u64]
) -> (u64, u64) eff [Ffi[Libm], Fail[ArithOverflow], Fail[RuntimeError], Fail[Fault]] {
    let temperature = from_bits_f32(temperature_bits);
    let top_p = from_bits_f32(top_p_bits);
    if temperature == 0.0 {
        return (s_argmax(in logits), rng);
    }
    for i in 0..logits.len() {
        probs.set(i, to_bits_f32(f(in logits, i) / temperature));
    }
    softmax(inout probs);
    let (seed, coin) = rng_f32(rng);
    if top_p <= 0.0 || top_p >= 1.0 {
        return (s_sample_mult(in probs, coin), seed);
    }
    (s_sample_top_p(in probs, top_p, coin, inout scratch), seed)
}

fn silu_f(v: f32) -> f32 eff [Ffi[Libm]] {
    v * (1.0 / (1.0 + expf(-v)))
}

pub fn swiglu(inout gate: Slice[u32], in up: Slice[u32]) eff [
    Ffi[Libm],
    Fail[RuntimeError],
    Fail[Fault]
] {
    if gate.len() != up.len() || gate.len() == 0 {
        Fail::raise(Fault::Shape);
    }
    for i in 0..gate.len() {
        let g = silu_f(f(in gate, i)) * f(in up, i);
        gate.set(i, to_bits_f32(g));
    }
}

// The dimension planner's normal form (see shape.ves).
pub fn shape_normalize(
    in nodes: Slice[u64],
    id: u64,
    in bound: Slice[u64],
    in ranks: Slice[u64],
    max_factors: u64,
    inout work: Slice[u64],
    inout out: Slice[u64]
) -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    d_normalize(in nodes, id, in bound, in ranks, max_factors, inout work, inout out)
}

pub fn shape_gqa_ratio(query_heads: u64, kv_heads: u64) -> u64 eff [Fail[RuntimeError]] {
    d_gqa_ratio(query_heads, kv_heads)
}

// Paged GQA decode attention (src/attention.rs) with the scalar kernel, over
// the K/V pool's tables and storage (see pool.ves): `tokens` visible tokens
// of sequence `(slot, generation)`, query head `h` reading K/V head
// `h / (query_heads / kv_heads)`. The wrapper has checked the shapes, the
// GQA ratio and `tokens`. `scores` holds `query_heads * tokens` values for
// the two-pass schedule; `block` holds one page of scores for the online
// one; `page` is three words of scratch. Returns a pool code (see pool.ves);
// non-finite values raise `NonFinite`.
pub fn attend(
    in storage: Slice[u8],
    in pages: Slice[u64],
    in slots: Slice[u64],
    in leases: Slice[u64],
    in cfg: Slice[u64],
    slot: u64,
    generation: u64,
    in query: Slice[u32],
    inout scores: Slice[u32],
    inout block: Slice[u32],
    inout out: Slice[u32],
    inout page: Slice[u64],
    query_heads: u64,
    tokens: u64,
    online: bool,
    words: bool
) -> u64 eff [Ffi[Libm], Fail[ArithOverflow], Fail[RuntimeError], Fail[Fault]] {
    let kv_heads = cfg[0];
    let head_dim = cfg[1];
    let plane = TOKENS_PER_PAGE * cfg[5];
    let width: u64 = if words {
        4
    } else {
        2
    };
    let kv_stride = kv_heads * head_dim;
    let group = query_heads / kv_heads;
    let npages = (tokens + TOKENS_PER_PAGE - 1) / TOKENS_PER_PAGE;
    let scale = sqrt(nearest_f32(head_dim));
    let neg_inf = from_bits_f32(F32_NEG_INFINITY);
    for h in u64_zero()..query_heads {
        let kv_head = h / group;
        let q0 = h * head_dim;
        let o0 = h * head_dim;
        if !online {
            let s0 = h * tokens;
            for p in u64_zero()..npages {
                let code = p_kv_read_page(
                    in pages,
                    in slots,
                    in leases,
                    in cfg,
                    slot,
                    generation,
                    p,
                    inout page
                );
                if code != 0 {
                    return code;
                }
                let first = page[0];
                let n = visible(page[1], tokens - first);
                for t in u64_zero()..n {
                    let at = page[2] + (t * kv_stride + kv_head * head_dim) * width;
                    let d = dot_at(in query, q0, in storage, at, head_dim, words) / scale;
                    scores.set(s0 + first + t, to_bits_f32(d));
                }
            }
            softmax(inout scores[s0..s0 + tokens]);
            for i in u64_zero()..head_dim {
                out.set(o0 + i, 0);
            }
            for p in u64_zero()..npages {
                let code = p_kv_read_page(
                    in pages,
                    in slots,
                    in leases,
                    in cfg,
                    slot,
                    generation,
                    p,
                    inout page
                );
                if code != 0 {
                    return code;
                }
                let first = page[0];
                let n = visible(page[1], tokens - first);
                for t in u64_zero()..n {
                    let a = f(in scores, s0 + first + t);
                    let at = page[2] + plane + (t * kv_stride + kv_head * head_dim) * width;
                    axpy_at(inout out, o0, a, in storage, at, head_dim, words);
                }
            }
        } else {
            let mut max = neg_inf;
            let mut sum: f32 = 0.0;
            for i in u64_zero()..head_dim {
                out.set(o0 + i, 0);
            }
            for p in u64_zero()..npages {
                let code = p_kv_read_page(
                    in pages,
                    in slots,
                    in leases,
                    in cfg,
                    slot,
                    generation,
                    p,
                    inout page
                );
                if code != 0 {
                    return code;
                }
                let first = page[0];
                let n = visible(page[1], tokens - first);
                let mut block_max = neg_inf;
                for t in u64_zero()..n {
                    let at = page[2] + (t * kv_stride + kv_head * head_dim) * width;
                    let d = dot_at(in query, q0, in storage, at, head_dim, words) / scale;
                    block.set(t, to_bits_f32(d));
                    if d > block_max {
                        block_max = d;
                    }
                }
                if !is_finite(block_max) {
                    Fail::raise(Fault::NonFinite);
                }
                if block_max > max {
                    let rescale = expf(max - block_max);
                    sum = sum * rescale;
                    for i in u64_zero()..head_dim {
                        let v = f(in out, o0 + i) * rescale;
                        out.set(o0 + i, to_bits_f32(v));
                    }
                    max = block_max;
                }
                for t in u64_zero()..n {
                    let weight = expf(f(in block, t) - max);
                    sum = sum + weight;
                    let at = page[2] + plane + (t * kv_stride + kv_head * head_dim) * width;
                    axpy_at(inout out, o0, weight, in storage, at, head_dim, words);
                }
            }
            for i in u64_zero()..head_dim {
                let v = f(in out, o0 + i) / sum;
                out.set(o0 + i, to_bits_f32(v));
            }
        }
    }
    for i in u64_zero()..out.len() {
        if !is_finite(f(in out, i)) {
            Fail::raise(Fault::NonFinite);
        }
    }
    0
}

fn visible(stored: u64, left: u64) -> u64 {
    if stored < left {
        stored
    } else {
        left
    }
}

// Element `i` of a K/V head at byte `at`: little-endian FP32 or BF16.
fn kv_elem(in storage: Slice[u8], at: u64, i: u64, words: bool)
    -> f32 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    if words {
        from_bits_f32(storage.read_u32_le(at + 4 * i))
    } else {
        let lo = widen_u32(storage[at + 2 * i]);
        let hi = widen_u32(storage[at + 2 * i + 1]);
        from_bits_f32((lo | (hi << 8)) << BF16_SHIFT)
    }
}

// The scalar kernel's dot product, in element order.
fn dot_at(in q: Slice[u32], q0: u64, in storage: Slice[u8], at: u64, n: u64, words: bool)
    -> f32 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let mut acc: f32 = 0.0;
    if words {
        for i in u64_zero()..n {
            acc = acc + from_bits_f32(q[q0 + i]) * from_bits_f32(storage.read_u32_le(at + 4 * i));
        }
    } else {
        for i in u64_zero()..n {
            acc = acc + f(in q, q0 + i) * kv_elem(in storage, at, i, false);
        }
    }
    acc
}

fn axpy_at(
    inout out: Slice[u32],
    o0: u64,
    alpha: f32,
    in storage: Slice[u8],
    at: u64,
    n: u64,
    words: bool
) eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    if words {
        for i in u64_zero()..n {
            let v = from_bits_f32(out[o0 + i])
                + alpha
                * from_bits_f32(storage.read_u32_le(at + 4 * i));
            out.set(o0 + i, to_bits_f32(v));
        }
    } else {
        for i in u64_zero()..n {
            let v = f(in out, o0 + i) + alpha * kv_elem(in storage, at, i, false);
            out.set(o0 + i, to_bits_f32(v));
        }
    }
}

// The pure checks of src/llama.rs (see llama.ves).
pub fn llama_validate(in dims: Slice[u64], rope_base: u32, rms_epsilon: u32)
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    l_validate(in dims, rope_base, rms_epsilon)
}

pub fn llama_checkpoint(in b: Slice[u8], rope_base: u32, rms_epsilon: u32, inout out: Slice[u64])
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    l_check_checkpoint(in b, rope_base, rms_epsilon, inout out)
}

pub fn llama_tokenizer(in b: Slice[u8], vocab: u64, inout out: Slice[u64])
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    l_check_tokenizer(in b, vocab, inout out)
}

pub fn llama_decode(in piece: Slice[u8], after_bos: bool, inout out: Slice[u64])
    -> u64 eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    l_decode_piece(in piece, after_bos, inout out)
}

// `Mapping::open` (src/mmap.rs) once the wrapper has opened the file: the
// `WeightFile` library stats and maps the file it holds. Returns 0 when the
// file is mapped, 1 when it is empty (zero-length mappings are not
// portable), 2 when it cannot be stat'ed, 3 when it is larger than
// `MAX_WEIGHT_FILE_BYTES` (64 GiB) and 4 when it cannot be mapped.
pub fn open_weights() -> u64 eff [Ffi[WeightFile]] {
    let len = WeightFile::vesper_tensor_file_len();
    if len == NO_LENGTH {
        return OPEN_NO_STAT;
    }
    if len > MAX_WEIGHT_FILE_BYTES {
        return OPEN_TOO_LARGE;
    }
    if len == 0 {
        return OPEN_EMPTY;
    }
    if WeightFile::vesper_tensor_file_map() != 0 {
        return OPEN_MAP_FAILED;
    }
    OPEN_MAPPED
}
