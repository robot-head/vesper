    sample_top_p as s_sample_top_p
};
use self::shape::{
    gqa_ratio as d_gqa_ratio,
    normalize as d_normalize
};

// Q4_K super-blocks (src/formats.rs `QK_K`, `Q4_K_BYTES`) and the scratch
// `qk::quantize_block` needs (its `S_LEN` bytes and `W_LEN` words).
const QK_K: u64 = 256;
const Q4_K_BYTES: u64 = 144;
const Q4_K_SCRATCH_BYTES: u64 = 320;
const Q4_K_SCRATCH_WORDS: u64 = 48;
// E8M0 (OCP MX v1.0) reserves 255 for NaN.
const E8M0_NAN: u8 = 255;
// Binary32 -Inf, and the shift from BF16 to binary32 bits.
const F32_NEG_INFINITY: u32 = 4286578688;
const BF16_SHIFT: u32 = 16;
// Tokens per K/V page (src/kv.rs `TOKENS_PER_PAGE`).
const TOKENS_PER_PAGE: u64 = 16;
// `open_weights`: the `WeightFile` length that means stat failed, the
// largest file it maps (src/mmap.rs `MAX_WEIGHT_FILE_BYTES`, 64 GiB) and its
// result codes (src/mmap.rs `open_code`).
const NO_LENGTH: u64 = 18446744073709551615;
const MAX_WEIGHT_FILE_BYTES: u64 = 68719476736;
const OPEN_MAPPED: u64 = 0;
const OPEN_EMPTY: u64 = 1;
const OPEN_NO_STAT: u64 = 2;
const OPEN_TOO_LARGE: u64 = 3;
const OPEN_MAP_FAILED: u64 = 4;

// A typed failure; src/port.rs maps it to the crate's `Error` with the
// message the Rust build uses at that call.
pub copy enum Fault {
    Shape,
    NonFinite,
    Limit,
    NoSpacePiece,
    NoBytePiece,
    Format
}

// binary16 / BF16 (src/quant.rs `encode_fp16`, `encode_bf16`,
// `decode_bf16`; src/host.rs `decode_fp16`).
pub fn decode_fp16(bits: u16) -> u32 eff [Fail[ArithOverflow]] {
    to_bits_f32(h_decode_fp16(bits))
}

pub fn encode_fp16(value: u32) -> u16 eff [Fail[ArithOverflow]] {
    h_encode_fp16(from_bits_f32(value))
}

pub fn encode_bf16(value: u32) -> u16 eff [Fail[ArithOverflow]] {
    h_encode_bf16(from_bits_f32(value))
}

pub fn decode_bf16(bits: u16) -> u32 eff [Fail[ArithOverflow]] {
    to_bits_f32(h_decode_bf16(bits))
}

// src/formats.rs scalars.
pub fn nearest_int(value: u32) -> i32 eff [Fail[ArithOverflow]] {
    f_nearest_int(from_bits_f32(value))
}

pub fn e8m0_half(e: u8) -> u32 eff [Fail[ArithOverflow]] {
    to_bits_f32(f_e8m0_half(e))
}

pub fn fp8_decode(e5m2: bool, code: u8) -> u32 eff [Fail[ArithOverflow]] {
    to_bits_f32(f_fp8_decode(e5m2, code))
}

pub fn fp8_encode(e5m2: bool, value: u32) -> u8 eff [Fail[ArithOverflow]] {
    f_fp8_encode(e5m2, from_bits_f32(value))
}

// Q4_K (src/formats.rs).
pub fn q4_k_scale_min(j: u64, in scales: Slice[u8])
    -> (u8, u8) eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    scale_min(j, in scales)
}

pub fn dequantize_q4_k_block(in block: Slice[u8], inout out: Slice[u32]) eff [
    Fail[ArithOverflow],
    Fail[RuntimeError]
] {
    dequantize_block(in block, inout out, 0);
}

pub fn check_q4_k_block(in block: Slice[u8]) -> bool eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    check_block(in block)
}

pub fn make_qkx2_quants(
    nmax: i32,
    in x: Slice[u32],
    in weights: Slice[u32],
    inout l: Slice[u8],
    inout laux: Slice[u8],
    rmin: u32,
    rdelta: u32,
    nstep: i32,
    use_mad: bool
) -> (u32, u32) eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    make_qkx2(
        nmax,
        in x,
        in weights,
        inout l,
        inout laux,
        from_bits_f32(rmin),
        from_bits_f32(rdelta),
        nstep,
        use_mad
    )
}

// One super-block of `QK_K` values: the `Q4_K_BYTES` block bytes.
pub fn quantize_q4_k_block(in x: Slice[u32])
    -> ChunkSeq[u8] eff [Fail[ArithOverflow], Fail[RuntimeError]] {
    let mut out = ChunkSeq::with_capacity[u8](Q4_K_BYTES);
    let mut s = ChunkSeq::new[u8]();
    for i in u64_zero()..Q4_K_SCRATCH_BYTES {
        s.push(0);
    }
    let mut w = ChunkSeq::new[u32]();
    for i in u64_zero()..Q4_K_SCRATCH_WORDS {
        w.push(0);
    }
    quantize_block(in x, 0, inout out, inout s.as_slice_mut(), inout w.as_slice_mut());
    out
}

// Rows of super-blocks; `Fault::Limit` when a scale exceeds binary16.
pub fn quantize_q4_k(in data: Slice[u32], cols: u64)
    -> ChunkSeq[u8] eff [Fail[ArithOverflow], Fail[RuntimeError], Fail[Fault]] {
    check_rows(in data, cols, QK_K);
    let blocks = data.len() / QK_K;
    let mut out = ChunkSeq::with_capacity[u8](blocks * Q4_K_BYTES);
    let mut s = ChunkSeq::new[u8]();
    for i in u64_zero()..Q4_K_SCRATCH_BYTES {
        s.push(0);
    }
    let mut w = ChunkSeq::new[u32]();
    for i in u64_zero()..Q4_K_SCRATCH_WORDS {
        w.push(0);
    }
    for b in 0..blocks {
        quantize_block(
            in data,
            QK_K * b,
            inout out,
            inout s.as_slice_mut(),
            inout w.as_slice_mut()
        );
        if !check_block(in out[b * Q4_K_BYTES..b * Q4_K_BYTES + Q4_K_BYTES]) {
            Fail::raise(Fault::Limit);
        }
    }
    out
}

