load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@vesper_cargo//:packages.bzl", "PACKAGES")
load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The Rust build is the default (default features, generated by
# vesper_crate below). The Vesper port (the Loom package in vesper/, Cargo
# feature `vesper-port`, port wave P3b lane 9, #1071) is non-default until it
# reaches parity. The compiler and vesper-fusion link neither: they link the
# Rust seed copy, //crates/vesper-resonance/seed (seed-copy rule,
# docs/maintenance/porting-a-crate.md).
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
)

vesper_port_object(
    name = "resonance_vesper",
    library = "resonance",
    package = ":port_package",
    target = VESPER_TARGET,
)

filegroup(
    name = "resonance_vesper_binding",
    srcs = [":resonance_vesper"],
    output_group = "rust_binding",
)

# The default crate's build script gets no port object (as vesper-bench):
# the port is built only by :port and its tests.
vesper_crate(
    # Lean resolves symlinked runfiles to the source tree and then rejects
    # them as outside --root, so these run in a copy of regular files.
    copy_test_cwd = ["test/lean_model"],
    extra_test_data = ["//:lean"],
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
]))

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-resonance/seed:__pkg__"],
)

# The Vesper build: the same sources with cfg(vesper_port), forwarding to
# the port through the committed binding (which the Cargo build checks
# against the generated one), and the crate's tests run unchanged against
# it. The object is linked into each test binary. The divergent builds and
# the realtime verifier proof run in Cargo, in the Linux "Vesper ports" job
# (crates/vesper-resonance/port/test-port.sh).
_CRATE_DATA = PACKAGES["crates/vesper-resonance"].crate_data()

_NORMAL = all_crate_deps(
    _CRATE_DATA,
    normal = True,
    platforms = _CRATE_DATA["platforms"],
)

_DEV = all_crate_deps(
    _CRATE_DATA,
    normal_dev = True,
    platforms = _CRATE_DATA["platforms"],
)

rust_library(
    name = "port",
    srcs = glob(["src/**/*.rs"]) + ["port/binding.rs"],
    crate_features = ["vesper-port"],
    crate_name = "vesper_resonance",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = ["--cfg=vesper_port"],
    deps = ["//crates/vesper-port-abi"] + _NORMAL,
)

# The in-crate unit tests of the port build, compiled from the same sources
# as :port (a `crate = ":port"` test does not find the crate root here).
rust_test(
    name = "port_unit_test",
    srcs = glob(["src/**/*.rs"]) + ["port/binding.rs"],
    compile_data = [":resonance_vesper"],
    crate_features = ["vesper-port"],
    crate_name = "vesper_resonance",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = [
        "--cfg=vesper_port",
        "-Clink-arg=$(location :resonance_vesper)",
    ],
    aliases = _CRATE_DATA["aliases"],
    deps = ["//crates/vesper-port-abi"] + _NORMAL + _DEV,
)

[
    rust_test(
        name = "port_%s_test" % t,
        srcs = ["tests/%s.rs" % t],
        aliases = _CRATE_DATA["aliases"],
        compile_data = [":resonance_vesper"],
        crate_features = ["vesper-port"],
        crate_name = t,
        edition = "2024",
        rustc_flags = ["-Clink-arg=$(location :resonance_vesper)"],
        deps = [":port"] + _NORMAL + _DEV,
    )
    for t in [
        "alloc",
        "confinement",
        "cranelift",
        "denorm",
        "pdc",
        "port_differential",
        "realtime",
        "simd",
        "slab",
        "spsc_stress",
        "stability",
    ]
]
