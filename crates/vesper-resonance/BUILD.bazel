load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The port-backed package (seed-copy rule, docs/maintenance/porting-a-crate.md;
# port wave P3b lane 9, #1071, flipped by SH6 lane 9, #1404): build.rs links
# the object built here from the Loom package in vesper/ and checks
# port/binding.rs against the generated binding. The compiler and
# vesper-fusion link the Rust seed copy, //crates/vesper-resonance/seed,
# instead. The divergent builds and the realtime verifier proof run in Cargo
# (aspect crate resonance test-port).
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
    visibility = ["//visibility:public"],
)

vesper_port_object(
    name = "resonance_vesper",
    library = "resonance",
    package = ":port_package",
    target = VESPER_TARGET,
)

filegroup(
    name = "resonance_vesper_binding",
    srcs = [":resonance_vesper"],
    output_group = "rust_binding",
)

vesper_crate(
    build_script_data = [
        ":resonance_vesper",
        ":resonance_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :resonance_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :resonance_vesper_binding)",
    },
    # Lean resolves symlinked runfiles to the source tree and then rejects
    # them as outside --root, so these run in a copy of regular files.
    copy_test_cwd = ["test/lean_model"],
    extra_test_data = ["//:lean"],
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
]))

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-resonance/seed:__pkg__"],
)
