# The frozen Rust seed copy of vesper-resonance (package
# vesper-resonance-seed, library vesper_resonance) that the compiler links:
# ../src built without the port, so cfg(vesper_port) is off. Written by hand
# because its sources live in the parent package; see "Crates the compiler
# links" in docs/maintenance/porting-a-crate.md.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("@vesper_cargo//:packages.bzl", "PACKAGES")

# The seed's external dependencies (cranelift-codegen and rtrb, and
# cranelift-frontend for the tests), from its Cargo metadata as vesper_crate
# derives them.
_DATA = PACKAGES["crates/vesper-resonance/seed"].crate_data()

_NORMAL = all_crate_deps(_DATA, platforms = _DATA["platforms"], normal = True)

_DEV = all_crate_deps(_DATA, platforms = _DATA["platforms"], normal_dev = True)

rust_library(
    name = "seed",
    srcs = ["//crates/vesper-resonance:rust_srcs"],
    crate_name = "vesper_resonance",
    crate_root = "//crates/vesper-resonance:src/lib.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_PKG_NAME": "vesper-resonance-seed",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = _NORMAL,
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    edition = "2024",
    deps = _DEV,
)

[
    rust_test(
        name = "seed_test_" + t,
        srcs = ["//crates/vesper-resonance:tests/%s.rs" % t],
        crate_root = "//crates/vesper-resonance:tests/%s.rs" % t,
        edition = "2024",
        deps = [":seed"] + _NORMAL + _DEV,
    )
    for t in [
        "alloc",
        "confinement",
        "cranelift",
        "denorm",
        "pdc",
        "realtime",
        "simd",
        "slab",
        "spsc_stress",
        "stability",
    ]
]

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
