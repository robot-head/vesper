// Module graph of @vesper/resonance (see lib.ves): a compiled graph whose
// processors are `Box[dyn DspProcessor]` objects in one sequence, run block
// by block as `CompiledGraph::process_block` runs them (src/pdc.rs).
//
// A `Box[dyn Trait]` cannot cross the export ABI (it has no fixed word
// layout), so the Rust `CompiledGraph`, whose processors are Rust trait
// objects, stays a Rust loop over the ported kernels. This module runs the
// built-in processors (a deterministic source, `MixGain` and `LatentMix`)
// entirely in Vesper, for the differential test and the ABBA benchmark.
use self::pdc::{
    Header,
    Input,
    InputKind,
    Line,
    Op,
    PdcCode,
    Words,
    p_compile
};
use self::seqs::{
    at,
    get
};
use self::slab::{
    SlabWords,
    Totals,
    s_advance,
    s_delays,
    s_read,
    s_write
};
use self::{
    SlabFault
};

// `DspProcessor`: one block from the input buffers `ins` of `slab` (each
// `block` samples at `buffer * block`) into `out`.
trait DspProcessor {
    fn process(
        inout self,
        in slab: ChunkSeq[u32],
        in ins: ChunkSeq[u64],
        block: u64,
        inout out: ChunkSeq[u32]
    ) eff [Fail[RuntimeError], Fail[ArithOverflow]];
}

// The test graphs' deterministic source (tests/pdc.rs `Generator`): sample t
// is ((t * GEN_STEP + seed * GEN_SEED_STEP) % GEN_MODULUS) / GEN_MODULUS -
// 0.5.
const GEN_STEP: u64 = 7919;
const GEN_SEED_STEP: u64 = 31;
const GEN_MODULUS: u64 = 97;
const GEN_SCALE: f32 = 97.0;
const GEN_BIAS: f32 = 0.5;

// A processor's kind in `kinds` (two words per node: kind, parameter).
enum Kind: _ {
    Source,
    Latent,
    Gain
}

const KIND_WORDS: u64 = 2;

struct Source {
    seed: u64,
    t: u64
}

impl DspProcessor for Source {
    fn process(
        inout self,
        in slab: ChunkSeq[u32],
        in ins: ChunkSeq[u64],
        block: u64,
        inout out: ChunkSeq[u32]
    ) eff [Fail[RuntimeError], Fail[ArithOverflow]] {
        for k in 0..block {
            let step = wrapping_mul(self.t, GEN_STEP);
            let x = wrapping_add(step, wrapping_mul(self.seed, GEN_SEED_STEP)) % GEN_MODULUS;
            out.set(k, to_bits_f32(nearest_f32(x) / GEN_SCALE - GEN_BIAS));
            self.t = wrapping_add(self.t, 1);
        }
    }
}

// `MixGain`: the sum of the inputs, times the gain.
struct Gain {
    gain: f32
}

fn sum_inputs(
    in slab: ChunkSeq[u32],
    in ins: ChunkSeq[u64],
    block: u64,
    inout out: ChunkSeq[u32]
) eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    for k in 0..block {
        out.set(k, 0);
    }
    for i in 0..ins.len() {
        let base = ins[i] * block;
        for k in 0..block {
            let v = from_bits_f32(out[k]) + from_bits_f32(slab[base + k]);
            out.set(k, to_bits_f32(v));
        }
    }
}

impl DspProcessor for Gain {
    fn process(
        inout self,
        in slab: ChunkSeq[u32],
        in ins: ChunkSeq[u64],
        block: u64,
        inout out: ChunkSeq[u32]
    ) eff [Fail[RuntimeError], Fail[ArithOverflow]] {
        sum_inputs(in slab, in ins, block, inout out);
        for k in 0..block {
            let v = from_bits_f32(out[k]) * self.gain;
            out.set(k, to_bits_f32(v));
        }
    }
}

// `LatentMix`: the sum of the inputs, delayed by the node's latency
// (`DelayLine`: a ring of `delay + block` samples).
struct Latent {
    ring: ChunkSeq[u32],
    delay: u64,
    head: u64,
    sum: ChunkSeq[u32]
}

impl DspProcessor for Latent {
    fn process(
        inout self,
        in slab: ChunkSeq[u32],
        in ins: ChunkSeq[u64],
        block: u64,
        inout out: ChunkSeq[u32]
    ) eff [Fail[RuntimeError], Fail[ArithOverflow]] {
        if self.delay == 0 {
            sum_inputs(in slab, in ins, block, inout out);
            return;
        }
        sum_inputs(in slab, in ins, block, inout self.sum);
        let len = self.ring.len();
        for k in 0..block {
            self.ring.set((self.head + k) % len, self.sum[k]);
        }
        let start = self.head + len - self.delay;
        for k in 0..block {
            out.set(k, self.ring[(start + k) % len]);
        }
        self.head = (self.head + block) % len;
    }
}

fn zeros(n: u64) -> ChunkSeq[u32] {
    let mut s: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](n);
    for i in 0..n {
        s.push(0);
    }
    s
}

// One processor per node: `kinds` holds KIND_WORDS words per node, the
// `Kind` (a source with its seed, a latent mix with the node's latency, a
// gain with f32 bits) and its parameter.
fn processors(in kinds: Slice[u64], in g: Slice[u64], n: u64, block: u64)
    -> ChunkSeq[Box[dyn DspProcessor]] eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    let mut procs: ChunkSeq[Box[dyn DspProcessor]] = ChunkSeq::new();
    for i in 0..n {
        let kind = at(in kinds, i * KIND_WORDS);
        let p = at(in kinds, i * KIND_WORDS + 1);
        if kind == Kind::Source {
            procs
                .push(
                    Box::new[dyn DspProcessor](
                        Source {
                            seed: p,
                            t: 0
                        }
                    )
                );
        } else if kind == Kind::Latent {
            let delay = at(in g, i * Words::Node + 1);
            procs
                .push(
                    Box::new[dyn DspProcessor](
                        Latent {
                            ring: zeros(delay + block),
                            delay: delay,
                            head: 0,
                            sum: zeros(block)
                        }
                    )
                );
        } else {
            procs
                .push(
                    Box::new[dyn DspProcessor](
                        Gain {
                            gain: from_bits_f32(narrow_u32(p))
                        }
                    )
                );
        }
    }
    procs
}

// The run state: the schedule words, the block buffers and the packed delay
// lines (the layout of `DelaySlab`, `SlabWords::Line` metadata words per line).
struct Run {
    sched: ChunkSeq[u64],
    slab: ChunkSeq[u32],
    lines: ChunkSeq[u32],
    slots: ChunkSeq[u64],
    ins: ChunkSeq[u64],
    out: ChunkSeq[u32],
    scratch: ChunkSeq[u32],
    block: u64
}

// One block: `CompiledGraph::process_block`.
fn run_block(inout r: Run, inout procs: ChunkSeq[Box[dyn DspProcessor]]) eff [
    Fail[RuntimeError],
    Fail[ArithOverflow]
] {
    let block = r.block;
    let nops = get(in r.sched, Header::OpCount);
    let mut k: u64 = Words::Header;
    for o in 0..nops {
        let spec = get(in r.sched, k + Op::Spec);
        let output = get(in r.sched, k + Op::Output);
        let count = get(in r.sched, k + Op::InputCount);
        k = k + Words::Op;
        r.ins.clear();
        for j in 0..count {
            let kind = get(in r.sched, k);
            let buffer = get(in r.sched, k + Input::Buffer);
            let has_line = get(in r.sched, k + Input::HasLine);
            let line = get(in r.sched, k + Input::Line);
            let scratch = get(in r.sched, k + Input::Scratch);
            if kind == InputKind::Forward && has_line == 1 {
                s_write(
                    inout r.lines.as_slice(),
                    0,
                    in r.slots.as_slice(),
                    line,
                    in r.slab[buffer * block..buffer * block + block]
                );
                s_read(
                    in r.lines.as_slice(),
                    0,
                    in r.slots.as_slice(),
                    line,
                    inout r.scratch.as_slice()
                );
                r.slab.copy_from(scratch * block, in r.scratch.as_slice());
                r.ins.push(scratch);
            } else if kind == InputKind::Feedback {
                s_read(
                    in r.lines.as_slice(),
                    0,
                    in r.slots.as_slice(),
                    line,
                    inout r.scratch.as_slice()
                );
                r.slab.copy_from(scratch * block, in r.scratch.as_slice());
                r.ins.push(scratch);
            } else {
                r.ins.push(buffer);
            }
            k = k + Words::Input;
        }
        procs[spec].process(in r.slab, in r.ins, block, inout r.out);
        r.slab.copy_from(output * block, in r.out.as_slice());
        let nfeeds = get(in r.sched, k);
        for f in 0..nfeeds {
            let line = get(in r.sched, k + 1 + f);
            s_write(inout r.lines.as_slice(), 0, in r.slots.as_slice(), line, in r.out.as_slice());
        }
        k = k + 1 + nfeeds;
    }
    s_advance(inout r.slots.as_slice(), block);
}

fn run_blocks(inout r: Run, inout procs: ChunkSeq[Box[dyn DspProcessor]], blocks: u64) eff [
    Fail[RuntimeError],
    Fail[ArithOverflow]
] {
    for b in 0..blocks {
        run_block(inout r, inout procs);
    }
}

// Runs `blocks` blocks of the graph and returns the schedule status, then
// (when it is 0) the output block of node `sink` (the spec index) of the
// last block, as f32 bits. Feedback edges must be at least one block long,
// as `CompiledGraph::new` requires.
pub fn g_render(
    in g: Slice[u64],
    n: u64,
    in kinds: Slice[u64],
    block: u64,
    blocks: u64,
    sink_node: u64
) -> ChunkSeq[u64] eff [Fail[RuntimeError], Fail[ArithOverflow], Fail[SlabFault]] {
    let sched = p_compile(in g, n);
    let mut result: ChunkSeq[u64] = ChunkSeq::new();
    if get(in sched, Header::Status) != PdcCode::Ok {
        result.push(get(in sched, Header::Status));
        return result;
    }
    let buffers = get(in sched, Header::BufferCount);
    let nlines = get(in sched, Header::LineCount);
    let mut delays: ChunkSeq[u32] = ChunkSeq::new();
    // Lines follow the ops; find the op of the sink on the way.
    let mut k: u64 = Words::Header;
    let mut sink_buffer: u64 = 0;
    for o in 0..get(in sched, Header::OpCount) {
        if get(in sched, k + Op::Spec) == sink_node {
            sink_buffer = get(in sched, k + Op::Output);
        }
        k = k + Words::Op + get(in sched, k + Op::InputCount) * Words::Input;
        k = k + 1 + get(in sched, k);
    }
    for l in 0..nlines {
        delays.push(narrow_u32(get(in sched, k + l * Words::Line + Line::Delay)));
    }
    let layout = s_delays(in delays.as_slice(), block);
    let mut slots: ChunkSeq[u64] = ChunkSeq::new();
    let meta = nlines * SlabWords::Line;
    for w in 0..meta {
        slots.push(get(in layout, w));
    }
    let mut r = Run {
        sched: sched,
        slab: zeros(buffers * block),
        lines: zeros(get(in layout, meta + Totals::Length)),
        slots: slots,
        ins: ChunkSeq::new(),
        out: zeros(block),
        scratch: zeros(block),
        block: block
    };
    let mut procs = processors(in kinds, in g, n, block);
    run_blocks(inout r, inout procs, blocks);
    result.push(PdcCode::Ok);
    for i in 0..block {
        result.push(widen_u64(r.slab[sink_buffer * block + i]));
    }
    result
}
