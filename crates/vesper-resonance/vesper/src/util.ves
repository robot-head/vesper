// Module util of @vesper/resonance (see lib.ves): float predicates.

// An f32's exponent bits: all set for infinities and NaNs.
const F32_EXPONENT: u32 = 2139095040;

// Whether the f32 with bits `b` is finite.
pub fn finite_bits(b: u32) -> bool {
    b & F32_EXPONENT != F32_EXPONENT
}

pub fn is_finite(v: f32) -> bool {
    finite_bits(to_bits_f32(v))
}
