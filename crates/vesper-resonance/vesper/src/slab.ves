// Module slab of @vesper/resonance (see lib.ves): the geometry of the
// block-buffer slab (`TiledSlab::new`) and the packed delay lines of
// src/slab.rs (`DelaySlab`).
//
// The Rust wrapper owns the 64-byte-aligned `Vec<f32>` (alignment is a
// property of its address) and lends it as bits with its base offset. A
// delay line's metadata is five words: offset, delay, capacity, stride and
// head.
use self::{
    SlabFault
};
use self::seqs::{
    at
};

fn isize_max() -> u64 {
    9223372036854775807
}

fn umax() -> u64 {
    18446744073709551615
}

// `n` rounded up to whole 16-sample tiles, or `None` on overflow.
fn tiles(n: u64) -> Option[u64] eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    if n > wrapping_sub(umax(), 15) {
        return Option::None;
    }
    Option::Some(wrapping_add(n, 15) / 16 * 16)
}

// Whether a slab of `len` samples has a byte size of at most `isize::MAX`.
fn fits_bytes(len: u64) -> bool {
    len <= isize_max() / 4
}

// `TiledSlab::new`: the stride and the allocation length in samples.
pub fn s_tiled(buffers: u64, block: u64)
    -> (u64, u64) eff [Fail[RuntimeError], Fail[ArithOverflow], Fail[SlabFault]] {
    let stride = match tiles(block) {
        Option::Some(s) => s,
        Option::None => {
            Fail::raise(SlabFault::TooLarge(buffers, block));
            0
        },
    };
    if stride != 0 && buffers > umax() / stride {
        Fail::raise(SlabFault::TooLarge(buffers, block));
    }
    let used = wrapping_mul(buffers, stride);
    if used > wrapping_sub(umax(), 15) {
        Fail::raise(SlabFault::TooLarge(buffers, block));
    }
    let len = wrapping_add(used, 15);
    if !fits_bytes(len) {
        Fail::raise(SlabFault::TooLarge(buffers, block));
    }
    (stride, len)
}

// `DelaySlab::new`: five metadata words per line, then the total stride and
// the allocation length (0 and 0 without lines).
pub fn s_delays(in delays: Slice[u32], block: u64)
    -> ChunkSeq[u64] eff [Fail[RuntimeError], Fail[ArithOverflow], Fail[SlabFault]] {
    let n = delays.len();
    if block == 0 {
        Fail::raise(SlabFault::TooLarge(n, block));
    }
    let mut out: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](wrapping_add(wrapping_mul(n, 5), 2));
    if n == 0 {
        out.push(0);
        out.push(0);
        return out;
    }
    let mut total: u64 = 0;
    for i in 0..n {
        let delay = match delays.try_get(i) {
            Option::Some(d) => widen_u64(d),
            Option::None => 0,
        };
        if delay > wrapping_sub(umax(), block) {
            Fail::raise(SlabFault::TooLarge(n, block));
        }
        let cap = wrapping_add(delay, block);
        let stride = match tiles(cap) {
            Option::Some(s) => s,
            Option::None => {
                Fail::raise(SlabFault::TooLarge(n, block));
                0
            },
        };
        out.push(total);
        out.push(delay);
        out.push(cap);
        out.push(stride);
        out.push(0);
        if total > wrapping_sub(umax(), stride) {
            Fail::raise(SlabFault::TooLarge(n, block));
        }
        total = wrapping_add(total, stride);
    }
    if total > wrapping_sub(umax(), 15) {
        Fail::raise(SlabFault::TooLarge(n, block));
    }
    let len = wrapping_add(total, 15);
    if !fits_bytes(len) {
        Fail::raise(SlabFault::TooLarge(n, block));
    }
    out.push(total);
    out.push(len);
    out
}

// `DelaySlab::write`: `input` into `line` at its head (nothing for a line
// that does not exist).
pub fn s_write(
    inout data: Slice[u32],
    base: u64,
    in slots: Slice[u64],
    line: u64,
    in input: Slice[u32]
) eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    if line >= slots.len() / 5 {
        return;
    }
    let m = line * 5;
    let start = base + slots[m];
    let cap = slots[m + 2];
    let head = slots[m + 4];
    let n = input.len();
    if n <= cap {
        let mut first = cap - head;
        if n < first {
            first = n;
        }
        data.copy_from(start + head, in input[0..first]);
        if first < n {
            data.copy_from(start, in input[first..n]);
        }
    } else {
        for k in 0..n {
            data.set(start + (head + k) % cap, input[k]);
        }
    }
}

// `DelaySlab::read`: `line`'s delayed samples into `out`.
pub fn s_read(
    in data: Slice[u32],
    base: u64,
    in slots: Slice[u64],
    line: u64,
    inout out: Slice[u32]
) eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    if line >= slots.len() / 5 {
        return;
    }
    let m = line * 5;
    let ring = base + slots[m];
    let delay = slots[m + 1];
    let cap = slots[m + 2];
    let head = slots[m + 4];
    let start = if head >= delay {
        head - delay
    } else if delay <= cap {
        head + cap - delay
    } else {
        (head + cap - delay % cap) % cap
    };
    let n = out.len();
    if n <= cap {
        let mut first = cap - start;
        if n < first {
            first = n;
        }
        out.copy_from(0, in data[ring + start..ring + start + first]);
        if first < n {
            out.copy_from(first, in data[ring..ring + n - first]);
        }
    } else {
        for k in 0..n {
            out.set(k, data[ring + (start + k) % cap]);
        }
    }
}

// `DelaySlab::advance_all`.
pub fn s_advance(inout slots: Slice[u64], block: u64) eff [
    Fail[RuntimeError],
    Fail[ArithOverflow]
] {
    let lines = slots.len() / 5;
    for line in 0..lines {
        let m = line * 5;
        let cap = slots[m + 2];
        let next = slots[m + 4] + block;
        if next < cap {
            slots.set(m + 4, next);
        } else {
            slots.set(m + 4, next % cap);
        }
    }
}
