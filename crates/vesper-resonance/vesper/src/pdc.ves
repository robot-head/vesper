// Module pdc of @vesper/resonance (see lib.ves): the delay-compensated
// schedule compiler of src/pdc.rs (`compile_schedule`), the block delay line
// (`DelayLine`) and the block kernels of the built-in processors.
//
// The graph crosses as one word slice: node i is the four words at 4 i (id,
// latency, first input, input count), and input j is the three words at
// 4 n + 3 j (0 forward or 1 feedback, the source id, the delay). The result
// is a word sequence whose first word is 0 or an error code:
//
// - 0: buffer count, op count, line count, then each op (node id, spec
//   index, output buffer, arrival latency, output latency, input count,
//   seven words per input, feed count, the feeds), then each line (source
//   id, delay, 1 for feedback).
//   An input is kind (0 forward, 1 feedback), source id, compensation or
//   delay, buffer, 1 when it has a line, line, scratch buffer.
// - 1 DuplicateNode(id), 2 UnknownNode(id), 3 CycleWithoutDelay(count,
//   ids), 4 ZeroDelayFeedback(from, to), 5 LatencyOverflow(id).
use self::{
    PdcFault
};
use self::seqs::{
    at,
    filled,
    get,
    heap_pop,
    heap_push,
    set,
    sort
};

// No index, buffer or reader.
const NONE: u64 = 18446744073709551615;

// The record sizes, in words: graph nodes, then the schedule's header, ops,
// inputs and lines (an enum, not consts: other modules import them, and an
// imported const is a call where an enum member is a literal).
pub enum Words: _ {
    Node = 4,
    Header = 4,
    Op = 6,
    Input = 7,
    Line = 3
}

// The graph slice: a node's words, then an input's.
enum Node: _ {
    Id,
    Latency,
    FirstInput,
    InputCount
}

enum GraphInput: _ {
    Kind,
    Source,
    Delay
}

const GRAPH_INPUT_WORDS: u64 = 3;

// An input's kind, in the graph and in the schedule.
pub enum InputKind: _ {
    Forward,
    Feedback
}

// The schedule's first word.
pub enum PdcCode: _ {
    Ok,
    DuplicateNode,
    UnknownNode,
    CycleWithoutDelay,
    ZeroDelayFeedback,
    LatencyOverflow
}

// The schedule's header words.
pub enum Header: _ {
    Status,
    BufferCount,
    OpCount,
    LineCount
}

// An op's header words; its inputs and feeds follow.
pub enum Op: _ {
    NodeId,
    Spec,
    Output,
    Arrival,
    OutputLatency,
    InputCount
}

// A scheduled input's words.
pub enum Input: _ {
    Kind,
    Source,
    // The compensation (forward) or the delay (feedback).
    Delay,
    Buffer,
    HasLine,
    Line,
    Scratch
}

// A line's words: source id, delay, then 1 for feedback.
pub enum Line: _ {
    Source,
    Delay,
    Feedback
}

// A feed is (source spec index, line).
const FEED_WORDS: u64 = 2;

// A sort key is (id << KEY_SHIFT | index); a compensation must fit u32.
const KEY_SHIFT: u64 = 32;
const INDEX_MASK: u64 = 4294967295;
const U32_MAX: u64 = 4294967295;

// `MAX_DELAY_SAMPLES`.
const MAX_DELAY_SAMPLES: u64 = 16777216;

fn fail1(code: u64, a: u64) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new();
    out.push(code);
    out.push(a);
    out
}

fn fail2(code: u64, a: u64, b: u64) -> ChunkSeq[u64] {
    let mut out = fail1(code, a);
    out.push(b);
    out
}

// The spec index of node `id`, or `NONE`: a binary search of `keys`, the
// sorted (id << KEY_SHIFT | index) words.
fn index_of(in keys: ChunkSeq[u64], id: u64) -> u64 {
    let mut lo: u64 = 0;
    let mut hi = keys.len();
    loop {
        if lo >= hi {
            return NONE;
        }
        let mid = wrapping_add(lo, wrapping_sub(hi, lo) / 2);
        let k = get(in keys, mid);
        let kid = k >> KEY_SHIFT;
        if kid == id {
            return k & INDEX_MASK;
        }
        if kid < id {
            lo = wrapping_add(mid, 1);
        } else {
            hi = mid;
        }
    }
}

fn node_id(in g: Slice[u64], i: u64) -> u64 {
    at(in g, wrapping_mul(i, Words::Node))
}

fn node_latency(in g: Slice[u64], i: u64) -> u64 {
    at(in g, wrapping_add(wrapping_mul(i, Words::Node), Node::Latency))
}

fn node_first(in g: Slice[u64], i: u64) -> u64 {
    at(in g, wrapping_add(wrapping_mul(i, Words::Node), Node::FirstInput))
}

fn node_count(in g: Slice[u64], i: u64) -> u64 {
    at(in g, wrapping_add(wrapping_mul(i, Words::Node), Node::InputCount))
}

// Word `w` (`GraphInput`) of input `j`.
fn input_word(in g: Slice[u64], n: u64, j: u64, w: u64) -> u64 {
    at(
        in g,
        wrapping_add(
            wrapping_add(wrapping_mul(n, Words::Node), wrapping_mul(j, GRAPH_INPUT_WORDS)),
            w
        )
    )
}

// `compile_schedule`.
pub fn p_compile(in g: Slice[u64], n: u64) -> ChunkSeq[u64] {
    // Ids, and the first duplicate in spec order.
    let mut keys: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    for i in 0..n {
        keys.push((node_id(in g, i) << KEY_SHIFT) | i);
    }
    sort(inout keys);
    let mut dup = NONE;
    for k in 1..n {
        let a = get(in keys, wrapping_sub(k, 1));
        let b = get(in keys, k);
        if a >> KEY_SHIFT == b >> KEY_SHIFT {
            let i = b & INDEX_MASK;
            if i < dup {
                dup = i;
            }
        }
    }
    if dup != NONE {
        return fail1(PdcCode::DuplicateNode, node_id(in g, dup));
    }

    // Forward in-degrees and dependents (in spec order, as the Rust build
    // pushes them); the first unknown source or zero-delay feedback.
    // Each input's source as a spec index, found once (`srcs`, by input).
    let mut ninputs: u64 = 0;
    for i in 0..n {
        let end = wrapping_add(node_first(in g, i), node_count(in g, i));
        if end > ninputs {
            ninputs = end;
        }
    }
    let mut srcs = filled(ninputs, NONE);
    let mut indegree = filled(n, 0);
    let mut dep_count = filled(wrapping_add(n, 1), 0);
    for i in 0..n {
        let first = node_first(in g, i);
        for j in first..wrapping_add(first, node_count(in g, i)) {
            let src = input_word(in g, n, j, GraphInput::Source);
            let s = index_of(in keys, src);
            if s == NONE {
                return fail1(PdcCode::UnknownNode, src);
            }
            set(inout srcs, j, s);
            if input_word(in g, n, j, GraphInput::Kind) == InputKind::Forward {
                let v_w = wrapping_add(get(in indegree, i), 1);
                set(inout indegree, i, v_w);
                let v_w = wrapping_add(get(in dep_count, s), 1);
                set(inout dep_count, s, v_w);
            } else if input_word(in g, n, j, GraphInput::Delay) == 0 {
                return fail2(PdcCode::ZeroDelayFeedback, src, node_id(in g, i));
            }
        }
    }
    let mut dep_start = filled(wrapping_add(n, 1), 0);
    for s in 0..n {
        let v_w = wrapping_add(get(in dep_start, s), get(in dep_count, s));
        set(inout dep_start, wrapping_add(s, 1), v_w);
    }
    let mut dep_fill = filled(n, 0);
    let mut dependents = filled(get(in dep_start, n), 0);
    for i in 0..n {
        let first = node_first(in g, i);
        for j in first..wrapping_add(first, node_count(in g, i)) {
            if input_word(in g, n, j, GraphInput::Kind) == InputKind::Forward {
                let s = get(in srcs, j);
                let at_s = wrapping_add(get(in dep_start, s), get(in dep_fill, s));
                set(inout dependents, at_s, i);
                let v_w = wrapping_add(get(in dep_fill, s), 1);
                set(inout dep_fill, s, v_w);
            }
        }
    }

    // Kahn's algorithm, lowest spec index first.
    let mut ready: ChunkSeq[u64] = ChunkSeq::new();
    for i in 0..n {
        if get(in indegree, i) == 0 {
            heap_push(inout ready, i);
        }
    }
    let mut order: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    loop {
        match heap_pop(inout ready) {
            Option::None => break,
            Option::Some(i) => {
                order.push(i);
                for k in get(in dep_start, i)..get(in dep_start, wrapping_add(i, 1)) {
                    let d = get(in dependents, k);
                    let left = wrapping_sub(get(in indegree, d), 1);
                    set(inout indegree, d, left);
                    if left == 0 {
                        heap_push(inout ready, d);
                    }
                }
            },
        }
    }
    if order.len() != n {
        let mut stuck: ChunkSeq[u64] = ChunkSeq::new();
        for i in 0..n {
            if get(in indegree, i) > 0 {
                stuck.push(node_id(in g, i));
            }
        }
        sort(inout stuck);
        let mut out = fail1(PdcCode::CycleWithoutDelay, stuck.len());
        for k in 0..stuck.len() {
            out.push(get(in stuck, k));
        }
        return out;
    }

    // Latencies.
    let mut out_lat = filled(n, 0);
    let mut arrival = filled(n, 0);
    for p in 0..n {
        let i = get(in order, p);
        let mut a: u64 = 0;
        let first = node_first(in g, i);
        for j in first..wrapping_add(first, node_count(in g, i)) {
            if input_word(in g, n, j, GraphInput::Kind) == InputKind::Forward {
                let l = get(in out_lat, get(in srcs, j));
                if l > a {
                    a = l;
                }
            }
        }
        set(inout arrival, i, a);
        let lat = node_latency(in g, i);
        if a > wrapping_sub(NONE, lat) {
            return fail1(PdcCode::LatencyOverflow, node_id(in g, i));
        }
        set(inout out_lat, i, wrapping_add(a, lat));
    }

    // Position of each node in the order, and its last forward reader.
    let mut pos = filled(n, 0);
    for p in 0..n {
        set(inout pos, get(in order, p), p);
    }
    let mut last_read = filled(n, NONE);
    for i in 0..n {
        let first = node_first(in g, i);
        for j in first..wrapping_add(first, node_count(in g, i)) {
            if input_word(in g, n, j, GraphInput::Kind) == InputKind::Forward {
                let s = get(in srcs, j);
                let lr = get(in last_read, s);
                let pi = get(in pos, i);
                if lr == NONE || pi > lr {
                    set(inout last_read, s, pi);
                }
            }
        }
    }
    // Sources whose last reader is position p, ascending.
    let mut die_count = filled(wrapping_add(n, 1), 0);
    for s in 0..n {
        let lr = get(in last_read, s);
        if lr != NONE {
            let v_w = wrapping_add(get(in die_count, lr), 1);
            set(inout die_count, lr, v_w);
        }
    }
    let mut die_start = filled(wrapping_add(n, 1), 0);
    for p in 0..n {
        let v_w = wrapping_add(get(in die_start, p), get(in die_count, p));
        set(inout die_start, wrapping_add(p, 1), v_w);
    }
    let mut die_fill = filled(n, 0);
    let mut dying = filled(get(in die_start, n), 0);
    for s in 0..n {
        let lr = get(in last_read, s);
        if lr != NONE {
            set(inout dying, wrapping_add(get(in die_start, lr), get(in die_fill, lr)), s);
            let v_w = wrapping_add(get(in die_fill, lr), 1);
            set(inout die_fill, lr, v_w);
        }
    }

    // Lines and linear-scan buffer coloring. `ops` holds each op's header
    // (node id, spec index, output, arrival, output latency, input count)
    // followed by its inputs; feeds are attached at the end.
    let mut lines: ChunkSeq[u64] = ChunkSeq::new();
    // (source spec index, line) per feedback line, in line order.
    let mut feeds: ChunkSeq[u64] = ChunkSeq::new();
    let mut free: ChunkSeq[u64] = ChunkSeq::new();
    let mut buffer_count: u64 = 0;
    let mut out_buf = filled(n, NONE);
    let mut ops: ChunkSeq[u64] = ChunkSeq::new();
    let mut temps: ChunkSeq[u64] = ChunkSeq::new();
    for p in 0..n {
        let i = get(in order, p);
        let count = node_count(in g, i);
        ops.push(node_id(in g, i));
        ops.push(i);
        let output_at = ops.len();
        ops.push(0);
        ops.push(get(in arrival, i));
        ops.push(get(in out_lat, i));
        ops.push(count);
        temps.clear();
        let first = node_first(in g, i);
        for j in first..wrapping_add(first, count) {
            let src = input_word(in g, n, j, GraphInput::Source);
            let s = get(in srcs, j);
            if input_word(in g, n, j, GraphInput::Kind) == InputKind::Forward {
                let comp = wrapping_sub(get(in arrival, i), get(in out_lat, s));
                if comp > U32_MAX {
                    return fail1(PdcCode::LatencyOverflow, node_id(in g, i));
                }
                ops.push(InputKind::Forward);
                ops.push(src);
                ops.push(comp);
                ops.push(get(in out_buf, s));
                if comp > 0 {
                    let scratch = alloc(inout free, inout buffer_count);
                    temps.push(scratch);
                    lines.push(src);
                    lines.push(comp);
                    lines.push(InputKind::Forward);
                    ops.push(1);
                    ops.push(wrapping_sub(lines.len() / Words::Line, 1));
                    ops.push(scratch);
                } else {
                    ops.push(0);
                    ops.push(0);
                    ops.push(0);
                }
            } else {
                let delay = input_word(in g, n, j, GraphInput::Delay);
                let scratch = alloc(inout free, inout buffer_count);
                temps.push(scratch);
                lines.push(src);
                lines.push(delay);
                lines.push(InputKind::Feedback);
                let line = wrapping_sub(lines.len() / Words::Line, 1);
                feeds.push(s);
                feeds.push(line);
                ops.push(InputKind::Feedback);
                ops.push(src);
                ops.push(delay);
                ops.push(scratch);
                ops.push(1);
                ops.push(line);
                ops.push(scratch);
            }
        }
        let output = alloc(inout free, inout buffer_count);
        set(inout ops, output_at, output);
        set(inout out_buf, i, output);
        for k in get(in die_start, p)..get(in die_start, wrapping_add(p, 1)) {
            heap_push(inout free, get(in out_buf, get(in dying, k)));
        }
        for k in 0..temps.len() {
            heap_push(inout free, get(in temps, k));
        }
    }

    let mut out: ChunkSeq[u64] = ChunkSeq::new();
    out.push(PdcCode::Ok);
    out.push(buffer_count);
    out.push(n);
    out.push(lines.len() / Words::Line);
    let mut at_op: u64 = 0;
    for p in 0..n {
        let spec = get(in ops, wrapping_add(at_op, Op::Spec));
        let count = get(in ops, wrapping_add(at_op, Op::InputCount));
        let words = wrapping_add(Words::Op, wrapping_mul(count, Words::Input));
        for k in 0..words {
            out.push(get(in ops, wrapping_add(at_op, k)));
        }
        at_op = wrapping_add(at_op, words);
        let mut nfeeds: u64 = 0;
        let pairs = feeds.len() / FEED_WORDS;
        for k in 0..pairs {
            if get(in feeds, wrapping_mul(k, FEED_WORDS)) == spec {
                nfeeds = wrapping_add(nfeeds, 1);
            }
        }
        out.push(nfeeds);
        for k in 0..pairs {
            if get(in feeds, wrapping_mul(k, FEED_WORDS)) == spec {
                out.push(get(in feeds, wrapping_add(wrapping_mul(k, FEED_WORDS), 1)));
            }
        }
    }
    for k in 0..lines.len() {
        out.push(get(in lines, k));
    }
    out
}

// A free buffer (the smallest), or a new one.
fn alloc(inout free: ChunkSeq[u64], inout count: u64) -> u64 {
    match heap_pop(inout free) {
        Option::Some(b) => b,
        Option::None => {
            count = wrapping_add(count, 1);
            wrapping_sub(count, 1)
        },
    }
}

// `DelayLine::new`: the line length (`delay + block`) after its checks.
pub fn p_line_len(delay: u64, block: u64) -> u64 eff [Fail[PdcFault]] {
    if delay > MAX_DELAY_SAMPLES {
        Fail::raise(PdcFault::DelayTooLong(delay));
    }
    if block > MAX_DELAY_SAMPLES || block == 0 {
        Fail::raise(PdcFault::BadBlockLength(block));
    }
    wrapping_add(delay, block)
}

// `DelayLine::write`: this block's input at `head` of the ring `buf`.
pub fn p_line_write(inout buf: Slice[u32], head: u64, in input: Slice[u32]) eff [
    Fail[RuntimeError],
    Fail[ArithOverflow]
] {
    let len = buf.len();
    for k in 0..input.len() {
        buf.set((head + k) % len, input[k]);
    }
}

// `DelayLine::read`: this block's delayed samples.
pub fn p_line_read(in buf: Slice[u32], head: u64, delay: u64, inout out: Slice[u32]) eff [
    Fail[RuntimeError],
    Fail[ArithOverflow]
] {
    let len = buf.len();
    let start = head + len - delay;
    for k in 0..out.len() {
        out.set(k, buf[(start + k) % len]);
    }
}

// `DelayLine::advance`: the head after one block.
pub fn p_line_advance(head: u64, block: u64, len: u64)
    -> u64 eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    (head + block) % len
}

// `out` filled with 0.0.
pub fn p_zero(inout out: Slice[u32]) eff [Fail[RuntimeError]] {
    for k in 0..out.len() {
        out.set(k, 0);
    }
}

// `y += x` over the common prefix of `out` and `x`.
pub fn p_accumulate(inout out: Slice[u32], in x: Slice[u32]) eff [Fail[RuntimeError]] {
    let mut n = out.len();
    if x.len() < n {
        n = x.len();
    }
    for k in 0..n {
        let v = from_bits_f32(out[k]) + from_bits_f32(x[k]);
        out.set(k, to_bits_f32(v));
    }
}

// `y *= gain`.
pub fn p_scale(inout out: Slice[u32], gain: u32) eff [Fail[RuntimeError]] {
    let g = from_bits_f32(gain);
    for k in 0..out.len() {
        let v = from_bits_f32(out[k]) * g;
        out.set(k, to_bits_f32(v));
    }
}

// `out[i] = left[i] + right[i]` for the first `n` samples (`SvfNode`).
pub fn p_mix_lr(inout out: Slice[u32], in left: Slice[u32], in right: Slice[u32], n: u64) eff [
    Fail[RuntimeError]
] {
    for i in 0..n {
        let v = from_bits_f32(left[i]) + from_bits_f32(right[i]);
        out.set(i, to_bits_f32(v));
    }
}

// `out.copy_from_slice(src)` (lengths equal).
pub fn p_copy(inout out: Slice[u32], in src: Slice[u32]) eff [Fail[RuntimeError]] {
    out.copy_from(0, in src);
}
