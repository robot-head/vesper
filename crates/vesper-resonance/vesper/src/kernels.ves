// Module kernels of @vesper/resonance (see lib.ves): the §32.3 voice bank
// (src/kernels.rs `SvfBank::render` and `render_reference`, and the scalar
// tick of src/simd.rs) and the PID torque controller.
//
// An `f32` crosses the export ABI as its bit pattern, so every sample and
// coefficient here is a `u32` word read with `from_bits_f32` and written with
// `to_bits_f32`. Every expression is the Rust build's single-precision
// expression in the Rust order, with no fused multiply-add, so the samples
// are bit for bit the Rust build's.
//
// A voice tile is five lane slices of 16 words (ic1eq, ic2eq, g_coeff,
// k_damping, gain), and the pan weights two (left, right). A parameter-ramp
// bank is one slice of three ramps (`RampBase`: gain, g, k), each the
// `RampSlice`s current, target, step and remaining, LANES words each.
use self::{
    PidFault
};
use self::util::{
    is_finite
};

// Voices per tile.
const LANES: u64 = 16;
// `pan`'s divisor: the last voice pans fully right.
const LAST_LANE: f32 = 15.0;

// A ramp's lane slices, LANES words each, from its base word.
enum RampSlice: _ {
    Current = 0,
    Target = 16,
    Step = 32,
    Remaining = 48
}

// The base word of each ramp in the ramp bank (each four `RampSlice`s).
enum RampBase: _ {
    Gain = 0,
    G = 64,
    K = 128
}

// The PID gains words (kp, ki, kd, dt, torque_limit, integral_limit).
enum Gain: _ {
    Kp,
    Ki,
    Kd,
    Dt,
    TorqueLimit,
    IntegralLimit
}

const GAIN_WORDS: u64 = 6;

// The PID state words.
enum Pid: _ {
    Integral,
    HasPrevious,
    Previous
}

pub fn f(in s: Slice[u32], i: u64) -> f32 eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    from_bits_f32(s[i])
}

pub fn put(inout s: Slice[u32], i: u64, v: f32) eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    s.set(i, to_bits_f32(v));
}

// `RampTile::advance_lane_scalar` for lane `lane` of the ramp at word `base`.
pub fn ramp_lane(inout ramps: Slice[u32], base: u64, lane: u64)
    -> f32 eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    let cur = base + lane;
    let rem = ramps[base + RampSlice::Remaining + lane];
    if rem > 0 {
        let next = rem - 1;
        ramps.set(base + RampSlice::Remaining + lane, next);
        if next == 0 {
            ramps.set(cur, ramps[base + RampSlice::Target + lane]);
        } else {
            let v = f(in ramps, cur) + f(in ramps, base + RampSlice::Step + lane);
            put(inout ramps, cur, v);
        }
    }
    f(in ramps, cur)
}

// `SvfBank::pan`: the stereo weights of voice `v`.
pub fn pan(v: u64) -> (f32, f32) {
    let p = nearest_f32(v) / LAST_LANE;
    (1.0 - p, p)
}

// `SvfBank::render`, four voices at a time: a group's state stays in
// registers for the whole block, and the group adds its panned samples, in
// voice order, to the frame's partial sum that the earlier groups left in
// `left` and `right`. The stereo sum adds the voices in voice order (`0.0 +
// y0 + y1 + ...`, `LaneOut::sum`) and the voices are independent, so the
// samples are bit for bit the Rust build's, which runs frame by frame.
// Four independent voices per loop keep four filter recurrences in flight.
// A voice's filter coefficients depend only on its g and k, so they are
// computed once per call to `group_frames`: frame by frame while one of the
// group's ramps moves (the first `max(remaining)` frames), then once for
// the rest of the block. A ramp lane with no samples remaining keeps its
// value, so stepping every lane of the group is the same as stepping only
// the moving ones.
pub fn k_render(
    inout ic1: Slice[u32],
    inout ic2: Slice[u32],
    inout gc: Slice[u32],
    inout kd: Slice[u32],
    inout gn: Slice[u32],
    inout ramps: Slice[u32],
    in pan_l: Slice[u32],
    in pan_r: Slice[u32],
    in input: Slice[u32],
    inout left: Slice[u32],
    inout right: Slice[u32],
    start: u64,
    end: u64
) eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    if start < end {
        for q in 0..GROUPS {
            let v0 = q * GROUP;
            let mut moving: u32 = 0;
            for v in v0..v0 + GROUP {
                let rem = RampSlice::Remaining + v;
                moving = max_u32(
                    moving,
                    max_u32(
                        ramps[rem + RampBase::Gain],
                        max_u32(ramps[rem + RampBase::G], ramps[rem + RampBase::K])
                    )
                );
                gn.set(v, ramps[v + RampBase::Gain]);
                gc.set(v, ramps[v + RampBase::G]);
                kd.set(v, ramps[v + RampBase::K]);
            }
            let ramped = start + min_u64(widen_u64(moving), end - start);
            for i in start..ramped {
                for v in v0..v0 + GROUP {
                    put(inout gn, v, ramp_lane(inout ramps, RampBase::Gain, v));
                    put(inout gc, v, ramp_lane(inout ramps, RampBase::G, v));
                    put(inout kd, v, ramp_lane(inout ramps, RampBase::K, v));
                }
                group_frames(
                    inout ic1,
                    inout ic2,
                    in gc,
                    in kd,
                    in gn,
                    in pan_l,
                    in pan_r,
                    in input,
                    inout left,
                    inout right,
                    v0,
                    i,
                    i + 1
                );
            }
            group_frames(
                inout ic1,
                inout ic2,
                in gc,
                in kd,
                in gn,
                in pan_l,
                in pan_r,
                in input,
                inout left,
                inout right,
                v0,
                ramped,
                end
            );
        }
    }
}

// Voices per group, and groups per tile.
const GROUP: u64 = 4;
const GROUPS: u64 = 4;

// Frames `from..to` of the four voices `v0..v0 + 4` with the tile's fixed
// coefficients: `tick_scalar`'s lanes, each adding its panned sample to the
// frame's partial sums in voice order (the first group starts them from
// 0.0). The voices' filter state is read from and written back to the tile.
fn group_frames(
    inout ic1: Slice[u32],
    inout ic2: Slice[u32],
    in gc: Slice[u32],
    in kd: Slice[u32],
    in gn: Slice[u32],
    in pan_l: Slice[u32],
    in pan_r: Slice[u32],
    in input: Slice[u32],
    inout left: Slice[u32],
    inout right: Slice[u32],
    v0: u64,
    from: u64,
    to: u64
) eff [Fail[RuntimeError]] {
    let v1 = wrapping_add(v0, 1);
    let v2 = wrapping_add(v0, 2);
    let v3 = wrapping_add(v0, 3);
    let g0 = from_bits_f32(gc[v0]);
    let g1 = from_bits_f32(gc[v1]);
    let g2 = from_bits_f32(gc[v2]);
    let g3 = from_bits_f32(gc[v3]);
    let a10 = 1.0 / (1.0 + g0 * (g0 + from_bits_f32(kd[v0])));
    let a11 = 1.0 / (1.0 + g1 * (g1 + from_bits_f32(kd[v1])));
    let a12 = 1.0 / (1.0 + g2 * (g2 + from_bits_f32(kd[v2])));
    let a13 = 1.0 / (1.0 + g3 * (g3 + from_bits_f32(kd[v3])));
    let a20 = g0 * a10;
    let a21 = g1 * a11;
    let a22 = g2 * a12;
    let a23 = g3 * a13;
    let a30 = g0 * a20;
    let a31 = g1 * a21;
    let a32 = g2 * a22;
    let a33 = g3 * a23;
    let gain0 = from_bits_f32(gn[v0]);
    let gain1 = from_bits_f32(gn[v1]);
    let gain2 = from_bits_f32(gn[v2]);
    let gain3 = from_bits_f32(gn[v3]);
    let pl0 = from_bits_f32(pan_l[v0]);
    let pl1 = from_bits_f32(pan_l[v1]);
    let pl2 = from_bits_f32(pan_l[v2]);
    let pl3 = from_bits_f32(pan_l[v3]);
    let pr0 = from_bits_f32(pan_r[v0]);
    let pr1 = from_bits_f32(pan_r[v1]);
    let pr2 = from_bits_f32(pan_r[v2]);
    let pr3 = from_bits_f32(pan_r[v3]);
    let mut c10 = from_bits_f32(ic1[v0]);
    let mut c11 = from_bits_f32(ic1[v1]);
    let mut c12 = from_bits_f32(ic1[v2]);
    let mut c13 = from_bits_f32(ic1[v3]);
    let mut c20 = from_bits_f32(ic2[v0]);
    let mut c21 = from_bits_f32(ic2[v1]);
    let mut c22 = from_bits_f32(ic2[v2]);
    let mut c23 = from_bits_f32(ic2[v3]);
    let first = v0 == 0;
    for i in from..to {
        let x = from_bits_f32(input[i]);
        let v30 = x - c20;
        let v31 = x - c21;
        let v32 = x - c22;
        let v33 = x - c23;
        let w10 = a10 * c10 + a20 * v30;
        let w11 = a11 * c11 + a21 * v31;
        let w12 = a12 * c12 + a22 * v32;
        let w13 = a13 * c13 + a23 * v33;
        let w20 = c20 + a20 * c10 + a30 * v30;
        let w21 = c21 + a21 * c11 + a31 * v31;
        let w22 = c22 + a22 * c12 + a32 * v32;
        let w23 = c23 + a23 * c13 + a33 * v33;
        c10 = 2.0 * w10 - c10;
        c11 = 2.0 * w11 - c11;
        c12 = 2.0 * w12 - c12;
        c13 = 2.0 * w13 - c13;
        c20 = 2.0 * w20 - c20;
        c21 = 2.0 * w21 - c21;
        c22 = 2.0 * w22 - c22;
        c23 = 2.0 * w23 - c23;
        let y0 = gain0 * w20;
        let y1 = gain1 * w21;
        let y2 = gain2 * w22;
        let y3 = gain3 * w23;
        let mut l: f32 = 0.0;
        let mut r: f32 = 0.0;
        if !first {
            l = from_bits_f32(left[i]);
            r = from_bits_f32(right[i]);
        }
        left.set(i, to_bits_f32(l + y0 * pl0 + y1 * pl1 + y2 * pl2 + y3 * pl3));
        right.set(i, to_bits_f32(r + y0 * pr0 + y1 * pr1 + y2 * pr2 + y3 * pr3));
    }
    ic1.set(v0, to_bits_f32(c10));
    ic1.set(v1, to_bits_f32(c11));
    ic1.set(v2, to_bits_f32(c12));
    ic1.set(v3, to_bits_f32(c13));
    ic2.set(v0, to_bits_f32(c20));
    ic2.set(v1, to_bits_f32(c21));
    ic2.set(v2, to_bits_f32(c22));
    ic2.set(v3, to_bits_f32(c23));
}

fn min_u64(a: u64, b: u64) -> u64 {
    if a < b {
        a
    } else {
        b
    }
}

fn max_u32(a: u32, b: u32) -> u32 {
    if a > b {
        a
    } else {
        b
    }
}

// `SvfBank::render_reference`: the fused scalar loop, advancing each voice's
// ramps lane by lane.
pub fn k_render_reference(
    inout ic1: Slice[u32],
    inout ic2: Slice[u32],
    inout gc: Slice[u32],
    inout kd: Slice[u32],
    inout gn: Slice[u32],
    inout ramps: Slice[u32],
    in input: Slice[u32],
    inout left: Slice[u32],
    inout right: Slice[u32],
    start: u64,
    end: u64
) eff [Fail[RuntimeError], Fail[ArithOverflow]] {
    for i in start..end {
        let v0 = f(in input, i);
        let mut l: f32 = 0.0;
        let mut r: f32 = 0.0;
        for v in 0..LANES {
            let gain = ramp_lane(inout ramps, RampBase::Gain, v);
            let g = ramp_lane(inout ramps, RampBase::G, v);
            let k = ramp_lane(inout ramps, RampBase::K, v);
            gn.set(v, to_bits_f32(gain));
            gc.set(v, to_bits_f32(g));
            kd.set(v, to_bits_f32(k));
            let a1 = 1.0 / (1.0 + g * (g + k));
            let a2 = g * a1;
            let a3 = g * a2;
            let c1 = f(in ic1, v);
            let c2 = f(in ic2, v);
            let v3 = v0 - c2;
            let v1 = a1 * c1 + a2 * v3;
            let v2 = c2 + a2 * c1 + a3 * v3;
            ic1.set(v, to_bits_f32(2.0 * v1 - c1));
            ic2.set(v, to_bits_f32(2.0 * v2 - c2));
            let y = gain * v2;
            let (pl, pr) = pan(v);
            l = l + y * pl;
            r = r + y * pr;
        }
        left.set(i, to_bits_f32(l));
        right.set(i, to_bits_f32(r));
    }
}

// `f32::clamp(lo, hi)` for `lo <= hi` (a NaN stays NaN).
fn clamp(x: f32, lo: f32, hi: f32) -> f32 {
    if x < lo {
        lo
    } else if x > hi {
        hi
    } else {
        x
    }
}

fn bad_gain(g: f32) -> bool {
    !is_finite(g) || g < 0.0
}

// `PidController::new`: the gains check (kp, ki, kd, dt, torque_limit,
// integral_limit as bits).
pub fn k_pid_check(in gains: Slice[u32]) eff [
    Fail[RuntimeError],
    Fail[ArithOverflow],
    Fail[PidFault]
] {
    for i in 0..GAIN_WORDS {
        if bad_gain(f(in gains, i)) {
            Fail::raise(PidFault::BadGains);
        }
    }
    if f(in gains, Gain::Dt) <= 0.0 {
        Fail::raise(PidFault::BadGains);
    }
}

// `PidController::step`. `state` is the integral, whether there is a
// previous measurement (0 or 1) and that measurement, as words; it changes
// only when the step succeeds.
pub fn k_pid_step(in gains: Slice[u32], inout st: Slice[u32], setpoint: u32, measurement: u32)
    -> u32 eff [Fail[RuntimeError], Fail[ArithOverflow], Fail[PidFault]] {
    let sp = from_bits_f32(setpoint);
    let m = from_bits_f32(measurement);
    if !is_finite(sp) || !is_finite(m) {
        Fail::raise(PidFault::NonFiniteInput);
    }
    let kp = f(in gains, Gain::Kp);
    let ki = f(in gains, Gain::Ki);
    let kdg = f(in gains, Gain::Kd);
    let dt = f(in gains, Gain::Dt);
    let tl = f(in gains, Gain::TorqueLimit);
    let il = f(in gains, Gain::IntegralLimit);
    let error = sp - m;
    let integral = clamp(f(in st, Pid::Integral) + ki * error * dt, -il, il);
    let mut derivative: f32 = 0.0;
    if st[(Pid::HasPrevious)] == 1 {
        derivative = -(m - f(in st, Pid::Previous)) / dt;
    }
    let u = kp * error + integral + kdg * derivative;
    if !is_finite(error) || !is_finite(integral) || !is_finite(derivative) || !is_finite(u) {
        Fail::raise(PidFault::NonFiniteIntermediate);
    }
    put(inout st, Pid::Integral, integral);
    st.set(Pid::HasPrevious, 1);
    st.set(Pid::Previous, measurement);
    to_bits_f32(clamp(u, -tl, tl))
}
