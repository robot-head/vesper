//! A tiny ledger used by the Codex package example. `vesper lint` and
//! `vesper test --doc` run over this package with no path argument.

/// Simulated clock: virtual nanoseconds from the SimPulse kernel.
linear effect Clock {
    fn now() -> u64;
    fn sleep(ns: u64) -> u64;
}

/// Simulated network: per-port inboxes with seeded latency.
linear effect Net {
    fn send(port: u64, value: u64) -> u64;
    fn recv(port: u64, timeout_ns: u64) -> u64;
}

/// Simulated disk: volatile writes until `flush`.
linear effect Disk {
    fn write(block: u64, value: u64) -> u64;
    fn read(block: u64) -> u64;
    fn flush() -> u64;
}

/// An open ledger transaction. It must be committed exactly once.
linear struct Tx {
    id: u64,
    total: u64
}

/// Opens a transaction. Dropping it is rejected statically:
///
/// ```vesper,compile_fail(E0302)
/// fn leaky() -> u64 {
///     let tx = open(7);
///     7
/// }
/// ```
fn open(id: u64) -> Tx {
    Tx {
        id: id,
        total: 0
    }
}

/// Adds an amount to the open transaction.
fn deposit(inout tx.{total}: Tx, amount: u64) {
    tx.total = wrapping_add(tx.total, amount);
}

/// Commits the transaction and returns its total.
///
/// @proof(Codex.Ledger.commit_total)
fn commit(sink tx: Tx) -> u64 {
    let Tx {
        id,
        total
    }
    = tx;
    total
}

/// Identity on amounts. The first example runs natively in the shared JIT
/// module; the second replicates a deposit under deterministic SimPulse I/O.
///
/// ```vesper,entry=doubled
/// fn doubled() -> u64 {
///     wrapping_add(amount_of(21), amount_of(21))
/// }
/// ```
///
/// ```vesper,sim(seed=0x5EED_CAFE,clock,net,disk),entry=replicate
/// fn replicate() -> u64 eff [Clock, Net, Disk] {
///     let sent = Net::send(1, 42);
///     let got = Net::recv(1, 1000);
///     let wrote = Disk::write(0, got);
///     let durable = Disk::flush();
///     wrapping_add(Disk::read(0), durable)
/// }
/// ```
fn amount_of(x: u64) -> u64 {
    x
}
