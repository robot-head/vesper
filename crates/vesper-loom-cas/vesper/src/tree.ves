// The canonical tree encoding (src/tree.rs, schema v1):
//
//   "VLTR" | u32 LE version=1 | u64 LE count |
//     count x ( u16 LE name_len | name | u8 kind | 32-byte digest | u64 LE size )
use self::name::{
    is_utf8,
    name_code
};

// TreeError positions plus one, as `tree_decode` reports them.
const BAD_MAGIC: u64 = 1;
const UNSUPPORTED_VERSION: u64 = 2;
const TRUNCATED: u64 = 3;
const TRAILING_BYTES: u64 = 4;
const TOO_MANY_ENTRIES: u64 = 5;
const UNKNOWN_ENTRY_KIND: u64 = 6;
const INVALID_NAME: u64 = 7;

const MAX_TREE_ENTRIES: u64 = 1048576;

fn byte(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(b) => b,
        Option::None => 0,
    }
}

fn word(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(b) => b,
        Option::None => 0,
    }
}

fn grow(inout out: ChunkSeq[u8], width: u64) -> u64 {
    let at = out.len();
    out.resize(wrapping_add(at, width), 0);
    at
}

fn push_u16(inout out: ChunkSeq[u8], v: u64) {
    let at = grow(inout out, 2);
    out.try_write_u16_le(at, wrapping_u16(v));
}

fn push_u32(inout out: ChunkSeq[u8], v: u64) {
    let at = grow(inout out, 4);
    out.try_write_u32_le(at, wrapping_u32(v));
}

fn push_u64(inout out: ChunkSeq[u8], v: u64) {
    let at = grow(inout out, 8);
    out.try_write_u64_le(at, v);
}

// Append `s[from..to]`.
fn push_range(inout out: ChunkSeq[u8], in s: Slice[u8], from: u64, to: u64) {
    out.extend(in s[from..to]);
}

pub fn tree_encode_into(
    in names: Slice[u8],
    in ends: Slice[u64],
    in kinds: Slice[u8],
    in digests: Slice[u8],
    in sizes: Slice[u64]
) -> ChunkSeq[u8] {
    let n = ends.len();
    let mut out = ChunkSeq::with_capacity[u8](wrapping_add(16, wrapping_mul(n, 64)));
    out.extend(in "VLTR".as_bytes());
    push_u32(inout out, 1);
    push_u64(inout out, n);
    let mut start: u64 = 0;
    let mut i: u64 = 0;
    loop {
        if i >= n {
            break;
        }
        let end = word(in ends, i);
        push_u16(inout out, wrapping_sub(end, start));
        push_range(inout out, in names, start, end);
        out.push(byte(in kinds, i));
        let d = wrapping_mul(i, 32);
        push_range(inout out, in digests, d, wrapping_add(d, 32));
        push_u64(inout out, word(in sizes, i));
        start = end;
        i = wrapping_add(i, 1);
    }
    out
}

fn read_le(in s: Slice[u8], at: u64, n: u64) -> u64 {
    if n == 8 {
        return match s.try_read_u64_le(at) {
            Option::Some(v) => v,
            Option::None => 0
        };
    }
    if n == 4 {
        return match s.try_read_u32_le(at) {
            Option::Some(v) => widen_u64(v),
            Option::None => 0
        };
    }
    match s.try_read_u16_le(at) {
        Option::Some(v) => widen_u64(v),
        Option::None => 0
    }
}

// Whether `s[a..a + an]` is at or after `s[b..b + bn]` in byte order.
fn not_before(in s: Slice[u8], a: u64, an: u64, b: u64, bn: u64) -> bool {
    let mut i: u64 = 0;
    loop {
        if i >= an || i >= bn {
            return an >= bn;
        }
        let x = byte(in s, wrapping_add(a, i));
        let y = byte(in s, wrapping_add(b, i));
        if x != y {
            return x > y;
        }
        i = wrapping_add(i, 1);
    }
}

fn finish(inout out: ChunkSeq[u64], status: u64, d1: u64, d2: u64) {
    out.push(status);
    out.push(d1);
    out.push(d2);
}

pub fn tree_scan(in s: Slice[u8]) -> ChunkSeq[u64] {
    let mut out: ChunkSeq[u64] = ChunkSeq::new();
    let len = s.len();
    if len < 4 {
        finish(inout out, TRUNCATED, 0, 0);
        return out;
    }
    if byte(in s, 0) != 86 || byte(in s, 1) != 76 || byte(in s, 2) != 84 || byte(in s, 3) != 82 {
        finish(inout out, BAD_MAGIC, 0, 0);
        return out;
    }
    if len < 8 {
        finish(inout out, TRUNCATED, 0, 0);
        return out;
    }
    let version = read_le(in s, 4, 4);
    if version != 1 {
        finish(inout out, UNSUPPORTED_VERSION, version, 0);
        return out;
    }
    if len < 16 {
        finish(inout out, TRUNCATED, 0, 0);
        return out;
    }
    let count = read_le(in s, 8, 8);
    if count > MAX_TREE_ENTRIES {
        finish(inout out, TOO_MANY_ENTRIES, count, 0);
        return out;
    }
    let mut pos: u64 = 16;
    let mut prev_at: u64 = 0;
    let mut prev_len: u64 = 0;
    let mut k: u64 = 0;
    loop {
        if k >= count {
            break;
        }
        if wrapping_sub(len, pos) < 2 {
            finish(inout out, TRUNCATED, 0, 0);
            return out;
        }
        let nlen = read_le(in s, pos, 2);
        let at = wrapping_add(pos, 2);
        if wrapping_sub(len, at) < nlen {
            finish(inout out, TRUNCATED, 0, 0);
            return out;
        }
        if !is_utf8(in s[at..wrapping_add(at, nlen)]) {
            finish(inout out, INVALID_NAME, at, nlen);
            return out;
        }
        let tag_at = wrapping_add(at, nlen);
        if tag_at >= len {
            finish(inout out, TRUNCATED, 0, 0);
            return out;
        }
        let tag = byte(in s, tag_at);
        if tag < 1 || tag > 3 {
            finish(inout out, UNKNOWN_ENTRY_KIND, widen_u64(tag), 0);
            return out;
        }
        let size_at = wrapping_add(tag_at, 33);
        if wrapping_sub(len, wrapping_add(tag_at, 1)) < 40 {
            finish(inout out, TRUNCATED, 0, 0);
            return out;
        }
        let size = read_le(in s, size_at, 8);
        let mut local: u64 = 0;
        if k > 0 && not_before(in s, prev_at, prev_len, at, nlen) {
            local = 1;
        } else if tag == 3 && size != 0 {
            local = 2;
        } else {
            let code = name_code(in s[at..wrapping_add(at, nlen)]);
            if code != 0 {
                local = wrapping_add(16, code);
            }
        }
        out.push(at);
        out.push(nlen);
        out.push(widen_u64(tag));
        out.push(size);
        out.push(local);
        if local != 0 {
            finish(inout out, 0, 0, 0);
            return out;
        }
        prev_at = at;
        prev_len = nlen;
        pos = wrapping_add(size_at, 8);
        k = wrapping_add(k, 1);
    }
    if pos != len {
        finish(inout out, TRAILING_BYTES, 0, 0);
        return out;
    }
    finish(inout out, 0, 0, 0);
    out
}
