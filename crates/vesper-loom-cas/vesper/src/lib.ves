    handle Fail[StoreErr] in {
        self::store::export_pack(
            inout r,
            in root,
            in root_id,
            pack,
            objects,
            depth,
            entries,
            meta,
            work
        );
    } with {
        return v => v,
        raise(_e, _k) => {},
    };
    r
}

// `import_pack` of `bytes` (whose root must be `expected`) into the store
// at `store_path`, under the limits as for `store_export_pack`: the
// `TransferReport`.
pub fn store_import_pack(
    in store_path: Slice[u8],
    in expected: Slice[u8],
    in bytes: Slice[u8],
    pack: u64,
    objects: u64,
    depth: u64,
    entries: u64,
    meta: u64,
    work: u64
