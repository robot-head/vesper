// Object identities (src/id.rs): the domain-separated BLAKE3 contexts,
// the 34-byte binary id and the `b3v1:<domain>:<kind>:<hex>` text form.
use self::IdErr;
use @vesper-std/hash-sys::{
    hasher_new_derive_key,
    update,
    finalize,
    hasher_free
};
use @vesper-std/hash::blake3::digest_bytes;

fn byte(in s: Slice[u8], i: u64) -> u8 {
    match s.try_get(i) {
        Option::Some(b) => b,
        Option::None => 0,
    }
}

// `object_context`: "vesper-loom-cas 2026-11 v1 <domain> <kind>".
pub fn context(domain: u8, kind: u8) -> Str {
    if domain == 1 {
        if kind == 1 {
            "vesper-loom-cas 2026-11 v1 source blob"
        } else {
            "vesper-loom-cas 2026-11 v1 source tree"
        }
    } else if domain == 2 {
        if kind == 1 {
            "vesper-loom-cas 2026-11 v1 interface blob"
        } else {
            "vesper-loom-cas 2026-11 v1 interface tree"
        }
    } else {
        if kind == 1 {
            "vesper-loom-cas 2026-11 v1 artifact blob"
        } else {
            "vesper-loom-cas 2026-11 v1 artifact tree"
        }
    }
}

pub fn object_hash(domain: u8, kind: u8, in bytes: Slice[u8]) -> ChunkSeq[u8] eff [Ffi[Blake3]] {
    let mut out = ChunkSeq::with_capacity[u8](32);
    match hasher_new_derive_key(in context(domain, kind).as_bytes()) {
        Option::Some(h) => {
            let mut h = h;
            update(inout h, in bytes);
            let d = finalize(in h);
            hasher_free(h);
            digest_bytes(d, inout out);
        },
        Option::None => {},
    }
    out
}

fn hex_digit(v: u8) -> u8 {
    if v < 10 {
        wrapping_add(v, 48)
    } else {
        wrapping_add(v, 87)
    }
}

pub fn hex_into(in bytes: Slice[u8], inout out: ChunkSeq[u8]) {
    // Grow once, then write each byte's two digits as one u16.
    let at = out.len();
    out.resize(wrapping_add(at, wrapping_mul(bytes.len(), 2)), 0);
    let mut i: u64 = 0;
    loop {
        if i >= bytes.len() {
            break;
        }
        let b = byte(in bytes, i);
        let hi = widen_u16(hex_digit(wrapping_shr_u8(b, 4)));
        let lo = widen_u16(hex_digit(b & 15));
        out.try_write_u16_le(wrapping_add(at, wrapping_mul(i, 2)), hi | wrapping_shl_u16(lo, 8));
        i = wrapping_add(i, 1);
    }
}

// The value of one lowercase hex digit, or 16.
fn nibble(c: u8) -> u8 {
    if c >= 48 && c <= 57 {
        wrapping_sub(c, 48)
    } else if c >= 97 && c <= 102 {
        wrapping_sub(c, 87)
    } else {
        16
    }
}

// The digest of 64 lowercase hex digits at `text[at..at + 64]`, appended
// to `out`; false (and `out` partly written) when a digit is not one.
fn hex_digest(in text: Slice[u8], at: u64, inout out: ChunkSeq[u8]) -> bool {
    let mut i: u64 = 0;
    loop {
        if i >= 32 {
            return true;
        }
        let hi = nibble(byte(in text, wrapping_add(at, wrapping_mul(i, 2))));
        let lo = nibble(byte(in text, wrapping_add(at, wrapping_add(wrapping_mul(i, 2), 1))));
        if hi > 15 || lo > 15 {
            return false;
        }
        out.push(wrapping_shl_u8(hi, 4) | lo);
        i = wrapping_add(i, 1);
    }
}

pub fn from_hex(in text: Slice[u8]) -> ChunkSeq[u8] eff [Fail[IdErr]] {
    let mut out = ChunkSeq::with_capacity[u8](32);
    if text.len() != 64 || !hex_digest(in text, 0, inout out) {
        Fail::raise(IdErr::Invalid);
    }
    out
}

// Whether `text[at..at + w.len()]` is exactly `w` and ends at `end`.
fn word_is(in text: Slice[u8], at: u64, end: u64, in w: Slice[u8]) -> bool {
    if wrapping_sub(end, at) != w.len() {
        return false;
    }
    let mut i: u64 = 0;
    loop {
        if i >= w.len() {
            return true;
        }
        if byte(in text, wrapping_add(at, i)) != byte(in w, i) {
            return false;
        }
        i = wrapping_add(i, 1);
    }
}

pub fn parse_id(in text: Slice[u8]) -> ChunkSeq[u8] eff [Fail[IdErr]] {
    // The positions of the three ':' separators; a fourth is invalid.
    let mut cuts: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](3);
    let mut i: u64 = 0;
    loop {
        if i >= text.len() {
            break;
        }
        if byte(in text, i) == 58 {
            if cuts.len() == 3 {
                Fail::raise(IdErr::Invalid);
            }
            cuts.push(i);
        }
        i = wrapping_add(i, 1);
    }
    if cuts.len() != 3 {
        Fail::raise(IdErr::Invalid);
    }
    let c0 = match cuts.try_get(0) {
        Option::Some(v) => v,
        Option::None => 0
    };
    let c1 = match cuts.try_get(1) {
        Option::Some(v) => v,
        Option::None => 0
    };
    let c2 = match cuts.try_get(2) {
        Option::Some(v) => v,
        Option::None => 0
    };
    if !word_is(in text, 0, c0, in "b3v1".as_bytes()) {
        Fail::raise(IdErr::Invalid);
    }
    let d0 = wrapping_add(c0, 1);
    let mut domain: u8 = 0;
    if word_is(in text, d0, c1, in "source".as_bytes()) {
        domain = 1;
    } else if word_is(in text, d0, c1, in "interface".as_bytes()) {
        domain = 2;
    } else if word_is(in text, d0, c1, in "artifact".as_bytes()) {
        domain = 3;
    }
    let k0 = wrapping_add(c1, 1);
    let mut kind: u8 = 0;
    if word_is(in text, k0, c2, in "blob".as_bytes()) {
        kind = 1;
    } else if word_is(in text, k0, c2, in "tree".as_bytes()) {
        kind = 2;
    }
    if domain == 0 || kind == 0 {
        Fail::raise(IdErr::Invalid);
    }
    let h0 = wrapping_add(c2, 1);
    let mut out = ChunkSeq::with_capacity[u8](34);
    out.push(domain);
    out.push(kind);
    if wrapping_sub(text.len(), h0) != 64 || !hex_digest(in text, h0, inout out) {
        Fail::raise(IdErr::Invalid);
    }
    out
}
