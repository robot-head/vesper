{
  "notes": [
    "The flip gate for vesper-loom-cas (aspect ci flip-gate --, SH6 lane 1,",
    "#1396; this crate's lane: SH6 lane 16, #1411). The port replaces all codecs,",
    "the on-disk CAS store and pack transfer; the frozen Rust CAS engine lives",
    "in seed/src/engine for the compiler and its tools until Stage 2.",
    "Whole-store differential suite against the frozen Rust seed copy.",
    "In-process A B B A whole-store timings (seed vs port)."
  ],
  "name": "vesper-loom-cas",
  "lane": "SH6-16",
  "rust": [
    "crates/vesper-loom-cas/seed/src/engine/id.rs",
    "crates/vesper-loom-cas/seed/src/engine/tree.rs",
    "crates/vesper-loom-cas/seed/src/engine/derivation.rs",
    "crates/vesper-loom-cas/seed/src/engine/store.rs",
    "crates/vesper-loom-cas/seed/src/engine/transfer.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0"
  },
  "build": [
    ["cargo", "build", "--locked", "--release", "-p", "vesper-loom-cas", "--example", "abba"]
  ],
  "tests": [
    {
      "run": ["cargo", "test", "--locked", "--release", "-p", "vesper-loom-cas", "-p", "vesper-loom-cas-seed"]
    }
  ],
  "differential": {
    "run": ["cargo", "test", "--locked", "--release", "-p", "vesper-loom-cas", "--test", "port_differential", "--", "--nocapture"]
  },
  "abba": [
    {
      "workload": "put_blob",
      "run": ["cargo", "run", "--locked", "--release", "-p", "vesper-loom-cas", "--example", "abba", "--", "flip-gate", "put_blob"]
    },
    {
      "workload": "read_blob",
      "run": ["cargo", "run", "--locked", "--release", "-p", "vesper-loom-cas", "--example", "abba", "--", "flip-gate", "read_blob"]
    },
    {
      "workload": "put_tree",
      "run": ["cargo", "run", "--locked", "--release", "-p", "vesper-loom-cas", "--example", "abba", "--", "flip-gate", "put_tree"]
    },
    {
      "workload": "ingest_dir",
      "run": ["cargo", "run", "--locked", "--release", "-p", "vesper-loom-cas", "--example", "abba", "--", "flip-gate", "ingest_dir"]
    },
    {
      "workload": "materialize",
      "run": ["cargo", "run", "--locked", "--release", "-p", "vesper-loom-cas", "--example", "abba", "--", "flip-gate", "materialize"]
    },
    {
      "workload": "publish_derivation",
      "run": ["cargo", "run", "--locked", "--release", "-p", "vesper-loom-cas", "--example", "abba", "--", "flip-gate", "publish_derivation"]
    },
    {
      "workload": "lookup_derivation",
      "run": ["cargo", "run", "--locked", "--release", "-p", "vesper-loom-cas", "--example", "abba", "--", "flip-gate", "lookup_derivation"]
    },
    {
      "workload": "export_pack",
      "run": ["cargo", "run", "--locked", "--release", "-p", "vesper-loom-cas", "--example", "abba", "--", "flip-gate", "export_pack"]
    },
    {
      "workload": "verify_all",
      "run": ["cargo", "run", "--locked", "--release", "-p", "vesper-loom-cas", "--example", "abba", "--", "flip-gate", "verify_all"]
    }
  ]
}
