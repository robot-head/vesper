# The frozen Rust seed copy of vesper-loom-cas (package
# vesper-loom-cas-seed, library vesper_loom_cas) that the compiler and its
# tools link: the shared API in ../src (cfg(vesper_port) off) over the
# frozen Rust CAS engine in src/engine. Written by hand because part of its
# sources live in the parent package; see "Crates the compiler links" in
# docs/maintenance/porting-a-crate.md.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("@vesper_cargo//:packages.bzl", "PACKAGES")

_CRATE = PACKAGES["crates/vesper-loom-cas/seed"].crate_data()

_DEPS = all_crate_deps(_CRATE, normal = True, platforms = _CRATE["platforms"])

_TEST_DEPS = all_crate_deps(
    _CRATE,
    normal = True,
    normal_dev = True,
    platforms = _CRATE["platforms"],
)

_ENV = {
    "CARGO_PKG_NAME": "vesper-loom-cas-seed",
    "CARGO_PKG_VERSION": "0.1.0",
}

rust_library(
    name = "seed",
    srcs = glob(["src/**/*.rs"]) + ["//crates/vesper-loom-cas:rust_srcs"],
    aliases = _CRATE.get("aliases", {}),
    crate_name = "vesper_loom_cas",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_env = _ENV,
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = _DEPS,
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    edition = "2024",
    deps = _TEST_DEPS,
)

[
    rust_test(
        name = "seed_test_" + t,
        srcs = ["//crates/vesper-loom-cas:tests/%s.rs" % t],
        compile_data = [
            "//crates/vesper-loom-cas:examples/lower_table.rs",
            "//crates/vesper-loom-cas:vesper_srcs",
        ],
        crate_root = "//crates/vesper-loom-cas:tests/%s.rs" % t,
        data = ["//crates/vesper-loom-cas:vesper_srcs"],
        edition = "2024",
        rustc_env = _ENV,
        deps = [":seed"] + _TEST_DEPS,
    )
    for t in [
        "codec_differential",
        "lower_table",
        "store",
        "transfer_acceptance",
        "transfer_export",
        "transfer_import",
    ]
]

rust_clippy_test(
    name = "clippy",
    tags = [
        "clippy",
        "lint",
    ],
    targets = [":seed"],
)
