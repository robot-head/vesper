// @vesper/quarry::store_log: table-store WAL record decoder (`src/store/log.rs`).

const PAGE_SIZE: u64 = 16384;

fn gb(in b: Slice[u8], i: u64) -> u8 {
    match b.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

fn s64(inout s: Slice[u64], i: u64, v: u64) {
    s.try_set(i, v);
}

fn le16(in b: Slice[u8], at: u64) -> u64 {
    widen_u64(gb(in b, at)) | (widen_u64(gb(in b, wrapping_add(at, 1))) << 8)
}

fn le32(in b: Slice[u8], at: u64) -> u64 {
    widen_u64(gb(in b, at))
        | (widen_u64(gb(in b, wrapping_add(at, 1))) << 8)
        | (widen_u64(gb(in b, wrapping_add(at, 2))) << 16)
        | (widen_u64(gb(in b, wrapping_add(at, 3))) << 24)
}

fn le64(in b: Slice[u8], at: u64) -> u64 {
    le32(in b, at) | (le32(in b, wrapping_add(at, 4)) << 32)
}

// Returns 0 = Ok, 1 = truncated, 2 = unknown tag, 3 = page diff range, 4 = trailing, 5 = grow out_ranges.
pub fn record_decode(
    in payload: Slice[u8],
    inout out_hdr: Slice[u64],
    inout out_ranges: Slice[u64]
) -> u64 {
    let plen = payload.len();
    if plen == 0 {
        return 1;
    }
    let tag = gb(in payload, 0);
    if tag == 1 {
        if plen < 9 {
            return 1;
        }
        let page = le64(in payload, 1);
        let need = wrapping_add(9, PAGE_SIZE);
        if plen < need {
            return 1;
        }
        if plen != need {
            return 4;
        }
        s64(inout out_hdr, 0, 1);
        s64(inout out_hdr, 1, page);
        return 0;
    }
    if tag == 2 {
        if plen < 19 {
            return 1;
        }
        let page = le64(in payload, 1);
        let prev_lsn = le64(in payload, 9);
        let count = le16(in payload, 17);
        if wrapping_mul(count, 3) > out_ranges.len() {
            return 5;
        }
        let mut at: u64 = 19;
        let mut end: u64 = 0;
        let mut i: u64 = 0;
        loop {
            if i >= count {
                break;
            }
            if wrapping_sub(plen, at) < 4 {
                return 1;
            }
            let off = le16(in payload, at);
            let len = le16(in payload, wrapping_add(at, 2));
            at = wrapping_add(at, 4);
            if len == 0 || off < end || wrapping_add(off, len) > PAGE_SIZE {
                return 3;
            }
            if wrapping_sub(plen, at) < len {
                return 1;
            }
            end = wrapping_add(off, len);
            let rb = wrapping_mul(i, 3);
            s64(inout out_ranges, rb, off);
            s64(inout out_ranges, wrapping_add(rb, 1), len);
            s64(inout out_ranges, wrapping_add(rb, 2), at);
            at = wrapping_add(at, len);
            i = wrapping_add(i, 1);
        }
        if at != plen {
            return 4;
        }
        s64(inout out_hdr, 0, 2);
        s64(inout out_hdr, 1, page);
        s64(inout out_hdr, 2, prev_lsn);
        s64(inout out_hdr, 3, count);
        return 0;
    }
    if tag == 3 {
        if plen < 17 {
            return 1;
        }
        if plen != 17 {
            return 4;
        }
        s64(inout out_hdr, 0, 3);
        s64(inout out_hdr, 1, le64(in payload, 1));
        s64(inout out_hdr, 2, le64(in payload, 9));
        return 0;
    }
    2
}

const LOG_HDR_LEN: u64 = 64;
const LOG_HDR_CRC_OFF: u64 = 60;
const LOG_HDR_REGION_OFF: u64 = 56;
const LOG_HDR_KIB_OFF: u64 = 57;
const LOG_HDR_FIELDS_OFF: u64 = 8;
const LOG_HDR_FIELD_COUNT: u64 = 6;
const LOG_HDR_FIELD_BYTES: u64 = 8;
const LOG_HDR_MAX_REGION: u8 = 1;
const LOG_MIN_REGION_KIB: u64 = 64;
const LOG_MAX_REGION_KIB: u64 = 131072;
const LOG_MAGIC_0: u8 = 81;
// 'Q'
const LOG_MAGIC_1: u8 = 82;
// 'R'
const LOG_MAGIC_2: u8 = 89;
// 'Y'
const LOG_MAGIC_3: u8 = 87;
// 'W'
const LOG_MAGIC_4: u8 = 65;
// 'A'
const LOG_MAGIC_5: u8 = 76;
// 'L'
const LOG_MAGIC_6: u8 = 48;
// '0'
const LOG_MAGIC_7: u8 = 50;
// '2'
const LOG_SHIFT_8: u64 = 8;
const LOG_SHIFT_16: u64 = 16;
const LOG_BYTE_MASK: u64 = 255;

const LOG_FIELD_HSEQ: u64 = 0;
const LOG_FIELD_CUR_GEN: u64 = 1;
const LOG_FIELD_CUR_BASE: u64 = 2;
const LOG_FIELD_PREV_GEN: u64 = 3;
const LOG_FIELD_PREV_BASE: u64 = 4;
const LOG_FIELD_PREV_END: u64 = 5;
const LOG_FIELD_CUR_REGION: u64 = 6;
const LOG_FIELD_REGION_KIB: u64 = 7;

fn g64(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

const LOG_MAGIC_U64: u64 = 0x32304c4157595251;

fn rd64(in b: Slice[u8], at: u64) -> u64 {
    match b.try_read_u64_le(at) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

pub fn header_encode(in fields: Slice[u64], inout out: Slice[u8]) {
    let _ = out.try_write_u64_le(0, LOG_MAGIC_U64);
    let mut i: u64 = 0;
    loop {
        if i >= LOG_HDR_FIELD_COUNT {
            break;
        }
        let off = wrapping_add(LOG_HDR_FIELDS_OFF, wrapping_mul(i, LOG_HDR_FIELD_BYTES));
        let _ = out.try_write_u64_le(off, g64(in fields, i));
        i = wrapping_add(i, 1);
    }
    out.try_set(
        LOG_HDR_REGION_OFF,
        wrapping_u8(g64(in fields, LOG_FIELD_CUR_REGION) & LOG_BYTE_MASK)
    );
    let kib = g64(in fields, LOG_FIELD_REGION_KIB);
    out.try_set(LOG_HDR_KIB_OFF, wrapping_u8(kib & LOG_BYTE_MASK));
    out.try_set(
        wrapping_add(LOG_HDR_KIB_OFF, 1),
        wrapping_u8((kib >> LOG_SHIFT_8) & LOG_BYTE_MASK)
    );
    out.try_set(
        wrapping_add(LOG_HDR_KIB_OFF, 2),
        wrapping_u8((kib >> LOG_SHIFT_16) & LOG_BYTE_MASK)
    );
}

// Validates magic, region, non-zero hseq/cur_gen/cur_base, and region_kib bounds.
// Returns 1 if valid (writing 8 fields into `out_fields`), 0 if invalid.
pub fn header_decode(in h: Slice[u8], inout out_fields: Slice[u64]) -> u64 {
    if h.len() != LOG_HDR_LEN {
        return 0;
    }
    let cur_region = gb(in h, LOG_HDR_REGION_OFF);
    if rd64(in h, 0) != LOG_MAGIC_U64 || cur_region > LOG_HDR_MAX_REGION {
        return 0;
    }
    let hseq = rd64(in h, LOG_HDR_FIELDS_OFF);
    let cur_gen = rd64(in h, wrapping_add(LOG_HDR_FIELDS_OFF, LOG_HDR_FIELD_BYTES));
    let cur_base = rd64(
        in h,
        wrapping_add(LOG_HDR_FIELDS_OFF, wrapping_mul(2, LOG_HDR_FIELD_BYTES))
    );
    let prev_gen = rd64(
        in h,
        wrapping_add(LOG_HDR_FIELDS_OFF, wrapping_mul(3, LOG_HDR_FIELD_BYTES))
    );
    let prev_base = rd64(
        in h,
        wrapping_add(LOG_HDR_FIELDS_OFF, wrapping_mul(4, LOG_HDR_FIELD_BYTES))
    );
    let prev_end = rd64(
        in h,
        wrapping_add(LOG_HDR_FIELDS_OFF, wrapping_mul(5, LOG_HDR_FIELD_BYTES))
    );
    let kib = widen_u64(gb(in h, LOG_HDR_KIB_OFF))
        | (widen_u64(gb(in h, wrapping_add(LOG_HDR_KIB_OFF, 1))) << LOG_SHIFT_8)
        | (widen_u64(gb(in h, wrapping_add(LOG_HDR_KIB_OFF, 2))) << LOG_SHIFT_16);
    if hseq == 0
        || cur_gen == 0
        || cur_base == 0
        || kib < LOG_MIN_REGION_KIB
        || kib > LOG_MAX_REGION_KIB
    {
        return 0;
    }
    s64(inout out_fields, LOG_FIELD_HSEQ, hseq);
    s64(inout out_fields, LOG_FIELD_CUR_GEN, cur_gen);
    s64(inout out_fields, LOG_FIELD_CUR_BASE, cur_base);
    s64(inout out_fields, LOG_FIELD_PREV_GEN, prev_gen);
    s64(inout out_fields, LOG_FIELD_PREV_BASE, prev_base);
    s64(inout out_fields, LOG_FIELD_PREV_END, prev_end);
    s64(inout out_fields, LOG_FIELD_CUR_REGION, widen_u64(cur_region));
    s64(inout out_fields, LOG_FIELD_REGION_KIB, kib);
    1
}
