// Module lex of @vesper/quarry (see lib.ves).
use self::{
    Q,
    Tok
};
use self::util::{
    bound,
    fail,
    identifier,
    identifier_in,
    word_end,
    lim,
    put,
    put_u64,
    sb,
    tk_int,
    tk_op,
    tk_param,
    tk_sym,
    tk_text,
    tk_word
};
use self::parse::{
    keyword
};

// ASCII bytes.
const TAB: u64 = 9;
const LF: u64 = 10;
const FF: u64 = 12;
const CR: u64 = 13;
const SPACE: u64 = 32;
const BANG: u64 = 33;
const QUOTE: u64 = 39;
const LPAREN: u64 = 40;
const RPAREN: u64 = 41;
const STAR: u64 = 42;
const COMMA: u64 = 44;
const MINUS: u64 = 45;
const DOT: u64 = 46;
const DIGIT_0: u64 = 48;
const DIGIT_9: u64 = 57;
const COLON: u64 = 58;
const SEMICOLON: u64 = 59;
const LT: u64 = 60;
const EQUALS: u64 = 61;
const GT: u64 = 62;
const UPPER_A: u64 = 65;
const UPPER_Z: u64 = 90;
const UNDERSCORE: u64 = 95;
const LOWER_A: u64 = 97;
const LOWER_Z: u64 = 122;

// i64 literal bounds: |i64::MIN| is one more than i64::MAX, and a magnitude
// above I64_MAX_DIV_10 overflows on the next digit.
const I64_MAX: u64 = 9223372036854775807;
const I64_MIN_MAGNITUDE: u64 = 9223372036854775808;
const I64_MAX_DIV_10: u64 = 922337203685477580;

// Lexer (src/parse.rs `lex`).

pub fn byte(in s: Slice[u8], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(x) => widen_u64(x),
        Option::None => 0,
    }
}

pub fn is_space(c: u64) -> bool {
    c == SPACE || c == TAB || c == LF || c == FF || c == CR
}

pub fn is_word_byte(c: u64) -> bool {
    (c >= LOWER_A && c <= LOWER_Z)
        || (c >= UPPER_A && c <= UPPER_Z)
        || (c >= DIGIT_0 && c <= DIGIT_9)
        || c
        == UNDERSCORE
}

pub fn is_digit(c: u64) -> bool {
    c >= DIGIT_0 && c <= DIGIT_9
}

pub fn lex(inout q: Q, in sql: Slice[u8]) {
    let bn = sql.len();
    if !bound(inout q, bn, 0, "SQL byte limit") {
        return;
    }
    // The SQL text is copied after the input text so identifiers can be
    // normalized from the pool.
    let base = q.pool.len();
    q.pool.extend(in sql);
    let n = sql.len();
    let mut i: u64 = 0;
    loop {
        if i >= n || q.err != 0 {
            break;
        }
        let c = byte(in sql, i);
        if is_space(c) {
            i = wrapping_add(i, 1);
        } else {
            // `bound`, inline: this runs once per token.
            if wrapping_add(q.toks.len(), 1) > lim(in q, 1) {
                fail(inout q, 6, "SQL token limit");
                return;
            }
            let start = i;
            if (c >= LOWER_A && c <= LOWER_Z)
                || (c >= UPPER_A && c <= UPPER_Z)
                || c
                == UNDERSCORE
                || c
                == COLON {
                let is_param = c == COLON;
                if is_param {
                    i = wrapping_add(i, 1);
                }
                let word_start = i;
                i = match word_end(in sql[i..n]) {
                    Option::Some(j) => wrapping_add(i, j),
                    Option::None => n,
                };
                let len = wrapping_sub(i, word_start);
                let off = identifier_in(
                    inout q,
                    in sql[word_start..i],
                    wrapping_add(base, word_start)
                );
                if q.err != 0 {
                    return;
                }
                let kw = if is_param {
                    0
                } else {
                    keyword(in q.pool, off, len)
                };
                q
                    .toks
                    .push(
                    Tok {
                        kind: if is_param {
                            tk_param()
                        } else {
                            tk_word()
                        },
                        a: off,
                        b: len,
                        kw: kw
                    }
                );
            } else if is_digit(c) || c == MINUS {
                i = wrapping_add(i, 1);
                loop {
                    if i >= n || !is_digit(byte(in sql, i)) {
                        break;
                    }
                    i = wrapping_add(i, 1);
                }
                // Parse sql[start..i] as an i64.
                let neg = c == MINUS;
                let first = if neg {
                    wrapping_add(start, 1)
                } else {
                    start
                };
                let mut ok = first < i;
                let mut m: u64 = 0;
                let mut j = first;
                loop {
                    if j >= i || !ok {
                        break;
                    }
                    if m > I64_MAX_DIV_10 {
                        ok = false;
                    } else {
                        m = wrapping_add(
                            wrapping_mul(m, 10),
                            wrapping_sub(byte(in sql, j), DIGIT_0)
                        );
                        if m > I64_MIN_MAGNITUDE {
                            ok = false;
                        }
                    }
                    j = wrapping_add(j, 1);
                }
                if ok && !neg && m > I64_MAX {
                    ok = false;
                }
                if !ok {
                    fail(inout q, 1, "invalid or overflowing i64 literal");
                    return;
                }
                let v = if neg {
                    wrapping_sub(0, m)
                } else {
                    m
                };
                q
                    .toks
                    .push(
                    Tok {
                        kind: tk_int(),
                        a: v,
                        b: 0,
                        kw: 0
                    }
                );
            } else if c == QUOTE {
                i = wrapping_add(i, 1);
                let off = q.pool.len();
                let mut part = i;
                loop {
                    if i == n {
                        fail(inout q, 1, "unterminated string");
                        return;
                    }
                    if byte(in sql, i) == QUOTE {
                        for k in part..i {
                            q.pool.push(sb(in sql, k));
                        }
                        i = wrapping_add(i, 1);
                        if i < n && byte(in sql, i) == QUOTE {
                            q.pool.push(wrapping_u8(QUOTE));
                            i = wrapping_add(i, 1);
                            part = i;
                        } else {
                            break;
                        }
                    } else {
                        i = wrapping_add(i, 1);
                    }
                }
                q
                    .toks
                    .push(
                    Tok {
                        kind: tk_text(),
                        a: off,
                        b: wrapping_sub(q.pool.len(), off),
                        kw: 0
                    }
                );
            } else if c == EQUALS {
                i = wrapping_add(i, 1);
                q
                    .toks
                    .push(
                    Tok {
                        kind: tk_op(),
                        a: 0,
                        b: 0,
                        kw: 0
                    }
                );
            } else if c == LT || c == GT || c == BANG {
                i = wrapping_add(i, 1);
                let second = if i < n {
                    byte(in sql, i)
                } else {
                    0
                };
                let mut op: u64 = 0;
                if c == LT && second == EQUALS {
                    i = wrapping_add(i, 1);
                    op = 3;
                } else if c == GT && second == EQUALS {
                    i = wrapping_add(i, 1);
                    op = 5;
                } else if (c == LT && second == GT) || (c == BANG && second == EQUALS) {
                    i = wrapping_add(i, 1);
                    op = 1;
                } else if c == LT {
                    op = 2;
                } else if c == GT {
                    op = 4;
                } else {
                    fail(inout q, 1, "unsupported operator");
                    return;
                }
                q
                    .toks
                    .push(
                    Tok {
                        kind: tk_op(),
                        a: op,
                        b: 0,
                        kw: 0
                    }
                );
            } else if c
                == LPAREN
                || c
                == RPAREN
                || c
                == COMMA
                || c
                == DOT
                || c
                == SEMICOLON
                || c
                == STAR {
                i = wrapping_add(i, 1);
                q
                    .toks
                    .push(
                    Tok {
                        kind: tk_sym(),
                        a: c,
                        b: 0,
                        kw: 0
                    }
                );
            } else {
                if q.err == 0 {
                    q.err = 1;
                    put(inout q.msg, "unsupported token at byte ");
                    put_u64(inout q.msg, i);
                }
                return;
            }
        }
    }
}
