// Module stats of @vesper/quarry (see lib.ves).
use self::{
    Bound,
    D,
    Node,
    Q,
    Stat,
    Val
};
use self::util::{
    ccol,
    ceil_div,
    ctab,
    cw,
    div_rem,
    ex,
    find_table,
    link,
    none,
    null_val,
    order,
    param,
    same,
    vat
};
use self::check::{
    ex_end
};
use self::values::{
    compare_vals,
    dtab,
    val_at
};

// Access path selection (spec/planner-ddl.md, sections 1 and 2).

pub fn stat(in ds: D, in q: Q, i: u64) -> Stat {
    match ds.stats.try_get(i) {
        Option::Some(s) => s,
        Option::None => Stat {
            binding: 0,
            slot: 0,
            ioff: 0,
            ilen: 0,
            nonnull: 0,
            distinct: 0,
            start: 0,
            n: 0
        },
    }
}

// ANALYZE of column k of data table d: the exact non-null count, distinct
// count and sorted distinct values with their counts. Cached in `stats`
// (`binding` is the data table, `slot` the column).
pub fn analyze(inout ds: D, inout q: Q, d: u64, k: u64) -> Stat {
    for i in 0..ds.stats.len() {
        let s = stat(in ds, in q, i);
        if s.binding == d && s.slot == k {
            return s;
        }
    }
    let t = dtab(in ds, in q, d);
    let start = ds.vals.len();
    let mut nonnull: u64 = 0;
    let mut p = t.start;
    for r in 0..t.n {
        let nvals = ex(in q, p);
        let v = val_at(in q, in q.ex, wrapping_add(wrapping_add(p, 1), wrapping_mul(k, 3)));
        p = wrapping_add(wrapping_add(p, 1), wrapping_mul(nvals, 3));
        if v.t == 0 {
            continue_none();
        } else {
            nonnull = wrapping_add(nonnull, 1);
            // Binary search in vals[start .. end].
            let mut lo = start;
            let mut hi = ds.vals.len();
            let mut found = false;
            loop {
                if lo >= hi {
                    break;
                }
                let (half, r2) = div_rem(wrapping_sub(hi, lo), 2);
                let mid = wrapping_add(lo, half);
                let o = compare_vals(in q, vat(in ds, in q, mid), v);
                if o == 1 {
                    let c = cw(in ds.counts, mid);
                    ds.counts.try_set(mid, wrapping_add(c, 1));
                    found = true;
                    break;
                } else if o == 0 {
                    lo = wrapping_add(mid, 1);
                } else {
                    hi = mid;
                }
            }
            if !found {
                // Insert at lo.
                ds.vals.push(v);
                ds.counts.push(1);
                let mut j = wrapping_sub(ds.vals.len(), 1);
                loop {
                    if j <= lo {
                        break;
                    }
                    let prev = vat(in ds, in q, wrapping_sub(j, 1));
                    let pc = cw(in ds.counts, wrapping_sub(j, 1));
                    ds.vals.try_set(j, prev);
                    ds.counts.try_set(j, pc);
                    j = wrapping_sub(j, 1);
                }
                ds.vals.try_set(lo, v);
                ds.counts.try_set(lo, 1);
            }
        }
    }
    let s = Stat {
        binding: d,
        slot: k,
        ioff: 0,
        ilen: 0,
        nonnull: nonnull,
        distinct: wrapping_sub(ds.vals.len(), start),
        start: start,
        n: wrapping_sub(ds.vals.len(), start)
    };
    ds.stats.push(s);
    s
}

pub fn continue_none() {}

// spec/planner-ddl.md: `pages(n) = max(1, ceil(n / 64))` and
// `height(n) = 1 + ceil(log_128(pages(n)))`.
const ROWS_PER_PAGE: u64 = 64;
const INDEX_FANOUT: u64 = 128;
// spec/planner-ddl.md: with an unknown parameter, a range keeps
// `ceil(n / 10)` rows and a one-sided bound `ceil(n / 4)`.
const RANGE_SELECTIVITY: u64 = 10;
const ONE_SIDED_SELECTIVITY: u64 = 4;

pub fn pages(n: u64) -> u64 {
    let p = ceil_div(n, ROWS_PER_PAGE);
    if p == 0 {
        1
    } else {
        p
    }
}

// 1 + ceil(log_128(pages(n))).
pub fn height(n: u64) -> u64 {
    let mut h: u64 = 1;
    let mut reach: u64 = 1;
    let p = pages(n);
    loop {
        if reach >= p {
            break;
        }
        reach = wrapping_mul(reach, INDEX_FANOUT);
        h = wrapping_add(h, 1);
    }
    h
}

pub fn no_bound() -> Bound {
    Bound {
        has_lo: false,
        lo: null_val(),
        lo_incl: false,
        has_hi: false,
        hi: null_val(),
        hi_incl: false,
        null: false,
        unknown: false,
        only_eq: true
    }
}

// A bound operand: a literal, or a parameter (known when it is bound).
// Returns (is an operand, value, known).
pub fn operand(in ds: D, in q: Q, p: u64) -> (bool, Val, bool) {
    let tag = ex(in q, p);
    if tag == 2 {
        (true, val_at(in q, in q.ex, wrapping_add(p, 3)), true)
    } else if tag == 1 {
        let off = ex(in q, wrapping_add(p, 3));
        let len = ex(in q, wrapping_add(p, 4));
        for i in 0..q.params.len() {
            let d = param(in q, i);
            if same(in q.pool, d.noff, d.nlen, off, len) {
                return (true, vat(in ds, in q, d.ty), true);
            }
        }
        (true, null_val(), false)
    } else {
        (false, null_val(), false)
    }
}

// Tighten bound b with `column op value` (op already oriented so the
// column is on the left).
pub fn tighten(in q: Q, b: Bound, op: u64, v: Val, known: bool) -> Bound {
    let mut r = b;
    if op != 0 {
        r.only_eq = false;
    }
    if !known {
        r.unknown = true;
    } else if v.t == 0 {
        r.null = true;
    }
    let lower = op == 0 || op == 4 || op == 5;
    let upper = op == 0 || op == 2 || op == 3;
    let incl = op == 0 || op == 3 || op == 5;
    if lower {
        if !r.has_lo {
            r.has_lo = true;
            r.lo = v;
            r.lo_incl = incl;
        } else if known && v.t != 0 && r.lo.t != 0 {
            let o = compare_vals(in q, v, r.lo);
            if o == 2 || (o == 1 && !incl) {
                r.lo = v;
                r.lo_incl = incl;
            }
        }
    }
    if upper {
        if !r.has_hi {
            r.has_hi = true;
            r.hi = v;
            r.hi_incl = incl;
        } else if known && v.t != 0 && r.hi.t != 0 {
            let o = compare_vals(in q, v, r.hi);
            if o == 0 || (o == 1 && !incl) {
                r.hi = v;
                r.hi_incl = incl;
            }
        }
    }
    r
}

// The sargable bounds on `slot` among the predicates of scan x.
pub fn bounds_of(in ds: D, in q: Q, x: Node, slot: u64) -> Bound {
    let mut b = no_bound();
    let mut l = x.f;
    loop {
        if l == none() {
            break;
        }
        let k = link(in q, l);
        l = k.next;
        let p = k.expr;
        if ex(in q, p) != 3 {
            continue_none();
        } else {
            let op = ex(in q, wrapping_add(p, 3));
            let a = wrapping_add(p, 4);
            let c = ex_end(in q, a);
            if op != 1 {
                if ex(in q, a) == 0 && ex(in q, wrapping_add(a, 3)) == slot {
                    let (is_op, v, known) = operand(in ds, in q, c);
                    if is_op {
                        b = tighten(in q, b, op, v, known);
                    }
                } else if ex(in q, c) == 0 && ex(in q, wrapping_add(c, 3)) == slot {
                    let (is_op, v, known) = operand(in ds, in q, a);
                    // `v > c` is `c < v`.
                    let flipped = if op == 2 {
                        4
                    } else if op == 3 {
                        5
                    } else if op == 4 {
                        2
                    } else if op == 5 {
                        3
                    } else {
                        op
                    };
                    if is_op {
                        b = tighten(in q, b, flipped, v, known);
                    }
                }
            }
        }
    }
    b
}

// The bound kind: eq 0, range 1, lower 2, upper 3.
pub fn bound_kind(in q: Q, b: Bound) -> u64 {
    if b.has_lo && b.has_hi {
        if b.lo_incl && b.hi_incl && !b.unknown && !b.null && compare_vals(in q, b.lo, b.hi) == 1 {
            0
        } else if (b.unknown || b.null) && b.only_eq {
            0
        } else {
            1
        }
    } else if b.has_lo {
        2
    } else {
        3
    }
}

// The estimated rows of an index path over column stats s.
pub fn index_rows(in ds: D, in q: Q, b: Bound, kind: u64, s: Stat, n: u64) -> u64 {
    if b.null {
        return 0;
    }
    if b.unknown {
        return if kind == 0 {
            if s.distinct == 0 {
                0
            } else {
                ceil_div(n, s.distinct)
            }
        } else if kind == 1 {
            ceil_div(n, RANGE_SELECTIVITY)
        } else {
            ceil_div(n, ONE_SIDED_SELECTIVITY)
        };
    }
    let mut m: u64 = 0;
    for i in 0..s.n {
        let v = vat(in ds, in q, wrapping_add(s.start, i));
        let above = if b.has_lo {
            let o = compare_vals(in q, v, b.lo);
            o == 2 || (o == 1 && b.lo_incl)
        } else {
            true
        };
        let below = if b.has_hi {
            let o = compare_vals(in q, v, b.hi);
            o == 0 || (o == 1 && b.hi_incl)
        } else {
            true
        };
        if above && below {
            m = wrapping_add(m, cw(in ds.counts, wrapping_add(s.start, i)));
        }
    }
    m
}

// The column position of a slot in scan x, or none.
pub fn column_of(in q: Q, x: Node, slot: u64) -> u64 {
    for k in 0..x.e {
        if ex(in q, wrapping_add(x.d, k)) == slot {
            return k;
        }
    }
    none()
}

// The catalog column position of the index at index-list entry i on the
// table of scan x, or none when the index is on another table.
pub fn index_column(in q: Q, x: Node, i: u64) -> u64 {
    let base = cw(in q.rows, 0);
    let at = wrapping_add(base, wrapping_mul(i, 6));
    if !same(in q.pool, ex(in q, wrapping_add(at, 2)), ex(in q, wrapping_add(at, 3)), x.a, x.b) {
        return none();
    }
    let t = find_table(in q, x.a, x.b);
    let tab = ctab(in q, t);
    for k in 0..tab.n {
        let c = ccol(in q, wrapping_add(tab.start, k));
        if same(
            in q.pool,
            c.noff,
            c.nlen,
            ex(in q, wrapping_add(at, 4)),
            ex(in q, wrapping_add(at, 5))
        ) {
            return k;
        }
    }
    none()
}

// Whether index name a sorts before index name b.
pub fn name_before(in q: Q, ao: u64, al: u64, bo: u64, bl: u64) -> bool {
    order(in q.pool, ao, al, bo, bl) == 0
}
