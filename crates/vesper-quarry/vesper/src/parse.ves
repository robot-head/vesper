// Module parse of @vesper/quarry (see lib.ves).
use self::{
    Bind,
    Q,
    Raw,
    Rng,
    Sel,
    Tok
};
use self::util::{
    bound,
    is_lit,
    none,
    put,
    put_u64,
    syntax,
    tk_int,
    tk_op,
    tk_param,
    tk_sym,
    tk_text,
    tk_word,
    tok
};

// ASCII bytes.
const LPAREN: u64 = 40;
const RPAREN: u64 = 41;
const STAR: u64 = 42;
const COMMA: u64 = 44;
const DOT: u64 = 46;
const SEMICOLON: u64 = 59;
const LOWER_A: u8 = 97;
const LOWER_B: u8 = 98;
const LOWER_C: u8 = 99;
const LOWER_D: u8 = 100;
const LOWER_F: u8 = 102;
const LOWER_G: u8 = 103;
const LOWER_H: u8 = 104;
const LOWER_I: u8 = 105;
const LOWER_J: u8 = 106;
const LOWER_L: u8 = 108;
const LOWER_N: u8 = 110;
const LOWER_O: u8 = 111;
const LOWER_R: u8 = 114;
const LOWER_S: u8 = 115;
const LOWER_T: u8 = 116;
const LOWER_U: u8 = 117;
const LOWER_W: u8 = 119;

// Reserved keyword ids (`Tok::kw`), 0 for an ordinary word.
pub fn kw_none() -> u64 {
    0
}

pub fn kw_select() -> u64 {
    1
}

pub fn kw_from() -> u64 {
    2
}

pub fn kw_where() -> u64 {
    3
}

pub fn kw_join() -> u64 {
    4
}

pub fn kw_inner() -> u64 {
    5
}

pub fn kw_left() -> u64 {
    6
}

pub fn kw_right() -> u64 {
    7
}

pub fn kw_full() -> u64 {
    8
}

pub fn kw_outer() -> u64 {
    9
}

pub fn kw_on() -> u64 {
    10
}

pub fn kw_as() -> u64 {
    11
}

pub fn kw_and() -> u64 {
    12
}

pub fn kw_or() -> u64 {
    13
}

pub fn kw_not() -> u64 {
    14
}

pub fn kw_is() -> u64 {
    15
}

pub fn kw_null() -> u64 {
    16
}

pub fn kw_true() -> u64 {
    17
}

pub fn kw_false() -> u64 {
    18
}

pub fn kw_create() -> u64 {
    19
}

pub fn kw_drop() -> u64 {
    20
}

pub fn kw_table() -> u64 {
    21
}

pub fn kw_order() -> u64 {
    22
}

pub fn kw_by() -> u64 {
    23
}

pub fn kw_group() -> u64 {
    24
}

pub fn kw_limit() -> u64 {
    25
}

pub fn kw_union() -> u64 {
    26
}

pub fn kw_distinct() -> u64 {
    27
}

pub fn kw_having() -> u64 {
    28
}

pub fn kw_offset() -> u64 {
    29
}

pub fn kw_cross() -> u64 {
    30
}

pub fn kw_using() -> u64 {
    31
}

// Parser (src/parse.rs `Parser`).

pub fn at_end(in q: Q) -> bool {
    q.pos >= q.toks.len()
}

pub fn peek_is_word(in q: Q, kw: u64) -> bool {
    let t = tok(in q, q.pos);
    t.kind == tk_word() && t.kw == kw
}

pub fn peek_is_sym(in q: Q, c: u64) -> bool {
    let t = tok(in q, q.pos);
    t.kind == tk_sym() && t.a == c
}

pub fn word(inout q: Q, kw: u64) -> bool {
    if q.err == 0 && peek_is_word(in q, kw) {
        q.pos = wrapping_add(q.pos, 1);
        true
    } else {
        false
    }
}

pub fn sym(inout q: Q, c: u64) -> bool {
    if q.err == 0 && peek_is_sym(in q, c) {
        q.pos = wrapping_add(q.pos, 1);
        true
    } else {
        false
    }
}

pub fn expect_word(inout q: Q, kw: u64, in s: Str) {
    if !word(inout q, kw) && q.err == 0 {
        q.err = 1;
        put(inout q.msg, "expected ");
        put(inout q.msg, s);
        put(inout q.msg, " near token ");
        put_u64(inout q.msg, q.pos);
    }
}

pub fn expect_sym(inout q: Q, c: u64) {
    if !sym(inout q, c) && q.err == 0 {
        q.err = 1;
        put(inout q.msg, "expected ");
        q.msg.push(wrapping_u8(c));
        put(inout q.msg, " near token ");
        put_u64(inout q.msg, q.pos);
    }
}

// `take`: the next token, or the "unexpected end" error (kind 0).
pub fn take(inout q: Q) -> Tok {
    if q.err != 0 {
        return tok(in q, none());
    }
    if at_end(in q) {
        syntax(inout q, "unexpected end");
        return tok(in q, none());
    }
    let t = tok(in q, q.pos);
    q.pos = wrapping_add(q.pos, 1);
    t
}

// The reserved keyword id of a lowercase word (`Tok::kw`), or 0.
pub fn keyword(in p: ChunkSeq[u8], off: u64, len: u64) -> u64 {
    let c = match p.try_get(off) {
        Option::Some(c) => c,
        Option::None => 0,
    };
    if len == 2 {
        if c == LOWER_O && is_lit(in p, off, len, "on") {
            return kw_on();
        }
        if c == LOWER_A && is_lit(in p, off, len, "as") {
            return kw_as();
        }
        if c == LOWER_O && is_lit(in p, off, len, "or") {
            return kw_or();
        }
        if c == LOWER_I && is_lit(in p, off, len, "is") {
            return kw_is();
        }
        if c == LOWER_B && is_lit(in p, off, len, "by") {
            return kw_by();
        }
    } else if len == 3 {
        if c == LOWER_A && is_lit(in p, off, len, "and") {
            return kw_and();
        }
        if c == LOWER_N && is_lit(in p, off, len, "not") {
            return kw_not();
        }
    } else if len == 4 {
        if c == LOWER_F && is_lit(in p, off, len, "from") {
            return kw_from();
        }
        if c == LOWER_J && is_lit(in p, off, len, "join") {
            return kw_join();
        }
        if c == LOWER_L && is_lit(in p, off, len, "left") {
            return kw_left();
        }
        if c == LOWER_F && is_lit(in p, off, len, "full") {
            return kw_full();
        }
        if c == LOWER_N && is_lit(in p, off, len, "null") {
            return kw_null();
        }
        if c == LOWER_T && is_lit(in p, off, len, "true") {
            return kw_true();
        }
        if c == LOWER_D && is_lit(in p, off, len, "drop") {
            return kw_drop();
        }
    } else if len == 5 {
        if c == LOWER_W && is_lit(in p, off, len, "where") {
            return kw_where();
        }
        if c == LOWER_I && is_lit(in p, off, len, "inner") {
            return kw_inner();
        }
        if c == LOWER_R && is_lit(in p, off, len, "right") {
            return kw_right();
        }
        if c == LOWER_O && is_lit(in p, off, len, "outer") {
            return kw_outer();
        }
        if c == LOWER_F && is_lit(in p, off, len, "false") {
            return kw_false();
        }
        if c == LOWER_T && is_lit(in p, off, len, "table") {
            return kw_table();
        }
        if c == LOWER_O && is_lit(in p, off, len, "order") {
            return kw_order();
        }
        if c == LOWER_G && is_lit(in p, off, len, "group") {
            return kw_group();
        }
        if c == LOWER_L && is_lit(in p, off, len, "limit") {
            return kw_limit();
        }
        if c == LOWER_U && is_lit(in p, off, len, "union") {
            return kw_union();
        }
        if c == LOWER_C && is_lit(in p, off, len, "cross") {
            return kw_cross();
        }
        if c == LOWER_U && is_lit(in p, off, len, "using") {
            return kw_using();
        }
    } else if len == 6 {
        if c == LOWER_S && is_lit(in p, off, len, "select") {
            return kw_select();
        }
        if c == LOWER_C && is_lit(in p, off, len, "create") {
            return kw_create();
        }
        if c == LOWER_H && is_lit(in p, off, len, "having") {
            return kw_having();
        }
        if c == LOWER_O && is_lit(in p, off, len, "offset") {
            return kw_offset();
        }
    } else if len == 8 {
        if c == LOWER_D && is_lit(in p, off, len, "distinct") {
            return kw_distinct();
        }
    }
    0
}

// A non-keyword identifier, as a pool range.
pub fn ident(inout q: Q) -> Rng {
    let t = take(inout q);
    if q.err != 0 {
        return Rng {
            off: 0,
            len: 0
        };
    }
    if t.kind == tk_word() && t.kw == kw_none() {
        Rng {
            off: t.a,
            len: t.b
        }
    } else {
        syntax(inout q, "expected non-keyword identifier");
        Rng {
            off: 0,
            len: 0
        }
    }
}

// Count one expression node and store it.
pub fn push_raw(inout q: Q, r: Raw) -> u64 {
    if q.err != 0 {
        return none();
    }
    q.nodes = wrapping_add(q.nodes, 1);
    let bn = q.nodes;
    if !bound(inout q, bn, 2, "expression node limit") {
        return none();
    }
    q.raw.push(r);
    wrapping_sub(q.raw.len(), 1)
}

pub fn raw2(kind: u64, a: u64, b: u64, c: u64) -> Raw {
    Raw {
        kind: kind,
        a: a,
        b: b,
        c: c,
        d: 0
    }
}

pub fn parse_expr(inout q: Q, depth: u64) -> u64 {
    let bn = depth;
    if !bound(inout q, bn, 3, "expression nesting limit") {
        return none();
    }
    let mut lhs = parse_and(inout q, depth);
    loop {
        if q.err != 0 || !word(inout q, kw_or()) {
            break;
        }
        let rhs = parse_and(inout q, depth);
        if q.err != 0 {
            break;
        }
        lhs = push_raw(inout q, raw2(5, 0, lhs, rhs));
    }
    lhs
}

pub fn parse_and(inout q: Q, depth: u64) -> u64 {
    let mut lhs = parse_not(inout q, depth);
    loop {
        if q.err != 0 || !word(inout q, kw_and()) {
            break;
        }
        let rhs = parse_not(inout q, depth);
        if q.err != 0 {
            break;
        }
        lhs = push_raw(inout q, raw2(4, 0, lhs, rhs));
    }
    lhs
}

pub fn parse_not(inout q: Q, depth: u64) -> u64 {
    let bn = depth;
    if !bound(inout q, bn, 3, "expression nesting limit") {
        return none();
    }
    if word(inout q, kw_not()) {
        let x = parse_not(inout q, wrapping_add(depth, 1));
        return push_raw(inout q, raw2(6, 0, x, 0));
    }
    let lhs = parse_atom(inout q, depth);
    if q.err != 0 {
        return none();
    }
    let t = tok(in q, q.pos);
    if t.kind == tk_op() {
        q.pos = wrapping_add(q.pos, 1);
        let rhs = parse_atom(inout q, depth);
        push_raw(inout q, raw2(3, t.a, lhs, rhs))
    } else if word(inout q, kw_is()) {
        let negated = word(inout q, kw_not());
        expect_word(inout q, kw_null(), "null");
        push_raw(
            inout q,
            raw2(
                7,
                if negated {
                    1
                } else {
                    0
                },
                lhs,
                0
            )
        )
    } else {
        lhs
    }
}

pub fn parse_atom(inout q: Q, depth: u64) -> u64 {
    if sym(inout q, LPAREN) {
        let x = parse_expr(inout q, wrapping_add(depth, 1));
        expect_sym(inout q, RPAREN);
        return x;
    }
    let t = take(inout q);
    if q.err != 0 {
        return none();
    }
    let r = if t.kind == tk_param() {
        raw2(1, t.a, t.b, 0)
    } else if t.kind == tk_int() {
        Raw {
            kind: 2,
            a: 2,
            b: t.a,
            c: 0,
            d: 0
        }
    } else if t.kind == tk_text() {
        Raw {
            kind: 2,
            a: 5,
            b: t.a,
            c: t.b,
            d: 0
        }
    } else if t.kind == tk_word() && t.kw == kw_null() {
        Raw {
            kind: 2,
            a: 0,
            b: 0,
            c: 0,
            d: 0
        }
    } else if t.kind == tk_word() && (t.kw == kw_true() || t.kw == kw_false()) {
        Raw {
            kind: 2,
            a: 4,
            b: if t.kw == kw_true() {
                1
            } else {
                0
            },
            c: 0,
            d: 0
        }
    } else if t.kind == tk_word() && t.kw == kw_none() {
        if sym(inout q, DOT) {
            let name = ident(inout q);
            Raw {
                kind: 0,
                a: t.a,
                b: t.b,
                c: name.off,
                d: name.len
            }
        } else {
            Raw {
                kind: 0,
                a: none(),
                b: 0,
                c: t.a,
                d: t.b
            }
        }
    } else {
        syntax(inout q, "expected scalar expression");
        return none();
    };
    push_raw(inout q, r)
}

pub fn parse_table(inout q: Q, kind: u64) -> Bind {
    let name = ident(inout q);
    let t = tok(in q, q.pos);
    let plain = q.err == 0 && t.kind == tk_word() && t.kw == kw_none();
    let alias = if word(inout q, kw_as()) || plain {
        ident(inout q)
    } else {
        name
    };
    Bind {
        kind: kind,
        noff: name.off,
        nlen: name.len,
        aoff: alias.off,
        alen: alias.len,
        on: none()
    }
}

pub fn finish(inout q: Q) {
    sym(inout q, SEMICOLON);
    if q.err == 0 && !at_end(in q) {
        syntax(inout q, "unsupported or trailing syntax");
    }
}

// SELECT: fills sels, binds (the FROM binding first) and filter.
pub fn parse_select(inout q: Q) {
    expect_word(inout q, kw_select(), "select");
    loop {
        if q.err != 0 {
            return;
        }
        let star = sym(inout q, STAR);
        let expr = if star {
            none()
        } else {
            parse_expr(inout q, 0)
        };
        let mut aoff = none();
        let mut alen: u64 = 0;
        if word(inout q, kw_as()) {
            let a = ident(inout q);
            aoff = a.off;
            alen = a.len;
        }
        if q.err != 0 {
            return;
        }
        if star && aoff != none() {
            syntax(inout q, "star cannot be aliased");
            return;
        }
        q
            .sels
            .push(
                Sel {
                    expr: expr,
                    aoff: aoff,
                    alen: alen
                }
            );
        let bn = q.sels.len();
        if !bound(inout q, bn, 2, "projection limit") {
            return;
        }
        if !sym(inout q, COMMA) {
            break;
        }
    }
    expect_word(inout q, kw_from(), "from");
    let from = parse_table(inout q, 0);
    if q.err != 0 {
        return;
    }
    q.binds.push(from);
    let bn: u64 = 1;
    if !bound(inout q, bn, 6, "relation limit") {
        return;
    }
    loop {
        if q.err != 0
            || at_end(in q)
            || peek_is_sym(in q, SEMICOLON)
            || peek_is_word(in q, kw_where()) {
            break;
        }
        let kind: u64 = if word(inout q, kw_inner()) {
            0
        } else if word(inout q, kw_left()) {
            word(inout q, kw_outer());
            1
        } else if word(inout q, kw_right()) {
            word(inout q, kw_outer());
            2
        } else if word(inout q, kw_full()) {
            word(inout q, kw_outer());
            3
        } else {
            0
        };
        expect_word(inout q, kw_join(), "join");
        if q.err != 0 {
            return;
        }
        // binds holds the FROM binding too, so its length is joins + 1.
        let bn = wrapping_add(q.binds.len(), 1);
        if !bound(inout q, bn, 6, "relation limit") {
            return;
        }
        let mut rhs = parse_table(inout q, kind);
        expect_word(inout q, kw_on(), "on");
        let on = parse_expr(inout q, 0);
        if q.err != 0 {
            return;
        }
        rhs.on = on;
        q.binds.push(rhs);
    }
    if word(inout q, kw_where()) {
        q.filter = parse_expr(inout q, 0);
    }
    finish(inout q);
}
