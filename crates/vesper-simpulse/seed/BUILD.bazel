# The frozen Rust seed copy of vesper-simpulse (package vesper-simpulse-seed,
# library vesper_simpulse) that the compiler and the crates it links use: the
# shared API in ../src/lib.rs (cfg(vesper_port) off) over the Rust Simulator
# in src/reference.rs. Written by hand because part of its sources live in
# the parent package; see "Crates the compiler links" in
# docs/maintenance/porting-a-crate.md.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("@vesper_cargo//:packages.bzl", "PACKAGES")

# serde and serde_json, as Cargo resolves them for this package.
_DATA = PACKAGES["crates/vesper-simpulse/seed"].crate_data()

rust_library(
    name = "seed",
    srcs = glob(["src/**/*.rs"]) + ["//crates/vesper-simpulse:rust_srcs"],
    compile_data = ["//crates/vesper-simpulse:README.md"],
    crate_name = "vesper_simpulse",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_PKG_NAME": "vesper-simpulse-seed",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        _DATA,
        normal = True,
        platforms = _DATA["platforms"],
    ),
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    compile_data = ["//crates/vesper-simpulse:README.md"],
    edition = "2024",
)

rust_test(
    name = "seed_test_kernel",
    srcs = ["//crates/vesper-simpulse:tests/kernel.rs"],
    crate_root = "//crates/vesper-simpulse:tests/kernel.rs",
    edition = "2024",
    deps = [":seed"] + all_crate_deps(
        _DATA,
        normal = True,
        platforms = _DATA["platforms"],
    ),
)

rust_test(
    name = "seed_test_stress",
    srcs = [
        "//crates/vesper-simpulse:tests/stress.rs",
        "//crates/vesper-simpulse:workload/mod.rs",
    ],
    crate_root = "//crates/vesper-simpulse:tests/stress.rs",
    edition = "2024",
    deps = [":seed"],
)

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
