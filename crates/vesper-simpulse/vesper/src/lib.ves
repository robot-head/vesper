// Vesper port of vesper-simpulse (port wave P1 lane 5, #902): the seeded
// SimPulse scheduling kernel of manuscript §14.6 (src/reference.rs is the
// model). One module, as the Rust crate has one.
//
// `Kernel` holds every scheduling decision: the run queue and its rounds,
// the virtual clock, the timers and injected completions, cancellation
// flags, the SplitMix64 choice, and the record/replay check. The Rust
// `Simulator<T>` wrapper (src/ported.rs) keeps only what Vesper cannot
// hold: the generic payloads (a token slab indexed by task id), the
// simulator instance identity that makes a token foreign, and the serde
// `Journal` it fills from `out`, so trace bytes stay those of the Rust
// build.
//
// Ids are dense: task `t` is entry `t - 1` of every `t_*` sequence and
// completion `c` is entry `c - 1` of every `p_*` sequence, because neither
// is ever reused. Scheduled timers and injected completions live in a
// binary min-heap keyed by `(deadline, completion)`, the order of the Rust
// build's `BTreeMap`; an entry whose completion is no longer pending is
// stale and is dropped when it reaches the top.
//
// Codes shared with the wrapper are the value enums below: `Code`,
// `State`, `Wake`, `EvKind` and `Cancel`. The kernel only carries the I/O
// result `rk` (0 Success with `rv` bytes, 1 Error with the i32 code
// sign-extended in `rv`, 2 Cancelled), which the wrapper encodes.

// `Ret.code`: ok, or the error (`value` is the id or the event index;
// `kernel_mismatch` is the event computed).
enum Code: _ {
    Ok,
    UnknownTask,
    UnknownCompletion,
    TaskFinished,
    TaskStillRunning,
    InvalidToken,
    ForeignToken,
    IdExhausted,
    ClockOverflow,
    RoundOverflow,
    ReplayMismatch
}

// Task states; `None` is the `St.kind` of an unknown task.
enum State: _ {
    Ready,
    Running,
    Sleeping,
    WaitingIo,
    Finished,
    None
}

// Wake reasons.
enum Wake: _ {
    Start,
    Yield,
    Timer,
    Io
}

// Event kinds. Unused fields are 0, so equal events are equal words.
enum EvKind: _ {
    Spawn,
    Dispatch,
    Yield,
    Sleep,
    SubmitIo,
    ClockAdvance,
    TimerElapsed,
    IoCompleted,
    CancelRequested,
    Finish
}

// `kernel_cancel_requested`.
enum Cancel: _ {
    No,
    Yes,
    UnknownTask
}

// `Ev.b` of a SubmitIo whose completion is scheduled.
const SUBMIT_SCHEDULED: u64 = 1;

// A trace event. `a` is the time (`at_ns`, `deadline_ns`, the scheduled
// time of SubmitIo, `from_ns`), `b` the round of Dispatch, `to_ns` of
// ClockAdvance, or 1 when SubmitIo is scheduled.
pub copy struct Ev {
    kind: u64,
    task: u64,
    completion: u64,
    a: u64,
    b: u64,
    rk: u64,
    rv: u64
}

impl Eq for Ev {}

// The result of an operation: `code` 0 and the result in `value`, or an
// error code and its payload.
pub copy struct Ret {
    code: u64,
    value: u64
}

// `next_task`: `task` 0 is None. The wake reason and cancellation flag
// belong to the token the wrapper builds.
pub copy struct Next {
    code: u64,
    task: u64,
    wk: u64,
    wc: u64,
    wrk: u64,
    wrv: u64,
    cancel: bool
}

// `task_state`: `kind` is a `State`.
pub copy struct St {
    kind: u64,
    completion: u64,
    deadline: u64
}

pub struct Kernel {
    now: u64,
    rng: u64,
    round: u64,
    next_task: u64,
    next_completion: u64,
    // The checked-out task, or 0.
    running: u64,
    finished_n: u64,
    pending_n: u64,
    replay: bool,
    cursor: u64,
    expected: ChunkSeq[Ev],
    // Events the last operation committed while recording.
    out: ChunkSeq[Ev],
    // Events of the operation in progress.
    batch: ChunkSeq[Ev],
    mismatch: Ev,
    t_state: ChunkSeq[u64],
    t_completion: ChunkSeq[u64],
    t_deadline: ChunkSeq[u64],
    t_wake: ChunkSeq[u64],
    t_wake_completion: ChunkSeq[u64],
    t_wake_rk: ChunkSeq[u64],
    t_wake_rv: ChunkSeq[u64],
    t_cancel: ChunkSeq[bool],
    t_seen: ChunkSeq[bool],
    // The task a completion is pending for, or 0 once it is not pending.
    p_task: ChunkSeq[u64],
    p_scheduled: ChunkSeq[bool],
    p_time: ChunkSeq[u64],
    // 0 timer, 1 injected I/O result.
    p_io: ChunkSeq[bool],
    p_rk: ChunkSeq[u64],
    p_rv: ChunkSeq[u64],
    h_time: ChunkSeq[u64],
    h_completion: ChunkSeq[u64],
    // Completions taken off the heap by the `next_task` in progress.
    due: ChunkSeq[u64],
    // Fenwick trees over task ids (entry 0 unused): `f_ready` counts the
    // runnable tasks, `f_cand` those not yet dispatched this round, so the
    // dispatch picks the `i`-th one in id order in O(log tasks). `in_*` is
    // each task's membership and `*_total` the count.
    f_ready: ChunkSeq[u64],
    f_cand: ChunkSeq[u64],
    in_ready: ChunkSeq[bool],
    in_cand: ChunkSeq[bool],
    // The tasks dispatched this round.
    seen_list: ChunkSeq[u64],
    ready_total: u64,
    cand_total: u64
}

// ---------------------------------------------------------------------------
// Helpers.

const MAX_U64: u64 = 18446744073709551615;

fn at(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn atb(in s: Slice[bool], i: u64) -> bool {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => false,
    }
}

fn inc(x: u64) -> u64 {
    wrapping_add(x, 1)
}

fn dec(x: u64) -> u64 {
    wrapping_sub(x, 1)
}

// `a % b` for `b > 0`.
fn rem(a: u64, b: u64) -> u64 {
    if b == 0 {
        return 0;
    }
    handle Fail[RuntimeError] in {
        a % b
    } with {
        return v => v,
        raise(e, k) => 0,
    }
}

fn ok(value: u64) -> Ret {
    Ret {
        code: Code::Ok,
        value: value
    }
}

fn err(code: u64, value: u64) -> Ret {
    Ret {
        code: code,
        value: value
    }
}

fn ev(kind: u64, task: u64, completion: u64, a: u64, b: u64) -> Ev {
    Ev {
        kind: kind,
        task: task,
        completion: completion,
        a: a,
        b: b,
        rk: 0,
        rv: 0
    }
}

fn ev_io(kind: u64, task: u64, completion: u64, a: u64, b: u64, rk: u64, rv: u64) -> Ev {
    Ev {
        kind: kind,
        task: task,
        completion: completion,
        a: a,
        b: b,
        rk: rk,
        rv: rv
    }
}

// SplitMix64.
fn random(seedv: u64) -> u64 {
    let mut z = seedv;
    z = wrapping_mul(z ^ (z >> 30), 0xbf58476d1ce4e5b9);
    z = wrapping_mul(z ^ (z >> 27), 0x94d049bb133111eb);
    z ^ (z >> 31)
}

// ---------------------------------------------------------------------------
// Fenwick trees of 0/1 counts, 1-based (`t[0]` is unused).

fn low_bit(i: u64) -> u64 {
    i & wrapping_sub(0, i)
}

fn fen_new() -> ChunkSeq[u64] {
    let mut t: ChunkSeq[u64] = ChunkSeq::new[u64]();
    t.push(0);
    t
}

// The sum of positions `1 ..= pos`.
fn fen_prefix(in t: Slice[u64], pos: u64) -> u64 {
    let mut sum: u64 = 0;
    let mut i = pos;
    loop {
        if i == 0 {
            break sum;
        }
        sum = wrapping_add(sum, at(in t, i));
        i = wrapping_sub(i, low_bit(i));
    }
}

// Add `d` (wrapping, so `MAX_U64` subtracts one) at `pos`.
fn fen_add(inout t: ChunkSeq[u64], pos: u64, d: u64) {
    let n = t.len();
    let mut i = pos;
    loop {
        if i == 0 || i >= n {
            break;
        }
        let v = at(in t.as_slice(), i);
        t.try_set(i, wrapping_add(v, d));
        i = wrapping_add(i, low_bit(i));
    }
}

// Append a position holding `v`.
fn fen_push(inout t: ChunkSeq[u64], v: u64) {
    let i = t.len();
    let below = wrapping_sub(i, low_bit(i));
    let covered = wrapping_sub(
        fen_prefix(in t.as_slice(), dec(i)),
        fen_prefix(in t.as_slice(), below)
    );
    t.push(wrapping_add(v, covered));
}

// The position of the one of rank `rank` (0 is the first), for
// `rank < total`.
fn fen_select(in t: Slice[u64], rank: u64) -> u64 {
    let n = dec(t.len());
    let mut step: u64 = 1;
    loop {
        if step > (n >> 1) {
            break;
        }
        step = wrapping_add(step, step);
    }
    let mut pos: u64 = 0;
    let mut rest = rank;
    loop {
        if step == 0 {
            break;
        }
        let next = wrapping_add(pos, step);
        if next <= n {
            let v = at(in t, next);
            if v <= rest {
                pos = next;
                rest = wrapping_sub(rest, v);
            }
        }
        step = step >> 1;
    }
    inc(pos)
}

fn empty_kernel(seed: u64, replay: bool, sink expected: ChunkSeq[Ev]) -> Kernel {
    Kernel {
        now: 0,
        rng: seed,
        round: 0,
        next_task: 1,
        next_completion: 1,
        running: 0,
        finished_n: 0,
        pending_n: 0,
        replay: replay,
        cursor: 0,
        expected: expected,
        out: ChunkSeq::new[Ev](),
        batch: ChunkSeq::new[Ev](),
        mismatch: ev(EvKind::Spawn, 0, 0, 0, 0),
        t_state: ChunkSeq::new[u64](),
        t_completion: ChunkSeq::new[u64](),
        t_deadline: ChunkSeq::new[u64](),
        t_wake: ChunkSeq::new[u64](),
        t_wake_completion: ChunkSeq::new[u64](),
        t_wake_rk: ChunkSeq::new[u64](),
        t_wake_rv: ChunkSeq::new[u64](),
        t_cancel: ChunkSeq::new[bool](),
        t_seen: ChunkSeq::new[bool](),
        p_task: ChunkSeq::new[u64](),
        p_scheduled: ChunkSeq::new[bool](),
        p_time: ChunkSeq::new[u64](),
        p_io: ChunkSeq::new[bool](),
        p_rk: ChunkSeq::new[u64](),
        p_rv: ChunkSeq::new[u64](),
        h_time: ChunkSeq::new[u64](),
        h_completion: ChunkSeq::new[u64](),
        due: ChunkSeq::new[u64](),
        f_ready: fen_new(),
        f_cand: fen_new(),
        in_ready: ChunkSeq::new[bool](),
        in_cand: ChunkSeq::new[bool](),
        seen_list: ChunkSeq::new[u64](),
        ready_total: 0,
        cand_total: 0
    }
}

// ---------------------------------------------------------------------------
// Reads.

impl Kernel {
    fn known(in self, task: u64) -> bool {
        task >= 1 && task < self.next_task
    }

    fn state_of(in self, task: u64) -> u64 {
        at(in self.t_state.as_slice(), dec(task))
    }

    fn task_completion(in self, task: u64) -> u64 {
        at(in self.t_completion.as_slice(), dec(task))
    }

    fn pending_task(in self, completion: u64) -> u64 {
        at(in self.p_task.as_slice(), dec(completion))
    }

    // The token check: 0, or the error code (ForeignToken, InvalidToken).
    fn token_fault(in self, task: u64, own: bool) -> u64 {
        if !own {
            Code::ForeignToken
        } else if self
            .running
            != task
            || !self
            .known(task)
            || self
            .state_of(task)
            != State::Running {
            Code::InvalidToken
        } else {
            Code::Ok
        }
    }

    // `(t_a, c_a) < (t_b, c_b)` for heap entries `a` and `b`.
    fn heap_less(in self, a: u64, b: u64) -> bool {
        let ta = at(in self.h_time.as_slice(), a);
        let tb = at(in self.h_time.as_slice(), b);
        if ta != tb {
            ta < tb
        } else {
            at(in self.h_completion.as_slice(), a) < at(in self.h_completion.as_slice(), b)
        }
    }

    // The batch matches the journal from the cursor on (always true while
    // recording); on a mismatch, the index and the event are kept.
    fn batch_fault(inout self) -> Ret {
        if !self.replay {
            return ok(0);
        }
        let n = self.batch.len();
        let mut i: u64 = 0;
        loop {
            if i >= n {
                break ok(0);
            }
            let index = wrapping_add(self.cursor, i);
            let actual = match self.batch.try_get(i) {
                Option::Some(e) => e,
                Option::None => ev(EvKind::Spawn, 0, 0, 0, 0),
            };
            let same = match self.expected.try_get(index) {
                Option::Some(e) => e == actual,
                Option::None => false,
            };
            if !same {
                self.mismatch = actual;
                break err(Code::ReplayMismatch, index);
            }
            i = inc(i);
        }
    }
}

// ---------------------------------------------------------------------------
// Updates.

impl Kernel {
    fn begin(inout self) {
        self.out.clear();
        self.batch.clear();
    }

    fn one(inout self, e: Ev) {
        self.batch.clear();
        self.batch.push(e);
    }

    // Commit the checked batch.
    fn commit(inout self) {
        let n = self.batch.len();
        if self.replay {
            self.cursor = wrapping_add(self.cursor, n);
        } else {
            for i in 0..n {
                match self.batch.try_get(i) {
                    Option::Some(e) => self.out.push(e),
                    Option::None => (),
                }
            }
        }
    }

    fn set_state(inout self, task: u64, to: u64) {
        let i = dec(task);
        self.mark(task, to == State::Ready);
        if to == State::Finished {
            self.finished_n = inc(self.finished_n);
        }
        self.t_state.try_set(i, to);
    }

    // Make `task` runnable or not in the dispatch trees; it is a candidate
    // when runnable and not yet dispatched this round.
    fn mark(inout self, task: u64, ready: bool) {
        let i = dec(task);
        if ready != atb(in self.in_ready.as_slice(), i) {
            self.in_ready.try_set(i, ready);
            let d = if ready {
                1
            } else {
                MAX_U64
            };
            fen_add(inout self.f_ready, task, d);
            self.ready_total = wrapping_add(self.ready_total, d);
        }
        let cand = ready && !atb(in self.t_seen.as_slice(), i);
        if cand != atb(in self.in_cand.as_slice(), i) {
            self.in_cand.try_set(i, cand);
            let d = if cand {
                1
            } else {
                MAX_U64
            };
            fen_add(inout self.f_cand, task, d);
            self.cand_total = wrapping_add(self.cand_total, d);
        }
    }

    // A new round: no task has been dispatched in it. Every runnable task
    // was dispatched in the last one, so only those need a look.
    fn new_round(inout self) {
        let n = self.seen_list.len();
        for j in 0..n {
            let task = at(in self.seen_list.as_slice(), j);
            let i = dec(task);
            self.t_seen.try_set(i, false);
            let ready = atb(in self.in_ready.as_slice(), i);
            self.mark(task, ready);
        }
        self.seen_list.clear();
    }

    // Undo the tentative wake-ups of a rejected dispatch.
    fn unwake_due(inout self) {
        let n = self.due.len();
        for i in 0..n {
            let c = at(in self.due.as_slice(), i);
            let task = at(in self.p_task.as_slice(), dec(c));
            self.mark(task, false);
        }
    }

    fn set_wake(inout self, task: u64, wake: u64, completion: u64, rk: u64, rv: u64) {
        let i = dec(task);
        self.t_wake.try_set(i, wake);
        self.t_wake_completion.try_set(i, completion);
        self.t_wake_rk.try_set(i, rk);
        self.t_wake_rv.try_set(i, rv);
    }

    fn heap_swap(inout self, a: u64, b: u64) {
        let ta = at(in self.h_time.as_slice(), a);
        let ca = at(in self.h_completion.as_slice(), a);
        let tb = at(in self.h_time.as_slice(), b);
        let cb = at(in self.h_completion.as_slice(), b);
        self.h_time.try_set(a, tb);
        self.h_completion.try_set(a, cb);
        self.h_time.try_set(b, ta);
        self.h_completion.try_set(b, ca);
    }

    fn heap_push(inout self, time: u64, completion: u64) {
        self.h_time.push(time);
        self.h_completion.push(completion);
        let mut i = dec(self.h_time.len());
        loop {
            if i == 0 {
                break;
            }
            let parent = (dec(i)) >> 1;
            if !self.heap_less(i, parent) {
                break;
            }
            self.heap_swap(i, parent);
            i = parent;
        }
    }

    // Remove the top entry.
    fn heap_pop(inout self) {
        let n = self.h_time.len();
        if n == 0 {
            return;
        }
        let last = dec(n);
        let lt = at(in self.h_time.as_slice(), last);
        let lc = at(in self.h_completion.as_slice(), last);
        self.h_time.try_set(0, lt);
        self.h_completion.try_set(0, lc);
        self.h_time.truncate(last);
        self.h_completion.truncate(last);
        let mut i: u64 = 0;
        loop {
            let l = inc(wrapping_add(i, i));
            if l >= last {
                break;
            }
            let r = inc(l);
            let mut m = l;
            if r < last && self.heap_less(r, l) {
                m = r;
            }
            if !self.heap_less(m, i) {
                break;
            }
            self.heap_swap(i, m);
            i = m;
        }
    }

    // Drop stale entries at the top; the earliest live deadline, if any.
    fn heap_top(inout self) -> Option[u64] {
        loop {
            if self.h_time.len() == 0 {
                break Option::None;
            }
            let c = at(in self.h_completion.as_slice(), 0);
            let i = dec(c);
            if at(in self.p_task.as_slice(), i) != 0 && atb(in self.p_scheduled.as_slice(), i) {
                break Option::Some(at(in self.h_time.as_slice(), 0));
            }
            self.heap_pop();
        }
    }

    // Put the completions of `due` back on the heap (a rejected dispatch).
    fn restore_due(inout self) {
        let n = self.due.len();
        for i in 0..n {
            let c = at(in self.due.as_slice(), i);
            let t = at(in self.p_time.as_slice(), dec(c));
            self.heap_push(t, c);
        }
        self.due.clear();
    }

    // Park the running token: a timer (`scheduled`, not `io`), an injected
    // completion (`scheduled` and `io`), or external I/O (neither).
    fn park(
        inout self,
        task: u64,
        own: bool,
        scheduled: bool,
        io: bool,
        time: u64,
        rk: u64,
        rv: u64
    ) -> Ret {
        let completion = self.next_completion;
        if completion == MAX_U64 {
            return err(Code::IdExhausted, 0);
        }
        let token = self.token_fault(task, own);
        if token != Code::Ok {
            return err(token, task);
        }
        if scheduled && !io {
            self.one(ev(EvKind::Sleep, task, completion, time, 0));
        } else if scheduled {
            self.one(ev_io(EvKind::SubmitIo, task, completion, time, SUBMIT_SCHEDULED, rk, rv));
        } else {
            self.one(ev(EvKind::SubmitIo, task, completion, 0, 0));
        }
        let fault = self.batch_fault();
        if fault.code != Code::Ok {
            return fault;
        }
        let i = dec(task);
        if scheduled && !io {
            self.set_state(task, State::Sleeping);
            self.t_deadline.try_set(i, time);
        } else {
            self.set_state(task, State::WaitingIo);
            self.t_deadline.try_set(i, 0);
        }
        self.t_completion.try_set(i, completion);
        self.p_task.push(task);
        self.p_scheduled.push(scheduled);
        self.p_time.push(time);
        self.p_io.push(io);
        self.p_rk.push(rk);
        self.p_rv.push(rv);
        self.pending_n = inc(self.pending_n);
        if scheduled {
            self.heap_push(time, completion);
        }
        self.next_completion = inc(completion);
        self.running = 0;
        self.commit();
        ok(completion)
    }
}

// ---------------------------------------------------------------------------
// The exported kernel.

pub fn kernel_new(seed: u64) -> Kernel {
    empty_kernel(seed, false, ChunkSeq::new[Ev]())
}

// Replay `events` from a journal whose version the wrapper checked.
pub fn kernel_replay(seed: u64, in events: Slice[Ev]) -> Kernel {
    let n = events.len();
    let mut expected: ChunkSeq[Ev] = ChunkSeq::with_capacity[Ev](n);
    for i in 0..n {
        match events.try_get(i) {
            Option::Some(e) => expected.push(e),
            Option::None => (),
        }
    }
    empty_kernel(seed, true, expected)
}

pub fn kernel_now_ns(in k: Kernel) -> u64 {
    k.now
}

pub fn kernel_task_state(in k: Kernel, task: u64) -> St {
    if !k.known(task) {
        return St {
            kind: State::None,
            completion: 0,
            deadline: 0
        };
    }
    let i = dec(task);
    St {
        kind: at(in k.t_state.as_slice(), i),
        completion: at(in k.t_completion.as_slice(), i),
        deadline: at(in k.t_deadline.as_slice(), i)
    }
}

pub fn kernel_cancel_requested(in k: Kernel, task: u64) -> u64 {
    if !k.known(task) {
        Cancel::UnknownTask
    } else if atb(in k.t_cancel.as_slice(), dec(task)) {
        Cancel::Yes
    } else {
        Cancel::No
    }
}

pub fn kernel_pending_count(in k: Kernel) -> u64 {
    k.pending_n
}

pub fn kernel_is_complete(in k: Kernel) -> bool {
    k.finished_n == dec(k.next_task)
}

// Journal events not yet consumed by a replay (0 while recording).
pub fn kernel_unconsumed(in k: Kernel) -> u64 {
    if k.replay {
        wrapping_sub(k.expected.len(), k.cursor)
    } else {
        0
    }
}

// The event a ReplayMismatch computed.
pub fn kernel_mismatch(in k: Kernel) -> Ev {
    k.mismatch
}

pub fn kernel_spawn(inout k: Kernel) -> Ret {
    k.begin();
    let task = k.next_task;
    if task == MAX_U64 {
        return err(Code::IdExhausted, 0);
    }
    let now = k.now;
    k.one(ev(EvKind::Spawn, task, 0, now, 0));
    let fault = k.batch_fault();
    if fault.code != Code::Ok {
        return fault;
    }
    k.t_state.push(State::Ready);
    fen_push(inout k.f_ready, 1);
    fen_push(inout k.f_cand, 1);
    k.in_ready.push(true);
    k.in_cand.push(true);
    k.ready_total = inc(k.ready_total);
    k.cand_total = inc(k.cand_total);
    k.t_completion.push(0);
    k.t_deadline.push(0);
    k.t_wake.push(Wake::Start);
    k.t_wake_completion.push(0);
    k.t_wake_rk.push(0);
    k.t_wake_rv.push(0);
    k.t_cancel.push(false);
    k.t_seen.push(false);
    k.next_task = inc(task);
    k.commit();
    ok(task)
}

pub fn kernel_yield_task(inout k: Kernel, task: u64, own: bool) -> Ret {
    k.begin();
    let token = k.token_fault(task, own);
    if token != Code::Ok {
        return err(token, task);
    }
    let now = k.now;
    k.one(ev(EvKind::Yield, task, 0, now, 0));
    let fault = k.batch_fault();
    if fault.code != Code::Ok {
        return fault;
    }
    k.set_state(task, State::Ready);
    k.set_wake(task, Wake::Yield, 0, 0, 0);
    k.running = 0;
    k.commit();
    ok(0)
}

pub fn kernel_finish(inout k: Kernel, task: u64, own: bool) -> Ret {
    k.begin();
    let token = k.token_fault(task, own);
    if token != Code::Ok {
        return err(token, task);
    }
    let now = k.now;
    k.one(ev(EvKind::Finish, task, 0, now, 0));
    let fault = k.batch_fault();
    if fault.code != Code::Ok {
        return fault;
    }
    k.set_state(task, State::Finished);
    k.running = 0;
    k.commit();
    ok(0)
}

pub fn kernel_sleep(inout k: Kernel, task: u64, own: bool, duration_ns: u64) -> Ret {
    k.begin();
    let deadline = wrapping_add(k.now, duration_ns);
    if deadline < k.now {
        return err(Code::ClockOverflow, 0);
    }
    k.park(task, own, true, false, deadline, 0, 0)
}

pub fn kernel_park_io(inout k: Kernel, task: u64, own: bool) -> Ret {
    k.begin();
    k.park(task, own, false, false, 0, 0, 0)
}

pub fn kernel_schedule_io(inout k: Kernel, task: u64, own: bool, delay_ns: u64, rk: u64, rv: u64)
    -> Ret {
    k.begin();
    let deadline = wrapping_add(k.now, delay_ns);
    if deadline < k.now {
        return err(Code::ClockOverflow, 0);
    }
    k.park(task, own, true, true, deadline, rk, rv)
}

// `value` 1 when this call recorded the request, 0 when it was already set.
pub fn kernel_request_cancel(inout k: Kernel, task: u64) -> Ret {
    k.begin();
    if !k.known(task) {
        return err(Code::UnknownTask, task);
    }
    if k.state_of(task) == State::Finished {
        return err(Code::TaskFinished, task);
    }
    if atb(in k.t_cancel.as_slice(), dec(task)) {
        return ok(0);
    }
    let now = k.now;
    k.one(ev(EvKind::CancelRequested, task, 0, now, 0));
    let fault = k.batch_fault();
    if fault.code != Code::Ok {
        return fault;
    }
    k.t_cancel.try_set(dec(task), true);
    k.commit();
    ok(1)
}

pub fn kernel_complete_io(inout k: Kernel, completion: u64, rk: u64, rv: u64) -> Ret {
    k.begin();
    if completion == 0 || completion >= k.next_completion {
        return err(Code::UnknownCompletion, completion);
    }
    let task = k.pending_task(completion);
    if task == 0 || k.state_of(task) != State::WaitingIo || k.task_completion(task) != completion {
        return err(Code::UnknownCompletion, completion);
    }
    let now = k.now;
    k.one(ev_io(EvKind::IoCompleted, task, completion, now, 0, rk, rv));
    let fault = k.batch_fault();
    if fault.code != Code::Ok {
        return fault;
    }
    k.p_task.try_set(dec(completion), 0);
    k.pending_n = dec(k.pending_n);
    k.set_state(task, State::Ready);
    k.set_wake(task, Wake::Io, completion, rk, rv);
    k.commit();
    ok(0)
}

// Deliver everything due, then dispatch one runnable task (see
// `Simulator::next_task` in src/reference.rs).
pub fn kernel_next_task(inout k: Kernel) -> Next {
    k.begin();
    let mut next = Next {
        code: Code::Ok,
        task: 0,
        wk: Wake::Start,
        wc: 0,
        wrk: 0,
        wrv: 0,
        cancel: false
    };
    if k.running != 0 {
        next.code = Code::TaskStillRunning;
        next.task = k.running;
        return next;
    }
    let mut now = k.now;
    if k.ready_total == 0 {
        match k.heap_top() {
            Option::Some(t) => {
                now = t;
            },
            Option::None => (),
        }
    }
    // Take every live entry due at `now` off the heap, in key order.
    k.due.clear();
    loop {
        match k.heap_top() {
            Option::Some(t) => {
                if t > now {
                    break;
                }
                let c = at(in k.h_completion.as_slice(), 0);
                k.heap_pop();
                k.due.push(c);
            },
            Option::None => {
                break;
            },
        }
    }
    if now != k.now {
        let from = k.now;
        k.batch.push(ev(EvKind::ClockAdvance, 0, 0, from, now));
    }
    let n_due = k.due.len();
    for i in 0..n_due {
        let c = at(in k.due.as_slice(), i);
        let j = dec(c);
        let task = at(in k.p_task.as_slice(), j);
        if atb(in k.p_io.as_slice(), j) {
            let rk = at(in k.p_rk.as_slice(), j);
            let rv = at(in k.p_rv.as_slice(), j);
            k.batch.push(ev_io(EvKind::IoCompleted, task, c, now, 0, rk, rv));
        } else {
            k.batch.push(ev(EvKind::TimerElapsed, task, c, now, 0));
        }
        // Runnable for this dispatch; undone if it is rejected.
        k.mark(task, true);
    }
    let mut round = k.round;
    let reset = k.ready_total > 0 && k.cand_total == 0;
    if reset {
        if round == MAX_U64 {
            k.unwake_due();
            k.restore_due();
            next.code = Code::RoundOverflow;
            return next;
        }
        round = inc(round);
    }
    let count = if reset {
        k.ready_total
    } else {
        k.cand_total
    };
    let mut rng = k.rng;
    let mut selected: u64 = 0;
    if count > 0 {
        let threshold = rem(wrapping_sub(0, count), count);
        let mut index: u64 = 0;
        loop {
            rng = wrapping_add(rng, 0x9e3779b97f4a7c15);
            let value = random(rng);
            if value >= threshold {
                index = rem(value, count);
                break;
            }
        }
        selected = if reset {
            fen_select(in k.f_ready.as_slice(), index)
        } else {
            fen_select(in k.f_cand.as_slice(), index)
        };
        k.batch.push(ev(EvKind::Dispatch, selected, 0, now, round));
    }
    let fault = k.batch_fault();
    if fault.code != Code::Ok {
        k.unwake_due();
        k.restore_due();
        next.code = fault.code;
        next.task = fault.value;
        return next;
    }
    // Commit: release the due completions and wake their tasks.
    for i in 0..n_due {
        let c = at(in k.due.as_slice(), i);
        let j = dec(c);
        let task = at(in k.p_task.as_slice(), j);
        let io = atb(in k.p_io.as_slice(), j);
        let rk = at(in k.p_rk.as_slice(), j);
        let rv = at(in k.p_rv.as_slice(), j);
        k.p_task.try_set(j, 0);
        k.pending_n = dec(k.pending_n);
        k.set_state(task, State::Ready);
        if io {
            k.set_wake(task, Wake::Io, c, rk, rv);
        } else {
            k.set_wake(task, Wake::Timer, c, 0, 0);
        }
    }
    k.due.clear();
    k.now = now;
    k.rng = rng;
    k.round = round;
    if reset {
        k.new_round();
    }
    k.commit();
    if selected != 0 {
        let i = dec(selected);
        k.t_seen.try_set(i, true);
        k.seen_list.push(selected);
        k.mark(selected, false);
        k.running = selected;
        k.set_state(selected, State::Running);
        next.task = selected;
        next.wk = at(in k.t_wake.as_slice(), i);
        next.wc = at(in k.t_wake_completion.as_slice(), i);
        next.wrk = at(in k.t_wake_rk.as_slice(), i);
        next.wrv = at(in k.t_wake_rv.as_slice(), i);
        next.cancel = atb(in k.t_cancel.as_slice(), i);
    }
    next
}

test {
    // @case odd_tree_last(3, 2, 3)
    // @case even_tree_first(4, 0, 1)
    // @case even_tree_middle(4, 1, 2)
    // @case even_tree_last(4, 3, 4)
    fn test_fenwick_selection(size: u64, rank: u64, expected: u64) -> bool {
        let mut weights = ChunkSeq::new[u64]();
        weights.push(0);
        for i in 0..size {
            let weight = if i == 0 {
                0
            } else {
                1
            };
            fen_push(inout weights, weight);
        }
        fen_add(inout weights, 0, 5);
        fen_add(inout weights, 1, 1);
        fen_prefix(in weights.as_slice(), size)
            == size
            && fen_select(in weights.as_slice(), rank)
            == expected
    }

    fn test_heap_orders_equal_deadlines_by_completion() -> bool {
        let mut kernel = kernel_new(0);
        kernel.heap_push(30, 1);
        kernel.heap_push(20, 2);
        kernel.heap_push(15, 3);
        kernel.heap_push(20, 4);
        kernel.heap_push(10, 5);
        kernel.heap_push(5, 6);
        if kernel.heap_less(0, 0) {
            return false;
        }
        let mut expected = ChunkSeq::new[u64]();
        expected.push(6);
        expected.push(5);
        expected.push(3);
        expected.push(2);
        expected.push(4);
        expected.push(1);
        let count = expected.len();
        for i in 0..count {
            if kernel.h_completion.try_get(0) != expected.try_get(i) {
                return false;
            }
            kernel.heap_pop();
        }
        kernel.heap_pop();
        kernel.h_time.len() == 0 && kernel.h_completion.len() == 0
    }

    fn test_threshold_draw_is_accepted() -> bool {
        // This seed makes the first SplitMix64 output equal 1, the threshold for 3 tasks.
        let seed: u64 = 17885559969949501885;
        let mut kernel = kernel_new(seed);
        kernel_spawn(inout kernel);
        kernel_spawn(inout kernel);
        kernel_spawn(inout kernel);
        let next = kernel_next_task(inout kernel);
        next.code == 0 && next.task == 2 && kernel.rng == wrapping_add(seed, 0x9e3779b97f4a7c15)
    }

    fn test_yielded_tasks_wait_until_next_round() -> bool {
        let mut kernel = kernel_new(42);
        let idle = kernel_next_task(inout kernel);
        if idle.cancel || kernel.round != 0 || atb(in kernel.t_seen.as_slice(), 0) {
            return false;
        }
        kernel_spawn(inout kernel);
        kernel_spawn(inout kernel);
        if atb(in kernel.t_seen.as_slice(), 0) || atb(in kernel.t_seen.as_slice(), 1) {
            return false;
        }
        let first = kernel_next_task(inout kernel);
        kernel_yield_task(inout kernel, first.task, true);
        if kernel.ready_total != 2 || kernel.cand_total != 1 {
            return false;
        }
        let second = kernel_next_task(inout kernel);
        kernel_yield_task(inout kernel, second.task, true);
        if second.task == first.task || kernel.round != 0 || kernel.cand_total != 0 {
            return false;
        }
        let next = kernel_next_task(inout kernel);
        next.code == 0 && next.task != 0 && kernel.round == 1 && kernel.cand_total == 1
    }

    fn test_rejected_wake_restores_pending_timer() -> bool {
        let mut journal = ChunkSeq::new[Ev]();
        journal.push(ev(0, 1, 0, 0, 0));
        journal.push(ev(1, 1, 0, 0, 0));
        journal.push(ev(3, 1, 1, 17, 0));
        let mut kernel = kernel_replay(0, in journal.as_slice());
        let spawned = kernel_spawn(inout kernel);
        let running = kernel_next_task(inout kernel);
        let parked = kernel_sleep(inout kernel, spawned.value, true, 17);
        if spawned.code != 0 || running.task != spawned.value || parked.code != 0 {
            return false;
        }
        let refused = kernel_next_task(inout kernel);
        refused
            .code
            == 10
            && refused
            .task
            == 3
            && kernel
            .ready_total
            == 0
            && kernel
            .cand_total
            == 0
            && kernel
            .now
            == 0
            && kernel
            .pending_n
            == 1
            && kernel
            .heap_top()
            == Option::Some(17)
    }

    fn test_completed_io_is_removed_from_deadline_heap() -> bool {
        let mut kernel = kernel_new(0);
        let task = kernel_spawn(inout kernel).value;
        kernel_next_task(inout kernel);
        let waiting = kernel_schedule_io(inout kernel, task, true, 17, 0, 45);
        let completed = kernel_complete_io(inout kernel, waiting.value, 0, 99);
        if waiting.code != 0 || completed.code != 0 || kernel.heap_top() != Option::None {
            return false;
        }
        let next = kernel_next_task(inout kernel);
        next.code == 0 && next.task == task && next.wrv == 99 && kernel.now == 0
    }

    // @case seed_zero(0)
    // @case seed_nonzero(42)
    // @case seed_max(18446744073709551615)
    fn test_spawn_yield_finish(seed: u64) -> bool {
        let mut kernel = kernel_new(seed);
        let empty = kernel_next_task(inout kernel);
        if !kernel_is_complete(in kernel) || empty.code != 0 || empty.task != 0 {
            return false;
        }
        let spawn = kernel_spawn(inout kernel);
        let dispatch = kernel_next_task(inout kernel);
        let busy = kernel_next_task(inout kernel);
        let started = spawn.code == 0 && spawn.value == 1;
        let dispatched = dispatch.code == 0 && dispatch.task == 1 && dispatch.wk == 0;
        let blocked = busy.code == 4 && busy.task == 1;
        let running = kernel_task_state(in kernel, 1);
        if !started
            || !dispatched
            || !blocked
            || running
            .kind
            != 1
            || kernel_is_complete(in kernel) {
            return false;
        }
        let yielded = kernel_yield_task(inout kernel, 1, true);
        let ready = kernel_task_state(in kernel, 1);
        let wake = kernel_next_task(inout kernel);
        let finished = kernel_finish(inout kernel, 1, true);
        let finished_state = kernel_task_state(in kernel, 1);
        let resumed = yielded.code == 0 && ready.kind == 0;
        let woke = wake.code == 0 && wake.task == 1 && wake.wk == 1;
        let done = finished.code == 0 && finished_state.kind == 4;
        resumed && woke && done && kernel_now_ns(in kernel) == 0 && kernel_is_complete(in kernel)
    }

    // @case zero_delay(0)
    // @case positive_delay(17)
    // @case maximum_deadline(18446744073709551615)
    fn test_timer(delay: u64) -> bool {
        let mut kernel = kernel_new(0);
        let task = kernel_spawn(inout kernel).value;
        kernel_next_task(inout kernel);
        let sleep = kernel_sleep(inout kernel, task, true, delay);
        let sleeping = kernel_task_state(in kernel, task);
        let sleep_started = sleep.code == 0 && sleep.value == 1 && sleeping.kind == 2;
        let timer_matches = sleeping.completion == sleep.value && sleeping.deadline == delay;
        let pending = kernel_pending_count(in kernel) == 1 && kernel_now_ns(in kernel) == 0;
        if !sleep_started || !timer_matches || !pending {
            return false;
        }
        if kernel.out.try_get(0) != Option::Some(ev(3, task, sleep.value, delay, 0)) {
            return false;
        }
        let rejected = kernel_complete_io(inout kernel, sleep.value, 0, 0);
        if rejected.code != 2 || kernel_pending_count(in kernel) != 1 {
            return false;
        }
        let wake = kernel_next_task(inout kernel);
        let expected_event = if delay == 0 {
            ev(6, task, sleep.value, 0, 0)
        } else {
            ev(5, 0, 0, 0, delay)
        };
        if kernel.out.try_get(0) != Option::Some(expected_event) {
            return false;
        }
        let resumed = wake.code == 0 && wake.task == task;
        let timer_finished = wake.wk == 2 && wake.wc == sleep.value;
        let advanced = kernel_pending_count(in kernel) == 0 && kernel_now_ns(in kernel) == delay;
        resumed && timer_finished && advanced
    }

    // @case external_success(false, 0, 27, false, 0)
    // @case scheduled_success(true, 0, 27, false, 13)
    // @case external_error(false, 1, 5, false, 0)
    // @case scheduled_cancelled(true, 2, 0, true, 13)
    // @case scheduled_zero_delay(true, 0, 27, false, 0)
    fn test_io(scheduled: bool, result: u64, payload: u64, cancel: bool, delay: u64) -> bool {
        let mut kernel = kernel_new(0);
        let task = kernel_spawn(inout kernel).value;
        kernel_next_task(inout kernel);
        let wait = if scheduled {
            kernel_schedule_io(inout kernel, task, true, delay, result, payload)
        } else {
            kernel_park_io(inout kernel, task, true)
        };
        let state = kernel_task_state(in kernel, task);
        let parked = wait.code == 0 && wait.value == 1 && state.kind == 3;
        let queued = state.completion == wait.value && kernel_pending_count(in kernel) == 1;
        if !parked || !queued || kernel_cancel_requested(in kernel, task) != 0 {
            return false;
        }
        let expected_event = if scheduled {
            ev_io(4, task, wait.value, delay, 1, result, payload)
        } else {
            ev(4, task, wait.value, 0, 0)
        };
        if kernel
            .out
            .try_get(0)
            != Option::Some(expected_event)
            || atb(in kernel.p_io.as_slice(), dec(wait.value))
            != scheduled {
            return false;
        }
        if cancel {
            let first = kernel_request_cancel(inout kernel, task);
            let second = kernel_request_cancel(inout kernel, task);
            let accepted = first.code == 0 && first.value == 1;
            let idempotent = second.code == 0 && second.value == 0;
            if !accepted || !idempotent || kernel_cancel_requested(in kernel, task) != 1 {
                return false;
            }
        }
        if !scheduled {
            let idle = kernel_next_task(inout kernel);
            let completion = kernel_complete_io(inout kernel, wait.value, result, payload);
            if idle.code != 0 || idle.task != 0 || completion.code != 0 {
                return false;
            }
        }
        let wake = kernel_next_task(inout kernel);
        let duplicate = kernel_complete_io(inout kernel, wait.value, result, payload);
        let resumed = wake.code == 0 && wake.task == task && wake.wk == 3 && wake.wc == wait.value;
        let result_matches = wake.wrk == result && wake.wrv == payload && wake.cancel == cancel;
        let consumed = duplicate.code == 2 && duplicate.value == wait.value;
        let drained = kernel_pending_count(in kernel) == 0;
        resumed && result_matches && consumed && drained && kernel_now_ns(in kernel) == delay
    }

    // @case foreign(1, false, 6)
    // @case wrong_task(2, true, 5)
    fn test_bad_token(task: u64, owned: bool, expected: u64) -> bool {
        let mut kernel = kernel_new(0);
        kernel_spawn(inout kernel);
        kernel_next_task(inout kernel);
        let refused = kernel_finish(inout kernel, task, owned);
        let state = kernel_task_state(in kernel, 1);
        let accepted = kernel_finish(inout kernel, 1, true);
        let still_running = refused.code == expected && refused.value == task && state.kind == 1;
        still_running && accepted.code == 0 && kernel_is_complete(in kernel)
    }

    // @case matching(true, 1, 0, 0)
    // @case mismatched_event(true, 2, 10, 1)
    // @case exhausted_journal(false, 0, 10, 0)
    fn test_replay_spawn(has_event: bool, expected_task: u64, code: u64, unconsumed: u64) -> bool {
        let mut journal = ChunkSeq::new[Ev]();
        if has_event {
            journal.push(ev(0, expected_task, 0, 0, 0));
        }
        let mut kernel = kernel_replay(0, in journal.as_slice());
        let spawn = kernel_spawn(inout kernel);
        if spawn.code != code || kernel_unconsumed(in kernel) != unconsumed {
            return false;
        }
        let state = kernel_task_state(in kernel, 1);
        if code == 0 {
            spawn.value == 1 && state.kind == 0
        } else {
            let rejected = spawn.value == 0 && state.kind == 5;
            rejected && kernel_mismatch(in kernel) == ev(0, 1, 0, 0, 0)
        }
    }
}
