// @vesper/beacon-arrow: the Vesper side of `vesper-beacon-arrow` (Rust-exit
// wave SH6, lane 18, #1413). Part 2 is the `vesper.beacon.spans/1` Arrow IPC
// stream that `export_batch` and `export_ring` return.
use self::cbor::scan_cbor_cell;
use self::spans::{stream_into, stream_len};

// Allocation-free RFC 8949 CBOR structural pre-scanner for OTAP attribute cells.
pub fn otap_cbor_scan(in bytes: Slice[u8], budget: u64, node_weight: u64, max_depth: u64) -> u64 {
    scan_cbor_cell(in bytes, budget, node_weight, max_depth)
}

// The exact byte length of the span stream of `rows` rows.
pub fn span_stream_len(rows: u64) -> u64 {
    stream_len(rows)
}

// Writes the span stream of `rows` rows into `out` (see spans.ves for the
// column layout); returns the bytes written, or 0 when the columns do not
// match `rows` or `out` is too short.
pub fn span_stream_into(
    in wide: Slice[u64],
    in narrow: Slice[u8],
    rows: u64,
    inout out: Slice[u8]
) -> u64 {
    stream_into(in wide, in narrow, rows, inout out)
}
