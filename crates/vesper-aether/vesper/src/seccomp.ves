// ---------------------------------------------------------------------------
// VMM seccomp-BPF compiler, validator, and evaluator (src/seccomp.rs).

const SECCOMP_RET_KILL_PROCESS: u32 = 2147483648;
const SECCOMP_RET_ALLOW: u32 = 2147418112;
const SECCOMP_BPF_MAXINSNS: u64 = 4096;

const BPF_LD_W_ABS: u16 = 32;
const BPF_JMP_JEQ_K: u16 = 21;
const BPF_JMP_JA: u16 = 5;
const BPF_RET_K: u16 = 6;

const OFF_NR: u32 = 0;
const OFF_ARCH: u32 = 4;
const OFF_ARGS_1_LO: u32 = 24;
const SECCOMP_DATA_BYTES: u32 = 64;

pub copy enum SeccompFault {
    TooLong,
    EmptyProgram,
    JumpOutOfRange {
        at: u64
    },
    BadLoad {
        at: u64
    },
    UnsupportedInstruction {
        at: u64,
        code: u16
    },
    NoTerminatingReturn,
    FellOff,
}

fn pack_filter(code: u16, jt: u8, jf: u8, k: u32) -> u64 {
    let c = widen_u64(widen_u32(code));
    let t = widen_u64(widen_u32(jt)) << 16;
    let f = widen_u64(widen_u32(jf)) << 24;
    let kv = widen_u64(k) << 32;
    c | t | f | kv
}

// A JEQ_K word with jump-if-true `jt` (at most 255) and constant `k`.
fn pack_jeq(jt: u64, k: u64) -> u64 {
    widen_u64(widen_u32(BPF_JMP_JEQ_K)) | (jt << 16) | (k << 32)
}

fn insn_code(w: u64) -> u16 {
    wrapping_u16(w)
}

fn insn_jt(w: u64) -> u8 {
    wrapping_u8(w >> 16)
}

fn insn_jf(w: u64) -> u8 {
    wrapping_u8(w >> 24)
}

fn insn_k(w: u64) -> u32 {
    wrapping_u32(w >> 32)
}

fn u64_slice_at(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

// The kernel's check of one instruction: 0 when it is fine, else
// VALIDATE_BAD_LOAD, VALIDATE_JUMP or VALIDATE_UNSUPPORTED (scalar, so the
// per-instruction loop keeps it in a register).
const VALIDATE_BAD_LOAD: u64 = 1;
const VALIDATE_JUMP: u64 = 2;
const VALIDATE_UNSUPPORTED: u64 = 3;

fn validate_code(at: u64, w: u64, len: u64) -> u64 {
    let code = insn_code(w);
    let k = insn_k(w);
    if code == BPF_JMP_JEQ_K {
        let jt = (w >> 16) & 255;
        let jf = (w >> 24) & 255;
        let max_j = if jt > jf {
            jt
        } else {
            jf
        };
        if wrapping_add(wrapping_add(at, 1), max_j) >= len {
            return VALIDATE_JUMP;
        }
        return 0;
    }
    if code == BPF_LD_W_ABS {
        if (k & 3) != 0 || k >= SECCOMP_DATA_BYTES {
            return VALIDATE_BAD_LOAD;
        }
        return 0;
    }
    if code == BPF_RET_K {
        return 0;
    }
    if code == BPF_JMP_JA {
        if wrapping_add(wrapping_add(at, 1), widen_u64(k)) >= len {
            return VALIDATE_JUMP;
        }
        return 0;
    }
    VALIDATE_UNSUPPORTED
}

// The first validation failure so far (`prev`, 0 for none), else this
// instruction's: the code in the low byte, the opcode above it and the
// index from bit 32.
fn check_insn(prev: u64, at: u64, w: u64, len: u64) -> u64 {
    if prev != 0 {
        return prev;
    }
    let c = validate_code(at, w, len);
    if c == 0 {
        return 0;
    }
    c | wrapping_shl_u64(widen_u64(widen_u32(insn_code(w))), 8) | wrapping_shl_u64(at, 32)
}

fn validate_fault(c: u64, at: u64, w: u64) -> SeccompFault {
    if c == VALIDATE_BAD_LOAD {
        SeccompFault::BadLoad {
            at: at
        }
    } else if c == VALIDATE_JUMP {
        SeccompFault::JumpOutOfRange {
            at: at
        }
    } else {
        SeccompFault::UnsupportedInstruction {
            at: at,
            code: insn_code(w)
        }
    }
}

// The jump field from `from` to `to`, or 256 when it does not fit.
fn jump_dist(from: u64, to: u64) -> u64 {
    if to <= from {
        return 256;
    }
    let diff = wrapping_sub(wrapping_sub(to, from), 1);
    if diff > 255 {
        return 256;
    }
    diff
}

pub fn seccomp_validate(in program: Slice[u64]) -> Result[(), SeccompFault] {
    let len = program.len();
    if len == 0 {
        return Result::Err(SeccompFault::EmptyProgram);
    }
    if len > SECCOMP_BPF_MAXINSNS {
        return Result::Err(SeccompFault::TooLong);
    }
    for i in 0..len {
        let w = u64_slice_at(in program, i);
        let c = validate_code(i, w, len);
        if c != 0 {
            return Result::Err(validate_fault(c, i, w));
        }
    }
    let last = u64_slice_at(in program, wrapping_sub(len, 1));
    if insn_code(last) != BPF_RET_K {
        return Result::Err(SeccompFault::NoTerminatingReturn);
    }
    Result::Ok(())
}

pub fn seccomp_evaluate(
    in program: Slice[u64],
    nr: u32,
    arch: u32,
    ip_lo: u32,
    ip_hi: u32,
    in args: Slice[u64]
) -> Result[u32, SeccompFault] {
    match seccomp_validate(in program) {
        Result::Err(e) => return Result::Err(e),
        Result::Ok(_) => {}
    }
    let len = program.len();
    let mut acc: u32 = 0;
    let mut pc: u64 = 0;
    loop {
        if pc >= len {
            return Result::Err(SeccompFault::FellOff);
        }
        let w = u64_slice_at(in program, pc);
        let code = insn_code(w);
        let k = insn_k(w);
        if code == BPF_LD_W_ABS {
            if k >= SECCOMP_DATA_BYTES || k % 4 != 0 {
                return Result::Err(
                    SeccompFault::BadLoad {
                        at: pc
                    }
                );
            }
            if k == OFF_NR {
                acc = nr;
            } else if k == OFF_ARCH {
                acc = arch;
            } else if k == 8 {
                acc = ip_lo;
            } else if k == 12 {
                acc = ip_hi;
            } else {
                let arg_off = wrapping_sub(k, 16);
                let arg_idx = widen_u64(arg_off / 8);
                let arg_val = u64_slice_at(in args, arg_idx);
                if arg_off % 8 == 0 {
                    acc = wrapping_u32(arg_val);
                } else {
                    acc = wrapping_u32(arg_val >> 32);
                }
            }
            pc = wrapping_add(pc, 1);
        } else if code == BPF_JMP_JEQ_K {
            let j = if acc == k {
                widen_u64(widen_u32(insn_jt(w)))
            } else {
                widen_u64(widen_u32(insn_jf(w)))
            };
            pc = wrapping_add(wrapping_add(pc, 1), j);
        } else if code == BPF_JMP_JA {
            pc = wrapping_add(wrapping_add(pc, 1), widen_u64(k));
        } else if code == BPF_RET_K {
            return Result::Ok(k);
        } else {
            return Result::Err(
                SeccompFault::UnsupportedInstruction {
                    at: pc,
                    code: code
                }
            );
        }
    }
}

// Sorts `src` into `out[start..]` (one value a slot) and drops repeats;
// returns how many distinct values it kept. `out` must have room for all of
// `src` from `start`.
fn sort_dedup_into(inout out: Slice[u64], start: u64, in src: Slice[u32]) -> u64 {
    let n = src.len();
    for i in 0..n {
        let key = match src.try_get(i) {
            Option::Some(x) => widen_u64(x),
            Option::None => 0,
        };
        let mut j = wrapping_add(start, i);
        loop {
            if j == start {
                break;
            }
            let prev = u64_slice_at(in out, wrapping_sub(j, 1));
            if prev <= key {
                break;
            }
            out.try_set(j, prev);
            j = wrapping_sub(j, 1);
        }
        out.try_set(j, key);
    }
    let mut kept: u64 = 0;
    let mut last: u64 = 0;
    for k in 0..n {
        let v = u64_slice_at(in out, wrapping_add(start, k));
        if kept == 0 || v != last {
            out.try_set(wrapping_add(start, kept), v);
            kept = wrapping_add(kept, 1);
            last = v;
        }
    }
    kept
}

// The program is laid out in `out`, which needs room for every input value
// plus nine instructions: the syscall numbers are sorted straight into
// their jump slots, the ioctl requests into theirs, and each slot is then
// rewritten as its jump.
pub fn seccomp_compile(
    audit_arch: u32,
    ioctl_nr: u32,
    default_ret: u32,
    in nrs_in: Slice[u32],
    in reqs_in: Slice[u32],
    inout out: Slice[u64]
) -> Result[u64, SeccompFault] {
    let room = wrapping_add(wrapping_add(nrs_in.len(), reqs_in.len()), 9);
    if room > out.len() {
        return Result::Err(SeccompFault::TooLong);
    }
    let n = sort_dedup_into(inout out, 4, in nrs_in);
    let has_ioctl = reqs_in.len() > 0;
    let ioctl_slot: u64 = if has_ioctl {
        1
    } else {
        0
    };
    let ioctl_block = wrapping_add(wrapping_add(4, n), wrapping_add(ioctl_slot, 1));
    let reqs_at = wrapping_add(ioctl_block, 1);
    let m = if has_ioctl {
        sort_dedup_into(inout out, reqs_at, in reqs_in)
    } else {
        0
    };
    let allow = if has_ioctl {
        wrapping_add(wrapping_add(ioctl_block, 1), wrapping_add(m, 1))
    } else {
        ioctl_block
    };
    let total = wrapping_add(allow, 1);
    if total > SECCOMP_BPF_MAXINSNS {
        return Result::Err(SeccompFault::TooLong);
    }

    // Each instruction is checked as it is written, against the program's
    // final length; the first failure is reported after the layout, as a
    // validation pass over the finished program would.
    let w0 = pack_filter(BPF_LD_W_ABS, 0, 0, OFF_ARCH);
    let w1 = pack_filter(BPF_JMP_JEQ_K, 1, 0, audit_arch);
    let w2 = pack_filter(BPF_RET_K, 0, 0, SECCOMP_RET_KILL_PROCESS);
    let w3 = pack_filter(BPF_LD_W_ABS, 0, 0, OFF_NR);
    out.try_set(0, w0);
    out.try_set(1, w1);
    out.try_set(2, w2);
    out.try_set(3, w3);
    let mut bad = check_insn(0, 0, w0, total);
    bad = check_insn(bad, 1, w1, total);
    bad = check_insn(bad, 2, w2, total);
    bad = check_insn(bad, 3, w3, total);

    let mut at_idx: u64 = 4;
    for _i in 0..n {
        let jt = jump_dist(at_idx, allow);
        if jt > 255 {
            return Result::Err(SeccompFault::TooLong);
        }
        let w = pack_jeq(jt, u64_slice_at(in out, at_idx));
        out.try_set(at_idx, w);
        bad = check_insn(bad, at_idx, w, total);
        at_idx = wrapping_add(at_idx, 1);
    }
    if has_ioctl {
        let jt = jump_dist(at_idx, ioctl_block);
        if jt > 255 {
            return Result::Err(SeccompFault::TooLong);
        }
        let w = pack_jeq(jt, widen_u64(ioctl_nr));
        out.try_set(at_idx, w);
        bad = check_insn(bad, at_idx, w, total);
        at_idx = wrapping_add(at_idx, 1);
    }
    let ret_default = pack_filter(BPF_RET_K, 0, 0, default_ret);
    out.try_set(at_idx, ret_default);
    at_idx = wrapping_add(at_idx, 1);

    if has_ioctl {
        let ld = pack_filter(BPF_LD_W_ABS, 0, 0, OFF_ARGS_1_LO);
        out.try_set(at_idx, ld);
        bad = check_insn(bad, at_idx, ld, total);
        at_idx = wrapping_add(at_idx, 1);
        for _j in 0..m {
            let jt = jump_dist(at_idx, allow);
            if jt > 255 {
                return Result::Err(SeccompFault::TooLong);
            }
            let w = pack_jeq(jt, u64_slice_at(in out, at_idx));
            out.try_set(at_idx, w);
            bad = check_insn(bad, at_idx, w, total);
            at_idx = wrapping_add(at_idx, 1);
        }
        out.try_set(at_idx, ret_default);
        at_idx = wrapping_add(at_idx, 1);
    }
    out.try_set(at_idx, pack_filter(BPF_RET_K, 0, 0, SECCOMP_RET_ALLOW));
    at_idx = wrapping_add(at_idx, 1);

    let plen = at_idx;
    if bad != 0 {
        let at = wrapping_shr_u64(bad, 32);
        let w = widen_u64(widen_u32(wrapping_u16(wrapping_shr_u64(bad, 8))));
        return Result::Err(validate_fault(bad & 255, at, w));
    }
    if plen == 0 {
        return Result::Err(SeccompFault::EmptyProgram);
    }
    Result::Ok(plen)
}
