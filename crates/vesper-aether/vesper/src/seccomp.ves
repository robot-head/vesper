// ---------------------------------------------------------------------------
// VMM seccomp-BPF compiler, validator, and evaluator (src/seccomp.rs).

const SECCOMP_RET_KILL_PROCESS: u32 = 2147483648;
const SECCOMP_RET_ALLOW: u32 = 2147418112;
const SECCOMP_BPF_MAXINSNS: u64 = 4096;

const BPF_LD_W_ABS: u16 = 32;
const BPF_JMP_JEQ_K: u16 = 21;
const BPF_JMP_JA: u16 = 5;
const BPF_RET_K: u16 = 6;

const OFF_NR: u32 = 0;
const OFF_ARCH: u32 = 4;
const OFF_ARGS_1_LO: u32 = 24;
const SECCOMP_DATA_BYTES: u32 = 64;

pub copy enum SeccompFault {
    TooLong,
    EmptyProgram,
    JumpOutOfRange {
        at: u64
    },
    BadLoad {
        at: u64
    },
    UnsupportedInstruction {
        at: u64,
        code: u16
    },
    NoTerminatingReturn,
    FellOff,
}

fn pack_filter(code: u16, jt: u8, jf: u8, k: u32) -> u64 {
    let c = widen_u64(widen_u32(code));
    let t = widen_u64(widen_u32(jt)) << 16;
    let f = widen_u64(widen_u32(jf)) << 24;
    let kv = widen_u64(k) << 32;
    c | t | f | kv
}

fn insn_code(w: u64) -> u16 {
    wrapping_u16(w)
}

fn insn_jt(w: u64) -> u8 {
    wrapping_u8(w >> 16)
}

fn insn_jf(w: u64) -> u8 {
    wrapping_u8(w >> 24)
}

fn insn_k(w: u64) -> u32 {
    wrapping_u32(w >> 32)
}

fn u32_at(in s: ChunkSeq[u32], i: u64) -> u32 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn u64_slice_at(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn sort_dedup_u32(in src: Slice[u32]) -> ChunkSeq[u32] {
    let mut tmp = ChunkSeq::new[u32]();
    let n = src.len();
    for i in 0..n {
        let v = match src.try_get(i) {
            Option::Some(x) => x,
            Option::None => 0,
        };
        tmp.push(v);
    }
    let mut i: u64 = 1;
    loop {
        if i >= n {
            break;
        }
        let key = u32_at(in tmp, i);
        let mut j = i;
        loop {
            if j == 0 {
                break;
            }
            let prev_idx = wrapping_sub(j, 1);
            let prev = u32_at(in tmp, prev_idx);
            if prev <= key {
                break;
            }
            tmp.try_set(j, prev);
            j = prev_idx;
        }
        tmp.try_set(j, key);
        i = wrapping_add(i, 1);
    }
    // Compact runs of equal values in place, then drop the tail.
    let mut kept: u64 = 0;
    for k in 0..n {
        let v = u32_at(in tmp, k);
        if kept == 0 || v != u32_at(in tmp, wrapping_sub(kept, 1)) {
            tmp.try_set(kept, v);
            kept = wrapping_add(kept, 1);
        }
    }
    tmp.truncate(kept);
    tmp
}

fn validate_insn(at: u64, w: u64, len: u64) -> Option[SeccompFault] {
    let code = insn_code(w);
    let k = insn_k(w);
    if code == BPF_LD_W_ABS {
        if k % 4 != 0 || k >= SECCOMP_DATA_BYTES {
            return Option::Some(
                SeccompFault::BadLoad {
                    at: at
                }
            );
        }
        return Option::None;
    }
    if code == BPF_JMP_JEQ_K {
        let jt = widen_u64(widen_u32(insn_jt(w)));
        let jf = widen_u64(widen_u32(insn_jf(w)));
        let max_j = if jt > jf {
            jt
        } else {
            jf
        };
        let far = wrapping_add(wrapping_add(at, 1), max_j);
        if far >= len {
            return Option::Some(
                SeccompFault::JumpOutOfRange {
                    at: at
                }
            );
        }
        return Option::None;
    }
    if code == BPF_JMP_JA {
        let far = wrapping_add(wrapping_add(at, 1), widen_u64(k));
        if far >= len {
            return Option::Some(
                SeccompFault::JumpOutOfRange {
                    at: at
                }
            );
        }
        return Option::None;
    }
    if code == BPF_RET_K {
        return Option::None;
    }
    Option::Some(
        SeccompFault::UnsupportedInstruction {
            at: at,
            code: code
        }
    )
}

fn jump_offset(from: u64, to: u64) -> Result[u8, SeccompFault] {
    if to <= from {
        return Result::Err(SeccompFault::TooLong);
    }
    let diff = wrapping_sub(wrapping_sub(to, from), 1);
    if diff > 255 {
        return Result::Err(SeccompFault::TooLong);
    }
    Result::Ok(wrapping_u8(diff))
}

pub fn seccomp_validate(in program: Slice[u64]) -> Result[(), SeccompFault] {
    let len = program.len();
    if len == 0 {
        return Result::Err(SeccompFault::EmptyProgram);
    }
    if len > SECCOMP_BPF_MAXINSNS {
        return Result::Err(SeccompFault::TooLong);
    }
    for i in 0..len {
        let w = u64_slice_at(in program, i);
        match validate_insn(i, w, len) {
            Option::Some(e) => return Result::Err(e),
            Option::None => {}
        }
    }
    let last = u64_slice_at(in program, wrapping_sub(len, 1));
    if insn_code(last) != BPF_RET_K {
        return Result::Err(SeccompFault::NoTerminatingReturn);
    }
    Result::Ok(())
}

pub fn seccomp_evaluate(
    in program: Slice[u64],
    nr: u32,
    arch: u32,
    ip_lo: u32,
    ip_hi: u32,
    in args: Slice[u64]
) -> Result[u32, SeccompFault] {
    match seccomp_validate(in program) {
        Result::Err(e) => return Result::Err(e),
        Result::Ok(_) => {}
    }
    let len = program.len();
    let mut acc: u32 = 0;
    let mut pc: u64 = 0;
    loop {
        if pc >= len {
            return Result::Err(SeccompFault::FellOff);
        }
        let w = u64_slice_at(in program, pc);
        let code = insn_code(w);
        let k = insn_k(w);
        if code == BPF_LD_W_ABS {
            if k >= SECCOMP_DATA_BYTES || k % 4 != 0 {
                return Result::Err(
                    SeccompFault::BadLoad {
                        at: pc
                    }
                );
            }
            if k == OFF_NR {
                acc = nr;
            } else if k == OFF_ARCH {
                acc = arch;
            } else if k == 8 {
                acc = ip_lo;
            } else if k == 12 {
                acc = ip_hi;
            } else {
                let arg_off = wrapping_sub(k, 16);
                let arg_idx = widen_u64(arg_off / 8);
                let arg_val = u64_slice_at(in args, arg_idx);
                if arg_off % 8 == 0 {
                    acc = wrapping_u32(arg_val);
                } else {
                    acc = wrapping_u32(arg_val >> 32);
                }
            }
            pc = wrapping_add(pc, 1);
        } else if code == BPF_JMP_JEQ_K {
            let j = if acc == k {
                widen_u64(widen_u32(insn_jt(w)))
            } else {
                widen_u64(widen_u32(insn_jf(w)))
            };
            pc = wrapping_add(wrapping_add(pc, 1), j);
        } else if code == BPF_JMP_JA {
            pc = wrapping_add(wrapping_add(pc, 1), widen_u64(k));
        } else if code == BPF_RET_K {
            return Result::Ok(k);
        } else {
            return Result::Err(
                SeccompFault::UnsupportedInstruction {
                    at: pc,
                    code: code
                }
            );
        }
    }
}

pub fn seccomp_compile(
    audit_arch: u32,
    ioctl_nr: u32,
    default_ret: u32,
    in nrs_in: Slice[u32],
    in reqs_in: Slice[u32],
    inout out: Slice[u64]
) -> Result[u64, SeccompFault] {
    let nrs = sort_dedup_u32(in nrs_in);
    let reqs = sort_dedup_u32(in reqs_in);
    let n = nrs.len();
    let m = reqs.len();
    let has_ioctl = m > 0;
    let ioctl_slot: u64 = if has_ioctl {
        1
    } else {
        0
    };
    let ioctl_block = wrapping_add(wrapping_add(4, n), wrapping_add(ioctl_slot, 1));
    let allow = if has_ioctl {
        wrapping_add(wrapping_add(ioctl_block, 1), wrapping_add(m, 1))
    } else {
        ioctl_block
    };
    let total = wrapping_add(allow, 1);
    if total > SECCOMP_BPF_MAXINSNS || total > out.len() {
        return Result::Err(SeccompFault::TooLong);
    }

    let mut at_idx: u64 = 0;
    out.try_set(at_idx, pack_filter(BPF_LD_W_ABS, 0, 0, OFF_ARCH));
    at_idx = wrapping_add(at_idx, 1);
    out.try_set(at_idx, pack_filter(BPF_JMP_JEQ_K, 1, 0, audit_arch));
    at_idx = wrapping_add(at_idx, 1);
    out.try_set(at_idx, pack_filter(BPF_RET_K, 0, 0, SECCOMP_RET_KILL_PROCESS));
    at_idx = wrapping_add(at_idx, 1);
    out.try_set(at_idx, pack_filter(BPF_LD_W_ABS, 0, 0, OFF_NR));
    at_idx = wrapping_add(at_idx, 1);

    for i in 0..n {
        let jt = match jump_offset(at_idx, allow) {
            Result::Ok(v) => v,
            Result::Err(e) => return Result::Err(e),
        };
        out.try_set(at_idx, pack_filter(BPF_JMP_JEQ_K, jt, 0, u32_at(in nrs, i)));
        at_idx = wrapping_add(at_idx, 1);
    }
    if has_ioctl {
        let jt = match jump_offset(at_idx, ioctl_block) {
            Result::Ok(v) => v,
            Result::Err(e) => return Result::Err(e),
        };
        out.try_set(at_idx, pack_filter(BPF_JMP_JEQ_K, jt, 0, ioctl_nr));
        at_idx = wrapping_add(at_idx, 1);
    }
    out.try_set(at_idx, pack_filter(BPF_RET_K, 0, 0, default_ret));
    at_idx = wrapping_add(at_idx, 1);

    if has_ioctl {
        out.try_set(at_idx, pack_filter(BPF_LD_W_ABS, 0, 0, OFF_ARGS_1_LO));
        at_idx = wrapping_add(at_idx, 1);
        for j in 0..m {
            let jt = match jump_offset(at_idx, allow) {
                Result::Ok(v) => v,
                Result::Err(e) => return Result::Err(e),
            };
            out.try_set(at_idx, pack_filter(BPF_JMP_JEQ_K, jt, 0, u32_at(in reqs, j)));
            at_idx = wrapping_add(at_idx, 1);
        }
        out.try_set(at_idx, pack_filter(BPF_RET_K, 0, 0, default_ret));
        at_idx = wrapping_add(at_idx, 1);
    }
    out.try_set(at_idx, pack_filter(BPF_RET_K, 0, 0, SECCOMP_RET_ALLOW));
    at_idx = wrapping_add(at_idx, 1);

    let plen = at_idx;
    for i in 0..plen {
        match validate_insn(i, u64_slice_at(in out, i), plen) {
            Option::Some(e) => return Result::Err(e),
            Option::None => {}
        }
    }
    if plen == 0 {
        return Result::Err(SeccompFault::EmptyProgram);
    }
    if insn_code(u64_slice_at(in out, wrapping_sub(plen, 1))) != BPF_RET_K {
        return Result::Err(SeccompFault::NoTerminatingReturn);
    }
    Result::Ok(plen)
}
