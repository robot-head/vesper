// ---------------------------------------------------------------------------
// VirtIO 1.2 MMIO status-register state machine and feature negotiation
// (src/devices/mmio.rs).

const MMIO_STATUS_DRIVER_OK: u32 = 4;
const MMIO_STATUS_FEATURES_OK: u32 = 8;
const MMIO_STATUS_DEVICE_NEEDS_RESET: u32 = 64;
const MMIO_VIRTIO_F_VERSION_1: u64 = 4294967296;

pub copy enum MmioStatusFault {
    DriverSetNeedsReset,
    StatusRegression {
        from: u32,
        to: u32
    },
    // `rejected_features`: this same write offered FEATURES_OK and the
    // device refused it (the Rust transport counts that before failing).
    DriverOkWithoutFeaturesOk {
        rejected_features: bool
    },
}

pub copy struct MmioStatusOutcome {
    pub reset: bool,
    pub next_status: u32,
    pub accepted_features: bool,
    pub rejected_features: bool,
    pub activate: bool,
}

pub fn mmio_write_status(
    old: u32,
    new_val: u32,
    driver_accepted_unknown: bool,
    driver_features: u64,
    offered: u64
) -> Result[MmioStatusOutcome, MmioStatusFault] {
    if new_val == 0 {
        return Result::Ok(
            MmioStatusOutcome {
                reset: true,
                next_status: 0,
                accepted_features: false,
                rejected_features: false,
                activate: false,
            }
        );
    }
    let added = new_val & ~old;
    if (added & MMIO_STATUS_DEVICE_NEEDS_RESET) != 0 {
        return Result::Err(MmioStatusFault::DriverSetNeedsReset);
    }
    if (old & ~new_val & ~MMIO_STATUS_DEVICE_NEEDS_RESET) != 0 {
        return Result::Err(
            MmioStatusFault::StatusRegression {
                from: old,
                to: new_val,
            }
        );
    }
    let mut next = new_val | (old & MMIO_STATUS_DEVICE_NEEDS_RESET);
    let mut accepted_features = false;
    let mut rejected_features = false;
    let mut activate = false;
    if (added & MMIO_STATUS_FEATURES_OK) != 0 {
        if driver_accepted_unknown
            || (driver_features & ~offered) != 0
            || (driver_features & MMIO_VIRTIO_F_VERSION_1) != MMIO_VIRTIO_F_VERSION_1 {
            next = next & ~MMIO_STATUS_FEATURES_OK;
            rejected_features = true;
        } else {
            accepted_features = true;
        }
    }
    if (added & MMIO_STATUS_DRIVER_OK) != 0 {
        if (next & MMIO_STATUS_FEATURES_OK) == 0 {
            return Result::Err(
                MmioStatusFault::DriverOkWithoutFeaturesOk {
                    rejected_features: rejected_features,
                }
            );
        }
        activate = true;
    }
    Result::Ok(
        MmioStatusOutcome {
            reset: false,
            next_status: next,
            accepted_features: accepted_features,
            rejected_features: rejected_features,
            activate: activate,
        }
    )
}
