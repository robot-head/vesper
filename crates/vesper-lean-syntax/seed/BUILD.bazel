# The frozen Rust seed copy of vesper-lean-syntax (package vesper-lean-syntax-seed,
# library vesper_lean_syntax) that the compiler links: ../src built without the port,
# so cfg(vesper_port) is off. Written by hand because its sources live in the
# parent package; see "Crates the compiler links" in
# docs/maintenance/porting-a-crate.md.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")

rust_library(
    name = "seed",
    srcs = ["//crates/vesper-lean-syntax:rust_srcs"],
    compile_data = ["//crates/vesper-lean-syntax:README.md"],
    crate_name = "vesper_lean_syntax",
    crate_root = "//crates/vesper-lean-syntax:src/lib.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_PKG_NAME": "vesper-lean-syntax-seed",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    version = "0.1.0",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    edition = "2024",
)

[
    rust_test(
        name = "seed_test_" + t,
        srcs = ["//crates/vesper-lean-syntax:tests/%s.rs" % t],
        crate_root = "//crates/vesper-lean-syntax:tests/%s.rs" % t,
        edition = "2024",
        # test/lean runs the pinned Lean (VESPER_LEAN) from the host.
        tags = ["no-remote-exec"] if t == "lean" else [],
        deps = [":seed"],
    )
    for t in [
        "lean",
        "lists",
        "port_memory",
    ]
]

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
