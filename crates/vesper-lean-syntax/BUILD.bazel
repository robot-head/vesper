load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The port-backed package (seed-copy rule, docs/maintenance/porting-a-crate.md;
# self-hosting SH0 lane 6, #1128): build.rs links the object built here from
# the Loom package in vesper/ and checks port/binding.rs against the
# generated binding. The compiler links the Rust seed copy,
# //crates/vesper-lean-syntax/seed, instead.
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
)

vesper_port_object(
    name = "lean_syntax_vesper",
    library = "lean_syntax",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

filegroup(
    name = "lean_syntax_vesper_binding",
    srcs = [":lean_syntax_vesper"],
    output_group = "rust_binding",
)

# The divergent builds, one per ported area: the same edits as the Cargo
# feature `vesper-port-divergent` (EDITS in build.rs). They must build; the
# Cargo run in port/test-port.sh (scripts/test-port-harness.sh) asserts that
# the tests catch each edit.
vesper_port_object(
    name = "lean_syntax_vesper_divergent_printer",
    edit_src = "vesper/src/lib.ves",
    edits = {"p.out.push_str(\"\\\\n\");": "p.out.push_str(\"\\\\t\");"},
    library = "lean_syntax",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

vesper_port_object(
    name = "lean_syntax_vesper_divergent_checks",
    edit_src = "vesper/src/lib.ves",
    edits = {"if n == 0 || v == \"_root_\" {": "if n == 0 {"},
    library = "lean_syntax",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

vesper_port_object(
    name = "lean_syntax_vesper_divergent_walks",
    edit_src = "vesper/src/lib.ves",
    edits = {"            truncate_scope(inout r, depth);\n            let typed = take(in s, inout at);": "            let typed = take(in s, inout at);"},
    library = "lean_syntax",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

# Pure Rust tests apart from the prebuilt port object, except test/lean, which
# runs the pinned Lean (VESPER_LEAN) and so stays local.
vesper_crate(
    build_script_data = [
        ":lean_syntax_vesper",
        ":lean_syntax_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :lean_syntax_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :lean_syntax_vesper_binding)",
    },
    remote_tests = [
        "vesper-lean-syntax_unit_test",
        "vesper-lean-syntax_doc_test",
        "test/differential",
        "test/lists",
        "test/port_memory",
    ],
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
    "README.md",
]))

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-lean-syntax/seed:__pkg__"],
)
