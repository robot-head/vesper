load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The Rust build is the default (default features, generated by vesper_crate
# below). The Vesper port of tier 0 (the Loom package in vesper/, Cargo
# feature `vesper-port`, self-hosting SH1 lane 11, #1154) is non-default
# until it reaches parity. The compiler links neither: it links the Rust seed
# copy, //crates/vesper-highlight/seed (seed-copy rule,
# docs/maintenance/porting-a-crate.md). The port's differential tests run in
# Cargo (port/test-port.sh, Linux port shard 7).
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
    deps = ["//:front_package"],
)

vesper_port_object(
    name = "highlight_vesper",
    library = "highlight",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

filegroup(
    name = "highlight_vesper_binding",
    srcs = [":highlight_vesper"],
    output_group = "rust_binding",
)

# The divergent builds, one per ported area (the Cargo
# `vesper-port-divergent` feature applies the same edits from build.rs, one
# at a time with VESPER_HIGHLIGHT_DIVERGE): each must keep compiling, and
# port/test-port.sh asserts that the differential test catches it.
[
    vesper_port_object(
        name = "highlight_vesper_divergent_" + area,
        edit_src = "vesper/src/lib.ves",
        edits = {old: new},
        library = "highlight",
        package = ":port_package",
        rust_types = "crate::port",
        target = VESPER_TARGET,
    )
    for area, old, new in [
        (
            "effects",
            "note(\n                    inout fx,\n                    in src,\n                    w32(in t.start, j),\n                    token_end(in t, j),\n                    sym_at(in t, j),\n                    Linear::Keep\n                );\n            }\n        } else if k == K_L_BRACKET {",
            "}\n        } else if k == K_L_BRACKET {",
        ),
        (
            "words",
            "        after == K_L_BRACE\n    } else if w == W_FOR {",
            "        false\n    } else if w == W_FOR {",
        ),
        (
            "types",
            "            in_type.try_set(widen_u64(ev), true);",
            "            in_type.try_set(widen_u64(ev), false);",
        ),
    ]
]

# The build script links this object only under `vesper-port`; passing it
# keeps the port in this package's dependency graph.
vesper_crate(
    build_script_data = [
        ":highlight_vesper",
        ":highlight_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :highlight_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :highlight_vesper_binding)",
    },
    extra_compile_data = ["//:website"],
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
]))

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-highlight/seed:__pkg__"],
)
