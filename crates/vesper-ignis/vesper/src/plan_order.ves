// ---------------------------------------------------------------------------
// Sorting helpers (stable merge sort over copy elements)

fn less[T: mod copy](a: T, b: T) -> bool where T: Ord {
    match a.cmp(b) {
        Less => true,
        _ => false,
    }
}

fn sort_seq[T: mod copy](inout s: ChunkSeq[T]) where T: Ord {
    let n = s.len();
    if n < 2 {
        return;
    }
    let mut src: ChunkSeq[T] = ChunkSeq::with_capacity[T](n);
    src.extend(in s.as_slice());
    let mut dst: ChunkSeq[T] = ChunkSeq::with_capacity[T](n);
    dst.extend(in src.as_slice());
    let mut width: u64 = 1;
    loop {
        if width >= n {
            break;
        }
        let mut lo: u64 = 0;
        loop {
            if lo >= n {
                break;
            }
            let mid = if wrapping_add(lo, width) < n {
                wrapping_add(lo, width)
            } else {
                n
            };
            let hi = if wrapping_add(mid, width) < n {
                wrapping_add(mid, width)
            } else {
                n
            };
            let mut i = lo;
            let mut j = mid;
            let mut k = lo;
            loop {
                if k >= hi {
                    break;
                }
                let take_left = if i >= mid {
                    false
                } else if j >= hi {
                    true
                } else {
                    match src.try_get(i) {
                        Option::Some(x) => match src.try_get(j) {
                            Option::Some(y) => !less(y, x),
                            Option::None => true,
                        },
                        Option::None => false,
                    }
                };
                let from = if take_left {
                    i
                } else {
                    j
                };
                match src.try_get(from) {
                    Option::Some(v) => {
                        dst.try_set(k, v);
                    },
                    Option::None => (),
                }
                if take_left {
                    i = wrapping_add(i, 1);
                } else {
                    j = wrapping_add(j, 1);
                }
                k = wrapping_add(k, 1);
            }
            lo = hi;
        }
        // Same lengths: the total copy cannot refuse.
        let _copied = src.try_copy_from(0, in dst.as_slice());
        width = wrapping_mul(width, 2);
    }
    let _copied = s.try_copy_from(0, in src.as_slice());
}

// Sorts and removes adjacent duplicates (a `BTreeSet` in the Rust code).
fn sort_dedup[T: mod copy](inout s: ChunkSeq[T]) where T: Ord {
    sort_seq(inout s);
    let n = s.len();
    if n < 2 {
        return;
    }
    let mut w: u64 = 1;
    for r in 1..n {
        match s.try_get(r) {
            Option::Some(v) => match s.try_get(wrapping_sub(w, 1)) {
                Option::Some(prev) => match v.cmp(prev) {
                    Equal => (),
                    _ => {
                        s.try_set(w, v);
                        w = wrapping_add(w, 1);
                    },
                },
                Option::None => (),
            },
            Option::None => (),
        }
    }
    s.truncate(w);
}

fn get32(in s: ChunkSeq[u32], i: u64) -> u32 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => none32(),
    }
}

fn get64(in s: ChunkSeq[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => 0,
    }
}

fn getb(in s: ChunkSeq[bool], i: u64) -> bool {
    match s.try_get(i) {
        Option::Some(v) => v,
        Option::None => false,
    }
}

fn max32(a: u32, b: u32) -> u32 {
    if a > b {
        a
    } else {
        b
    }
}

fn layout_ord(l: Layout) -> u32 {
    match l {
        Layout::Undefined => 0,
        Layout::Common => 1,
        Layout::GenericRead => 2,
        Layout::RenderTarget => 3,
        Layout::UnorderedAccess => 4,
        Layout::DepthStencilWrite => 5,
        Layout::DepthStencilRead => 6,
        Layout::ShaderResource => 7,
        Layout::CopySource => 8,
        Layout::CopyDest => 9,
        Layout::ResolveSource => 10,
        Layout::ResolveDest => 11,
        Layout::ShadingRateSource => 12,
        Layout::DirectQueueCommon => 13,
        Layout::DirectQueueGenericRead => 14,
        Layout::DirectQueueUnorderedAccess => 15,
        Layout::DirectQueueShaderResource => 16,
        Layout::DirectQueueCopySource => 17,
        Layout::DirectQueueCopyDest => 18,
        Layout::ComputeQueueCommon => 19,
        Layout::ComputeQueueGenericRead => 20,
        Layout::ComputeQueueUnorderedAccess => 21,
        Layout::ComputeQueueShaderResource => 22,
        Layout::ComputeQueueCopySource => 23,
        Layout::ComputeQueueCopyDest => 24,
    }
}

fn layout_of(o: u32) -> Layout {
    match o {
        0 => Layout::Undefined,
        1 => Layout::Common,
        2 => Layout::GenericRead,
        3 => Layout::RenderTarget,
        4 => Layout::UnorderedAccess,
        5 => Layout::DepthStencilWrite,
        6 => Layout::DepthStencilRead,
        7 => Layout::ShaderResource,
        8 => Layout::CopySource,
        9 => Layout::CopyDest,
        10 => Layout::ResolveSource,
        11 => Layout::ResolveDest,
        12 => Layout::ShadingRateSource,
        13 => Layout::DirectQueueCommon,
        14 => Layout::DirectQueueGenericRead,
        15 => Layout::DirectQueueUnorderedAccess,
        16 => Layout::DirectQueueShaderResource,
        17 => Layout::DirectQueueCopySource,
        18 => Layout::DirectQueueCopyDest,
        19 => Layout::ComputeQueueCommon,
        20 => Layout::ComputeQueueGenericRead,
        21 => Layout::ComputeQueueUnorderedAccess,
        22 => Layout::ComputeQueueShaderResource,
        23 => Layout::ComputeQueueCopySource,
        _ => Layout::ComputeQueueCopyDest,
    }
}

// ---------------------------------------------------------------------------
// Hazard planner (src/plan.rs)

// `DependencyKind`, in the Rust enum's order.
copy enum DependencyKind {
    ReadAfterWrite,
    WriteAfterRead,
    WriteAfterWrite,
    ReadOrder,
    Explicit
}

fn dep_kind_ord(k: DependencyKind) -> u32 {
    match k {
        DependencyKind::ReadAfterWrite => 0,
        DependencyKind::WriteAfterRead => 1,
        DependencyKind::WriteAfterWrite => 2,
        DependencyKind::ReadOrder => 3,
        DependencyKind::Explicit => 4,
    }
}

fn dep_kind_of(o: u32) -> DependencyKind {
    match o {
        0 => DependencyKind::ReadAfterWrite,
        1 => DependencyKind::WriteAfterRead,
        2 => DependencyKind::WriteAfterWrite,
        3 => DependencyKind::ReadOrder,
        _ => DependencyKind::Explicit,
    }
}

// An ordering edge, ordered as the Rust `(before, after, kind, resource)`
// tuple (`has_resource` 0 sorts first, as `None` does).
copy struct Edge {
    before: u32,
    after: u32,
    kind: u32,
    has_resource: u32,
    resource: u32
}

impl Ord for Edge {}

impl Eq for Edge {}

// A `Dependency` of the plan; `texture` says which handle kind `resource`
// names.
copy struct DepRec {
    before: u32,
    after: u32,
    kind: DependencyKind,
    has_resource: bool,
    resource: u32,
    texture: bool
}

// A barrier of the plan (`Barrier::Buffer` or `Barrier::Texture`).
copy struct BarrierRec {
    texture: bool,
    resource: u32,
    sync_before: u32,
    sync_after: u32,
    access_before: u32,
    access_after: u32,
    layout_before: Layout,
    layout_after: Layout,
    subresources: SubresourceRange
}

// One step of a queue stream. `tag` 0 is `Wait { queue: a, value: b }`, 1
// `Barriers` (`b` barriers from index `a`), 2 `Execute(a)`, 3
// `Signal { value: b }`.
copy struct CmdRec {
    queue: u32,
    tag: u32,
    a: u64,
    b: u64
}

copy enum PlanFault {
    None,
    Cycle,
    NoLayoutForAccess {
        pass: u32,
        resource: u32,
        subresource: u32,
        access: u32
    },
    UnsupportedQueueHandoff {
        pass: u32,
        resource: u32,
        subresource: u32,
        from: Layout,
        to: Layout
    },
    FinalLayoutUnreachable {
        resource: u32,
        subresource: u32,
        from: Layout,
        to: Layout
    }
}

// The plan, or the fault that stopped it (`cycle` holds the passes of a
// `Cycle`).
struct PlanOut {
    fault: PlanFault,
    cycle: ChunkSeq[u32],
    order: ChunkSeq[u32],
    deps: ChunkSeq[DepRec],
    cmds: ChunkSeq[CmdRec],
    barriers: ChunkSeq[BarrierRec]
}

fn get_pass(in g: Graph, p: u64) -> PassInfo {
    match g.passes.try_get(p) {
        Option::Some(x) => x,
        Option::None => PassInfo {
            queue: 0,
            first_use: 0,
            use_count: 0
        },
    }
}

fn get_resource(in g: Graph, r: u64) -> Resource {
    match g.resources.try_get(r) {
        Option::Some(x) => x,
        Option::None => Resource {
            texture: false,
            size: 0,
            mips: 1,
            slices: 1,
            planes: 1,
            initial_layout: Layout::Undefined,
            has_final: false,
            final_layout: Layout::Undefined
        },
    }
}

fn get_queue(in g: Graph, q: u64) -> QueueKind {
    match g.queues.try_get(q) {
        Option::Some(k) => k,
        Option::None => QueueKind::Direct,
    }
}

// The hazard between use `a` of pass `i` and use `b` of a later pass `j`
// on the same resource, pushed onto `out` unless there is none.
fn push_hazard(inout out: ChunkSeq[Edge], i: u64, j: u64, a: Use, b: Use) {
    let aw = access_is_write(a.access);
    let bw = access_is_write(b.access);
    let buffer_writers = a.bytes && aw && bw;
    if buffer_writers || uses_overlap(a, b) {
        let kind: u32 = if aw && bw {
            2
        } else if aw {
            0
        } else if bw {
            1
        } else if a.bytes || (a.has_layout && b.has_layout && a.layout == b.layout) {
            5
        } else {
            3
        };
        if kind != 5 {
            out
                .push(
                    Edge {
                        before: wrapping_u32(i),
                        after: wrapping_u32(j),
                        kind: kind,
                        has_resource: 1,
                        resource: a.resource
                    }
                );
        }
    }
}

// Sorts a short run of edges in place and drops duplicates (insertion
// sort: the run holds the hazards of one pass pair).
fn sort_dedup_short(inout s: ChunkSeq[Edge]) {
    let n = s.len();
    for r in 1..n {
        match s.try_get(r) {
            Option::Some(v) => {
                let mut k = r;
                loop {
                    if k == 0 {
                        break;
                    }
                    match s.try_get(wrapping_sub(k, 1)) {
                        Option::Some(prev) => {
                            if less(v, prev) {
                                s.try_set(k, prev);
                                k = wrapping_sub(k, 1);
                            } else {
                                break;
                            }
                        },
                        Option::None => {
                            break;
                        },
                    }
                }
                s.try_set(k, v);
            },
            Option::None => (),
        }
    }
    if n < 2 {
        return;
    }
    let mut w: u64 = 1;
    for r in 1..n {
        match s.try_get(r) {
            Option::Some(v) => match s.try_get(wrapping_sub(w, 1)) {
                Option::Some(prev) => match v.cmp(prev) {
                    Equal => (),
                    _ => {
                        s.try_set(w, v);
                        w = wrapping_add(w, 1);
                    },
                },
                Option::None => (),
            },
            Option::None => (),
        }
    }
    s.truncate(w);
}

// The pass of the use at `list[k]`, or `none32()` past the list.
fn pass_at(in list: ChunkSeq[u64], in use_pass: ChunkSeq[u32], k: u64) -> u32 {
    match list.try_get(k) {
        Option::Some(u) => get32(in use_pass, u),
        Option::None => none32(),
    }
}

// Pairwise hazards plus explicit edges, sorted and distinct (a `BTreeSet`
// in the Rust code). Each pass `i` walks, for each of its uses, the later
// uses of the same resource (a per-resource index in pass order) and merges
// those walks by pass, so the edges come out in `(before, after)` order and
// only one pass pair's hazards need sorting.
fn hazard_edges(in g: Graph) -> ChunkSeq[Edge] {
    let n = g.passes.len();
    let nr = g.resources.len();
    let nu = g.uses.len();
    let mut use_pass: ChunkSeq[u32] = ChunkSeq::with_capacity[u32](nu);
    let mut start: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](wrapping_add(nr, 1));
    for u in 0..nu {
        use_pass.push(0);
    }
    for r in 0..wrapping_add(nr, 1) {
        start.push(0);
    }
    for p in 0..n {
        let pp = get_pass(in g, p);
        for x in 0..pp.use_count {
            let u = wrapping_add(pp.first_use, x);
            use_pass.try_set(u, wrapping_u32(p));
            let at = wrapping_add(widen_u64(get_use(in g.uses, u).resource), 1);
            let c = wrapping_add(get64(in start, at), 1);
            start.try_set(at, c);
        }
    }
    for r in 0..nr {
        let at = wrapping_add(r, 1);
        let c = wrapping_add(get64(in start, at), get64(in start, r));
        start.try_set(at, c);
    }
    // `list[start[r]..start[r + 1]]`: the uses of resource `r`, in pass
    // order; `slot[u]`: where use `u` sits in it.
    let mut fill: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](nr);
    let mut list: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](nu);
    let mut slot: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](nu);
    for r in 0..nr {
        let c = get64(in start, r);
        fill.push(c);
    }
    for u in 0..nu {
        list.push(0);
        slot.push(0);
    }
    for p in 0..n {
        let pp = get_pass(in g, p);
        for x in 0..pp.use_count {
            let u = wrapping_add(pp.first_use, x);
            let r = widen_u64(get_use(in g.uses, u).resource);
            let k = get64(in fill, r);
            list.try_set(k, u);
            slot.try_set(u, k);
            fill.try_set(r, wrapping_add(k, 1));
        }
    }
    // `next_write[k]`: the first position at or after `k` in its
    // resource's run that holds a write (the run's end when none). A buffer
    // read has hazards only with later writes, so its walk jumps there.
    let mut next_write: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](nu);
    for u in 0..nu {
        next_write.push(0);
    }
    for r in 0..nr {
        let lo = get64(in start, r);
        let hi = get64(in start, wrapping_add(r, 1));
        let mut nw = hi;
        let mut k = hi;
        loop {
            if k <= lo {
                break;
            }
            k = wrapping_sub(k, 1);
            let u = get64(in list, k);
            if access_is_write(get_use(in g.uses, u).access) {
                nw = k;
            }
            next_write.try_set(k, nw);
        }
    }
    let mut edges: ChunkSeq[Edge] = ChunkSeq::new[Edge]();
    let mut group: ChunkSeq[Edge] = ChunkSeq::new[Edge]();
    let mut jump: ChunkSeq[bool] = ChunkSeq::new[bool]();
    let mut cur: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut end: ChunkSeq[u64] = ChunkSeq::new[u64]();
    for i in 0..n {
        let pi = get_pass(in g, i);
        let mine = wrapping_u32(i);
        cur.clear();
        end.clear();
        jump.clear();
        for x in 0..pi.use_count {
            let u = wrapping_add(pi.first_use, x);
            let a = get_use(in g.uses, u);
            let r = widen_u64(a.resource);
            let stop = get64(in start, wrapping_add(r, 1));
            let mut k = wrapping_add(get64(in slot, u), 1);
            loop {
                if k >= stop || pass_at(in list, in use_pass, k) > mine {
                    break;
                }
                k = wrapping_add(k, 1);
            }
            let skip_reads = a.bytes && !access_is_write(a.access);
            if skip_reads && k < stop {
                k = get64(in next_write, k);
            }
            cur.push(k);
            end.push(stop);
            jump.push(skip_reads);
        }
        loop {
            let mut j = none32();
            for x in 0..pi.use_count {
                let k = get64(in cur, x);
                if k < get64(in end, x) {
                    let q = pass_at(in list, in use_pass, k);
                    if q < j {
                        j = q;
                    }
                }
            }
            if j == none32() {
                break;
            }
            group.clear();
            for x in 0..pi.use_count {
                let a = get_use(in g.uses, wrapping_add(pi.first_use, x));
                let stop = get64(in end, x);
                let mut k = get64(in cur, x);
                loop {
                    if k >= stop || pass_at(in list, in use_pass, k) != j {
                        break;
                    }
                    let b = match list.try_get(k) {
                        Option::Some(v) => get_use(in g.uses, v),
                        Option::None => get_use(in g.uses, nu),
                    };
                    push_hazard(inout group, i, widen_u64(j), a, b);
                    k = wrapping_add(k, 1);
                }
                if k < stop && getb(in jump, x) {
                    k = get64(in next_write, k);
                }
                cur.try_set(x, k);
            }
            sort_dedup_short(inout group);
            for e in 0..group.len() {
                match group.try_get(e) {
                    Option::Some(v) => edges.push(v),
                    Option::None => (),
                }
            }
        }
    }
    let mut explicit: ChunkSeq[Edge] = ChunkSeq::new[Edge]();
    for e in 0..g.explicit.len() {
        match g.explicit.try_get(e) {
            Option::Some(x) => explicit
                .push(
                    Edge {
                        before: x.before,
                        after: x.after,
                        kind: 4,
                        has_resource: 0,
                        resource: 0
                    }
                ),
            Option::None => (),
        }
    }
    if explicit.len() == 0 {
        return edges;
    }
    sort_dedup(inout explicit);
    // Merge the two sorted, distinct runs (a hazard never equals an
    // explicit edge: `has_resource` differs).
    let mut out: ChunkSeq[Edge] = ChunkSeq::with_capacity[Edge](
        wrapping_add(edges.len(), explicit.len())
    );
    let mut h: u64 = 0;
    let mut x: u64 = 0;
    loop {
        match edges.try_get(h) {
            Option::Some(a) => match explicit.try_get(x) {
                Option::Some(b) => {
                    if less(b, a) {
                        out.push(b);
                        x = wrapping_add(x, 1);
                    } else {
                        out.push(a);
                        h = wrapping_add(h, 1);
                    }
                },
                Option::None => {
                    out.push(a);
                    h = wrapping_add(h, 1);
                },
            },
            Option::None => match explicit.try_get(x) {
                Option::Some(b) => {
                    out.push(b);
                    x = wrapping_add(x, 1);
                },
                Option::None => {
                    break;
                },
            },
        }
    }
    out
}

copy enum OrderOutcome {
    Ordered,
    Cyclic
}

// Distinct (before, after) pairs of `edges` (sorted and distinct, as
// `hazard_edges` returns them), sorted by `(key, other)`. By `before` they
// are already in order; by `after` a stable counting sort over the `n`
// passes keeps each bucket in `before` order.
fn pairs_by(in edges: ChunkSeq[Edge], by_after: bool, n: u64) -> ChunkSeq[Edge2] {
    let m = edges.len();
    let mut out: ChunkSeq[Edge2] = ChunkSeq::with_capacity[Edge2](m);
    if by_after {
        let mut at: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](wrapping_add(n, 1));
        for v in 0..wrapping_add(n, 1) {
            at.push(0);
        }
        for i in 0..m {
            match edges.try_get(i) {
                Option::Some(e) => {
                    let k = wrapping_add(widen_u64(e.after), 1);
                    let c = wrapping_add(get64(in at, k), 1);
                    at.try_set(k, c);
                },
                Option::None => (),
            }
        }
        for v in 0..n {
            let k = wrapping_add(v, 1);
            let c = wrapping_add(get64(in at, k), get64(in at, v));
            at.try_set(k, c);
        }
        for i in 0..m {
            out
                .push(
                    Edge2 {
                        before: 0,
                        after: 0
                    }
                );
        }
        for i in 0..m {
            match edges.try_get(i) {
                Option::Some(e) => {
                    let k = widen_u64(e.after);
                    let w = get64(in at, k);
                    out
                        .try_set(
                            w,
                            Edge2 {
                                before: e.after,
                                after: e.before
                            }
                        );
                    at.try_set(k, wrapping_add(w, 1));
                },
                Option::None => (),
            }
        }
    } else {
        for i in 0..m {
            match edges.try_get(i) {
                Option::Some(e) => out
                    .push(
                        Edge2 {
                            before: e.before,
                            after: e.after
                        }
                    ),
                Option::None => (),
            }
        }
    }
    dedup_sorted(inout out);
    out
}

// Removes adjacent duplicates of a sorted sequence.
fn dedup_sorted[T: mod copy](inout s: ChunkSeq[T]) where T: Ord {
    let n = s.len();
    if n < 2 {
        return;
    }
    let mut w: u64 = 1;
    for r in 1..n {
        match s.try_get(r) {
            Option::Some(v) => match s.try_get(wrapping_sub(w, 1)) {
                Option::Some(prev) => match v.cmp(prev) {
                    Equal => (),
                    _ => {
                        s.try_set(w, v);
                        w = wrapping_add(w, 1);
                    },
                },
                Option::None => (),
            },
            Option::None => (),
        }
    }
    s.truncate(w);
}

impl Ord for Edge2 {}

impl Eq for Edge2 {}

// Start offset of each key in pairs sorted by key (n + 1 entries).
fn offsets(in pairs: ChunkSeq[Edge2], n: u64) -> ChunkSeq[u64] {
    let mut starts: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut k: u64 = 0;
    for v in 0..n {
        loop {
            match pairs.try_get(k) {
                Option::Some(p) => {
                    if widen_u64(p.before) < v {
                        k = wrapping_add(k, 1);
                    } else {
                        break;
                    }
                },
                Option::None => {
                    break;
                },
            }
        }
        starts.push(k);
    }
    starts.push(pairs.len());
    starts
}

// Kahn's algorithm taking the lowest ready index, or the cycle that blocks
// it (`topological_order`).
fn topological_order(
    n: u64,
    in edges: ChunkSeq[Edge],
    inout order: ChunkSeq[u32],
    inout cycle: ChunkSeq[u32]
) -> OrderOutcome {
    let succ = pairs_by(in edges, false, n);
    let pred = pairs_by(in edges, true, n);
    let succ_at = offsets(in succ, n);
    let pred_at = offsets(in pred, n);
    let mut indegree: ChunkSeq[u64] = ChunkSeq::new[u64]();
    let mut done: ChunkSeq[bool] = ChunkSeq::new[bool]();
    for p in 0..n {
        indegree.push(wrapping_sub(get64(in pred_at, wrapping_add(p, 1)), get64(in pred_at, p)));
        done.push(false);
    }
    loop {
        let mut pick = n;
        for p in 0..n {
            if pick == n && !getb(in done, p) && get64(in indegree, p) == 0 {
                pick = p;
            }
        }
        if pick == n {
            break;
        }
        done.try_set(pick, true);
        order.push(wrapping_u32(pick));
        for k in get64(in succ_at, pick)..get64(in succ_at, wrapping_add(pick, 1)) {
            match succ.try_get(k) {
                Option::Some(e) => {
                    let s = widen_u64(e.after);
                    let left = wrapping_sub(get64(in indegree, s), 1);
                    indegree.try_set(s, left);
                },
                Option::None => (),
            }
        }
    }
    if order.len() == n {
        return OrderOutcome::Ordered;
    }
    // Every remaining node has a remaining predecessor; walk the smallest
    // ones until a node repeats.
    let mut start = n;
    for p in 0..n {
        if start == n && get64(in indegree, p) > 0 {
            start = p;
        }
    }
    let mut walk: ChunkSeq[u64] = ChunkSeq::new[u64]();
    walk.push(start);
    let mut cur = start;
    loop {
        let mut next = n;
        for k in get64(in pred_at, cur)..get64(in pred_at, wrapping_add(cur, 1)) {
            match pred.try_get(k) {
                Option::Some(e) => {
                    let b = widen_u64(e.after);
                    if next == n && get64(in indegree, b) > 0 {
                        next = b;
                    }
                },
                Option::None => (),
            }
        }
        let mut pos = walk.len();
        for w in 0..walk.len() {
            if pos == walk.len() && get64(in walk, w) == next {
                pos = w;
            }
        }
        if pos < walk.len() || next == n {
            // walk[pos..] reversed, rotated to start at its smallest pass.
            let mut rev: ChunkSeq[u64] = ChunkSeq::new[u64]();
            let mut i = walk.len();
            loop {
                if i <= pos {
                    break;
                }
                i = wrapping_sub(i, 1);
                rev.push(get64(in walk, i));
            }
            let mut min_at: u64 = 0;
            for x in 0..rev.len() {
                if get64(in rev, x) < get64(in rev, min_at) {
                    min_at = x;
                }
            }
            for x in 0..rev.len() {
                let mut at = wrapping_add(min_at, x);
                if at >= rev.len() {
                    at = wrapping_sub(at, rev.len());
                }
                cycle.push(wrapping_u32(get64(in rev, at)));
            }
            return OrderOutcome::Cyclic;
        }
        walk.push(next);
        cur = next;
    }
    OrderOutcome::Cyclic
}

// One access recorded against a subresource or byte segment.
copy struct Rec {
    pass: u32,
    queue: u32,
    sync: u32,
    access: u32
}

// Which later accesses on a queue are already ordered after `last_write`:
// a barrier with this after-scope (sync, access) followed it, or a fence
// wait did.
copy enum Covered {
    Scope(u32, u32),
    Full
}

copy struct RecNode {
    rec: Rec,
    next: u32
}

copy struct CovNode {
    queue: u32,
    cov: Covered,
    next: u32
}

// A subresource or segment state. Reads and coverage are linked lists in
// the planner's pools.
copy struct SubState {
    has_layout: bool,
    layout: Layout,
    has_write: bool,
    write: Rec,
    reads_head: u32,
    reads_tail: u32,
    cov_head: u32
}

copy struct Seg {
    start: u64,
    end: u64,
    sid: u32,
    next: u32
}

// A pending texture barrier for one subresource, ordered by its key
// (placement, resource, scopes, layout ordinals), then the subresource.
// Placement: `pk0` 0/1/2 is `Single(Pre/Post/Final(pk1))`, 4 is
// `Split { begin_after: pk1, end_before: pk2 }`.
copy struct TexEntry {
    pk0: u32,
    pk1: u32,
    pk2: u32,
    resource: u32,
    sync_before: u32,
    sync_after: u32,
    access_before: u32,
    access_after: u32,
    layout_before: u32,
    layout_after: u32,
    sub: u32,
    mip: u32,
    slice: u32,
    plane: u32
}

impl Ord for TexEntry {}

// A subresource: its flat index and its (mip, slice, plane).
copy struct SubPos {
    flat: u32,
    mip: u32,
    slice: u32,
    plane: u32
}

fn no_sub() -> SubPos {
    SubPos {
        flat: 0,
        mip: 0,
        slice: 0,
        plane: 0
    }
}

impl Eq for TexEntry {}

copy struct BufEntry {
    pk0: u32,
    pk1: u32,
    pk2: u32,
    resource: u32,
    sync_before: u32,
    sync_after: u32,
    access_before: u32,
    access_after: u32
}

impl Ord for BufEntry {}

impl Eq for BufEntry {}

copy struct Pair {
    key: u32,
    value: u32
}

impl Ord for Pair {}

impl Eq for Pair {}

copy struct Placement {
    pk0: u32,
    pk1: u32,
    pk2: u32
}

copy struct Req {
    access: u32,
    sync: u32,
    has_layout: bool,
    layout: Layout,
    has_other: bool,
    other: Rec
}

struct Planner {
    split: bool,
    nq: u64,
    qpos: ChunkSeq[u32],
    gpos: ChunkSeq[u32],
    has_writer: ChunkSeq[bool],
    writer: ChunkSeq[Rec],
    last_touch: ChunkSeq[u32],
    tex: ChunkSeq[TexEntry],
    buf: ChunkSeq[BufEntry],
    cross: ChunkSeq[Pair],
    final_waits: ChunkSeq[Pair],
    states: ChunkSeq[SubState],
    reads: ChunkSeq[RecNode],
    covs: ChunkSeq[CovNode],
    segs: ChunkSeq[Seg],
    base: ChunkSeq[u32]
}

fn empty_rec() -> Rec {
    Rec {
        pass: none32(),
        queue: none32(),
        sync: 0,
        access: no_access()
    }
}

fn new_state(has_layout: bool, layout: Layout) -> SubState {
    SubState {
        has_layout: has_layout,
        layout: layout,
        has_write: false,
        write: empty_rec(),
        reads_head: none32(),
        reads_tail: none32(),
        cov_head: none32()
    }
}

fn state_at(in pl: Planner, s: u32) -> SubState {
    match pl.states.try_get(widen_u64(s)) {
        Option::Some(x) => x,
        Option::None => new_state(false, Layout::Undefined),
    }
}

fn seg_at(in pl: Planner, s: u32) -> Seg {
    match pl.segs.try_get(widen_u64(s)) {
        Option::Some(x) => x,
        Option::None => Seg {
            start: 0,
            end: 0,
            sid: none32(),
            next: none32()
        },
    }
}
