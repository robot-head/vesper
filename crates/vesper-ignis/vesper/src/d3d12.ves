// @vesper/ignis: the vesper-ignis render-graph planner (design section 19,
// port wave P1 lane 12, #909). The Rust crate keeps its public types and
// forwards to the functions below through the generated binding
// (port/binding.rs); names, strings and backend payloads stay in the Rust
// wrapper (src/port/).
//
// Sections: D3D12 barrier vocabulary, graph declarations, the hazard
// planner, multi-backend lowering, the lifecycle fence protocol and the
// recording backend. Bit sets (`Sync`, `Access`) cross the boundary as
// their raw D3D12 `u32` patterns. Export ABI v3 lends the copy-struct
// slices of `graph_add_pass` and `lower_plan` in place (#954).
//
// @export abi 3

// ---------------------------------------------------------------------------
// D3D12 enhanced-barrier vocabulary (src/d3d12.rs)
//
// `D3D12_BARRIER_SYNC` bits (RTAS = raytracing acceleration structure,
// UAV = unordered access view).
const SYNC_ALL: u32 = 0x1;
const SYNC_DRAW: u32 = 0x2;
const SYNC_INDEX_INPUT: u32 = 0x4;
const SYNC_VERTEX_SHADING: u32 = 0x8;
const SYNC_PIXEL_SHADING: u32 = 0x10;
const SYNC_DEPTH_STENCIL: u32 = 0x20;
const SYNC_RENDER_TARGET: u32 = 0x40;
const SYNC_COMPUTE_SHADING: u32 = 0x80;
const SYNC_RAYTRACING: u32 = 0x100;
const SYNC_COPY: u32 = 0x200;
const SYNC_RESOLVE: u32 = 0x400;
const SYNC_EXECUTE_INDIRECT: u32 = 0x800;
const SYNC_ALL_SHADING: u32 = 0x1000;
const SYNC_NON_PIXEL_SHADING: u32 = 0x2000;
const SYNC_EMIT_RTAS_POSTBUILD_INFO: u32 = 0x4000;
const SYNC_CLEAR_UAV: u32 = 0x8000;
const SYNC_BUILD_RTAS: u32 = 0x800000;
const SYNC_COPY_RTAS: u32 = 0x1000000;
const SYNC_SPLIT: u32 = 0x80000000;
// Every sync bit but SPLIT.
const SYNC_SCOPES: u32 = 0x7fffffff;
// ALL through CLEAR_UAV, the low sixteen scopes.
const SYNC_ALL_THROUGH_CLEAR_UAV: u32 = 0xffff;

// `D3D12_BARRIER_ACCESS` bits (COMMON is 0).
const ACCESS_VERTEX_BUFFER: u32 = 0x1;
const ACCESS_CONSTANT_BUFFER: u32 = 0x2;
const ACCESS_INDEX_BUFFER: u32 = 0x4;
const ACCESS_RENDER_TARGET: u32 = 0x8;
const ACCESS_UNORDERED_ACCESS: u32 = 0x10;
const ACCESS_DEPTH_STENCIL_WRITE: u32 = 0x20;
const ACCESS_DEPTH_STENCIL_READ: u32 = 0x40;
const ACCESS_SHADER_RESOURCE: u32 = 0x80;
const ACCESS_STREAM_OUTPUT: u32 = 0x100;
const ACCESS_INDIRECT_ARGUMENT: u32 = 0x200;
const ACCESS_COPY_DEST: u32 = 0x400;
const ACCESS_COPY_SOURCE: u32 = 0x800;
const ACCESS_RESOLVE_DEST: u32 = 0x1000;
const ACCESS_RESOLVE_SOURCE: u32 = 0x2000;
const ACCESS_RTAS_READ: u32 = 0x4000;
const ACCESS_RTAS_WRITE: u32 = 0x8000;
const ACCESS_SHADING_RATE_SOURCE: u32 = 0x10000;
const ACCESS_NO_ACCESS: u32 = 0x80000000;

// `D3D12_BARRIER_LAYOUT` for textures, in the Rust enum's order.
copy enum Layout {
    Undefined,
    Common,
    GenericRead,
    RenderTarget,
    UnorderedAccess,
    DepthStencilWrite,
    DepthStencilRead,
    ShaderResource,
    CopySource,
    CopyDest,
    ResolveSource,
    ResolveDest,
    ShadingRateSource,
    DirectQueueCommon,
    DirectQueueGenericRead,
    DirectQueueUnorderedAccess,
    DirectQueueShaderResource,
    DirectQueueCopySource,
    DirectQueueCopyDest,
    ComputeQueueCommon,
    ComputeQueueGenericRead,
    ComputeQueueUnorderedAccess,
    ComputeQueueShaderResource,
    ComputeQueueCopySource,
    ComputeQueueCopyDest
}

copy enum QueueKind {
    Direct,
    Compute,
    Copy
}

// Sync scopes the `ALL` table supersedes.
fn all_sync_supersedes() -> u32 {
    SYNC_DRAW | SYNC_INDEX_INPUT | SYNC_VERTEX_SHADING | SYNC_PIXEL_SHADING | SYNC_DEPTH_STENCIL | SYNC_RENDER_TARGET | SYNC_COMPUTE_SHADING | SYNC_RAYTRACING | SYNC_COPY | SYNC_RESOLVE | SYNC_EXECUTE_INDIRECT | SYNC_CLEAR_UAV
}

fn split_bit() -> u32 {
    SYNC_SPLIT
}

fn no_access() -> u32 {
    ACCESS_NO_ACCESS
}

// Aggregate scopes expanded to the scopes they supersede.
pub fn sync_expanded(sync: u32) -> u32 {
    let mut bits = sync & SYNC_SCOPES;
    if (bits & SYNC_ALL) != 0 {
        bits = bits | all_sync_supersedes() | SYNC_ALL_SHADING | SYNC_NON_PIXEL_SHADING;
    }
    if (bits & SYNC_DRAW) != 0 {
        bits = bits | SYNC_INDEX_INPUT | SYNC_VERTEX_SHADING | SYNC_PIXEL_SHADING | SYNC_DEPTH_STENCIL | SYNC_RENDER_TARGET;
    }
    if (bits & SYNC_ALL_SHADING) != 0 {
        bits = bits | SYNC_VERTEX_SHADING | SYNC_PIXEL_SHADING | SYNC_COMPUTE_SHADING;
    }
    if (bits & SYNC_NON_PIXEL_SHADING) != 0 {
        bits = bits | SYNC_VERTEX_SHADING | SYNC_COMPUTE_SHADING;
    }
    bits
}

pub fn sync_covers(have: u32, need: u32) -> bool {
    let h = sync_expanded(have);
    let n = sync_expanded(need);
    (h & n) == n
}

// Union where NONE is the identity (`Sync::union_nonempty`).
fn sync_union(a: u32, b: u32) -> u32 {
    if a == 0 {
        b
    } else if b == 0 {
        a
    } else {
        a | b
    }
}

// Union where NO_ACCESS is the identity (`Access::union_nonempty`).
fn access_union(a: u32, b: u32) -> u32 {
    if a == no_access() {
        b
    } else if b == no_access() {
        a
    } else {
        a | b
    }
}

fn write_access() -> u32 {
    ACCESS_RENDER_TARGET | ACCESS_UNORDERED_ACCESS | ACCESS_DEPTH_STENCIL_WRITE | ACCESS_STREAM_OUTPUT | ACCESS_COPY_DEST | ACCESS_RESOLVE_DEST | ACCESS_RTAS_WRITE
}

fn buffer_only_access() -> u32 {
    ACCESS_VERTEX_BUFFER | ACCESS_CONSTANT_BUFFER | ACCESS_INDEX_BUFFER | ACCESS_STREAM_OUTPUT | ACCESS_INDIRECT_ARGUMENT | ACCESS_RTAS_READ | ACCESS_RTAS_WRITE
}

fn texture_only_access() -> u32 {
    ACCESS_RENDER_TARGET | ACCESS_DEPTH_STENCIL_WRITE | ACCESS_DEPTH_STENCIL_READ | ACCESS_RESOLVE_DEST | ACCESS_RESOLVE_SOURCE | ACCESS_SHADING_RATE_SOURCE
}

// Every access bit, VERTEX_BUFFER through SHADING_RATE_SOURCE.
fn known_access() -> u32 {
    0x1ffff
}

pub fn access_is_write(access: u32) -> bool {
    access != no_access() && (access & write_access()) != 0
}

fn access_contains(have: u32, need: u32) -> bool {
    (have & need) == need
}

// Sync scopes compatible with one access bit.
fn compatible_sync(bit: u32) -> u32 {
    let shading: u32 = SYNC_VERTEX_SHADING | SYNC_PIXEL_SHADING | SYNC_COMPUTE_SHADING | SYNC_DRAW | SYNC_ALL_SHADING;
    let rtas: u32 = SYNC_BUILD_RTAS | SYNC_COPY_RTAS;
    let listed: u32 = if bit == ACCESS_VERTEX_BUFFER {
        SYNC_VERTEX_SHADING | SYNC_DRAW | SYNC_ALL_SHADING
    } else if bit == ACCESS_CONSTANT_BUFFER {
        shading
    } else if bit == ACCESS_INDEX_BUFFER {
        SYNC_INDEX_INPUT | SYNC_DRAW
    } else if bit == ACCESS_RENDER_TARGET {
        SYNC_DRAW | SYNC_RENDER_TARGET
    } else if bit == ACCESS_UNORDERED_ACCESS {
        shading | SYNC_CLEAR_UAV | SYNC_EMIT_RTAS_POSTBUILD_INFO | SYNC_RAYTRACING
    } else if bit == ACCESS_DEPTH_STENCIL_WRITE || bit == ACCESS_DEPTH_STENCIL_READ {
        SYNC_DRAW | SYNC_DEPTH_STENCIL
    } else if bit == ACCESS_SHADER_RESOURCE {
        shading | SYNC_BUILD_RTAS | SYNC_RAYTRACING
    } else if bit == ACCESS_STREAM_OUTPUT {
        SYNC_VERTEX_SHADING | SYNC_DRAW | SYNC_ALL_SHADING
    } else if bit == ACCESS_INDIRECT_ARGUMENT {
        SYNC_EXECUTE_INDIRECT
    } else if bit == ACCESS_COPY_DEST || bit == ACCESS_COPY_SOURCE {
        SYNC_COPY
    } else if bit == ACCESS_RESOLVE_DEST || bit == ACCESS_RESOLVE_SOURCE {
        SYNC_RESOLVE
    } else if bit == ACCESS_RTAS_READ {
        SYNC_COMPUTE_SHADING | SYNC_RAYTRACING | SYNC_ALL_SHADING | rtas | SYNC_EMIT_RTAS_POSTBUILD_INFO
    } else if bit == ACCESS_RTAS_WRITE {
        SYNC_COMPUTE_SHADING | SYNC_RAYTRACING | SYNC_ALL_SHADING | rtas
    } else if bit == ACCESS_SHADING_RATE_SOURCE {
        SYNC_PIXEL_SHADING | SYNC_ALL_SHADING
    } else {
        0
    };
    SYNC_ALL | listed
}

// Access bits for which none of `sync`'s scopes is listed as compatible.
pub fn access_incompatible_with_sync(access: u32, sync: u32) -> u32 {
    let mut bad: u32 = 0;
    let mut rest = access;
    loop {
        if rest == 0 {
            break;
        }
        let bit = rest & wrapping_add(~rest, 1);
        rest = rest & ~bit;
        if (sync & compatible_sync(bit)) == 0 {
            bad = bad | bit;
        }
    }
    bad
}

pub fn layout_raw(layout: Layout) -> u32 {
    match layout {
        Layout::Undefined => 0xffffffff,
        Layout::Common => 0,
        Layout::GenericRead => 1,
        Layout::RenderTarget => 2,
        Layout::UnorderedAccess => 3,
        Layout::DepthStencilWrite => 4,
        Layout::DepthStencilRead => 5,
        Layout::ShaderResource => 6,
        Layout::CopySource => 7,
        Layout::CopyDest => 8,
        Layout::ResolveSource => 9,
        Layout::ResolveDest => 10,
        Layout::ShadingRateSource => 11,
        Layout::DirectQueueCommon => 18,
        Layout::DirectQueueGenericRead => 19,
        Layout::DirectQueueUnorderedAccess => 20,
        Layout::DirectQueueShaderResource => 21,
        Layout::DirectQueueCopySource => 22,
        Layout::DirectQueueCopyDest => 23,
        Layout::ComputeQueueCommon => 24,
        Layout::ComputeQueueGenericRead => 25,
        Layout::ComputeQueueUnorderedAccess => 26,
        Layout::ComputeQueueShaderResource => 27,
        Layout::ComputeQueueCopySource => 28,
        Layout::ComputeQueueCopyDest => 29,
    }
}

// Accesses the specification lists as compatible with a layout.
pub fn layout_compatible_access(layout: Layout) -> u32 {
    let srv: u32 = ACCESS_SHADER_RESOURCE;
    let src: u32 = ACCESS_COPY_SOURCE;
    let dst: u32 = ACCESS_COPY_DEST;
    let uav: u32 = ACCESS_UNORDERED_ACCESS;
    match layout {
        Layout::Undefined => 0,
        Layout::Common => srv | src | dst,
        Layout::DirectQueueCommon => srv | src | dst | uav,
        Layout::ComputeQueueCommon => srv | src | dst | uav,
        Layout::GenericRead => srv | src,
        Layout::ComputeQueueGenericRead => srv | src,
        Layout::DirectQueueGenericRead => srv | src | ACCESS_DEPTH_STENCIL_READ | ACCESS_SHADING_RATE_SOURCE | ACCESS_RESOLVE_SOURCE,
        Layout::RenderTarget => ACCESS_RENDER_TARGET,
        Layout::UnorderedAccess => uav,
        Layout::DirectQueueUnorderedAccess => uav,
        Layout::ComputeQueueUnorderedAccess => uav,
        Layout::DepthStencilWrite => ACCESS_DEPTH_STENCIL_READ | ACCESS_DEPTH_STENCIL_WRITE,
        Layout::DepthStencilRead => ACCESS_DEPTH_STENCIL_READ,
        Layout::ShaderResource => srv,
        Layout::DirectQueueShaderResource => srv,
        Layout::ComputeQueueShaderResource => srv,
        Layout::CopySource => src,
        Layout::DirectQueueCopySource => src,
        Layout::ComputeQueueCopySource => src,
        Layout::CopyDest => dst,
        Layout::DirectQueueCopyDest => dst,
        Layout::ComputeQueueCopyDest => dst,
        Layout::ResolveSource => ACCESS_RESOLVE_SOURCE,
        Layout::ResolveDest => ACCESS_RESOLVE_DEST,
        Layout::ShadingRateSource => ACCESS_SHADING_RATE_SOURCE,
    }
}

pub fn layout_allows(layout: Layout, access: u32) -> bool {
    access != no_access() && access_contains(layout_compatible_access(layout), access)
}

fn is_compute_queue_layout(layout: Layout) -> bool {
    match layout {
        Layout::ComputeQueueCommon => true,
        Layout::ComputeQueueGenericRead => true,
        Layout::ComputeQueueUnorderedAccess => true,
        Layout::ComputeQueueShaderResource => true,
        Layout::ComputeQueueCopySource => true,
        Layout::ComputeQueueCopyDest => true,
        _ => false,
    }
}

// Layouts a subresource may be in while used on a queue type.
pub fn queue_supports_layout(kind: QueueKind, layout: Layout) -> bool {
    match kind {
        QueueKind::Direct => !(layout == Layout::Undefined || is_compute_queue_layout(layout)),
        QueueKind::Compute => match layout {
            Layout::Common => true,
            Layout::GenericRead => true,
            Layout::UnorderedAccess => true,
            Layout::ShaderResource => true,
            Layout::CopySource => true,
            Layout::CopyDest => true,
            _ => is_compute_queue_layout(layout),
        },
        QueueKind::Copy => layout == Layout::Common,
    }
}

pub fn queue_can_transition(kind: QueueKind, before: Layout, after: Layout) -> bool {
    kind != QueueKind::Copy
        && after != Layout::Undefined
        && (before == Layout::Undefined || queue_supports_layout(kind, before))
        && queue_supports_layout(kind, after)
}

pub fn queue_supported_access(kind: QueueKind) -> u32 {
    match kind {
        QueueKind::Direct => known_access(),
        QueueKind::Compute => ACCESS_CONSTANT_BUFFER | ACCESS_UNORDERED_ACCESS | ACCESS_SHADER_RESOURCE | ACCESS_INDIRECT_ARGUMENT | ACCESS_COPY_DEST | ACCESS_COPY_SOURCE | ACCESS_RTAS_READ | ACCESS_RTAS_WRITE,
        QueueKind::Copy => ACCESS_COPY_DEST | ACCESS_COPY_SOURCE,
    }
}

pub fn queue_supported_sync(kind: QueueKind) -> u32 {
    match kind {
        QueueKind::Direct => SYNC_ALL_THROUGH_CLEAR_UAV | SYNC_BUILD_RTAS | SYNC_COPY_RTAS,
        QueueKind::Compute => SYNC_ALL | SYNC_COMPUTE_SHADING | SYNC_ALL_SHADING | SYNC_NON_PIXEL_SHADING | SYNC_RAYTRACING | SYNC_COPY | SYNC_EXECUTE_INDIRECT | SYNC_CLEAR_UAV | SYNC_EMIT_RTAS_POSTBUILD_INFO | SYNC_BUILD_RTAS | SYNC_COPY_RTAS,
        QueueKind::Copy => SYNC_ALL | SYNC_COPY,
    }
}

// Layouts tried, in order, when a use leaves its layout to the planner and
// the current layout does not admit the access (`AUTO_CANDIDATES`, then
// `Common`).
fn auto_candidate(i: u64) -> Layout {
    match i {
        0 => Layout::ShaderResource,
        1 => Layout::CopySource,
        2 => Layout::CopyDest,
        3 => Layout::UnorderedAccess,
        4 => Layout::RenderTarget,
        5 => Layout::DepthStencilRead,
        6 => Layout::DepthStencilWrite,
        7 => Layout::ResolveSource,
        8 => Layout::ResolveDest,
        9 => Layout::ShadingRateSource,
        10 => Layout::GenericRead,
        11 => Layout::DirectQueueGenericRead,
        _ => Layout::Common,
    }
}
