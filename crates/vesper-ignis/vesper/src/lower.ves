// ---------------------------------------------------------------------------
// Multi-backend barrier lowering (src/multi_backend.rs)
//
// Vulkan `VkPipelineStageFlagBits2`.
const VK_STAGE_DRAW_INDIRECT: u64 = 0x2;
const VK_STAGE_VERTEX_INPUT: u64 = 0x4;
const VK_STAGE_VERTEX_SHADER: u64 = 0x8;
const VK_STAGE_FRAGMENT_SHADER: u64 = 0x80;
const VK_STAGE_EARLY_FRAGMENT_TESTS: u64 = 0x100;
const VK_STAGE_LATE_FRAGMENT_TESTS: u64 = 0x200;
const VK_STAGE_COLOR_ATTACHMENT_OUTPUT: u64 = 0x400;
const VK_STAGE_COMPUTE_SHADER: u64 = 0x800;
const VK_STAGE_ALL_TRANSFER: u64 = 0x1000;
const VK_STAGE_ALL_GRAPHICS: u64 = 0x8000;
const VK_STAGE_ALL_COMMANDS: u64 = 0x10000;
const VK_STAGE_RAY_TRACING_SHADER: u64 = 0x200000;
const VK_STAGE_FRAGMENT_SHADING_RATE_ATTACHMENT: u64 = 0x400000;
const VK_STAGE_TRANSFORM_FEEDBACK: u64 = 0x1000000;
const VK_STAGE_ACCELERATION_STRUCTURE_BUILD: u64 = 0x2000000;
const VK_STAGE_ACCELERATION_STRUCTURE_COPY: u64 = 0x10000000;
const VK_STAGE_RESOLVE: u64 = 0x200000000;
const VK_STAGE_CLEAR: u64 = 0x800000000;
const VK_STAGE_VERTEX_ATTRIBUTE_INPUT: u64 = 0x2000000000;
const VK_STAGE_PRE_RASTERIZATION_SHADERS: u64 = 0x4000000000;

// Vulkan `VkAccessFlagBits2`.
const VK_ACCESS_INDIRECT_COMMAND_READ: u64 = 0x1;
const VK_ACCESS_INDEX_READ: u64 = 0x2;
const VK_ACCESS_VERTEX_ATTRIBUTE_READ: u64 = 0x4;
const VK_ACCESS_UNIFORM_READ: u64 = 0x8;
const VK_ACCESS_SHADER_READ: u64 = 0x20;
const VK_ACCESS_SHADER_WRITE: u64 = 0x40;
const VK_ACCESS_COLOR_ATTACHMENT_READ: u64 = 0x80;
const VK_ACCESS_COLOR_ATTACHMENT_WRITE: u64 = 0x100;
const VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ: u64 = 0x200;
const VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE: u64 = 0x400;
const VK_ACCESS_TRANSFER_READ: u64 = 0x800;
const VK_ACCESS_TRANSFER_WRITE: u64 = 0x1000;
const VK_ACCESS_MEMORY_READ: u64 = 0x8000;
const VK_ACCESS_MEMORY_WRITE: u64 = 0x10000;
const VK_ACCESS_ACCELERATION_STRUCTURE_READ: u64 = 0x200000;
const VK_ACCESS_ACCELERATION_STRUCTURE_WRITE: u64 = 0x400000;
const VK_ACCESS_FRAGMENT_SHADING_RATE_ATTACHMENT_READ: u64 = 0x800000;
const VK_ACCESS_TRANSFORM_FEEDBACK_WRITE: u64 = 0x2000000;

// Metal 4 `MTLStages`.
const MTL_STAGE_VERTEX: u32 = 0x1;
const MTL_STAGE_FRAGMENT: u32 = 0x2;
const MTL_STAGE_TILE: u32 = 0x4;
const MTL_STAGE_DISPATCH: u32 = 0x8000000;
const MTL_STAGE_BLIT: u32 = 0x10000000;
const MTL_STAGE_ACCELERATION_STRUCTURE: u32 = 0x20000000;

copy enum GpuApiTarget {
    D3D12Agility1620,
    Vulkan14,
    Metal4
}

copy enum StageBits {
    Mapped(u64),
    Unmapped(u32)
}

copy enum AccessBits {
    Mapped(u64),
    Unmapped(u32)
}

fn vk_stage_bits_lossy(sync: u32) -> u64 {
    let bits = sync & SYNC_SCOPES;
    let mut out: u64 = 0;
    if (bits & SYNC_ALL) != 0 {
        out = out | VK_STAGE_ALL_COMMANDS;
    }
    if (bits & SYNC_DRAW) != 0 {
        out = out | VK_STAGE_ALL_GRAPHICS;
    }
    if (bits & SYNC_INDEX_INPUT) != 0 {
        out = out | VK_STAGE_VERTEX_INPUT;
    }
    if (bits & SYNC_VERTEX_SHADING) != 0 {
        out = out | VK_STAGE_VERTEX_SHADER | VK_STAGE_VERTEX_ATTRIBUTE_INPUT;
    }
    if (bits & SYNC_PIXEL_SHADING) != 0 {
        out = out | VK_STAGE_FRAGMENT_SHADER;
    }
    if (bits & SYNC_DEPTH_STENCIL) != 0 {
        out = out | VK_STAGE_EARLY_FRAGMENT_TESTS | VK_STAGE_LATE_FRAGMENT_TESTS;
    }
    if (bits & SYNC_RENDER_TARGET) != 0 {
        out = out | VK_STAGE_COLOR_ATTACHMENT_OUTPUT;
    }
    if (bits & SYNC_COMPUTE_SHADING) != 0 {
        out = out | VK_STAGE_COMPUTE_SHADER;
    }
    if (bits & SYNC_RAYTRACING) != 0 {
        out = out | VK_STAGE_RAY_TRACING_SHADER;
    }
    if (bits & SYNC_BUILD_RTAS) != 0 {
        out = out | VK_STAGE_ACCELERATION_STRUCTURE_BUILD;
    }
    if (bits & (SYNC_COPY_RTAS | SYNC_EMIT_RTAS_POSTBUILD_INFO)) != 0 {
        out = out | VK_STAGE_ACCELERATION_STRUCTURE_COPY;
    }
    if (bits & SYNC_COPY) != 0 {
        out = out | VK_STAGE_ALL_TRANSFER;
    }
    if (bits & SYNC_RESOLVE) != 0 {
        out = out | VK_STAGE_RESOLVE;
    }
    if (bits & SYNC_EXECUTE_INDIRECT) != 0 {
        out = out | VK_STAGE_DRAW_INDIRECT;
    }
    if (bits & SYNC_ALL_SHADING) != 0 {
        out = out | VK_STAGE_PRE_RASTERIZATION_SHADERS | VK_STAGE_VERTEX_ATTRIBUTE_INPUT | VK_STAGE_FRAGMENT_SHADER | VK_STAGE_COMPUTE_SHADER;
    }
    if (bits & SYNC_NON_PIXEL_SHADING) != 0 {
        out = out | VK_STAGE_PRE_RASTERIZATION_SHADERS | VK_STAGE_VERTEX_ATTRIBUTE_INPUT | VK_STAGE_COMPUTE_SHADER;
    }
    if (bits & SYNC_CLEAR_UAV) != 0 {
        out = out | VK_STAGE_CLEAR;
    }
    out
}

// Every sync bit the Vulkan mapping knows.
fn mapped_sync() -> u32 {
    SYNC_ALL | SYNC_DRAW | SYNC_INDEX_INPUT | SYNC_VERTEX_SHADING | SYNC_PIXEL_SHADING | SYNC_DEPTH_STENCIL | SYNC_RENDER_TARGET | SYNC_COMPUTE_SHADING | SYNC_RAYTRACING | SYNC_COPY | SYNC_RESOLVE | SYNC_EXECUTE_INDIRECT | SYNC_ALL_SHADING | SYNC_NON_PIXEL_SHADING | SYNC_EMIT_RTAS_POSTBUILD_INFO | SYNC_CLEAR_UAV | SYNC_BUILD_RTAS | SYNC_COPY_RTAS
}

pub fn vk_stage_bits(sync: u32) -> u64 {
    vk_stage_bits_lossy(sync)
}

pub fn try_vk_stage_bits(sync: u32) -> StageBits {
    let rest = (sync & SYNC_SCOPES) & ~mapped_sync();
    if rest != 0 {
        StageBits::Unmapped(rest)
    } else {
        StageBits::Mapped(vk_stage_bits_lossy(sync))
    }
}

fn vk_access_bits_lossy(access: u32) -> u64 {
    if access == no_access() {
        return 0;
    }
    if access == 0 {
        return VK_ACCESS_MEMORY_READ | VK_ACCESS_MEMORY_WRITE;
    }
    let mut out: u64 = 0;
    if (access & ACCESS_INDIRECT_ARGUMENT) != 0 {
        out = out | VK_ACCESS_INDIRECT_COMMAND_READ;
    }
    if (access & ACCESS_INDEX_BUFFER) != 0 {
        out = out | VK_ACCESS_INDEX_READ;
    }
    if (access & ACCESS_VERTEX_BUFFER) != 0 {
        out = out | VK_ACCESS_VERTEX_ATTRIBUTE_READ;
    }
    if (access & ACCESS_CONSTANT_BUFFER) != 0 {
        out = out | VK_ACCESS_UNIFORM_READ;
    }
    if (access & ACCESS_SHADER_RESOURCE) != 0 {
        out = out | VK_ACCESS_SHADER_READ;
    }
    if (access & ACCESS_UNORDERED_ACCESS) != 0 {
        out = out | VK_ACCESS_SHADER_READ | VK_ACCESS_SHADER_WRITE;
    }
    if (access & ACCESS_RENDER_TARGET) != 0 {
        out = out | VK_ACCESS_COLOR_ATTACHMENT_READ | VK_ACCESS_COLOR_ATTACHMENT_WRITE;
    }
    if (access & ACCESS_DEPTH_STENCIL_READ) != 0 {
        out = out | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ;
    }
    if (access & ACCESS_DEPTH_STENCIL_WRITE) != 0 {
        out = out | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE;
    }
    if (access & ACCESS_STREAM_OUTPUT) != 0 {
        out = out | VK_ACCESS_TRANSFORM_FEEDBACK_WRITE;
    }
    if (access & (ACCESS_COPY_SOURCE | ACCESS_RESOLVE_SOURCE)) != 0 {
        out = out | VK_ACCESS_TRANSFER_READ;
    }
    if (access & (ACCESS_COPY_DEST | ACCESS_RESOLVE_DEST)) != 0 {
        out = out | VK_ACCESS_TRANSFER_WRITE;
    }
    if (access & ACCESS_RTAS_READ) != 0 {
        out = out | VK_ACCESS_ACCELERATION_STRUCTURE_READ;
    }
    if (access & ACCESS_RTAS_WRITE) != 0 {
        out = out | VK_ACCESS_ACCELERATION_STRUCTURE_WRITE;
    }
    if (access & ACCESS_SHADING_RATE_SOURCE) != 0 {
        out = out | VK_ACCESS_FRAGMENT_SHADING_RATE_ATTACHMENT_READ;
    }
    out
}

pub fn vk_access_bits(access: u32) -> u64 {
    vk_access_bits_lossy(access)
}

pub fn try_vk_access_bits(access: u32) -> AccessBits {
    if access == no_access() || access == 0 {
        return AccessBits::Mapped(vk_access_bits_lossy(access));
    }
    let rest = access & ~known_access();
    if rest != 0 {
        AccessBits::Unmapped(rest)
    } else {
        AccessBits::Mapped(vk_access_bits_lossy(access))
    }
}

// UAV output of operations outside shader stages (post-build info, UAV
// clears) is a transfer write (`vk_access_bits_for_sync`).
pub fn vk_access_bits_for_sync(access: u32, sync: u32) -> u64 {
    let base = vk_access_bits(access);
    if (access & ACCESS_UNORDERED_ACCESS) == 0 || access == 0 || access == no_access() {
        return base;
    }
    let sync_bits = sync & SYNC_SCOPES;
    if (sync_bits & (SYNC_EMIT_RTAS_POSTBUILD_INFO | SYNC_CLEAR_UAV)) == 0 {
        return base;
    }
    let shader_or_all: u32 = SYNC_ALL | SYNC_DRAW | SYNC_VERTEX_SHADING | SYNC_PIXEL_SHADING | SYNC_COMPUTE_SHADING | SYNC_RAYTRACING | SYNC_ALL_SHADING | SYNC_NON_PIXEL_SHADING;
    let mut adjusted = base;
    if (sync_bits & shader_or_all) == 0 {
        let remaining = access & ~ACCESS_UNORDERED_ACCESS;
        adjusted = if remaining == 0 {
            0
        } else {
            vk_access_bits_lossy(remaining)
        };
    }
    adjusted | VK_ACCESS_TRANSFER_WRITE
}

fn vk_stage_bits_for_access(sync: u32, access: u32) -> u64 {
    let mut out = vk_stage_bits(sync);
    if out != 0 {
        if (access & ACCESS_STREAM_OUTPUT) != 0 {
            out = out | VK_STAGE_TRANSFORM_FEEDBACK;
        }
        if (access & ACCESS_SHADING_RATE_SOURCE) != 0 {
            out = out | VK_STAGE_FRAGMENT_SHADING_RATE_ATTACHMENT;
        }
    }
    out
}

pub fn mtl4_stage_bits(sync: u32) -> u32 {
    let bits = sync & SYNC_SCOPES;
    if bits == 0 {
        return 0;
    }
    let vertex = MTL_STAGE_VERTEX;
    let fragment = MTL_STAGE_FRAGMENT;
    let tile = MTL_STAGE_TILE;
    let dispatch = MTL_STAGE_DISPATCH;
    let blit = MTL_STAGE_BLIT;
    let accel = MTL_STAGE_ACCELERATION_STRUCTURE;
    let mut out: u32 = 0;
    if (bits & SYNC_ALL) != 0 {
        out = out | vertex | fragment | tile | dispatch | blit | accel;
    }
    if (bits & SYNC_DRAW) != 0 {
        out = out | vertex | fragment | tile;
    }
    if (bits & (SYNC_INDEX_INPUT | SYNC_VERTEX_SHADING)) != 0 {
        out = out | vertex;
    }
    if (bits & (SYNC_PIXEL_SHADING | SYNC_DEPTH_STENCIL | SYNC_RENDER_TARGET)) != 0 {
        out = out | fragment;
    }
    if (bits & SYNC_RESOLVE) != 0 {
        out = out | fragment | blit;
    }
    if (bits & SYNC_EXECUTE_INDIRECT) != 0 {
        out = out | vertex | dispatch;
    }
    if (bits & (SYNC_COMPUTE_SHADING | SYNC_RAYTRACING)) != 0 {
        out = out | dispatch;
    }
    if (bits & SYNC_CLEAR_UAV) != 0 {
        out = out | dispatch | blit;
    }
    if (bits & SYNC_COPY) != 0 {
        out = out | blit;
    }
    if (bits & (SYNC_BUILD_RTAS | SYNC_COPY_RTAS | SYNC_EMIT_RTAS_POSTBUILD_INFO)) != 0 {
        out = out | accel;
    }
    if (bits & SYNC_ALL_SHADING) != 0 {
        out = out | vertex | fragment | tile | dispatch;
    }
    if (bits & SYNC_NON_PIXEL_SHADING) != 0 {
        out = out | vertex | dispatch;
    }
    out
}

// A lowered barrier. Handles, subresources and layouts of the Vulkan forms
// come from the planner barrier it lowers, which the wrapper still holds;
// `D3D12` is that barrier unchanged.
copy enum Native {
    Elided,
    D3D12,
    BufferBarrier2 {
        src_stage_mask: u64,
        dst_stage_mask: u64,
        src_access_mask: u64,
        dst_access_mask: u64
    },
    ImageBarrier2 {
        src_stage_mask: u64,
        dst_stage_mask: u64,
        src_access_mask: u64,
        dst_access_mask: u64
    },
    SplitEventSignal {
        event_id: u32,
        src_stage_mask: u64
    },
    SplitEventWait {
        event_id: u32,
        dst_stage_mask: u64,
        src_access_mask: u64,
        dst_access_mask: u64
    },
    Metal4StageBarrier {
        after_stages_mask: u32,
        before_stages_mask: u32
    }
}

fn masked_access(stage: u64, access: u32, sync: u32) -> u64 {
    if stage == 0 {
        0
    } else {
        vk_access_bits_for_sync(access, sync)
    }
}

// `lower_barrier_with_split_hint`.
pub fn lower_barrier(
    target: GpuApiTarget,
    queue_kind: QueueKind,
    b: BarrierRec,
    split_event_id: u32,
    has_producer: bool,
    producer_sync: u32
) -> Native {
    match target {
        GpuApiTarget::D3D12Agility1620 => Native::D3D12,
        GpuApiTarget::Vulkan14 => {
            let collapse = queue_kind == QueueKind::Copy;
            if (b.sync_after & split_bit()) == split_bit() {
                if collapse {
                    Native::Elided
                } else {
                    Native::SplitEventSignal {
                        event_id: split_event_id,
                        src_stage_mask: vk_stage_bits_for_access(b.sync_before, b.access_before)
                    }
                }
            } else if (b.sync_before & split_bit()) == split_bit() && !collapse {
                let before = if has_producer {
                    producer_sync
                } else {
                    SYNC_ALL
                };
                let dst = vk_stage_bits_for_access(b.sync_after, b.access_after);
                Native::SplitEventWait {
                    event_id: split_event_id,
                    dst_stage_mask: dst,
                    src_access_mask: vk_access_bits_for_sync(b.access_before, before),
                    dst_access_mask: masked_access(dst, b.access_after, b.sync_after)
                }
            } else {
                let before = if (b.sync_before & split_bit()) == split_bit() {
                    if has_producer {
                        producer_sync
                    } else {
                        SYNC_ALL
                    }
                } else {
                    b.sync_before
                };
                let src = vk_stage_bits_for_access(before, b.access_before);
                let dst = vk_stage_bits_for_access(b.sync_after, b.access_after);
                if b.texture {
                    Native::ImageBarrier2 {
                        src_stage_mask: src,
                        dst_stage_mask: dst,
                        src_access_mask: masked_access(src, b.access_before, before),
                        dst_access_mask: masked_access(dst, b.access_after, b.sync_after)
                    }
                } else {
                    Native::BufferBarrier2 {
                        src_stage_mask: src,
                        dst_stage_mask: dst,
                        src_access_mask: masked_access(src, b.access_before, before),
                        dst_access_mask: masked_access(dst, b.access_after, b.sync_after)
                    }
                }
            }
        },
        GpuApiTarget::Metal4 => {
            if (b.sync_after & split_bit()) == split_bit() {
                return Native::Elided;
            }
            let before = if (b.sync_before & split_bit()) == split_bit() {
                if has_producer {
                    producer_sync
                } else {
                    SYNC_COMPUTE_SHADING
                }
            } else {
                b.sync_before
            };
            if before == 0 && (b.access_before == no_access() || b.access_before == 0) {
                return Native::Elided;
            }
            let after_stages = mtl4_stage_bits(before);
            let before_stages = mtl4_stage_bits(b.sync_after);
            if after_stages == 0 || before_stages == 0 {
                Native::Elided
            } else {
                Native::Metal4StageBarrier {
                    after_stages_mask: after_stages,
                    before_stages_mask: before_stages
                }
            }
        },
    }
}

// A planner barrier and the graph its handle belongs to.
copy struct KeyedBarrier {
    graph: u32,
    barrier: BarrierRec
}

// A lowered command: `source` is the input command it lowers (waits,
// executes and signals are unchanged); a `Barriers` command (tag 1) holds
// `count` natives from `start`.
copy struct LoweredRec {
    stream: u32,
    tag: u32,
    source: u64,
    start: u64,
    count: u64
}

copy struct NativeRec {
    source: u64,
    native: Native
}

struct LoweredOut {
    cmds: ChunkSeq[LoweredRec],
    natives: ChunkSeq[NativeRec]
}

copy struct ActiveSplit {
    graph: u32,
    texture: bool,
    resource: u32,
    range: SubresourceRange,
    event_id: u32,
    producer_sync: u32
}

fn same_split(a: ActiveSplit, kb: KeyedBarrier) -> bool {
    let b = kb.barrier;
    a.graph == kb.graph
        && a.texture == b.texture
        && a.resource == b.resource
        && (!b.texture || a.range == b.subresources)
}

fn next_id(id: u32) -> u32 {
    if id == none32() {
        id
    } else {
        wrapping_add(id, 1)
    }
}

// Lowers every queue stream of a plan (`lower_plan`). `cmds` are the plan's
// commands (`queue` is the stream index), `barriers` its barriers.
pub fn lower_plan(
    target: GpuApiTarget,
    in kinds: Slice[QueueKind],
    in cmds: Slice[CmdRec],
    in barriers: Slice[KeyedBarrier]
) -> LoweredOut {
    let mut out = LoweredOut {
        cmds: ChunkSeq::new[LoweredRec](),
        natives: ChunkSeq::new[NativeRec]()
    };
    let mut next_event: u32 = 1;
    for stream in 0..kinds.len() {
        let kind = match kinds.try_get(stream) {
            Option::Some(k) => k,
            Option::None => QueueKind::Direct,
        };
        let s32 = wrapping_u32(stream);
        let mut active: ChunkSeq[ActiveSplit] = ChunkSeq::new[ActiveSplit]();
        let event_ids = target == GpuApiTarget::Vulkan14 && kind != QueueKind::Copy;
        for c in 0..cmds.len() {
            match cmds.try_get(c) {
                Option::Some(cmd) => {
                    if cmd.queue == s32 {
                        if cmd.tag != 1 {
                            out
                                .cmds
                                .push(
                                    LoweredRec {
                                        stream: s32,
                                        tag: cmd.tag,
                                        source: c,
                                        start: 0,
                                        count: 0
                                    }
                                );
                        } else {
                            let start = out.natives.len();
                            for bi in cmd.a..wrapping_add(cmd.a, cmd.b) {
                                match barriers.try_get(bi) {
                                    Option::Some(kb) => {
                                        let b = kb.barrier;
                                        let mut event_id: u32 = 0;
                                        let mut has_producer = false;
                                        let mut producer_sync: u32 = 0;
                                        if (b.sync_after & split_bit()) == split_bit() {
                                            if event_ids {
                                                event_id = next_event;
                                                next_event = next_id(next_event);
                                            }
                                            let mut replaced = false;
                                            for a in 0..active.len() {
                                                match active.try_get(a) {
                                                    Option::Some(x) => {
                                                        if !replaced && same_split(x, kb) {
                                                            let mut y = x;
                                                            y.event_id = event_id;
                                                            y.producer_sync = b.sync_before;
                                                            active.try_set(a, y);
                                                            replaced = true;
                                                        }
                                                    },
                                                    Option::None => (),
                                                }
                                            }
                                            if !replaced {
                                                active
                                                    .push(
                                                        ActiveSplit {
                                                            graph: kb.graph,
                                                            texture: b.texture,
                                                            resource: b.resource,
                                                            range: b.subresources,
                                                            event_id: event_id,
                                                            producer_sync: b.sync_before
                                                        }
                                                    );
                                            }
                                        } else if (b.sync_before & split_bit()) == split_bit() {
                                            let mut found = active.len();
                                            for a in 0..active.len() {
                                                match active.try_get(a) {
                                                    Option::Some(x) => {
                                                        if found == active.len()
                                                            && same_split(x, kb) {
                                                            found = a;
                                                        }
                                                    },
                                                    Option::None => (),
                                                }
                                            }
                                            if found < active.len() {
                                                match active.try_get(found) {
                                                    Option::Some(x) => {
                                                        event_id = x.event_id;
                                                        has_producer = true;
                                                        producer_sync = x.producer_sync;
                                                    },
                                                    Option::None => (),
                                                }
                                                remove_split(inout active, found);
                                            } else if event_ids {
                                                event_id = next_event;
                                                next_event = next_id(next_event);
                                            }
                                        }
                                        match lower_barrier(
                                            target,
                                            kind,
                                            b,
                                            event_id,
                                            has_producer,
                                            producer_sync
                                        ) {
                                            Native::Elided => (),
                                            native => out
                                                .natives
                                                .push(
                                                    NativeRec {
                                                        source: bi,
                                                        native: native
                                                    }
                                                ),
                                        }
                                    },
                                    Option::None => (),
                                }
                            }
                            let count = wrapping_sub(out.natives.len(), start);
                            if count > 0 {
                                out
                                    .cmds
                                    .push(
                                        LoweredRec {
                                            stream: s32,
                                            tag: 1,
                                            source: c,
                                            start: start,
                                            count: count
                                        }
                                    );
                            }
                        }
                    }
                },
                Option::None => (),
            }
        }
    }
    out
}

fn remove_split(inout s: ChunkSeq[ActiveSplit], at: u64) {
    let n = s.len();
    for i in at..n {
        match s.try_get(wrapping_add(i, 1)) {
            Option::Some(x) => {
                s.try_set(i, x);
            },
            Option::None => (),
        }
    }
    if n > 0 {
        s.truncate(wrapping_sub(n, 1));
    }
}
