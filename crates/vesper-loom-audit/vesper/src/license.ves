// Module license of @vesper/loom-audit (see lib.ves): the documented SPDX
// subset, the tokenizer and the WITH > AND > OR parser of license.rs, and
// the policy allowlist. Every branch is parsed before the value counts, so
// the value is computed while parsing: a failure anywhere discards it.
use self::{
    A,
    Val
};
use self::util::{
    ErrorKind,
    ascii_alnum,
    byte,
    copy_range,
    fail,
    lit,
    str_len,
    str_off,
    word
};
use @vesper/loom-calculus::util::{
    Ascii,
    is_lit,
    none,
    sbool
};

// The supported SPDX license IDs, in license.rs order.
enum License: _ {
    Mit,
    Apache20,
    Bsd2Clause,
    Bsd3Clause,
    Isc,
    Mpl20,
    Gpl20Only,
    Gpl20OrLater,
    Gpl30Only,
    Gpl30OrLater,
    Lgpl21Only,
    Lgpl21OrLater,
    Lgpl30Only,
    Lgpl30OrLater,
    Agpl30Only,
    Agpl30OrLater,
    Unlicense,
    Zlib,
    Bsl10,
    Cc010
}

// The supported SPDX exceptions, in license.rs order.
enum Exception: _ {
    Llvm,
    Classpath20,
    Gcc31
}

// A license failure: none yet, an unknown or unsupported expression, or an
// exhausted budget.
pub enum LicenseFail: _ {
    None,
    Unknown,
    Limit
}

// A grant code is license * GRANTS_PER_LICENSE, plus exception + 1 with an
// exception; GRANT_COUNT covers the 20 licenses.
const GRANTS_PER_LICENSE: u64 = 4;
const GRANT_COUNT: u64 = 80;

// The supported SPDX license IDs (license.rs order): the index of the
// token at pool range (off, len), or none().
fn license_index(in s: A, off: u64, len: u64) -> u64 {
    if is_lit(in s.l, off, len, "MIT") {
        return License::Mit;
    }
    if is_lit(in s.l, off, len, "Apache-2.0") {
        return License::Apache20;
    }
    if is_lit(in s.l, off, len, "BSD-2-Clause") {
        return License::Bsd2Clause;
    }
    if is_lit(in s.l, off, len, "BSD-3-Clause") {
        return License::Bsd3Clause;
    }
    if is_lit(in s.l, off, len, "ISC") {
        return License::Isc;
    }
    if is_lit(in s.l, off, len, "MPL-2.0") {
        return License::Mpl20;
    }
    if is_lit(in s.l, off, len, "GPL-2.0-only") {
        return License::Gpl20Only;
    }
    if is_lit(in s.l, off, len, "GPL-2.0-or-later") {
        return License::Gpl20OrLater;
    }
    if is_lit(in s.l, off, len, "GPL-3.0-only") {
        return License::Gpl30Only;
    }
    if is_lit(in s.l, off, len, "GPL-3.0-or-later") {
        return License::Gpl30OrLater;
    }
    if is_lit(in s.l, off, len, "LGPL-2.1-only") {
        return License::Lgpl21Only;
    }
    if is_lit(in s.l, off, len, "LGPL-2.1-or-later") {
        return License::Lgpl21OrLater;
    }
    if is_lit(in s.l, off, len, "LGPL-3.0-only") {
        return License::Lgpl30Only;
    }
    if is_lit(in s.l, off, len, "LGPL-3.0-or-later") {
        return License::Lgpl30OrLater;
    }
    if is_lit(in s.l, off, len, "AGPL-3.0-only") {
        return License::Agpl30Only;
    }
    if is_lit(in s.l, off, len, "AGPL-3.0-or-later") {
        return License::Agpl30OrLater;
    }
    if is_lit(in s.l, off, len, "Unlicense") {
        return License::Unlicense;
    }
    if is_lit(in s.l, off, len, "Zlib") {
        return License::Zlib;
    }
    if is_lit(in s.l, off, len, "BSL-1.0") {
        return License::Bsl10;
    }
    if is_lit(in s.l, off, len, "CC0-1.0") {
        return License::Cc010;
    }
    none()
}

// The supported exceptions, likewise.
fn exception_index(in s: A, off: u64, len: u64) -> u64 {
    if is_lit(in s.l, off, len, "LLVM-exception") {
        return Exception::Llvm;
    }
    if is_lit(in s.l, off, len, "Classpath-exception-2.0") {
        return Exception::Classpath20;
    }
    if is_lit(in s.l, off, len, "GCC-exception-3.1") {
        return Exception::Gcc31;
    }
    none()
}

// Grant codes: license * GRANTS_PER_LICENSE, plus exception + 1 for `WITH`.
pub fn grant_count() -> u64 {
    GRANT_COUNT
}

fn tok_off(in s: A, i: u64) -> u64 {
    word(in s.toff, i)
}

fn tok_len(in s: A, i: u64) -> u64 {
    word(in s.tlen, i)
}

// A license failure (`LicenseFail`). `tok` appends that token's text.
fn lfail(inout s: A, kind: u64, in t: Str, tok: u64) {
    let mo = s.dp.len();
    lit(inout s, t);
    if tok != none() {
        let off = tok_off(in s, tok);
        let len = tok_len(in s, tok);
        copy_range(inout s, off, len);
    }
    s.lf = kind;
    s.lmo = mo;
    s.lml = wrapping_sub(s.dp.len(), mo);
}

fn push_tok(inout s: A, off: u64, len: u64) {
    s.toff.push(off);
    s.tlen.push(len);
}

fn ws(b: u8) -> bool {
    b == Ascii::Space || b == Ascii::Tab || b == Ascii::Lf || b == Ascii::FormFeed || b == Ascii::Cr
}

// Split the pool range into tokens; false on a failure.
fn tokenize(inout s: A, off: u64, len: u64) -> bool {
    s.toff.clear();
    s.tlen.clear();
    if len > s.m_string {
        lfail(inout s, LicenseFail::Limit, "license byte budget exhausted", none());
        return false;
    }
    let mut start = none();
    for i in 0..len {
        let b = byte(in s, wrapping_add(off, i));
        if ws(b) || b == Ascii::LParen || b == Ascii::RParen {
            if start != none() {
                push_tok(inout s, wrapping_add(off, start), wrapping_sub(i, start));
                start = none();
            }
            if b == Ascii::LParen || b == Ascii::RParen {
                push_tok(inout s, wrapping_add(off, i), 1);
            }
        } else if ascii_alnum(b) || b == Ascii::Minus || b == Ascii::Dot {
            if start == none() {
                start = i;
            }
        } else {
            lfail(inout s, LicenseFail::Unknown, "unsupported/freeform license syntax", none());
            return false;
        }
        if s.toff.len() > s.m_ltokens {
            lfail(inout s, LicenseFail::Limit, "license token budget exhausted", none());
            return false;
        }
    }
    if start != none() {
        push_tok(inout s, wrapping_add(off, start), wrapping_sub(len, start));
    }
    if s.toff.len() > s.m_ltokens {
        lfail(inout s, LicenseFail::Limit, "license token budget exhausted", none());
        return false;
    }
    true
}

fn take(inout s: A, in t: Str) -> bool {
    let p = s.tpos;
    if p >= s.toff.len() {
        return false;
    }
    if is_lit(in s.l, tok_off(in s, p), tok_len(in s, p), t) {
        s.tpos = wrapping_add(p, 1);
        return true;
    }
    false
}

fn bad() -> Val {
    Val {
        ok: false,
        single: false,
        grant: 0
    }
}

fn expression(inout s: A, depth: u64) -> Val {
    let mut left = conjunction(inout s, depth);
    if s.lf != LicenseFail::None {
        return bad();
    }
    loop {
        if !take(inout s, "OR") {
            break;
        }
        let right = conjunction(inout s, depth);
        if s.lf != LicenseFail::None {
            return bad();
        }
        left = Val {
            ok: left.ok || right.ok,
            single: false,
            grant: 0
        };
    }
    left
}

fn conjunction(inout s: A, depth: u64) -> Val {
    let mut left = atom(inout s, depth);
    if s.lf != LicenseFail::None {
        return bad();
    }
    loop {
        if !take(inout s, "AND") {
            break;
        }
        let right = atom(inout s, depth);
        if s.lf != LicenseFail::None {
            return bad();
        }
        left = Val {
            ok: left.ok && right.ok,
            single: false,
            grant: 0
        };
    }
    left
}

fn atom(inout s: A, depth: u64) -> Val {
    if depth > s.m_ldepth {
        lfail(inout s, LicenseFail::Limit, "license nesting budget exhausted", none());
        return bad();
    }
    if take(inout s, "(") {
        let value = expression(inout s, wrapping_add(depth, 1));
        if s.lf != LicenseFail::None {
            return bad();
        }
        if !take(inout s, ")") {
            lfail(inout s, LicenseFail::Unknown, "missing closing license parenthesis", none());
            return bad();
        }
        return value;
    }
    let p = s.tpos;
    if p >= s.toff.len() {
        lfail(inout s, LicenseFail::Unknown, "expected SPDX license identifier", none());
        return bad();
    }
    let li = license_index(in s, tok_off(in s, p), tok_len(in s, p));
    if li == none() {
        lfail(inout s, LicenseFail::Unknown, "unknown/unsupported SPDX license identifier: ", p);
        return bad();
    }
    s.tpos = wrapping_add(p, 1);
    let mut grant = wrapping_mul(li, GRANTS_PER_LICENSE);
    if take(inout s, "WITH") {
        let q = s.tpos;
        if q >= s.toff.len() {
            lfail(inout s, LicenseFail::Unknown, "expected SPDX exception identifier", none());
            return bad();
        }
        let ei = exception_index(in s, tok_off(in s, q), tok_len(in s, q));
        if ei == none() {
            lfail(inout s, LicenseFail::Unknown, "unknown/unsupported SPDX exception: ", q);
            return bad();
        }
        s.tpos = wrapping_add(q, 1);
        grant = wrapping_add(grant, wrapping_add(ei, 1));
    }
    Val {
        ok: sbool(in s.grants, grant),
        single: true,
        grant: grant
    }
}

// `parse` of the expression with string id `id`; on failure s.lf is set.
pub fn parse(inout s: A, id: u64) -> Val {
    s.lf = LicenseFail::None;
    let off = str_off(in s, id);
    let len = str_len(in s, id);
    if !tokenize(inout s, off, len) {
        return bad();
    }
    s.tpos = 0;
    let v = expression(inout s, 0);
    if s.lf != LicenseFail::None {
        return bad();
    }
    if s.tpos != s.toff.len() {
        lfail(inout s, LicenseFail::Unknown, "unexpected trailing license token", none());
        return bad();
    }
    v
}

// `allowlist`: the policy's grants into s.grants.
pub fn allowlist(inout s: A) {
    s.grants.clear();
    let gc = grant_count();
    for i in 0..gc {
        s.grants.push(false);
    }
    for i in 0..s.allow.len() {
        let id = word(in s.allow, i);
        let v = parse(inout s, id);
        if s.lf != LicenseFail::None {
            // The failure text becomes the error message.
            s.err = if s.lf == LicenseFail::Limit {
                wrapping_add(ErrorKind::Limit, 1)
            } else {
                wrapping_add(ErrorKind::Policy, 1)
            };
            s.emo = s.lmo;
            s.eml = s.lml;
            return;
        }
        if !v.single {
            fail(
                inout s,
                ErrorKind::Policy,
                "allow entries must be single licenses or explicit license WITH exception grants"
            );
            return;
        }
        if sbool(in s.grants, v.grant) {
            fail(inout s, ErrorKind::Policy, "duplicate license grant");
            return;
        }
        s.grants.try_set(v.grant, true);
    }
}
