# The frozen Rust seed copy of vesper-loom-audit (package
# vesper-loom-audit-seed, library vesper_loom_audit) that the compiler
# links: ../src built without the port, so
# cfg(vesper_port) is off. Written by hand because its sources live in the
# parent package; see "Crates the compiler links" in
# docs/maintenance/porting-a-crate.md.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("@vesper_cargo//:packages.bzl", "PACKAGES")

_CRATE = PACKAGES["crates/vesper-loom-audit/seed"].crate_data()

_DEPS = all_crate_deps(_CRATE, normal = True, platforms = _CRATE["platforms"])

_TEST_DEPS = all_crate_deps(
    _CRATE,
    normal = True,
    normal_dev = True,
    platforms = _CRATE["platforms"],
)

rust_library(
    name = "seed",
    srcs = ["//crates/vesper-loom-audit:rust_srcs"],
    aliases = _CRATE.get("aliases", {}),
    compile_data = ["//crates/vesper-loom-audit:README.md"],
    crate_name = "vesper_loom_audit",
    crate_root = "//crates/vesper-loom-audit:src/lib.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_PKG_NAME": "vesper-loom-audit-seed",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = _DEPS,
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    edition = "2024",
)

[
    rust_test(
        name = "seed_test_" + t,
        srcs = ["//crates/vesper-loom-audit:tests/%s.rs" % t],
        crate_root = "//crates/vesper-loom-audit:tests/%s.rs" % t,
        edition = "2024",
        deps = [":seed"] + _TEST_DEPS,
    )
    for t in [
        "audit",
        "differential",
    ]
]

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
