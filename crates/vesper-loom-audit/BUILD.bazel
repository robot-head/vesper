load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The port-backed package (seed-copy rule, docs/maintenance/porting-a-crate.md):
# build.rs links the object built here from the Loom package in vesper/ and
# checks port/binding.rs against the generated binding. The compiler links
# the Rust seed copy, //crates/vesper-loom-audit/seed, instead (port wave P3a
# lane 4, #1039).
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
    deps = ["//crates/vesper-loom-calculus:port_package"],
)

vesper_port_object(
    name = "loom_audit_vesper",
    library = "loom_audit",
    package = ":port_package",
    target = VESPER_TARGET,
)

filegroup(
    name = "loom_audit_vesper_binding",
    srcs = [":loom_audit_vesper"],
    output_group = "rust_binding",
)

# The divergent builds, one per ported module (the Cargo
# `vesper-port-divergent` feature applies the same edits, DIVERGENT in
# build.rs): each must build from a copy of the package with its edit
# applied. The Cargo run in port/test-port.sh asserts which test catches
# each one.
[
    vesper_port_object(
        name = "loom_audit_vesper_divergent_" + module,
        edit_src = "vesper/src/%s.ves" % module,
        edits = {old: new},
        library = "loom_audit",
        package = ":port_package",
        target = VESPER_TARGET,
    )
    for module, old, new in [
        ("input", "s.m_pdepth = rd(inout s.l);", "s.m_pdepth = wrapping_add(rd(inout s.l), 1);"),
        ("license", "ok: left.ok && right.ok,", "ok: left.ok || right.ok,"),
        ("check", "if !p.has_fixed || prec_ord(in s.l, p.fixed, r.intro) == 2 {", "if !p.has_fixed {"),
        ("paths", "if shorter(in s, nat_at, n, p) {", "if !shorter(in s, nat_at, n, p) {"),
        ("report", "if affected && x.sev >= s.minsev {", "if affected {"),
        ("util", "    pre_ord(in l, x.pre, y.pre)\n}", "    1\n}"),
    ]
]

vesper_crate(
    build_script_data = [
        ":loom_audit_vesper",
        ":loom_audit_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :loom_audit_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :loom_audit_vesper_binding)",
    },
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
    "examples/**/*.rs",
]) + ["README.md"])

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-loom-audit/seed:__pkg__"],
)
