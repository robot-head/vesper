load("//tools/bazel:defs.bzl", "vesper_crate")

# The tests load the @vesper/cranelift package beside the fixtures.
vesper_crate(
    extra_test_data = ["//packages/vesper-cranelift:files"],
)

# crates/vesper-cranelift-component's object comparison runs these
# fixtures through the same support module.
exports_files(
    ["tests/support/mod.rs"],
    visibility = ["//crates/vesper-cranelift-component:__pkg__"],
)

# The root crate's CLIF pass differentials include the seam's function
# words and edit replay by path (#2606): the root cannot depend on the shim.
exports_files(
    ["src/clif_words.rs"],
    visibility = ["//:__pkg__"],
)

filegroup(
    name = "test_fixtures",
    srcs = glob(["tests/fixtures/**"]),
    visibility = [
        "//:__pkg__",
        "//crates/vesper-cranelift-component:__pkg__",
    ],
)
