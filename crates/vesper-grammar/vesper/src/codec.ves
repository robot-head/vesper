// Module codec of @vesper/grammar (see lib.ves): src/grammar/codec.rs.
//
// Codec limits (`cl`): max_values, max_metadata_bytes, max_output_bytes,
// max_depth, max_work, then the Rust byte sizes of `Value` and of the
// private plan `Write` (the Rust budgets count them). The grammar arrives
// as in module grammar.
//
// Values cross as a preorder word stream (src/port.rs): Unit 0; Number 1
// (n); Bytes 2 (start, length: of the input when decoding, of `arena` when
// encoding); Sequence 3 (count); Choice 4 (branch); Frame 5; Repeat 6
// (count). Children follow their parent.
use self::{
    GErr
};
use self::common::{
    add_or,
    bound,
    charge_or,
    fail,
    leb_len,
    min,
    mul_or,
    put_leb,
    sb,
    sw
};
use self::framing::{
    decode
};
use self::grammar::{
    charge_or_at,
    first_has,
    rec,
    same
};

// Rule record tags (module grammar).
const R_EMPTY: u64 = 0;
const R_BYTE: u64 = 1;
const R_LITERAL: u64 = 2;
const R_ULEB128: u64 = 3;
const R_BLOB: u64 = 4;
const R_FRAME: u64 = 5;
const R_U24_FRAME: u64 = 6;
const R_SEQUENCE: u64 = 7;
const R_CHOICE: u64 = 8;
const R_REPEAT: u64 = 9;
const R_COUNTED: u64 = 10;
// Value tags (see above).
const V_UNIT: u64 = 0;
const V_NUMBER: u64 = 1;
const V_BYTES: u64 = 2;
const V_SEQUENCE: u64 = 3;
const V_CHOICE: u64 = 4;
const V_FRAME: u64 = 5;
const V_REPEAT: u64 = 6;
// Plan write kinds (see the encoding section), three words per write.
const W_BYTE: u64 = 0;
const W_NUMBER: u64 = 1;
const W_U24: u64 = 2;
const W_ARENA: u64 = 3;
const W_LITS: u64 = 4;
const WRITE_WORDS: u64 = 3;
// src/grammar/codec.rs: the work one number costs, the encoder's passes
// over each output byte, and the u24 frame header and payload ceiling.
const NUMBER_WORK: u64 = 10;
const COPY_PASSES: u64 = 3;
const U24_HEADER_BYTES: u64 = 3;
const MAX_U24_PAYLOAD: u64 = 16777215;
// Ceiling on `max_depth` (src/grammar.rs `HARD_MAX_DEPTH`).
const HARD_MAX_DEPTH: u64 = 64;
// No choice branch selected yet.
const NO_RULE: u64 = 18446744073709551615;

// Budget plus the reader or planner position.
pub copy struct Cx {
    work: u64,
    metadata: u64,
    visits: u64,
    max_visits: u64,
    max_depth: u64,
    max_metadata: u64,
    max_output: u64,
    value_size: u64,
    write_size: u64,
    max_input: u64,
    max_frame: u64,
    max_reps: u64,
    pos: u64,
    end: u64,
    // Planner: output length, plan writes and their emulated capacity.
    len: u64,
    writes: u64,
    capacity: u64
}

pub fn validate_limits(in cl: Slice[u64]) -> Unit eff [Fail[GErr]] {
    let five: u64 = 5;
    for i in 0..five {
        let n = sw(in cl, i);
        let hard: u64 = if i == 0 {
            16384
        } else if i == 1 || i == 2 {
            4194304
        } else if i == 3 {
            64
        } else {
            67108864
        };
        if n == 0 || n > hard {
            fail(19, 0);
        }
    }
}

fn new_cx(in glim: Slice[u64], in cl: Slice[u64]) -> Cx eff [Fail[GErr]] {
    validate_limits(in cl);
    Cx {
        work: min(sw(in cl, 4), sw(in glim, 10)),
        metadata: 0,
        visits: 0,
        max_visits: min(sw(in cl, 0), sw(in glim, 7)),
        max_depth: min(min(sw(in cl, 3), sw(in glim, 4)), HARD_MAX_DEPTH),
        max_metadata: sw(in cl, 1),
        max_output: sw(in cl, 2),
        value_size: sw(in cl, 5),
        write_size: sw(in cl, 6),
        max_input: sw(in glim, 5),
        max_frame: sw(in glim, 6),
        max_reps: sw(in glim, 11),
        pos: 0,
        end: 0,
        len: 0,
        writes: 0,
        capacity: 0
    }
}

fn work(inout cx: Cx, n: u64) -> Unit eff [Fail[GErr]] {
    let mut w = cx.work;
    charge_or(inout w, n, 8);
    cx.work = w;
}

fn visit(inout cx: Cx, depth: u64) -> Unit eff [Fail[GErr]] {
    bound(depth, cx.max_depth, 9);
    cx.visits = add_or(cx.visits, 1, 2, 0);
    bound(cx.visits, cx.max_visits, 10);
    work(inout cx, 1);
}

fn children(inout cx: Cx, count: u64, depth: u64) -> Unit eff [Fail[GErr]] {
    if count != 0 {
        bound(add_or(depth, 1, 2, 0), cx.max_depth, 9);
    }
    let left = if cx.visits > cx.max_visits {
        0
    } else {
        wrapping_sub(cx.max_visits, cx.visits)
    };
    bound(count, left, 10);
    work(inout cx, count);
}

fn metadata(inout cx: Cx, bytes: u64) -> Unit eff [Fail[GErr]] {
    cx.metadata = add_or(cx.metadata, bytes, 2, 0);
    bound(cx.metadata, cx.max_metadata, 11);
    work(inout cx, bytes);
}

fn values(inout cx: Cx, count: u64, depth: u64) -> Unit eff [Fail[GErr]] {
    children(inout cx, count, depth);
    let bytes = mul_or(count, cx.value_size, 2, 0);
    metadata(inout cx, bytes);
}

fn boxed(inout cx: Cx, depth: u64) -> Unit eff [Fail[GErr]] {
    children(inout cx, 1, depth);
    let bytes = cx.value_size;
    metadata(inout cx, bytes);
}

// Decoding.

pub fn decode_exact(
    in rules: Slice[u64],
    in lits: Slice[u8],
    in meta: Slice[u64],
    root: u64,
    in glim: Slice[u64],
    in cl: Slice[u64],
    in input: Slice[u8]
) -> ChunkSeq[u64] eff [Fail[GErr]] {
    let mut cx = new_cx(in glim, in cl);
    bound(input.len(), cx.max_input, 5);
    cx.end = input.len();
    let mut out = ChunkSeq::new[u64]();
    node(in rules, in lits, in meta, in input, inout cx, inout out, root, 1);
    if cx.pos != input.len() {
        fail(3, cx.pos);
    }
    out
}

fn number(in input: Slice[u8], inout cx: Cx) -> u64 eff [Fail[GErr]] {
    let mut w = cx.work;
    let p = decode(in input, cx.pos, cx.end, inout w, cx.pos);
    cx.work = w;
    cx.pos = wrapping_add(cx.pos, p.b);
    p.a
}

fn literal(in input: Slice[u8], in lits: Slice[u8], inout cx: Cx, start: u64, len: u64)
    -> Unit eff [Fail[GErr]] {
    work(inout cx, len);
    let end = add_or(cx.pos, len, 2, 0);
    if end > cx.end {
        fail(0, cx.end);
    }
    if !same(in input[cx.pos..end], in lits[start..wrapping_add(start, len)]) {
        fail(24, cx.pos);
    }
    cx.pos = end;
}

fn byte_literal(in input: Slice[u8], inout cx: Cx, byte: u64) -> Unit eff [Fail[GErr]] {
    work(inout cx, 1);
    let end = add_or(cx.pos, 1, 2, 0);
    if end > cx.end {
        fail(0, cx.end);
    }
    if sb(in input, cx.pos) != byte {
        fail(24, cx.pos);
    }
    cx.pos = end;
}

fn u24(in input: Slice[u8], inout cx: Cx) -> u64 eff [Fail[GErr]] {
    let mut value: u64 = 0;
    let mut w = cx.work;
    for i in 0..U24_HEADER_BYTES {
        charge_or_at(inout w, 1, cx.pos);
        let at = wrapping_add(cx.pos, i);
        if at >= cx.end {
            fail(0, at);
        }
        value = (value << 8) | sb(in input, at);
    }
    cx.work = w;
    cx.pos = wrapping_add(cx.pos, U24_HEADER_BYTES);
    value
}

fn node(
    in rules: Slice[u64],
    in lits: Slice[u8],
    in meta: Slice[u64],
    in input: Slice[u8],
    inout cx: Cx,
    inout out: ChunkSeq[u64],
    id: u64,
    depth: u64
) -> Unit eff [Fail[GErr]] {
    visit(inout cx, depth);
    let off = rec(in rules, id);
    let tag = sw(in rules, off);
    let next = wrapping_add(depth, 1);
    if tag == R_EMPTY {
        out.push(V_UNIT);
    } else if tag == R_BYTE {
        byte_literal(in input, inout cx, sw(in rules, wrapping_add(off, 1)));
        out.push(V_UNIT);
    } else if tag == R_LITERAL {
        literal(
            in input,
            in lits,
            inout cx,
            sw(in rules, wrapping_add(off, 1)),
            sw(in rules, wrapping_add(off, 2))
        );
        out.push(V_UNIT);
    } else if tag == R_ULEB128 {
        let v = number(in input, inout cx);
        out.push(V_NUMBER);
        out.push(v);
    } else if tag == R_BLOB || tag == R_FRAME || tag == R_U24_FRAME {
        let len = if tag == R_U24_FRAME {
            u24(in input, inout cx)
        } else {
            number(in input, inout cx)
        };
        bound(len, cx.max_frame, 7);
        let start = cx.pos;
        let end = add_or(start, len, 2, 0);
        if end > cx.end {
            fail(0, cx.end);
        }
        if tag == R_BLOB {
            work(inout cx, len);
            cx.pos = end;
            out.push(V_BYTES);
            out.push(start);
            out.push(len);
        } else {
            boxed(inout cx, depth);
            out.push(V_FRAME);
            let previous = cx.end;
            cx.end = end;
            node(
                in rules,
                in lits,
                in meta,
                in input,
                inout cx,
                inout out,
                sw(in rules, wrapping_add(off, 1)),
                next
            );
            if cx.pos != end {
                fail(3, cx.pos);
            }
            cx.end = previous;
        }
    } else if tag == R_SEQUENCE {
        let count = sw(in rules, wrapping_add(off, 1));
        values(inout cx, count, depth);
        out.push(V_SEQUENCE);
        out.push(count);
        for i in 0..count {
            node(
                in rules,
                in lits,
                in meta,
                in input,
                inout cx,
                inout out,
                sw(in rules, wrapping_add(wrapping_add(off, 2), i)),
                next
            );
        }
    } else if tag == R_REPEAT || tag == R_COUNTED {
        let count = if tag == R_REPEAT {
            sw(in rules, wrapping_add(off, 2))
        } else {
            number(in input, inout cx)
        };
        bound(count, cx.max_reps, 10);
        values(inout cx, count, depth);
        out.push(V_REPEAT);
        out.push(count);
        let child = sw(in rules, wrapping_add(off, 1));
        for i in 0..count {
            node(in rules, in lits, in meta, in input, inout cx, inout out, child, next);
        }
    } else {
        if cx.pos >= cx.end || cx.pos >= input.len() {
            fail(0, cx.pos);
        }
        let byte = sb(in input, cx.pos);
        let count = sw(in rules, wrapping_add(off, 1));
        let mut chosen: u64 = NO_RULE;
        let mut branch: u64 = 0;
        for i in 0..count {
            if chosen == NO_RULE {
                work(inout cx, 1);
                let at = wrapping_add(wrapping_add(off, 2), wrapping_mul(i, 2));
                let child = sw(in rules, wrapping_add(at, 1));
                if first_has(in meta, child, byte) {
                    chosen = child;
                    branch = sw(in rules, at);
                }
            }
        }
        if chosen == NO_RULE {
            fail(24, cx.pos);
        }
        boxed(inout cx, depth);
        out.push(V_CHOICE);
        out.push(branch);
        node(in rules, in lits, in meta, in input, inout cx, inout out, chosen, next);
    }
}

// Encoding. Plan writes are three words: Byte (0, byte), Number (1, n,
// length), U24 (2, n) and Bytes (3, start, length; of `arena` when `lit`
// is 0, of `lits` when it is 1, in word 0's high half: kind 3 or 4).

fn push_write(inout cx: Cx, inout writes: ChunkSeq[u64], kind: u64, a: u64, b: u64)
    -> u64 eff [Fail[GErr]] {
    if cx.writes == cx.capacity {
        let base = if cx.capacity < 2 {
            2
        } else {
            cx.capacity
        };
        let capacity = mul_or(base, 2, 2, 0);
        let reserved = mul_or(capacity, cx.write_size, 2, 0);
        metadata(inout cx, reserved);
        let moved = mul_or(cx.writes, cx.write_size, 2, 0);
        work(inout cx, moved);
        cx.capacity = capacity;
    }
    let index = cx.writes;
    cx.writes = wrapping_add(index, 1);
    writes.push(kind);
    writes.push(a);
    writes.push(b);
    index
}

fn length(inout cx: Cx, bytes: u64) -> Unit eff [Fail[GErr]] {
    cx.len = add_or(cx.len, bytes, 2, 0);
    bound(cx.len, cx.max_output, 6);
    bound(cx.len, cx.max_input, 5);
}

fn plan_number(inout cx: Cx, inout writes: ChunkSeq[u64], n: u64) -> Unit eff [Fail[GErr]] {
    work(inout cx, NUMBER_WORK);
    let len = leb_len(n);
    length(inout cx, len);
    push_write(inout cx, inout writes, W_NUMBER, n, len);
}

fn plan_bytes(inout cx: Cx, inout writes: ChunkSeq[u64], kind: u64, start: u64, len: u64)
    -> Unit eff [Fail[GErr]] {
    length(inout cx, len);
    if len != 0 {
        push_write(inout cx, inout writes, kind, start, len);
    }
}

fn plan_repeat(
    in rules: Slice[u64],
    in vals: Slice[u64],
    inout cx: Cx,
    inout writes: ChunkSeq[u64],
    inout cur: u64,
    child: u64,
    count: u64,
    depth: u64
) -> Unit eff [Fail[GErr]] {
    bound(count, cx.max_reps, 10);
    children(inout cx, count, depth);
    let next = wrapping_add(depth, 1);
    for i in 0..count {
        plan_node(in rules, in vals, inout cx, inout writes, inout cur, child, next);
    }
}

fn take(in vals: Slice[u64], inout cur: u64) -> u64 {
    let v = sw(in vals, cur);
    cur = wrapping_add(cur, 1);
    v
}

fn plan_node(
    in rules: Slice[u64],
    in vals: Slice[u64],
    inout cx: Cx,
    inout writes: ChunkSeq[u64],
    inout cur: u64,
    id: u64,
    depth: u64
) -> Unit eff [Fail[GErr]] {
    visit(inout cx, depth);
    let off = rec(in rules, id);
    let tag = sw(in rules, off);
    let value = take(in vals, inout cur);
    let next = wrapping_add(depth, 1);
    if tag == R_EMPTY && value == V_UNIT {
        return;
    } else if tag == R_BYTE && value == V_UNIT {
        length(inout cx, 1);
        push_write(inout cx, inout writes, W_BYTE, sw(in rules, wrapping_add(off, 1)), 0);
    } else if tag == R_LITERAL && value == V_UNIT {
        plan_bytes(
            inout cx,
            inout writes,
            W_LITS,
            sw(in rules, wrapping_add(off, 1)),
            sw(in rules, wrapping_add(off, 2))
        );
    } else if tag == R_ULEB128 && value == V_NUMBER {
        let n = take(in vals, inout cur);
        plan_number(inout cx, inout writes, n);
    } else if tag == R_BLOB && value == V_BYTES {
        let start = take(in vals, inout cur);
        let len = take(in vals, inout cur);
        bound(len, cx.max_frame, 7);
        plan_number(inout cx, inout writes, len);
        plan_bytes(inout cx, inout writes, W_ARENA, start, len);
    } else if tag == R_FRAME && value == V_FRAME {
        children(inout cx, 1, depth);
        let prefix = push_write(inout cx, inout writes, W_NUMBER, 0, 0);
        let start = cx.len;
        plan_node(
            in rules,
            in vals,
            inout cx,
            inout writes,
            inout cur,
            sw(in rules, wrapping_add(off, 1)),
            next
        );
        let payload = wrapping_sub(cx.len, start);
        bound(payload, cx.max_frame, 7);
        work(inout cx, NUMBER_WORK);
        let len = leb_len(payload);
        length(inout cx, len);
        let at = wrapping_mul(prefix, WRITE_WORDS);
        writes.try_set(wrapping_add(at, 1), payload);
        writes.try_set(wrapping_add(at, 2), len);
    } else if tag == R_U24_FRAME && value == V_FRAME {
        children(inout cx, 1, depth);
        let prefix = push_write(inout cx, inout writes, W_U24, 0, 0);
        length(inout cx, U24_HEADER_BYTES);
        let start = cx.len;
        plan_node(
            in rules,
            in vals,
            inout cx,
            inout writes,
            inout cur,
            sw(in rules, wrapping_add(off, 1)),
            next
        );
        let payload = wrapping_sub(cx.len, start);
        bound(payload, cx.max_frame, 7);
        if payload > MAX_U24_PAYLOAD {
            fail(2, 0);
        }
        work(inout cx, U24_HEADER_BYTES);
        writes.try_set(wrapping_add(wrapping_mul(prefix, WRITE_WORDS), 1), payload);
    } else if tag == R_SEQUENCE && value == V_SEQUENCE {
        let count = take(in vals, inout cur);
        if count != sw(in rules, wrapping_add(off, 1)) {
            fail(24, 0);
        }
        children(inout cx, count, depth);
        for i in 0..count {
            plan_node(
                in rules,
                in vals,
                inout cx,
                inout writes,
                inout cur,
                sw(in rules, wrapping_add(wrapping_add(off, 2), i)),
                next
            );
        }
    } else if tag == R_CHOICE && value == V_CHOICE {
        let branch = take(in vals, inout cur);
        let count = sw(in rules, wrapping_add(off, 1));
        let mut chosen: u64 = NO_RULE;
        for i in 0..count {
            if chosen == NO_RULE {
                work(inout cx, 1);
                let at = wrapping_add(wrapping_add(off, 2), wrapping_mul(i, 2));
                if sw(in rules, at) == branch {
                    chosen = sw(in rules, wrapping_add(at, 1));
                }
            }
        }
        if chosen == NO_RULE {
            fail(24, 0);
        }
        children(inout cx, 1, depth);
        plan_node(in rules, in vals, inout cx, inout writes, inout cur, chosen, next);
    } else if tag == R_REPEAT && value == V_REPEAT {
        let count = take(in vals, inout cur);
        if count != sw(in rules, wrapping_add(off, 2)) {
            fail(24, 0);
        }
        plan_repeat(
            in rules,
            in vals,
            inout cx,
            inout writes,
            inout cur,
            sw(in rules, wrapping_add(off, 1)),
            count,
            depth
        );
    } else if tag == R_COUNTED && value == V_REPEAT {
        let count = take(in vals, inout cur);
        bound(count, cx.max_reps, 10);
        plan_number(inout cx, inout writes, count);
        plan_repeat(
            in rules,
            in vals,
            inout cx,
            inout writes,
            inout cur,
            sw(in rules, wrapping_add(off, 1)),
            count,
            depth
        );
    } else {
        fail(24, 0);
    }
}

fn plan(
    in rules: Slice[u64],
    root: u64,
    in glim: Slice[u64],
    in cl: Slice[u64],
    in vals: Slice[u64],
    inout writes: ChunkSeq[u64]
) -> Cx eff [Fail[GErr]] {
    let mut cx = new_cx(in glim, in cl);
    let mut cur: u64 = 0;
    plan_node(in rules, in vals, inout cx, inout writes, inout cur, root, 1);
    cx
}

pub fn encoded_len(
    in rules: Slice[u64],
    root: u64,
    in glim: Slice[u64],
    in cl: Slice[u64],
    in vals: Slice[u64]
) -> u64 eff [Fail[GErr]] {
    let mut writes = ChunkSeq::new[u64]();
    let cx = plan(in rules, root, in glim, in cl, in vals, inout writes);
    cx.len
}

pub fn encode_into(
    in rules: Slice[u64],
    in lits: Slice[u8],
    root: u64,
    in glim: Slice[u64],
    in cl: Slice[u64],
    in vals: Slice[u64],
    in arena: Slice[u8],
    inout output: Slice[u8]
) -> u64 eff [Fail[GErr]] {
    let mut writes = ChunkSeq::new[u64]();
    let mut cx = plan(in rules, root, in glim, in cl, in vals, inout writes);
    if output.len() < cx.len {
        fail(4, 0);
    }
    let len = cx.len;
    metadata(inout cx, len);
    let copies = add_or(mul_or(len, COPY_PASSES, 2, 0), cx.writes, 2, 0);
    work(inout cx, copies);
    let mut at: u64 = 0;
    for i in 0..cx.writes {
        let base = wrapping_mul(i, WRITE_WORDS);
        let kind = match writes.try_get(base) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        let a = match writes.try_get(wrapping_add(base, 1)) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        let b = match writes.try_get(wrapping_add(base, 2)) {
            Option::Some(v) => v,
            Option::None => 0,
        };
        if kind == W_BYTE {
            output.try_set(at, wrapping_u8(a));
            at = wrapping_add(at, 1);
        } else if kind == W_NUMBER {
            put_leb(inout output, at, a, b);
            at = wrapping_add(at, b);
        } else if kind == W_U24 {
            output.try_set(at, wrapping_u8(a >> 16));
            output.try_set(wrapping_add(at, 1), wrapping_u8(a >> 8));
            output.try_set(wrapping_add(at, 2), wrapping_u8(a));
            at = wrapping_add(at, U24_HEADER_BYTES);
        } else if kind == W_ARENA {
            output.try_copy_from(at, in arena[a..wrapping_add(a, b)]);
            at = wrapping_add(at, b);
        } else {
            output.try_copy_from(at, in lits[a..wrapping_add(a, b)]);
            at = wrapping_add(at, b);
        }
    }
    cx.len
}
