// Module utf8 of @vesper/grammar (see lib.ves): the UTF-8 check of Rust's
// `core::str::from_utf8`, with the same `valid_up_to`.
use self::common::{
    sb
};

// Well-formed UTF-8 byte sequences (Unicode Standard Table 3-7): ASCII,
// continuation bytes, the lead byte ranges of two-, three- and four-byte
// sequences, and the narrower second bytes after E0 (no overlongs), ED (no
// surrogates), F0 (no overlongs) and F4 (nothing past U+10FFFF).
const ASCII_END: u64 = 128;
const CONT_MIN: u64 = 128;
const CONT_MAX: u64 = 191;
const LEAD2_MIN: u64 = 194;
const LEAD2_MAX: u64 = 223;
const LEAD3_MIN: u64 = 224;
const LEAD3_MAX: u64 = 239;
const SURROGATE_LEAD: u64 = 237;
const E0_SECOND_MIN: u64 = 160;
const ED_SECOND_MAX: u64 = 159;
const LEAD4_MIN: u64 = 240;
const LEAD4_MAX: u64 = 244;
const F0_SECOND_MIN: u64 = 144;
const F4_SECOND_MAX: u64 = 143;

fn cont(in s: Slice[u8], at: u64, end: u64, lo: u64, hi: u64) -> bool {
    if at >= end {
        return false;
    }
    let b = sb(in s, at);
    b >= lo && b <= hi
}

// The offset of the first byte of `s[start..end]` that does not start a
// complete valid UTF-8 sequence (RFC 3629: no overlongs, surrogates or
// values past U+10FFFF), or `end` when the whole range is valid.
pub fn valid_up_to(in s: Slice[u8], start: u64, end: u64) -> u64 {
    let mut i = start;
    loop {
        if i >= end {
            return end;
        }
        let b = sb(in s, i);
        let i1 = wrapping_add(i, 1);
        let i2 = wrapping_add(i, 2);
        let i3 = wrapping_add(i, 3);
        if b < ASCII_END {
            i = i1;
        } else if b >= LEAD2_MIN && b <= LEAD2_MAX {
            if !cont(in s, i1, end, CONT_MIN, CONT_MAX) {
                return i;
            }
            i = i2;
        } else if b >= LEAD3_MIN && b <= LEAD3_MAX {
            let lo: u64 = if b == LEAD3_MIN {
                E0_SECOND_MIN
            } else {
                CONT_MIN
            };
            let hi: u64 = if b == SURROGATE_LEAD {
                ED_SECOND_MAX
            } else {
                CONT_MAX
            };
            if !cont(in s, i1, end, lo, hi) || !cont(in s, i2, end, CONT_MIN, CONT_MAX) {
                return i;
            }
            i = i3;
        } else if b >= LEAD4_MIN && b <= LEAD4_MAX {
            let lo: u64 = if b == LEAD4_MIN {
                F0_SECOND_MIN
            } else {
                CONT_MIN
            };
            let hi: u64 = if b == LEAD4_MAX {
                F4_SECOND_MAX
            } else {
                CONT_MAX
            };
            if !cont(in s, i1, end, lo, hi)
                || !cont(in s, i2, end, CONT_MIN, CONT_MAX)
                || !cont(in s, i3, end, CONT_MIN, CONT_MAX) {
                return i;
            }
            i = wrapping_add(i, 4);
        } else {
            return i;
        }
    }
}
