// Module framing of @vesper/grammar (see lib.ves): src/framing.rs.
// Error kinds are crate::ErrorKind indices: UnexpectedEof 0, NonCanonical 1,
// Overflow 2, OutputTooSmall 4, InputLimit 5, OutputLimit 6, PayloadLimit 7,
// WorkLimit 8. Limits: max_input_bytes, max_payload_bytes,
// max_output_bytes, max_work.
use self::{
    GErr,
    P2
};
use self::common::{
    add_or,
    bound,
    charge_or,
    fail,
    leb_len,
    pair,
    put_leb,
    sb,
    shl,
    sw
};

// Unsigned LEB128 (src/framing.rs `LEB128_*`): at most ten bytes for a
// `u64`, whose last may only hold bit 63; seven payload bits per byte and a
// continuation bit.
const LEB128_MAX_BYTES: u64 = 10;
const LEB128_LAST: u64 = 9;
const LEB128_PAYLOAD: u64 = 127;
const LEB128_MORE: u64 = 128;
const LEB128_SHIFT: u64 = 7;
// A u24 frame: a three-byte big-endian length, then at most
// `MAX_U24_PAYLOAD` bytes (src/framing.rs).
const U24_HEADER_BYTES: u64 = 3;
const MAX_U24_PAYLOAD: u64 = 16777215;

// Canonical unsigned LEB128 at `s[start..end]` (framing::decode). Every
// error offset is `base` plus the byte index; the kinds are the caller's
// codes for UnexpectedEof, NonCanonical, Overflow and WorkLimit. Returns
// (value, consumed).
pub fn leb_decode(
    in s: Slice[u8],
    start: u64,
    end: u64,
    inout work: u64,
    base: u64,
    eof: u64,
    noncanonical: u64,
    overflow: u64,
    work_kind: u64
) -> P2 eff [Fail[GErr]] {
    let mut value: u64 = 0;
    let mut i: u64 = 0;
    loop {
        if i == LEB128_MAX_BYTES {
            fail(overflow, wrapping_add(base, LEB128_LAST));
        }
        if work == 0 {
            fail(work_kind, base);
        }
        work = wrapping_sub(work, 1);
        let at = wrapping_add(start, i);
        if at >= end {
            fail(eof, wrapping_add(base, i));
        }
        let byte = sb(in s, at);
        if i == LEB128_LAST && byte > 1 {
            fail(overflow, wrapping_add(base, i));
        }
        value = value | shl(byte & LEB128_PAYLOAD, wrapping_mul(i, LEB128_SHIFT));
        if byte & LEB128_MORE == 0 {
            if i != 0 && byte == 0 {
                fail(noncanonical, wrapping_add(base, i));
            }
            return pair(value, wrapping_add(i, 1));
        }
        i = wrapping_add(i, 1);
    }
}

// framing::decode over a whole slice with the crate's own codes.
pub fn decode(in s: Slice[u8], start: u64, end: u64, inout work: u64, base: u64)
    -> P2 eff [Fail[GErr]] {
    leb_decode(in s, start, end, inout work, base, 0, 1, 2, 8)
}

pub fn decode_prefix(in input: Slice[u8], work: u64) -> P2 eff [Fail[GErr]] {
    let mut w = work;
    decode(in input, 0, input.len(), inout w, 0)
}

pub fn encode_u64_into(value: u64, inout output: Slice[u8], in lim: Slice[u64])
    -> u64 eff [Fail[GErr]] {
    let len = leb_len(value);
    bound(len, sw(in lim, 2), 6);
    bound(len, sw(in lim, 3), 8);
    if output.len() < len {
        fail(4, 0);
    }
    put_leb(inout output, 0, value, len);
    len
}

// (payload start, end) of a LEB128-length frame at the start of `input`.
pub fn frame_parts(in input: Slice[u8], in lim: Slice[u64]) -> P2 eff [Fail[GErr]] {
    bound(input.len(), sw(in lim, 0), 5);
    let mut work = sw(in lim, 3);
    let head = decode(in input, 0, input.len(), inout work, 0);
    let len = head.a;
    bound(len, sw(in lim, 1), 7);
    let end = add_or(head.b, len, 2, 0);
    if end > input.len() {
        fail(0, input.len());
    }
    charge_or(inout work, len, 8);
    pair(head.b, end)
}

// (payload start, end) of a three-byte big-endian length frame.
pub fn u24_frame_parts(in input: Slice[u8], in lim: Slice[u64]) -> P2 eff [Fail[GErr]] {
    bound(input.len(), sw(in lim, 0), 5);
    let mut work = sw(in lim, 3);
    let mut len: u64 = 0;
    for i in 0..U24_HEADER_BYTES {
        charge_or(inout work, 1, 8);
        if i >= input.len() {
            fail(0, i);
        }
        len = shl(len, 8) | sb(in input, i);
    }
    bound(len, sw(in lim, 1), 7);
    let end = wrapping_add(U24_HEADER_BYTES, len);
    if end > input.len() {
        fail(0, input.len());
    }
    charge_or(inout work, len, 8);
    pair(U24_HEADER_BYTES, end)
}

pub fn encode_u24_frame_into(in payload: Slice[u8], inout output: Slice[u8], in lim: Slice[u64])
    -> u64 eff [Fail[GErr]] {
    let n = payload.len();
    if n > MAX_U24_PAYLOAD {
        fail(2, 0);
    }
    bound(n, sw(in lim, 1), 7);
    let size = wrapping_add(U24_HEADER_BYTES, n);
    bound(size, sw(in lim, 2), 6);
    bound(size, sw(in lim, 3), 8);
    if output.len() < size {
        fail(4, 0);
    }
    output.try_set(0, wrapping_u8(n >> 16));
    output.try_set(1, wrapping_u8(n >> 8));
    output.try_set(2, wrapping_u8(n));
    output.try_copy_from(U24_HEADER_BYTES, in payload);
    size
}

pub fn parse_u64(in input: Slice[u8], in lim: Slice[u64]) -> P2 eff [Fail[GErr]] {
    bound(input.len(), sw(in lim, 0), 5);
    let mut work = sw(in lim, 3);
    decode(in input, 0, input.len(), inout work, 0)
}

pub fn frame_encoded_len(n: u64, in lim: Slice[u64]) -> u64 eff [Fail[GErr]] {
    bound(n, sw(in lim, 1), 7);
    let size = add_or(leb_len(n), n, 2, 0);
    bound(size, sw(in lim, 2), 6);
    bound(size, sw(in lim, 3), 8);
    size
}

pub fn encode_frame_into(in payload: Slice[u8], inout output: Slice[u8], in lim: Slice[u64])
    -> u64 eff [Fail[GErr]] {
    let n = payload.len();
    let size = frame_encoded_len(n, in lim);
    if output.len() < size {
        fail(4, 0);
    }
    let prefix = wrapping_sub(size, n);
    put_leb(inout output, 0, n, prefix);
    output.try_copy_from(prefix, in payload);
    size
}
