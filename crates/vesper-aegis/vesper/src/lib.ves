// Corim corim-meta parser (module corim).
pub fn corim_meta_parse(
    in b: Slice[u8],
    inout n: Slice[u64],
    inout st: Slice[u64],
    inout w: Slice[u64]
) -> Unit eff [Fail[AErr]] {
