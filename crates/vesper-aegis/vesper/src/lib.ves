// @vesper/aegis: Vesper port of the parsing and policy logic of
// vesper-aegis (port wave P3a lane 8, #1043): AMD SEV-SNP reports, Intel
// TDX quotes v4/v5 and SGX quotes v3, the 128-byte claims wire struct,
// collateral timestamps, and the relying-party policy check. Signatures,
// certificate chains, X.509, COSE and AEAD stay in Rust (vetted crypto).
//
// Parsers fill `w`, a word buffer the caller lends: `w[0]` counts the
// words after it, which are the integer fields in the order they are read,
// with each byte array given as its offset in the input (a variable-length
// one as its length, then its offset). Bytes the parser computes rather
// than finds in the input (the SNP signature, reversed) go to `d`. The
// Rust adapter (src/port.rs) rebuilds the crate's own structs from the
// words and the input it passed, so no layout knowledge lives on the Rust
// side and nothing is allocated or copied at the boundary. Every parse failure is one
// `AErr`: `kind` is the ParseError variant index, `format` the Format
// index, `field` an index into the field-name table of src/port.rs
// (FIELDS), and `a`, `b` the variant's numbers.
use self::cbor::decode as cbor_decode_impl;
use self::der_cert::{
    parse_amd_cert_ext as parse_amd_cert_ext_impl,
    parse_crl_this_update as parse_crl_this_update_impl, parse_raw_cert as parse_raw_cert_impl,
    parse_spki_ec_key as parse_spki_ec_key_impl, parse_spki_key_bits as parse_spki_key_bits_impl
};
use self::pck_ext::parse_pck_ext as parse_pck_ext_impl;
use self::pem::{
    decode_pem_certificates as decode_pem_certificates_impl,
    decode_pem_public_key as decode_pem_public_key_impl
};
use self::cca::{
    cca_token_parse as cca_token_parse_impl, platform_claims, platform_profile, realm_claims,
    realm_profile
};
use self::claims::{check_policy, decode_wire};
use self::corim::{corim_meta_parse as corim_meta_parse_impl, corim_parse as corim_parse_impl};
use self::corim_cca::{
    cca_appraise as cca_appraise_impl, corim_validate_cca as corim_validate_cca_impl
};
use self::cose::{
    cose_key_p384 as cose_key_p384_impl, sig_structure as cose_sig_structure_impl,
    sign1_parse as cose_sign1_parse_impl
};
use self::gpa::{
    check_access as gpa_check_access_impl, covers as gpa_covers_impl,
    first_gap as gpa_first_gap_impl, first_overlap as gpa_first_overlap_impl,
    insert as gpa_insert_impl, pages as gpa_pages_impl, remove as gpa_remove_impl
};
use self::host::{
    accept_mmap as host_accept_mmap_impl, unmap as host_unmap_impl,
    validate_clock as host_validate_clock_impl
};
use self::sgx::parse as sgx_parse_impl;
use self::snp::{parse as snp_parse_impl, parse_etcb};
use self::tdx::parse as tdx_parse_impl;
use self::time::iso8601_utc_to_unix as iso8601_impl;

// A ParseError: variant index, Format index, field-name index and payload.
pub copy struct AErr {
    kind: u64,
    format: u64,
    field: u64,
    a: u64,
    b: u64
}

// An AttestError: variant index, target/prefix index, reason index and payload.
pub copy struct AtErr {
    kind: u64,
    what: u64,
    reason: u64,
    index: u64,
    extra: u64,
    off: u64,
    len: u64
}

// An AegisVerifyError: variant index and payload.
pub copy struct PErr {
    kind: u64,
    a: u64,
    b: u64,
    c: u64
}

// A bounded reader window (module reader).
pub copy struct Rd {
    pos: u64,
    end: u64,
    format: u64
}

// SnpReport::parse.
pub fn snp_parse(
    in b: Slice[u8],
    inout w: Slice[u64],
    inout d: Slice[u8]
) -> Unit eff [Fail[AErr]] {
    snp_parse_impl(in b, inout w, inout d)
}

// SnpEtcb::parse of a 32-byte ETCB_VERSION: the offset of its fourteen
// SVNs.
pub fn snp_etcb_parse(in b: Slice[u8], inout w: Slice[u64]) -> Unit eff [Fail[AErr]] {
    parse_etcb(in b, inout w)
}

// TdxQuote::parse (mode 0), parse_padded (1) and parse_prefix (2): the
// bytes the quote occupies.
pub fn tdx_parse(in b: Slice[u8], mode: u64, inout w: Slice[u64]) -> u64 eff [Fail[AErr]] {
    tdx_parse_impl(in b, mode, inout w)
}

// SgxQuote::parse (mode 0), parse_padded (1) and parse_prefix (2).
pub fn sgx_parse(in b: Slice[u8], mode: u64, inout w: Slice[u64]) -> u64 eff [Fail[AErr]] {
    sgx_parse_impl(in b, mode, inout w)
}

// cca::decode_value: one CBOR item at the start of `b` as preorder nodes
// in `w` (module cbor), with `st` the decoder's stack; the bytes it used.
pub fn cbor_decode(
    in b: Slice[u8],
    inout w: Slice[u64],
    inout st: Slice[u64]
) -> u64 eff [Fail[AErr]] {
    cbor_decode_impl(in b, inout w, inout st)
}

// CcaRealmClaims::from_cbor (module cca), with `n` and `st` the CBOR
// decoder's node buffer and stack.
pub fn cca_realm_claims(
    in b: Slice[u8],
    inout n: Slice[u64],
    inout st: Slice[u64],
    inout w: Slice[u64]
) -> Unit eff [Fail[AErr]] {
    realm_claims(in b, inout n, inout st, inout w)
}

// CcaPlatformClaims::from_cbor.
pub fn cca_platform_claims(
    in b: Slice[u8],
    inout n: Slice[u64],
    inout st: Slice[u64],
    inout w: Slice[u64]
) -> Unit eff [Fail[AErr]] {
    platform_claims(in b, inout n, inout st, inout w)
}

// The platform token's profile: CcaPlatformProfile in declaration order.
pub fn cca_platform_profile(
    in b: Slice[u8],
    inout n: Slice[u64],
    inout st: Slice[u64]
) -> u64 eff [Fail[AErr]] {
    platform_profile(in b, inout n, inout st)
}

// The realm token's profile: CcaRealmProfile in declaration order.
pub fn cca_realm_profile(
    in b: Slice[u8],
    inout n: Slice[u64],
    inout st: Slice[u64]
) -> u64 eff [Fail[AErr]] {
    realm_profile(in b, inout n, inout st)
}

// AegisAttestationClaimsWire::decode.
pub fn claims_wire_decode(in b: Slice[u8], inout w: Slice[u64]) -> Unit eff [Fail[AErr]] {
    decode_wire(in b, inout w)
}

// time::iso8601_utc_to_unix.
pub fn iso8601_utc_to_unix(in s: Slice[u8]) -> Option[u64] {
    iso8601_impl(in s)
}

// policy::verify_attestation_claims (module claims documents the words).
pub fn verify_attestation_claims(
    in cw: Slice[u64],
    in cb: Slice[u8],
    in pw: Slice[u64],
    in pb: Slice[u8],
    in expected: Slice[u8]
) -> Unit eff [Fail[PErr]] {
    check_policy(in cw, in cb, in pw, in pb, in expected)
}

// COSE_Sign1 parsing and header validation (module cose).
pub fn cose_sign1_parse(
    in b: Slice[u8],
    inout s: Slice[u8],
    inout n: Slice[u64],
    inout st: Slice[u64],
    inout w: Slice[u64],
    field: u64,
    reason: u64
) -> Unit eff [Fail[AErr]] {
    cose_sign1_parse_impl(in b, inout s, inout n, inout st, inout w, field, reason)
}

// RFC 8152 Sig_structure TBS encoder (module cose).
pub fn cose_sig_structure(
    in prot: Slice[u8],
    in aad: Slice[u8],
    in pay: Slice[u8],
    inout out: Slice[u8]
) -> u64 {
    cose_sig_structure_impl(in prot, in aad, in pay, inout out)
}

// COSE_Key / raw SEC1 P-384 decoder (module cose).
pub fn cose_key_p384(
    in b: Slice[u8],
    inout n: Slice[u64],
    inout st: Slice[u64],
    inout out_sec1: Slice[u8]
) -> Unit eff [Fail[AtErr]] {
    cose_key_p384_impl(in b, inout n, inout st, inout out_sec1)
}

