// Module claims of @vesper/aegis (see lib.ves): the evidence-independent
// pieces of src/claims.rs and src/policy.rs: AegisAttestationClaimsWire
// decoding (format code 5, ClaimsWire), constant-time comparison and the
// relying-party policy check verify_attestation_claims.
use self::{
    AErr,
    PErr,
    Rd
};
use self::reader::{
    arr,
    byte,
    finish,
    rd,
    rd_u16,
    rd_u32,
    unsupported,
    put
};

// src/claims.rs: the wire's architecture tags (TDX 1, SNP 2, CCA 3), the
// known enclave flags (bits 0..3), field sizes, and format code 5.
const FORMAT_CLAIMS_WIRE: u64 = 5;
const ARCH_TDX: u64 = 1;
const ARCH_SNP: u64 = 2;
const ARCH_CCA: u64 = 3;
const ENCLAVE_FLAG_DEBUG_DISABLED: u64 = 1;
const FLAGS_RESERVED: u64 = 4294967288;
const MEASUREMENT_BYTES: u64 = 48;
const DIGEST_BYTES: u64 = 32;
const PREFIX_BYTES: u64 = 8;
// `ct_eq` folds eight bytes at a time.
const WORD_BYTES: u64 = 8;
const CHANNEL_BINDING_BYTES: u64 = 48;
// Claims and policy layouts (see check_policy).
const CW_ARCH: u64 = 0;
const CW_TCB_SVN: u64 = 1;
const CW_FLAGS: u64 = 2;
const CW_REPLAYED: u64 = 3;
const CW_HAS_VMPL: u64 = 4;
const CW_VMPL: u64 = 5;
const CW_HAS_REPORTED_TCB: u64 = 6;
const CW_REPORTED_TCB: u64 = 7;
const CB_MEASUREMENT: u64 = 0;
const CB_LOOM_LOCK: u64 = 48;
const CB_OLEAN_MIF: u64 = 80;
const CB_PREFIX: u64 = 112;
const CB_CHANNEL_BINDING: u64 = 120;
const PW_TDX_FLOOR: u64 = 0;
const PW_SNP_FLOOR: u64 = 1;
const PW_CCA_FLOOR: u64 = 2;
const PW_HAS_COMPONENT_FLOORS: u64 = 3;
const PW_COMPONENT_FLOORS: u64 = 4;
const PW_MAX_VMPL: u64 = 5;
const PW_REQUIRE_REPLAY: u64 = 6;
const PW_NARCHS: u64 = 7;
const PW_ARCHS: u64 = 8;
const PB_LOOM_LOCK: u64 = 0;
const PB_OLEAN_MIF: u64 = 32;
const PB_MEASUREMENTS: u64 = 64;
// An unset `snp_vmpl` compares as `u32::MAX`.
const NO_VMPL: u64 = 4294967295;
// The SNP TCB_VERSION components the policy floors: bootloader, tee (bytes
// 0 and 1), snp and microcode (bytes 6 and 7).
const TCB_COMPONENTS: u64 = 4;
const TCB_LOW_COMPONENTS: u64 = 2;
const TCB_HIGH_SKIP: u64 = 4;

// AegisAttestationClaimsWire::decode. Words: tee_arch_tag, tcb_svn,
// enclave_flags. Bytes: mr_enclave_sha384, loom_lock_blake3,
// olean_spec_mif, chan_binding_prefix.
pub fn decode_wire(in b: Slice[u8], inout w: Slice[u64])
    -> Unit eff [Fail[AErr]] {
    let mut r = rd(0, b.len(), FORMAT_CLAIMS_WIRE);
    let tag = rd_u16(in b, inout r, 122);
    if tag < ARCH_TDX || tag > ARCH_CCA {
        unsupported(in r, 122, tag);
    }
    let tcb_svn = rd_u16(in b, inout r, 123);
    let flags = rd_u32(in b, inout r, 124);
    if flags & FLAGS_RESERVED != 0 {
        unsupported(in r, 124, flags);
    }
    put(inout w, tag);
    put(inout w, tcb_svn);
    put(inout w, flags);
    arr(in b, inout r, MEASUREMENT_BYTES, 125, inout w);
    arr(in b, inout r, DIGEST_BYTES, 126, inout w);
    arr(in b, inout r, DIGEST_BYTES, 127, inout w);
    arr(in b, inout r, PREFIX_BYTES, 128, inout w);
    finish(in r);
}

// Whether `a[ai..ai + n]` equals `b[bi..bi + n]`, in time that depends on
// `n` only: every word and byte pair is visited and folded with XOR and
// OR, with no early exit (claims::ct_eq uses `subtle` for the same). Eight
// bytes at a time, then the tail; callers check both intervals first.
pub fn ct_eq(in a: Slice[u8], ai: u64, in b: Slice[u8], bi: u64, n: u64) -> bool {
    let mut acc: u64 = 0;
    let words = n / WORD_BYTES;
    for k in 0..words {
        let at = wrapping_mul(k, WORD_BYTES);
        acc = acc | (le_word(in a, wrapping_add(ai, at)) ^ le_word(in b, wrapping_add(bi, at)));
    }
    for i in wrapping_mul(words, WORD_BYTES)..n {
        acc = acc | (byte(in a, wrapping_add(ai, i)) ^ byte(in b, wrapping_add(bi, i)));
    }
    acc == 0
}

// The eight bytes at `i` as a little-endian word, or 0 past the end.
pub fn le_word(in s: Slice[u8], i: u64) -> u64 {
    match s.try_read_u64_le(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

// The word at `i`, or 0 past the end.
pub fn word(in s: Slice[u64], i: u64) -> u64 {
    match s.try_get(i) {
        Option::Some(x) => x,
        Option::None => 0,
    }
}

pub fn deny(kind: u64, a: u64, b: u64, c: u64) -> Never eff [Fail[PErr]] {
    Fail::raise(
        PErr {
            kind: kind,
            a: a,
            b: b,
            c: c
        }
    )
}

// Byte `i` (0 = least significant) of `x`.
pub fn byte_of(x: u64, i: u64) -> u64 {
    if i >= 8 {
        return 0;
    }
    handle Fail[ArithOverflow] in {
        (x >> wrapping_mul(i, 8)) & 255
    } with {
        return v => v,
        raise(e, k) => 0
    }
}

// verify_attestation_claims. Every failure is an AegisVerifyError variant
// index with its payload words.
//
// Claims words `cw`: arch tag, tcb_svn, enclave_flags, 1 if the supply
// chain is register replayed, 1 if snp_vmpl is set, snp_vmpl, 1 if
// snp_reported_tcb is set, its TCB_VERSION word. Claims bytes `cb`:
// mr_enclave_sha384 (0..48), loom_lock_blake3 (48..80), olean_spec_mif
// (80..112), chan_binding_prefix (112..120), channel_binding (120..168).
//
// Policy words `pw`: the TDX, SNP and CCA TCB floors, 1 if
// snp_component_floors is set, its TCB_VERSION word, snp_max_vmpl,
// require_register_replay, the number of allowed architectures, their
// tags, then the architecture tag of each allowed measurement. Policy
// bytes `pb`: expected_loom_blake3 (0..32), expected_olean_mif (32..64),
// then the allowed measurements, 48 bytes each.
pub fn check_policy(
    in cw: Slice[u64],
    in cb: Slice[u8],
    in pw: Slice[u64],
    in pb: Slice[u8],
    in expected: Slice[u8]
) -> Unit eff [Fail[PErr]] {
    let arch = word(in cw, CW_ARCH);
    let tcb_svn = word(in cw, CW_TCB_SVN);
    let flags = word(in cw, CW_FLAGS);
    let narchs = word(in pw, PW_NARCHS);
    let mut allowed = false;
    for i in 0..narchs {
        if word(in pw, wrapping_add(PW_ARCHS, i)) == arch {
            allowed = true;
        }
    }
    if !allowed {
        deny(0, arch, 0, 0);
    }
    if flags & ENCLAVE_FLAG_DEBUG_DISABLED == 0 {
        deny(1, 0, 0, 0);
    }
    let floor = if arch == ARCH_TDX {
        word(in pw, PW_TDX_FLOOR)
    } else if arch == ARCH_SNP {
        word(in pw, PW_SNP_FLOOR)
    } else {
        word(in pw, PW_CCA_FLOOR)
    };
    if tcb_svn < floor {
        deny(2, tcb_svn, floor, 0);
    }
    let meas_words = wrapping_add(PW_ARCHS, narchs);
    let nmeas = wrapping_sub(pw.len(), meas_words);
    let mut found = false;
    for i in 0..nmeas {
        if word(in pw, wrapping_add(meas_words, i))
            == arch
            && ct_eq(
            in pb,
            wrapping_add(PB_MEASUREMENTS, wrapping_mul(i, MEASUREMENT_BYTES)),
            in cb,
            CB_MEASUREMENT,
            MEASUREMENT_BYTES
        ) {
            found = true;
        }
    }
    if !found {
        deny(4, 0, 0, 0);
    }
    if !ct_eq(in cb, CB_LOOM_LOCK, in pb, PB_LOOM_LOCK, DIGEST_BYTES) {
        deny(5, 0, 0, 0);
    }
    if !ct_eq(in cb, CB_OLEAN_MIF, in pb, PB_OLEAN_MIF, DIGEST_BYTES) {
        deny(6, 0, 0, 0);
    }
    if !ct_eq(in cb, CB_CHANNEL_BINDING, in expected, 0, CHANNEL_BINDING_BYTES)
        || !ct_eq(in cb, CB_PREFIX, in expected, 0, PREFIX_BYTES) {
        deny(7, 0, 0, 0);
    }
    if arch == ARCH_SNP {
        let vmpl = if word(in cw, CW_HAS_VMPL) == 1 {
            word(in cw, CW_VMPL)
        } else {
            NO_VMPL
        };
        let max_vmpl = word(in pw, PW_MAX_VMPL);
        if vmpl > max_vmpl {
            deny(9, vmpl, max_vmpl, 0);
        }
        if word(in pw, PW_HAS_COMPONENT_FLOORS) == 1 {
            let actual = if word(in cw, CW_HAS_REPORTED_TCB) == 1 {
                word(in cw, CW_REPORTED_TCB)
            } else {
                0
            };
            let floors = word(in pw, PW_COMPONENT_FLOORS);
            // bootloader, tee, snp, microcode: bytes 0, 1, 6 and 7.
            let mut component: u64 = 0;
            for c in 0..TCB_COMPONENTS {
                let at = if c < TCB_LOW_COMPONENTS {
                    c
                } else {
                    wrapping_add(c, TCB_HIGH_SKIP)
                };
                let a = byte_of(actual, at);
                let m = byte_of(floors, at);
                if a < m {
                    deny(3, c, a, m);
                }
            }
        }
    }
    if word(in pw, PW_REQUIRE_REPLAY) == 1 && word(in cw, CW_REPLAYED) != 1 {
        deny(8, arch, 0, 0);
    }
}
