// Module sgx of @vesper/aegis (see lib.ves): SgxQuote::parse_prefix (and
// parse, parse_padded) of src/sgx.rs, Intel SGX DCAP quotes v3. Format
// code 1 (SgxQuoteV3).
use self::{
    AErr,
    Rd
};
use self::reader::{
    arr,
    finish,
    k_over_budget,
    raise,
    rd,
    reserved,
    tail,
    take,
    rd_u16,
    rd_u32,
    unsupported
};
use self::tdx::{
    blob,
    max_sig_data,
    qe_report
};

// SgxReportBody::parse. Words: misc_select, isv_prod_id, isv_svn,
// config_svn. Bytes: cpu_svn, isv_ext_prod_id, attributes, mr_enclave,
// mr_signer, config_id, isv_family_id, report_data.
pub fn report_body(in b: Slice[u8], inout r: Rd, inout w: ChunkSeq[u64], inout d: ChunkSeq[u8])
    -> Unit eff [Fail[AErr]] {
    arr(in b, inout r, 16, 105, inout d);
    w.push(rd_u32(in b, inout r, 106));
    reserved(in b, inout r, 12, 107);
    arr(in b, inout r, 16, 108, inout d);
    arr(in b, inout r, 16, 109, inout d);
    arr(in b, inout r, 32, 110, inout d);
    reserved(in b, inout r, 32, 111);
    arr(in b, inout r, 32, 112, inout d);
    reserved(in b, inout r, 32, 113);
    arr(in b, inout r, 64, 114, inout d);
    w.push(rd_u16(in b, inout r, 115));
    w.push(rd_u16(in b, inout r, 116));
    w.push(rd_u16(in b, inout r, 117));
    reserved(in b, inout r, 42, 118);
    arr(in b, inout r, 16, 119, inout d);
    arr(in b, inout r, 64, 69, inout d);
}

// SgxQuote::parse_prefix, then the tail rule `mode` (reader::tail).
// Returns the bytes the quote occupies.
//
// Words: version, att_key_type, qe_svn, pce_svn, the body words, the QE
// report words, qe_auth_data length, PCK chain length. Bytes:
// qe_vendor_id, user_data, the body bytes, the signed header and body (432
// bytes as received), quote_signature, attestation_key, the raw QE report
// (384 bytes), the QE report bytes, qe_report_signature, qe_auth_data, the
// PEM chain.
pub fn parse(in b: Slice[u8], mode: u64, inout w: ChunkSeq[u64], inout d: ChunkSeq[u8])
    -> u64 eff [Fail[AErr]] {
    let mut r = rd(0, b.len(), 1);
    w.reserve(14);
    // A hint only, capped as in tdx.ves.
    let hint = if b.len() < 16384 {
        wrapping_add(b.len(), 816)
    } else {
        17200
    };
    d.reserve(hint);
    let version = rd_u16(in b, inout r, 80);
    if version != 3 {
        unsupported(in r, 80, version);
    }
    let att_key_type = rd_u16(in b, inout r, 81);
    if att_key_type != 2 {
        unsupported(in r, 81, att_key_type);
    }
    reserved(in b, inout r, 4, 120);
    w.push(version);
    w.push(att_key_type);
    w.push(rd_u16(in b, inout r, 83));
    w.push(rd_u16(in b, inout r, 84));
    arr(in b, inout r, 16, 85, inout d);
    arr(in b, inout r, 20, 86, inout d);
    report_body(in b, inout r, inout w, inout d);
    d.extend(in b[0..r.pos]);

    let sig_len = rd_u32(in b, inout r, 92);
    if sig_len > max_sig_data() {
        raise(k_over_budget(), 1, 92, max_sig_data(), sig_len);
    }
    let sig = take(inout r, sig_len, 93);
    let used = r.pos;

    let mut s = rd(sig, wrapping_add(sig, sig_len), 1);
    arr(in b, inout s, 64, 94, inout d);
    arr(in b, inout s, 64, 95, inout d);
    let qe = take(inout s, 384, 121);
    d.extend(in b[qe..wrapping_add(qe, 384)]);
    let mut q = rd(qe, wrapping_add(qe, 384), 1);
    qe_report(in b, inout q, inout w, inout d);
    arr(in b, inout s, 64, 99, inout d);
    let auth_len = rd_u16(in b, inout s, 100);
    blob(in b, inout s, auth_len, 101, inout w, inout d);
    let cert_type = rd_u16(in b, inout s, 96);
    if cert_type != 5 {
        unsupported(in s, 96, cert_type);
    }
    let cert_size = rd_u32(in b, inout s, 97);
    blob(in b, inout s, cert_size, 98, inout w, inout d);
    finish(in s);
    tail(in b, used, mode, 1);
    used
}
