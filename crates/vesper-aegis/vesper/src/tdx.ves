// Module tdx of @vesper/aegis (see lib.ves): TdxQuote::parse_prefix (and
// parse, parse_padded) of src/tdx.rs, Intel TDX DCAP quotes v4 and v5, and
// the Quoting Enclave report body it shares with SGX quotes. Format code 0
// (TdxQuoteV4).
use self::{
    AErr,
    Rd
};
use self::reader::{
    arr,
    finish,
    k_over_budget,
    raise,
    rd,
    reserved,
    tail,
    take,
    rd_u16,
    rd_u32,
    rd_u64,
    unsupported
};

// The largest signature-data section (MAX_SIG_DATA_LEN).
pub fn max_sig_data() -> u64 {
    65536
}

// A length-prefixed byte string: its length goes to `w`, its bytes to `d`.
pub fn blob(
    in b: Slice[u8],
    inout r: Rd,
    n: u64,
    field: u64,
    inout w: ChunkSeq[u64],
    inout d: ChunkSeq[u8]
) -> Unit eff [Fail[AErr]] {
    w.push(n);
    arr(in b, inout r, n, field, inout d);
}

// QeReportBody::parse (the 384-byte SGX report of the Quoting Enclave).
// Words: misc_select, isv_prod_id, isv_svn. Bytes: cpu_svn, attributes,
// mr_enclave, mr_signer, report_data.
pub fn qe_report(in b: Slice[u8], inout r: Rd, inout w: ChunkSeq[u64], inout d: ChunkSeq[u8])
    -> Unit eff [Fail[AErr]] {
    arr(in b, inout r, 16, 43, inout d);
    w.push(rd_u32(in b, inout r, 44));
    reserved(in b, inout r, 28, 45);
    arr(in b, inout r, 16, 46, inout d);
    arr(in b, inout r, 32, 47, inout d);
    reserved(in b, inout r, 32, 48);
    arr(in b, inout r, 32, 49, inout d);
    reserved(in b, inout r, 96, 50);
    w.push(rd_u16(in b, inout r, 51));
    w.push(rd_u16(in b, inout r, 52));
    reserved(in b, inout r, 60, 53);
    arr(in b, inout r, 64, 54, inout d);
}

// TdReportBody::parse. Words: seam_attributes, td_attributes, xfam.
// Bytes: tee_tcb_svn, mr_seam, mr_signer_seam, mr_td, mr_config_id,
// mr_owner, mr_owner_config, rtmr0..3, report_data.
pub fn td_body(in b: Slice[u8], inout r: Rd, inout w: ChunkSeq[u64], inout d: ChunkSeq[u8])
    -> Unit eff [Fail[AErr]] {
    arr(in b, inout r, 16, 55, inout d);
    arr(in b, inout r, 48, 56, inout d);
    arr(in b, inout r, 48, 57, inout d);
    w.push(rd_u64(in b, inout r, 58));
    w.push(rd_u64(in b, inout r, 59));
    w.push(rd_u64(in b, inout r, 60));
    arr(in b, inout r, 48, 61, inout d);
    arr(in b, inout r, 48, 62, inout d);
    arr(in b, inout r, 48, 63, inout d);
    arr(in b, inout r, 48, 64, inout d);
    arr(in b, inout r, 48, 65, inout d);
    arr(in b, inout r, 48, 66, inout d);
    arr(in b, inout r, 48, 67, inout d);
    arr(in b, inout r, 48, 68, inout d);
    arr(in b, inout r, 64, 69, inout d);
}

// Td15ExFields::parse. Words: vm_index. Bytes: the nine arrays after it.
pub fn td15_ex(in b: Slice[u8], inout r: Rd, inout w: ChunkSeq[u64], inout d: ChunkSeq[u8])
    -> Unit eff [Fail[AErr]] {
    let at = take(inout r, 1, 70);
    let vm_index = match b.try_get(at) {
        Option::Some(x) => widen_u64(x),
        Option::None => 0,
    };
    if vm_index > 3 {
        unsupported(in r, 70, vm_index);
    }
    w.push(vm_index);
    arr(in b, inout r, 32, 71, inout d);
    arr(in b, inout r, 48, 72, inout d);
    arr(in b, inout r, 48, 73, inout d);
    arr(in b, inout r, 8, 74, inout d);
    arr(in b, inout r, 16, 75, inout d);
    arr(in b, inout r, 16, 76, inout d);
    arr(in b, inout r, 12, 77, inout d);
    arr(in b, inout r, 48, 78, inout d);
    arr(in b, inout r, 8, 79, inout d);
}

// TdxQuote::parse_prefix, then the tail rule `mode` (reader::tail).
// Returns the bytes the quote occupies.
//
// Words: version, att_key_type, tee_type, qe_svn, pce_svn, body type (0
// for v4), the body words (td_body), vm_index (type 4 only), the QE report
// words, qe_auth_data length, PCK chain length. Bytes: qe_vendor_id,
// user_data, the body bytes, tee_tcb_svn2 and mr_service_td (types 3 and
// 4), the type 4 bytes, quote_signature, attestation_key, the QE report
// bytes, qe_report_signature, qe_auth_data, the PEM chain.
pub fn parse(in b: Slice[u8], mode: u64, inout w: ChunkSeq[u64], inout d: ChunkSeq[u8])
    -> u64 eff [Fail[AErr]] {
    let mut r = rd(0, b.len(), 0);
    w.reserve(16);
    // A hint only: capped so a short quote at the front of a large
    // buffer (prefix mode) or an input rejected at the header reserves
    // no more than a real quote needs.
    let hint = if b.len() < 16384 {
        b.len()
    } else {
        16384
    };
    d.reserve(hint);
    let version = rd_u16(in b, inout r, 80);
    let att_key_type = rd_u16(in b, inout r, 81);
    let tee_type = rd_u32(in b, inout r, 82);
    w.push(version);
    w.push(att_key_type);
    w.push(tee_type);
    w.push(rd_u16(in b, inout r, 83));
    w.push(rd_u16(in b, inout r, 84));
    arr(in b, inout r, 16, 85, inout d);
    arr(in b, inout r, 20, 86, inout d);
    if version != 4 && version != 5 {
        unsupported(in r, 80, version);
    }
    if att_key_type != 2 {
        unsupported(in r, 81, att_key_type);
    }
    if tee_type != 129 {
        unsupported(in r, 82, tee_type);
    }
    if version == 5 {
        let body_type = rd_u16(in b, inout r, 87);
        let body_size = rd_u32(in b, inout r, 88);
        let want: u64 = if body_type == 2 {
            584
        } else if body_type == 3 {
            648
        } else if body_type == 4 {
            885
        } else {
            unsupported(in r, 87, body_type)
        };
        if body_size != want {
            unsupported(in r, 88, body_size);
        }
        let at = take(inout r, body_size, 89);
        let mut br = rd(at, wrapping_add(at, body_size), 0);
        w.push(body_type);
        td_body(in b, inout br, inout w, inout d);
        if body_type != 2 {
            arr(in b, inout br, 16, 90, inout d);
            arr(in b, inout br, 48, 91, inout d);
        }
        if body_type == 4 {
            td15_ex(in b, inout br, inout w, inout d);
        }
        finish(in br);
    } else {
        w.push(0);
        td_body(in b, inout r, inout w, inout d);
    }
    let sig_len = rd_u32(in b, inout r, 92);
    if sig_len > max_sig_data() {
        raise(k_over_budget(), 0, 92, max_sig_data(), sig_len);
    }
    let sig = take(inout r, sig_len, 93);
    let used = r.pos;

    let mut s = rd(sig, wrapping_add(sig, sig_len), 0);
    arr(in b, inout s, 64, 94, inout d);
    arr(in b, inout s, 64, 95, inout d);
    let cert_type = rd_u16(in b, inout s, 96);
    if cert_type != 6 {
        unsupported(in s, 96, cert_type);
    }
    let cert_size = rd_u32(in b, inout s, 97);
    let cert = take(inout s, cert_size, 98);
    finish(in s);

    let mut c = rd(cert, wrapping_add(cert, cert_size), 0);
    qe_report(in b, inout c, inout w, inout d);
    arr(in b, inout c, 64, 99, inout d);
    let auth_len = rd_u16(in b, inout c, 100);
    blob(in b, inout c, auth_len, 101, inout w, inout d);
    let inner_type = rd_u16(in b, inout c, 102);
    if inner_type != 5 {
        unsupported(in c, 102, inner_type);
    }
    let inner_size = rd_u32(in b, inout c, 103);
    blob(in b, inout c, inner_size, 104, inout w, inout d);
    finish(in c);
    tail(in b, used, mode, 0);
    used
}
