# The frozen Rust seed copy of vesper-aegis (package vesper-aegis-seed,
# library vesper_aegis) that the compiler links: ../src built without the
# port, so cfg(vesper_port) is off. Written by hand because its sources live
# in the parent package; see "Crates the compiler links" in
# docs/maintenance/porting-a-crate.md.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("@vesper_cargo//:packages.bzl", "PACKAGES")

# The seed's external dependencies (ring, webpki, x509-parser, coset, ...,
# and rcgen for the tests), from its Cargo metadata as vesper_crate derives
# them. The path dependencies (vesper-loom-cas, vesper-vault) are in it too.
_DATA = PACKAGES["crates/vesper-aegis/seed"].crate_data()

_NORMAL = all_crate_deps(_DATA, platforms = _DATA["platforms"], normal = True)

_DEV = all_crate_deps(_DATA, platforms = _DATA["platforms"], normal_dev = True)

rust_library(
    name = "seed",
    srcs = ["//crates/vesper-aegis:rust_srcs"],
    # src/roots.rs embeds the pinned vendor roots.
    compile_data = ["//crates/vesper-aegis:roots"],
    crate_name = "vesper_aegis",
    crate_root = "//crates/vesper-aegis:src/lib.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_PKG_NAME": "vesper-aegis-seed",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = _NORMAL,
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    edition = "2024",
    deps = _DEV,
)

# The integration tests read tests/data/vendor through
# `support::crate_dir()`; the runfiles tree holds it at this path.
[
    rust_test(
        name = "seed_test_" + t,
        srcs = [
            "//crates/vesper-aegis:tests/%s.rs" % t,
            "//crates/vesper-aegis:tests/support/mod.rs",
        ],
        crate_root = "//crates/vesper-aegis:tests/%s.rs" % t,
        data = ["//crates/vesper-aegis:test_data"],
        edition = "2024",
        rustc_env = {"CARGO_MANIFEST_DIR": "crates/vesper-aegis"},
        deps = [":seed"] + _NORMAL + _DEV,
    )
    for t in [
        "attestation",
        "corim_cca",
        "gpa_props",
        "host",
        "parser_fuzz",
        "policy",
        "port_memory",
        "revocation",
        "sgx_quote_v3",
        "snp_v6",
        "toctou",
        "vault_gate",
        "vendor_samples",
        "vendor_samples_rest",
        "zero_alloc",
    ]
]

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
