# The frozen Rust seed copy of vesper-span (package vesper-span-seed,
# library vesper_span) that the compiler links: ../src built without the port,
# so cfg(vesper_port) is off. Written by hand because its sources live in the
# parent package; see "Crates the compiler links" in
# docs/maintenance/porting-a-crate.md.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")

rust_library(
    name = "seed",
    srcs = ["//crates/vesper-span:rust_srcs"],
    crate_name = "vesper_span",
    crate_root = "//crates/vesper-span:src/lib.rs",
    edition = "2024",
    rustc_env = {
        "CARGO_PKG_NAME": "vesper-span-seed",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    version = "0.1.0",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    edition = "2024",
)

[
    rust_test(
        name = "seed_test_" + t,
        srcs = ["//crates/vesper-span:tests/%s.rs" % t],
        crate_root = "//crates/vesper-span:tests/%s.rs" % t,
        edition = "2024",
        deps = [":seed"],
    )
    for t in [
        "port_memory",
        "span",
    ]
]

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
