load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The port-backed package (seed-copy rule, docs/maintenance/porting-a-crate.md;
# self-hosting SH0 lane 6, #1128): build.rs links the object built here from
# the Loom package in vesper/ and checks port/binding.rs against the
# generated binding. The compiler links the Rust seed copy,
# //crates/vesper-span/seed, instead.
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
)

vesper_port_object(
    name = "span_vesper",
    library = "span",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

filegroup(
    name = "span_vesper_binding",
    srcs = [":span_vesper"],
    output_group = "rust_binding",
)

# The divergent builds, one per ported area: the same edits as the Cargo
# feature `vesper-port-divergent` (EDITS in build.rs). They must build; the
# Cargo run in port/test-port.sh (scripts/test-port-harness.sh) asserts that
# the tests catch each edit.
vesper_port_object(
    name = "span_vesper_divergent_index",
    edit_src = "vesper/src/lib.ves",
    edits = {"            character = if b >= 240 {": "            character = if b >= 224 {"},
    library = "span",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

vesper_port_object(
    name = "span_vesper_divergent_edits",
    edit_src = "vesper/src/lib.ves",
    edits = {"|| (start == end && start == b_end)": "|| (start == end && start == b_end && false)"},
    library = "span",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

vesper_port_object(
    name = "span_vesper_divergent_diagnostics",
    edit_src = "vesper/src/lib.ves",
    edits = {"        if !primary {\n            Fail::raise(Error::InvalidDiagnostic);": "        if false {\n            Fail::raise(Error::InvalidDiagnostic);"},
    library = "span",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

# Pure Rust tests apart from the prebuilt port object: no external tools or
# host services.
vesper_crate(
    build_script_data = [
        ":span_vesper",
        ":span_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :span_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :span_vesper_binding)",
    },
    remote_tests = ["*"],
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
    "README.md",
]))

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-span/seed:__pkg__"],
)
