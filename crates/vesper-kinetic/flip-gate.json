{
  "notes": [
    "The flip gate for vesper-kinetic (aspect ci flip-gate --, SH6 lane 1,",
    "#1396; this crate's lane: SH6 lane 9, #1404). The flipped modules are the",
    "constraint colouring (coloring.rs: Colorer and MultiColorer), gjk, sap,",
    "the fast math (fastmath.rs), morton, lbvh and the correctly rounded math",
    "(crmath.rs). The package has only their port; the frozen",
    "Rust is the seed's engine, which the compiler links until Stage 2.",
    "Both colourers against the seed: visiting order, colours and layers.",
    "Both builds are in one binary (the seed is a dev-dependency), so the",
    "harness times both arms itself (A B B A per epoch) and prints the pairs."
  ],
  "name": "vesper-kinetic",
  "lane": "SH6-9",
  "rust": [
    "crates/vesper-kinetic/seed/src/engine/coloring.rs",
    "crates/vesper-kinetic/seed/src/engine/crmath.rs",
    "crates/vesper-kinetic/seed/src/engine/fastmath.rs",
    "crates/vesper-kinetic/seed/src/engine/gjk.rs",
    "crates/vesper-kinetic/seed/src/engine/lbvh.rs",
    "crates/vesper-kinetic/seed/src/engine/morton.rs",
    "crates/vesper-kinetic/seed/src/engine/sap.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0"
  },
  "build": [
    ["cargo", "build", "--locked", "--release", "-p", "vesper-kinetic", "--example", "abba"]
  ],
  "tests": [
    {
      "run": ["cargo", "test", "--locked", "--release", "-p", "vesper-kinetic", "-p", "vesper-kinetic-seed"]
    }
  ],
  "differential": {
    "run": ["cargo", "test", "--locked", "--release", "-p", "vesper-kinetic", "--test", "port_differential", "--", "--nocapture"]
  },
  "abba": [
    {
      "workload": "colorer",
      "run": {
        "cargo_target": "release/examples/abba",
        "args": ["flip-gate", "colorer", "20"]
      }
    },
    {
      "workload": "multi-colorer",
      "run": {
        "cargo_target": "release/examples/abba",
        "args": ["flip-gate", "multi-colorer", "20"]
      }
    },
    {
      "workload": "gjk",
      "run": {
        "cargo_target": "release/examples/abba",
        "args": ["flip-gate", "gjk", "20"]
      }
    },
    {
      "workload": "sap",
      "run": {
        "cargo_target": "release/examples/abba",
        "args": ["flip-gate", "sap", "5"]
      }
    },
    {
      "workload": "fastmath",
      "run": {
        "cargo_target": "release/examples/abba",
        "args": ["flip-gate", "fastmath", "20"]
      }
    },
    {
      "workload": "morton",
      "run": {
        "cargo_target": "release/examples/abba",
        "args": ["flip-gate", "morton", "20"]
      }
    },
    {
      "workload": "lbvh",
      "run": {
        "cargo_target": "release/examples/abba",
        "args": ["flip-gate", "lbvh", "5"]
      }
    },
    {
      "workload": "pile-lbvh",
      "run": {
        "cargo_target": "release/examples/abba",
        "args": ["flip-gate", "pile-lbvh", "5"]
      }
    },
    {
      "workload": "crmath",
      "run": {
        "cargo_target": "release/examples/abba",
        "args": ["flip-gate", "crmath", "20"]
      }
    }
  ]
}
