# The frozen Rust seed copy of vesper-kinetic (package vesper-kinetic-seed,
# library vesper_kinetic) that the compiler and every other dependent link:
# ../src built without the port, so cfg(vesper_port) is off. Written by hand
# because its sources live in the parent package; see "Crates the compiler
# links" in docs/maintenance/porting-a-crate.md (port wave P3b lane 8, #1070).
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs/private:all_crate_deps.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("@vesper_cargo//:packages.bzl", "PACKAGES")

# The seed's dependencies from its Cargo metadata, as vesper_crate derives
# them.
_DATA = PACKAGES["crates/vesper-kinetic/seed"].crate_data()

_NORMAL = all_crate_deps(_DATA, platforms = _DATA["platforms"], normal = True)

_DEV = all_crate_deps(_DATA, platforms = _DATA["platforms"], normal_dev = True)

_ENV = {
    "CARGO_PKG_NAME": "vesper-kinetic-seed",
    "CARGO_PKG_VERSION": "0.1.0",
}

rust_library(
    name = "seed",
    srcs = ["//crates/vesper-kinetic:rust_srcs"],
    crate_name = "vesper_kinetic",
    crate_root = "//crates/vesper-kinetic:src/lib.rs",
    edition = "2024",
    rustc_env = _ENV,
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = _NORMAL,
)

rust_test(
    name = "seed_unit_test",
    crate = ":seed",
    edition = "2024",
    deps = _DEV,
)

# Every integration test but tests/lean_model.rs, which reads lean/ through
# a regular-file copy of the runfiles; it runs against the seed in Cargo
# (crates/vesper-kinetic/port/check.sh) and against the port here.
[
    rust_test(
        name = "seed_test_" + t,
        srcs = [
            "//crates/vesper-kinetic:tests/%s.rs" % t,
            "//crates/vesper-kinetic:test_common",
        ],
        compile_data = ["//crates/vesper-kinetic:test_data"],
        crate_root = "//crates/vesper-kinetic:tests/%s.rs" % t,
        edition = "2024",
        rustc_env = _ENV,
        deps = [":seed"] + _NORMAL + _DEV,
    )
    for t in [
        "alloc",
        "alloc_arena",
        "articulation",
        "batches",
        "bench_batches",
        "coloring",
        "contacts",
        "couple",
        "crmath",
        "detfloat",
        "diff",
        "diff_contacts",
        "diff_rigid",
        "fastmath",
        "gjk",
        "golden",
        "joint_drives",
        "joints",
        "lbvh",
        "morton",
        "pair_backend",
        "rigid",
        "rigid_features",
        "rollback",
        "sap",
        "sleep_ccd",
        "soft",
        "world",
    ]
]

rust_clippy_test(
    name = "clippy",
    targets = [":seed"],
    tags = [
        "clippy",
        "lint",
    ],
)
