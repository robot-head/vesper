// Table forms of encode_masked and of the 30-bit decode (same results):
// three loads instead of three spread chains, and four byte loads for the
// three compactions; the axes come back packed as x | y << 10 | z << 20.
pub fn encode_table(x: u16, y: u16, z: u16) -> u32 {
    let sx = MORTON_SPREAD10[widen_u64(x) & 1023];
    let sy = MORTON_SPREAD10[widen_u64(y) & 1023];
    let sz = MORTON_SPREAD10[widen_u64(z) & 1023];
    sx | (sy << 1) | (sz << 2)
}

pub fn decode_table(code: u32) -> u32 {
    let c = widen_u64(code);
    MORTON_COMPACT_B0[c & 255]
        | MORTON_COMPACT_B1[(c >> 8) & 255]
        | MORTON_COMPACT_B2[(c >> 16) & 255]
        | MORTON_COMPACT_B3[(c >> 24) & 255]
}
