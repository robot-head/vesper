// Module lbvh of @vesper/kinetic (see lib.ves): the 64-bit Morton LBVH of
// src/lbvh.rs (Karras 2012). Boxes are six f32 bit patterns each (min x, y,
// z, max x, y, z). A child is a word: an internal node `k` is `k`, a leaf
// at sorted position `i` is `2^32 + i`. The Rust wrapper owns every buffer
// and lends it here sized for the call.
use @vesper-std/sort::unstable::{sort};
use self::{LbvhError};
use self::morton::{morton64};
use self::sap::{radix_sort, radix_sort_pairs};
use self::util::{box_valid, dec, g32, g64, gf, inc, shr_i64, u};

// A child word: a node index, or a leaf index with bit 32 set. Keys are
// 64-bit Morton codes (equal keys break ties by index, past bit 64); a box
// is six floats (min then max); a quantised axis has 21 bits.
const LEAF_BIT: u64 = 0x100000000;
const INDEX_MASK: u64 = 0xffffffff;
const KEY_BITS: i64 = 64;
const BOX_FLOATS: u64 = 6;
const MORTON64_AXIS_MAX: u32 = 0x1fffff;
const MORTON64_AXIS_MAX_F: f32 = 2097151.0;
// IEEE 754 binary32 +-infinity.
const F32_INFINITY_BITS: u32 = 0x7f800000;
const F32_NEG_INFINITY_BITS: u32 = 0xff800000;

fn raise_lbvh(e: LbvhError) eff [Fail[LbvhError]] {
    Fail::raise(e);
}

// Common prefix length of sorted key `i` (`a = codes[i]`) and `j`; -1 outside.
fn delta(in codes: Slice[u64], n: u64, i: u64, a: u64, j: i64) -> i64 {
    if j < 0 || wrapping_u64(j) >= n {
        return -1;
    }
    let uj = wrapping_u64(j);
    let b = g64(in codes, uj);
    if a == b {
        wrapping_add(KEY_BITS, widen_i64(leading_zeros_u32(wrapping_u32(i) ^ wrapping_u32(uj))))
    } else {
        widen_i64(leading_zeros_u64(a ^ b))
    }
}

fn min_i64(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn max_i64(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

// Karras 2012, algorithm 3, for internal node `i`: its (left, right)
// children.
fn internal(in codes: Slice[u64], n: u64, i: u64) -> (u64, u64) {
    let a = g64(in codes, i);
    let ii = wrapping_i64(i);
    let mut d: i64 = -1;
    if delta(in codes, n, i, a, wrapping_add(ii, 1))
        > delta(in codes, n, i, a, wrapping_sub(ii, 1))
    {
        d = 1;
    }
    let delta_min = delta(in codes, n, i, a, wrapping_sub(ii, d));
    let mut l_max: i64 = 2;
    loop {
        if !(delta(in codes, n, i, a, wrapping_add(ii, wrapping_mul(l_max, d))) > delta_min) {
            break;
        }
        l_max = wrapping_mul(l_max, 2);
    }
    let mut l: i64 = 0;
    let mut t = l_max / 2;
    loop {
        if !(t >= 1) {
            break;
        }
        if delta(in codes, n, i, a, wrapping_add(ii, wrapping_mul(wrapping_add(l, t), d)))
            > delta_min
        {
            l = wrapping_add(l, t);
        }
        t = shr_i64(t, 1);
    }
    let j = wrapping_add(ii, wrapping_mul(l, d));
    let delta_node = delta(in codes, n, i, a, j);
    let mut s: i64 = 0;
    let mut div: i64 = 2;
    let mut log: u32 = 1;
    loop {
        // (l + div - 1) / div for l >= 0 and div = 2^log.
        let tt = shr_i64(wrapping_add(l, wrapping_sub(div, 1)), log);
        if delta(in codes, n, i, a, wrapping_add(ii, wrapping_mul(wrapping_add(s, tt), d)))
            > delta_node
        {
            s = wrapping_add(s, tt);
        }
        if tt <= 1 {
            break;
        }
        div = wrapping_mul(div, 2);
        log = wrapping_add(log, 1);
    }
    let gamma = wrapping_add(wrapping_add(ii, wrapping_mul(s, d)), min_i64(d, 0));
    let g = wrapping_u64(gamma);
    let mut left = g;
    if min_i64(ii, j) == gamma {
        left = LEAF_BIT | g;
    }
    let mut right = inc(g);
    if max_i64(ii, j) == wrapping_add(gamma, 1) {
        right = LEAF_BIT | inc(g);
    }
    (left, right)
}

// Box `c` (a child word) from the leaf or node bounds.
fn bounds_lane(in leaf: Slice[u32], in node_box: Slice[u32], c: u64, lane: u64) -> f32 {
    if (c & LEAF_BIT) != 0 {
        gf(in leaf, wrapping_add(wrapping_mul(c & INDEX_MASK, BOX_FLOATS), lane))
    } else {
        gf(in node_box, wrapping_add(wrapping_mul(c, BOX_FLOATS), lane))
    }
}

// Lbvh::build over `n` boxes (the wrapper checked the capacity): fills the
// sorted `codes`/`prims`, the leaf bounds, the `n - 1` nodes and their
// bounds. `order` and `stack` are scratch of n and n + 1 slots; `tk`, `tv`
// (n slots each) and `hist` (256 slots) are the radix sort scratch.
pub fn build(
    in boxes: Slice[u32],
    inout codes: Slice[u64],
    inout prims: Slice[u32],
    inout leaf: Slice[u32],
    inout left: Slice[u64],
    inout right: Slice[u64],
    inout node_box: Slice[u32],
    inout order: Slice[u32],
    inout stack: Slice[u64],
    inout tk: Slice[u64],
    inout tv: Slice[u32],
    inout hist: Slice[u32]
) eff [Fail[LbvhError]] {
    let n = boxes.len() / 6;
    for i in 0..n {
        if !box_valid(in boxes, i) {
            raise_lbvh(LbvhError::InvalidBox { index: wrapping_usize(i) });
        }
    }
    if n == 0 {
        return ();
    }
    // Centroid bounds.
    let inf = from_bits_f32(F32_INFINITY_BITS);
    let ninf = from_bits_f32(F32_NEG_INFINITY_BITS);
    let mut lo0 = inf;
    let mut lo1 = inf;
    let mut lo2 = inf;
    let mut hi0 = ninf;
    let mut hi1 = ninf;
    let mut hi2 = ninf;
    for i in 0..n {
        let b = wrapping_mul(i, 6);
        let c0 = (gf(in boxes, b) + gf(in boxes, wrapping_add(b, 3))) * 0.5;
        let c1 = (gf(in boxes, wrapping_add(b, 1)) + gf(in boxes, wrapping_add(b, 4))) * 0.5;
        let c2 = (gf(in boxes, wrapping_add(b, 2)) + gf(in boxes, wrapping_add(b, 5))) * 0.5;
        let cb = wrapping_mul(i, 3);
        leaf.try_set(cb, to_bits_f32(c0));
        leaf.try_set(inc(cb), to_bits_f32(c1));
        leaf.try_set(wrapping_add(cb, 2), to_bits_f32(c2));
        if c0 < lo0 {
            lo0 = c0;
        }
        if c0 > hi0 {
            hi0 = c0;
        }
        if c1 < lo1 {
            lo1 = c1;
        }
        if c1 > hi1 {
            hi1 = c1;
        }
        if c2 < lo2 {
            lo2 = c2;
        }
        if c2 > hi2 {
            hi2 = c2;
        }
    }
    let e0 = hi0 - lo0;
    let e1 = hi1 - lo1;
    let e2 = hi2 - lo2;
    for i in 0..n {
        let cb = wrapping_mul(i, 3);
        let q0 = quantize(gf(in leaf, cb), lo0, e0);
        let q1 = quantize(gf(in leaf, inc(cb)), lo1, e1);
        let q2 = quantize(gf(in leaf, wrapping_add(cb, 2)), lo2, e2);
        codes.try_set(i, morton64(q0, q1, q2));
        prims.try_set(i, wrapping_u32(i));
    }
    // Stable LSD radix sort of 63-bit Morton codes (equal codes keep 0..n order).
    radix_sort(inout codes, inout prims, true, n, 8, inout tk, inout tv, inout hist);
    for i in 0..n {
        let pr = widen_u64(g32(in prims, i));
        let p = wrapping_mul(pr, 6);
        let at = wrapping_mul(i, 6);
        for lane in 0..u(6) {
            leaf.try_set(wrapping_add(at, lane), g32(in boxes, wrapping_add(p, lane)));
        }
    }
    if n < 2 {
        return ();
    }
    for i in 0..dec(n) {
        let (l, r) = internal(in codes, n, i);
        left.try_set(i, l);
        right.try_set(i, r);
    }
    // Pre-order from the root, then fill bounds children-first.
    let mut sp: u64 = 1;
    stack.try_set(0, 0);
    let mut count: u64 = 0;
    loop {
        if !(sp > 0) {
            break;
        }
        sp = dec(sp);
        let c = g64(in stack, sp);
        if (c & LEAF_BIT) == 0 {
            order.try_set(count, wrapping_u32(c));
            count = inc(count);
            stack.try_set(sp, g64(in left, c));
            stack.try_set(inc(sp), g64(in right, c));
            sp = wrapping_add(sp, 2);
        }
    }
    let mut idx = count;
    loop {
        if !(idx > 0) {
            break;
        }
        idx = dec(idx);
        let k = widen_u64(g32(in order, idx));
        let l = g64(in left, k);
        let r = g64(in right, k);
        let at = wrapping_mul(k, 6);
        let mut l0: f32 = 0.0;
        let mut l1: f32 = 0.0;
        let mut l2: f32 = 0.0;
        let mut l3: f32 = 0.0;
        let mut l4: f32 = 0.0;
        let mut l5: f32 = 0.0;
        if (l & LEAF_BIT) != 0 {
            let bl = wrapping_mul(l & INDEX_MASK, BOX_FLOATS);
            l0 = gf(in leaf, bl);
            l1 = gf(in leaf, inc(bl));
            l2 = gf(in leaf, wrapping_add(bl, 2));
            l3 = gf(in leaf, wrapping_add(bl, 3));
            l4 = gf(in leaf, wrapping_add(bl, 4));
            l5 = gf(in leaf, wrapping_add(bl, 5));
        } else {
            let bl = wrapping_mul(l, BOX_FLOATS);
            l0 = gf(in node_box, bl);
            l1 = gf(in node_box, inc(bl));
            l2 = gf(in node_box, wrapping_add(bl, 2));
            l3 = gf(in node_box, wrapping_add(bl, 3));
            l4 = gf(in node_box, wrapping_add(bl, 4));
            l5 = gf(in node_box, wrapping_add(bl, 5));
        }
        let mut r0: f32 = 0.0;
        let mut r1: f32 = 0.0;
        let mut r2: f32 = 0.0;
        let mut r3: f32 = 0.0;
        let mut r4: f32 = 0.0;
        let mut r5: f32 = 0.0;
        if (r & LEAF_BIT) != 0 {
            let br = wrapping_mul(r & INDEX_MASK, BOX_FLOATS);
            r0 = gf(in leaf, br);
            r1 = gf(in leaf, inc(br));
            r2 = gf(in leaf, wrapping_add(br, 2));
            r3 = gf(in leaf, wrapping_add(br, 3));
            r4 = gf(in leaf, wrapping_add(br, 4));
            r5 = gf(in leaf, wrapping_add(br, 5));
        } else {
            let br = wrapping_mul(r, BOX_FLOATS);
            r0 = gf(in node_box, br);
            r1 = gf(in node_box, inc(br));
            r2 = gf(in node_box, wrapping_add(br, 2));
            r3 = gf(in node_box, wrapping_add(br, 3));
            r4 = gf(in node_box, wrapping_add(br, 4));
            r5 = gf(in node_box, wrapping_add(br, 5));
        }
        node_box.try_set(at, to_bits_f32(if r0 < l0 { r0 } else { l0 }));
        node_box.try_set(inc(at), to_bits_f32(if r1 < l1 { r1 } else { l1 }));
        node_box.try_set(wrapping_add(at, 2), to_bits_f32(if r2 < l2 { r2 } else { l2 }));
        node_box.try_set(wrapping_add(at, 3), to_bits_f32(if r3 > l3 { r3 } else { l3 }));
        node_box.try_set(wrapping_add(at, 4), to_bits_f32(if r4 > l4 { r4 } else { l4 }));
        node_box.try_set(wrapping_add(at, 5), to_bits_f32(if r5 > l5 { r5 } else { l5 }));
    }
}

// The quantised coordinate of centroid `c` over [lo, lo + extent].
fn quantize(c: f32, lo: f32, extent: f32) -> u32 {
    if extent > 0.0 {
        let t = (c - lo) / extent;
        let q = saturating_u32(t * MORTON64_AXIS_MAX_F);
        if q > MORTON64_AXIS_MAX {
            return MORTON64_AXIS_MAX;
        }
        return q;
    }
    0
}

// Whether child word c can hold a pair reported from leaf p: a leaf after
// p, or (when pruning) an internal node whose highest leaf is after p. The
// left child sorts below the right one, so it is live only if the right
// one is.
fn live(c: u64, p: u64, prune: bool, in tk: Slice[u64]) -> bool {
    if (c & LEAF_BIT) != 0 {
        (c & INDEX_MASK) > p
    } else {
        !prune || g64(in tk, c) > p
    }
}

// Lbvh::overlapping_pairs: every overlapping pair `(a << 32) | b`, `a < b`,
// ascending, into `pairs`. Returns the pair count; `max_pairs` + 1 means
// more than `max_pairs` pairs, and the length of `pairs` + 1 (when below
// `max_pairs`) asks the wrapper for a larger buffer.
pub fn pairs(
    in codes: Slice[u64],
    in prims: Slice[u32],
    in leaf: Slice[u32],
    in left: Slice[u64],
    in right: Slice[u64],
    in node_box: Slice[u32],
    inout stack: Slice[u64],
    inout out: Slice[u64],
    inout tk: Slice[u64],
    inout novals: Slice[u32],
    inout tv: Slice[u32],
    inout hist: Slice[u32],
    max_pairs: u64
) -> u64 {
    let n = codes.len();
    if n < 2 {
        return 0;
    }
    let room = out.len();
    let mut len: u64 = 0;
    // The output is sorted at the end, so any visiting order gives the same
    // pairs. A subtree whose leaves all sort at or below p holds no pair
    // reported from p (each pair is reported from its lower leaf), so it is
    // skipped without testing its box: tk[k] is internal node k's highest
    // leaf, the end of its right spine (tk is the sort's scratch, free until
    // the sort; when it is too short every subtree is tested).
    let inner = dec(n);
    let prune = tk.len() >= inner;
    if prune {
        for k in 0..inner {
            let mut c = g64(in right, k);
            loop {
                if (c & LEAF_BIT) != 0 {
                    break;
                }
                c = g64(in right, c);
            }
            tk.try_set(k, c & INDEX_MASK);
        }
    }
    for p in 0..n {
        let bp = wrapping_mul(p, 6);
        let pmin0 = gf(in leaf, bp);
        let pmin1 = gf(in leaf, inc(bp));
        let pmin2 = gf(in leaf, wrapping_add(bp, 2));
        let pmax0 = gf(in leaf, wrapping_add(bp, 3));
        let pmax1 = gf(in leaf, wrapping_add(bp, 4));
        let pmax2 = gf(in leaf, wrapping_add(bp, 5));
        let ap = widen_u64(g32(in prims, p));
        let mut sp: u64 = 0;
        if live(0, p, prune, in tk) {
            stack.try_set(0, 0);
            sp = 1;
        }
        loop {
            if !(sp > 0) {
                break;
            }
            sp = dec(sp);
            let c = g64(in stack, sp);
            if (c & LEAF_BIT) != 0 {
                let q = c & INDEX_MASK;
                {
                    let bq = wrapping_mul(q, 6);
                    if pmin0 <= gf(in leaf, wrapping_add(bq, 3))
                        && gf(in leaf, bq) <= pmax0
                        && pmin1 <= gf(in leaf, wrapping_add(bq, 4))
                        && gf(in leaf, inc(bq)) <= pmax1
                        && pmin2 <= gf(in leaf, wrapping_add(bq, 5))
                        && gf(in leaf, wrapping_add(bq, 2)) <= pmax2
                    {
                        if len == max_pairs {
                            return inc(max_pairs);
                        }
                        if len == room {
                            return inc(room);
                        }
                        let b = widen_u64(g32(in prims, q));
                        if ap < b {
                            out.try_set(len, (ap << 32) | b);
                        } else {
                            out.try_set(len, (b << 32) | ap);
                        }
                        len = inc(len);
                    }
                }
            } else {
                let bc = wrapping_mul(c, 6);
                if pmin0 <= gf(in node_box, wrapping_add(bc, 3))
                    && gf(in node_box, bc) <= pmax0
                    && pmin1 <= gf(in node_box, wrapping_add(bc, 4))
                    && gf(in node_box, inc(bc)) <= pmax1
                    && pmin2 <= gf(in node_box, wrapping_add(bc, 5))
                    && gf(in node_box, wrapping_add(bc, 2)) <= pmax2
                {
                    // Push only the children that can hold a pair from p:
                    // a leaf after p, or a subtree reaching past p.
                    let r = g64(in right, c);
                    if live(r, p, prune, in tk) {
                        stack.try_set(sp, r);
                        sp = inc(sp);
                        let l = g64(in left, c);
                        if live(l, p, prune, in tk) {
                            stack.try_set(sp, l);
                            sp = inc(sp);
                        }
                    }
                }
            }
        }
    }
    if len > INDEX_MASK {
        // Radix histogram offsets are u32.
        sort(inout out[0..len]);
    } else if len > 1 {
        radix_sort_pairs(inout out, len, n, inout tk, inout novals, inout tv, inout hist);
    }
    len
}
