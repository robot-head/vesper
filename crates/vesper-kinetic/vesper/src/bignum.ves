// Module bignum of @vesper/kinetic (see lib.ves): the arbitrary-precision
// integers `crmath.ves` evaluates in, standing in for `num-bigint`'s
// `BigInt`. A magnitude is little-endian 64-bit limbs with no high zero
// limb (zero has none); a `Big` is a sign and a magnitude, and zero is never
// negative. Shifts right round toward negative infinity and division
// truncates toward zero, as in `num-bigint`, so every crmath intermediate
// is the Rust build's bit for bit. Products use `mul_wide`; quotients of
// two limbs by one use `u128` division. The constant cache that crmath
// keeps in a lent `Slice[u32]` stays in 32-bit limbs (`big_from_limbs`,
// `big_limbs`, `big_store`).
use self::util::{dec, g32, g64, inc, shl_u64, shr_u64};

pub struct Big {
    neg: bool,
    mag: ChunkSeq[u64],
}

// The value bits of a 32-bit cache limb, and the largest divisor or
// multiplier the `_small` forms take.
const LIMB32_MASK: u64 = 0xffffffff;

// Unsigned `a / b` and `a % b` for a nonzero `b` (callers check).
pub fn div64(a: u64, b: u64) -> u64 {
    if b == 0 {
        return 0;
    }
    handle Fail[RuntimeError] in {
        a / b
    } with {
        return v => v,
        raise(e, k) => 0,
    }
}

pub fn rem64(a: u64, b: u64) -> u64 {
    if b == 0 {
        return 0;
    }
    handle Fail[RuntimeError] in {
        a % b
    } with {
        return v => v,
        raise(e, k) => 0,
    }
}

// `(hi * 2^64 + lo) / d` for `hi < d` (so the quotient fits in a limb).
fn div128(hi: u64, lo: u64, d: u64) -> u64 {
    if d == 0 {
        return 0;
    }
    let n = wrapping_shl_u128(widen_u128(hi), 64) | widen_u128(lo);
    handle Fail[RuntimeError] in {
        wrapping_u64(n / widen_u128(d))
    } with {
        return v => v,
        raise(e, k) => 0,
    }
}

// ----- magnitudes -----------------------------------------------------------

// Number of limbs of `a` below its highest nonzero one.
fn nat_len(in a: Slice[u64]) -> u64 {
    let mut n = a.len();
    loop {
        if n == 0 || g64(in a, dec(n)) != 0 {
            break;
        }
        n = dec(n);
    }
    n
}

fn trim(inout a: ChunkSeq[u64]) {
    let n = nat_len(in a.as_slice());
    a.truncate(n);
}

fn nat_from_u64(x: u64) -> ChunkSeq[u64] {
    let mut r: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](1);
    if x != 0 {
        r.push(x);
    }
    r
}

fn nat_copy(in a: Slice[u64]) -> ChunkSeq[u64] {
    let n = nat_len(in a);
    let mut r: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    r.extend(in a[0..n]);
    r
}

// -1, 0 or 1 as `a` is less than, equal to or greater than `b`.
fn nat_cmp(in a: Slice[u64], in b: Slice[u64]) -> i64 {
    let na = nat_len(in a);
    let nb = nat_len(in b);
    if na != nb {
        return if na < nb {
            -1
        } else {
            1
        };
    }
    let mut i = na;
    loop {
        if i == 0 {
            break;
        }
        i = dec(i);
        let x = g64(in a, i);
        let y = g64(in b, i);
        if x != y {
            return if x < y {
                -1
            } else {
                1
            };
        }
    }
    0
}

pub fn nat_bits(in a: Slice[u64]) -> u64 {
    let n = nat_len(in a);
    if n == 0 {
        return 0;
    }
    let top = g64(in a, dec(n));
    wrapping_sub(wrapping_mul(n, 64), widen_u64(leading_zeros_u64(top)))
}

// `x + y + c` for a carry `c` of 0 or 1: the sum limb and the carry out.
fn add_carry(x: u64, y: u64, c: u64) -> (u64, u64) {
    let s = wrapping_add(x, y);
    let s2 = wrapping_add(s, c);
    let out: u64 = if s < x || s2 < s {
        1
    } else {
        0
    };
    (s2, out)
}

// `x - y - b` for a borrow `b` of 0 or 1: the difference limb and the
// borrow out.
fn sub_borrow(x: u64, y: u64, b: u64) -> (u64, u64) {
    let d = wrapping_sub(x, y);
    let d2 = wrapping_sub(d, b);
    let out: u64 = if x < y || d < b {
        1
    } else {
        0
    };
    (d2, out)
}

fn nat_add(in a: Slice[u64], in b: Slice[u64]) -> ChunkSeq[u64] {
    let na = nat_len(in a);
    let nb = nat_len(in b);
    let n = if na > nb {
        na
    } else {
        nb
    };
    let mut r: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](inc(n));
    let mut carry: u64 = 0;
    for i in 0..n {
        let (s, c) = add_carry(g64(in a, i), g64(in b, i), carry);
        r.push(s);
        carry = c;
    }
    if carry != 0 {
        r.push(carry);
    }
    r
}

// `a - b` for `a >= b`.
fn nat_sub(in a: Slice[u64], in b: Slice[u64]) -> ChunkSeq[u64] {
    let na = nat_len(in a);
    let mut r: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](na);
    let mut borrow: u64 = 0;
    for i in 0..na {
        let (d, b2) = sub_borrow(g64(in a, i), g64(in b, i), borrow);
        r.push(d);
        borrow = b2;
    }
    trim(inout r);
    r
}

fn nat_mul(in a: Slice[u64], in b: Slice[u64]) -> ChunkSeq[u64] {
    let na = nat_len(in a);
    let nb = nat_len(in b);
    let mut r: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](wrapping_add(na, nb));
    if na == 0 || nb == 0 {
        return r;
    }
    r.resize(wrapping_add(na, nb), 0);
    mul_into(inout r.as_slice_mut(), in a, na, in b, nb);
    trim(inout r);
    r
}

// Schoolbook product rows into the zeroed `r`.
fn mul_into(inout r: Slice[u64], in a: Slice[u64], na: u64, in b: Slice[u64], nb: u64) {
    for i in 0..na {
        let x = g64(in a, i);
        if x != 0 {
            let mut carry: u64 = 0;
            for j in 0..nb {
                let at = wrapping_add(i, j);
                // x * b[j] + r[at] + carry < 2^128: no carry out of `hi`.
                let p = wrapping_add(
                    wrapping_add(
                        wrapping_mul(widen_u128(x), widen_u128(g64(in b, j))),
                        widen_u128(g64(in r, at))
                    ),
                    widen_u128(carry)
                );
                r.try_set(at, wrapping_u64(p));
                carry = wrapping_u64(wrapping_shr_u128(p, 64));
            }
            r.try_set(wrapping_add(i, nb), carry);
        }
    }
}

fn nat_mul_small(in a: Slice[u64], m: u64) -> ChunkSeq[u64] {
    let na = nat_len(in a);
    let mut r: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](inc(na));
    if m == 0 {
        return r;
    }
    let mut carry: u64 = 0;
    for i in 0..na {
        let (lo, hi) = mul_wide(g64(in a, i), m);
        let (s, c) = add_carry(lo, carry, 0);
        r.push(s);
        carry = wrapping_add(hi, c);
    }
    if carry != 0 {
        r.push(carry);
    }
    r
}

fn nat_shl(in a: Slice[u64], k: u64) -> ChunkSeq[u64] {
    let na = nat_len(in a);
    let words = k >> 6;
    let bits = wrapping_u32(k & 63);
    let mut r: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](
        wrapping_add(wrapping_add(na, words), 1)
    );
    if na == 0 {
        return r;
    }
    r.resize(words, 0);
    if bits == 0 {
        r.extend(in a[0..na]);
        return r;
    }
    let back = wrapping_sub(64, bits);
    let mut carry: u64 = 0;
    for i in 0..na {
        let x = g64(in a, i);
        r.push(shl_u64(x, bits) | carry);
        carry = shr_u64(x, back);
    }
    if carry != 0 {
        r.push(carry);
    }
    r
}

// `floor(a / 2^k)`.
fn nat_shr(in a: Slice[u64], k: u64) -> ChunkSeq[u64] {
    let na = nat_len(in a);
    let words = k >> 6;
    let bits = wrapping_u32(k & 63);
    if words >= na {
        return ChunkSeq::new[u64]();
    }
    let n = wrapping_sub(na, words);
    let mut r: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](n);
    if bits == 0 {
        r.extend(in a[words..na]);
        return r;
    }
    let back = wrapping_sub(64, bits);
    for i in 0..n {
        let lo = shr_u64(g64(in a, wrapping_add(words, i)), bits);
        let hi = shl_u64(g64(in a, wrapping_add(words, inc(i))), back);
        r.push(lo | hi);
    }
    trim(inout r);
    r
}

// Whether any of the low `k` bits of `a` is set.
fn nat_low_bits_set(in a: Slice[u64], k: u64) -> bool {
    let na = nat_len(in a);
    let words = k >> 6;
    let bits = wrapping_u32(k & 63);
    for i in 0..words {
        if i >= na {
            return false;
        }
        if g64(in a, i) != 0 {
            return true;
        }
    }
    if bits == 0 || words >= na {
        return false;
    }
    let mask = wrapping_sub(shl_u64(1, bits), 1);
    (g64(in a, words) & mask) != 0
}

// `a / d` (truncated) for `0 < d < 2^32`: two 64-by-32-bit steps per limb.
fn nat_div_small(in a: Slice[u64], d: u64) -> ChunkSeq[u64] {
    let na = nat_len(in a);
    let mut r: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](na);
    r.resize(na, 0);
    let mut acc: u64 = 0;
    let mut i = na;
    loop {
        if i == 0 {
            break;
        }
        i = dec(i);
        let limb = g64(in a, i);
        let cur_hi = (acc << 32) | (limb >> 32);
        let q_hi = div64(cur_hi, d);
        acc = wrapping_sub(cur_hi, wrapping_mul(q_hi, d));
        let cur_lo = (acc << 32) | (limb & LIMB32_MASK);
        let q_lo = div64(cur_lo, d);
        acc = wrapping_sub(cur_lo, wrapping_mul(q_lo, d));
        r.try_set(i, (q_hi << 32) | q_lo);
    }
    trim(inout r);
    r
}

// Whether the two-limb `(h1, h0)` exceeds `(l1, l0)`.
fn gt2(h1: u64, h0: u64, l1: u64, l0: u64) -> bool {
    h1 > l1 || (h1 == l1 && h0 > l0)
}

// Knuth's algorithm D: `a / b` truncated, for nonzero `b`.
fn nat_div(in a: Slice[u64], in b: Slice[u64]) -> ChunkSeq[u64] {
    let nb = nat_len(in b);
    if nb == 0 || nat_cmp(in a, in b) < 0 {
        return ChunkSeq::new[u64]();
    }
    let na = nat_len(in a);
    if nb == 1 {
        let d = g64(in b, 0);
        if d <= LIMB32_MASK {
            return nat_div_small(in a, d);
        }
    }
    let s = widen_u64(leading_zeros_u64(g64(in b, dec(nb))));
    let v = nat_shl(in b, s);
    let mut un = nat_shl(in a, s);
    un.resize(inc(na), 0);
    let m = wrapping_sub(na, nb);
    let mut q: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](inc(m));
    q.resize(inc(m), 0);
    div_rows(inout un.as_slice_mut(), in v.as_slice(), nb, inout q.as_slice_mut(), m);
    trim(inout q);
    q
}

// The quotient rows of `nat_div`: `un` is the shifted dividend (one limb
// longer), `v` the normalized divisor of `nb` limbs.
fn div_rows(inout un: Slice[u64], in v: Slice[u64], nb: u64, inout q: Slice[u64], m: u64) {
    let vtop = g64(in v, dec(nb));
    // With one limb (nb == 1) the second divisor limb is zero.
    let vnext = if nb >= 2 {
        g64(in v, wrapping_sub(nb, 2))
    } else {
        0
    };
    let mut j = inc(m);
    loop {
        if j == 0 {
            break;
        }
        j = dec(j);
        let u2 = g64(in un, wrapping_add(j, nb));
        let u1 = g64(in un, wrapping_add(j, dec(nb)));
        let u0 = if nb >= 2 {
            g64(in un, wrapping_add(j, wrapping_sub(nb, 2)))
        } else {
            0
        };
        // qhat = min((u2, u1) / vtop, 2^64 - 1), rhat the remainder.
        let mut qhat: u64 = 0;
        let mut rhat: u64 = 0;
        let mut rhat_big = false;
        if u2 >= vtop {
            qhat = 0xffffffffffffffff;
            // rhat = (u2, u1) - qhat * vtop = u1 + vtop when u2 == vtop.
            let (r0, c) = add_carry(u1, vtop, 0);
            rhat = r0;
            rhat_big = c != 0;
        } else {
            qhat = div128(u2, u1, vtop);
            let (plo, _phi) = mul_wide(qhat, vtop);
            rhat = wrapping_sub(u1, plo);
        }
        loop {
            if rhat_big {
                break;
            }
            let (t0, t1) = mul_wide(qhat, vnext);
            if !gt2(t1, t0, rhat, u0) {
                break;
            }
            qhat = dec(qhat);
            let (r0, c) = add_carry(rhat, vtop, 0);
            rhat = r0;
            if c != 0 {
                rhat_big = true;
            }
        }
        // un[j..j+nb+1] -= qhat * v.
        let mut carry: u64 = 0;
        let mut borrow: u64 = 0;
        for i in 0..nb {
            let (plo, phi) = mul_wide(qhat, g64(in v, i));
            let (p, c) = add_carry(plo, carry, 0);
            carry = wrapping_add(phi, c);
            let at = wrapping_add(i, j);
            let (t, b2) = sub_borrow(g64(in un, at), p, borrow);
            un.try_set(at, t);
            borrow = b2;
        }
        let at = wrapping_add(j, nb);
        let (t, b1) = sub_borrow(g64(in un, at), carry, borrow);
        un.try_set(at, t);
        if b1 != 0 {
            // Added back: qhat was one too large.
            qhat = dec(qhat);
            let mut c: u64 = 0;
            for i in 0..nb {
                let at2 = wrapping_add(i, j);
                let (s2, c2) = add_carry(g64(in un, at2), g64(in v, i), c);
                un.try_set(at2, s2);
                c = c2;
            }
            un.try_set(at, wrapping_add(g64(in un, at), c));
        }
        q.try_set(j, qhat);
    }
}

// `floor(sqrt(a))` by Newton's iteration from above.
fn nat_sqrt(in a: Slice[u64]) -> ChunkSeq[u64] {
    let bits = nat_bits(in a);
    if bits == 0 {
        return ChunkSeq::new[u64]();
    }
    let one = nat_from_u64(1);
    let mut x = nat_shl(in one.as_slice(), inc(bits) >> 1);
    loop {
        let d = nat_div(in a, in x.as_slice());
        let s = nat_add(in x.as_slice(), in d.as_slice());
        let y = nat_shr(in s.as_slice(), 1);
        if nat_cmp(in y.as_slice(), in x.as_slice()) >= 0 {
            break;
        }
        x = y;
    }
    x
}

// ----- signed values ---------------------------------------------------------

fn make(neg: bool, sink mag: ChunkSeq[u64]) -> Big {
    let z = nat_len(in mag.as_slice()) == 0;
    Big { neg: neg && !z, mag: mag }
}

pub fn big_zero() -> Big {
    make(false, ChunkSeq::new[u64]())
}

pub fn big_u64(x: u64) -> Big {
    make(false, nat_from_u64(x))
}

pub fn big_i64(x: i64) -> Big {
    if x < 0 {
        make(true, nat_from_u64(wrapping_sub(0, wrapping_u64(x))))
    } else {
        make(false, nat_from_u64(wrapping_u64(x)))
    }
}

pub fn big_copy(in a: Big) -> Big {
    make(a.neg, nat_copy(in a.mag.as_slice()))
}

pub fn big_is_zero(in a: Big) -> bool {
    nat_len(in a.mag.as_slice()) == 0
}

pub fn big_is_neg(in a: Big) -> bool {
    a.neg
}

pub fn big_bits(in a: Big) -> u64 {
    nat_bits(in a.mag.as_slice())
}

// The low 64 bits of the magnitude.
pub fn big_low_u64(in a: Big) -> u64 {
    g64(in a.mag.as_slice(), 0)
}

pub fn big_bit0(in a: Big) -> bool {
    (g64(in a.mag.as_slice(), 0) & 1) == 1
}

pub fn big_neg(in a: Big) -> Big {
    make(!a.neg, nat_copy(in a.mag.as_slice()))
}

pub fn big_abs(in a: Big) -> Big {
    make(false, nat_copy(in a.mag.as_slice()))
}

pub fn big_cmp(in a: Big, in b: Big) -> i64 {
    if a.neg != b.neg {
        return if a.neg {
            -1
        } else {
            1
        };
    }
    let c = nat_cmp(in a.mag.as_slice(), in b.mag.as_slice());
    if a.neg {
        wrapping_sub(0, c)
    } else {
        c
    }
}

fn signed_add(an: bool, in a: Slice[u64], bn: bool, in b: Slice[u64]) -> Big {
    if an == bn {
        return make(an, nat_add(in a, in b));
    }
    let c = nat_cmp(in a, in b);
    if c >= 0 {
        make(an, nat_sub(in a, in b))
    } else {
        make(bn, nat_sub(in b, in a))
    }
}

pub fn big_add(in a: Big, in b: Big) -> Big {
    signed_add(a.neg, in a.mag.as_slice(), b.neg, in b.mag.as_slice())
}

pub fn big_sub(in a: Big, in b: Big) -> Big {
    signed_add(a.neg, in a.mag.as_slice(), !b.neg, in b.mag.as_slice())
}

pub fn big_add_u64(in a: Big, x: u64) -> Big {
    let b = nat_from_u64(x);
    signed_add(a.neg, in a.mag.as_slice(), false, in b.as_slice())
}

pub fn big_mul(in a: Big, in b: Big) -> Big {
    make(a.neg != b.neg, nat_mul(in a.mag.as_slice(), in b.mag.as_slice()))
}

// `a * m` for `m < 2^32` (any `u64` works).
pub fn big_mul_small(in a: Big, m: u64) -> Big {
    make(a.neg, nat_mul_small(in a.mag.as_slice(), m))
}

// `a * x` for any i64 `x`.
pub fn big_mul_i64(in a: Big, x: i64) -> Big {
    let m = if x < 0 {
        wrapping_sub(0, wrapping_u64(x))
    } else {
        wrapping_u64(x)
    };
    make(a.neg != (x < 0), nat_mul_small(in a.mag.as_slice(), m))
}

pub fn big_shl(in a: Big, k: u64) -> Big {
    make(a.neg, nat_shl(in a.mag.as_slice(), k))
}

// `floor(a / 2^k)` (toward negative infinity, as `num-bigint`'s `>>`).
pub fn big_shr(in a: Big, k: u64) -> Big {
    let q = nat_shr(in a.mag.as_slice(), k);
    if a.neg && nat_low_bits_set(in a.mag.as_slice(), k) {
        let one = nat_from_u64(1);
        return make(true, nat_add(in q.as_slice(), in one.as_slice()));
    }
    make(a.neg, q)
}

// `a / b` truncated toward zero, for nonzero `b`.
pub fn big_div(in a: Big, in b: Big) -> Big {
    make(a.neg != b.neg, nat_div(in a.mag.as_slice(), in b.mag.as_slice()))
}

// `a / d` truncated toward zero, for `0 < d < 2^32`.
pub fn big_div_small(in a: Big, d: u64) -> Big {
    make(a.neg, nat_div_small(in a.mag.as_slice(), d))
}

// `a / d` truncated toward zero, for any nonzero `d < 2^64`.
pub fn big_div_u64(in a: Big, d: u64) -> Big {
    if d <= LIMB32_MASK {
        return big_div_small(in a, d);
    }
    let b = big_u64(d);
    big_div(in a, in b)
}

// `a mod 4` of a nonnegative `a`.
pub fn big_mod4(in a: Big) -> u64 {
    g64(in a.mag.as_slice(), 0) & 3
}

// `floor(sqrt(a))` of a nonnegative `a`.
pub fn big_sqrt(in a: Big) -> Big {
    make(false, nat_sqrt(in a.mag.as_slice()))
}

// The value of the 32-bit limbs `s[at..at + n]` (nonnegative).
pub fn big_from_limbs(in s: Slice[u32], at: u64, n: u64) -> Big {
    let words = inc(n) >> 1;
    let mut r: ChunkSeq[u64] = ChunkSeq::with_capacity[u64](words);
    for w in 0..words {
        let i = wrapping_add(at, wrapping_mul(w, 2));
        let lo = widen_u64(g32(in s, i));
        let hi = if inc(wrapping_mul(w, 2)) < n {
            widen_u64(g32(in s, inc(i)))
        } else {
            0
        };
        r.push(lo | (hi << 32));
    }
    make(false, r)
}

// The number of 32-bit limbs of a nonnegative `a`.
pub fn big_limbs(in a: Big) -> u64 {
    wrapping_add(nat_bits(in a.mag.as_slice()), 31) >> 5
}

// Store the 32-bit limbs of a nonnegative `a` at `s[at..]`.
pub fn big_store(in a: Big, inout s: Slice[u32], at: u64) {
    let n = big_limbs(in a);
    for i in 0..n {
        let limb = g64(in a.mag.as_slice(), i >> 1);
        let half = if (i & 1) == 0 {
            limb & LIMB32_MASK
        } else {
            limb >> 32
        };
        s.try_set(wrapping_add(at, i), wrapping_u32(half));
    }
}

// ----- in place ----------------------------------------------------------------
// The forms crmath's series loops use, so a term or a sum keeps its limbs
// instead of allocating a new magnitude per operation.

// `a = floor(a / 2^k)` of a magnitude.
fn nat_shr_assign(inout a: ChunkSeq[u64], k: u64) {
    let na = nat_len(in a.as_slice());
    let words = k >> 6;
    if words >= na {
        a.truncate(0);
        return;
    }
    let n = wrapping_sub(na, words);
    shr_rows(inout a.as_slice_mut(), words, wrapping_u32(k & 63), n);
    a.truncate(n);
    trim(inout a);
}

// `a[i] = bits of a from limb i + words, shifted by bits`, for i < n,
// reading only at or above the limb it writes.
fn shr_rows(inout a: Slice[u64], words: u64, bits: u32, n: u64) {
    if bits == 0 {
        for i in 0..n {
            a.try_set(i, g64(in a, wrapping_add(words, i)));
        }
        return;
    }
    let back = wrapping_sub(64, bits);
    for i in 0..n {
        let lo = shr_u64(g64(in a, wrapping_add(words, i)), bits);
        let hi = shl_u64(g64(in a, wrapping_add(words, inc(i))), back);
        a.try_set(i, lo | hi);
    }
}

// `a = a / d` (truncated) for `0 < d < 2^32`.
fn nat_div_small_assign(inout a: ChunkSeq[u64], d: u64) {
    let na = nat_len(in a.as_slice());
    div_small_rows(inout a.as_slice_mut(), na, d);
    trim(inout a);
}

fn div_small_rows(inout a: Slice[u64], na: u64, d: u64) {
    let mut acc: u64 = 0;
    let mut i = na;
    loop {
        if i == 0 {
            break;
        }
        i = dec(i);
        let limb = g64(in a, i);
        let cur_hi = (acc << 32) | (limb >> 32);
        let q_hi = div64(cur_hi, d);
        acc = wrapping_sub(cur_hi, wrapping_mul(q_hi, d));
        let cur_lo = (acc << 32) | (limb & LIMB32_MASK);
        let q_lo = div64(cur_lo, d);
        acc = wrapping_sub(cur_lo, wrapping_mul(q_lo, d));
        a.try_set(i, (q_hi << 32) | q_lo);
    }
}

// `a = a + b` of magnitudes.
fn nat_add_assign(inout a: ChunkSeq[u64], in b: Slice[u64]) {
    trim(inout a);
    let na = a.len();
    let nb = nat_len(in b);
    let n = if na > nb {
        na
    } else {
        nb
    };
    a.resize(inc(n), 0);
    add_rows(inout a.as_slice_mut(), in b, n);
    trim(inout a);
}

fn add_rows(inout a: Slice[u64], in b: Slice[u64], n: u64) {
    let mut carry: u64 = 0;
    for i in 0..n {
        let (s, c) = add_carry(g64(in a, i), g64(in b, i), carry);
        a.try_set(i, s);
        carry = c;
    }
    a.try_set(n, carry);
}

// `a = a - b` of magnitudes, `a >= b`.
fn nat_sub_assign(inout a: ChunkSeq[u64], in b: Slice[u64]) {
    let na = nat_len(in a.as_slice());
    sub_rows(inout a.as_slice_mut(), in b, na, false);
    trim(inout a);
}

// `a = b - a` of magnitudes, `b > a`.
fn nat_rsub_assign(inout a: ChunkSeq[u64], in b: Slice[u64]) {
    trim(inout a);
    let nb = nat_len(in b);
    a.resize(nb, 0);
    sub_rows(inout a.as_slice_mut(), in b, nb, true);
    trim(inout a);
}

// `a[i] = a[i] - b[i]` (or `b[i] - a[i]` when `reverse`) with borrow, for
// i < n; the result is nonnegative, so no borrow leaves limb n - 1.
fn sub_rows(inout a: Slice[u64], in b: Slice[u64], n: u64, reverse: bool) {
    let mut borrow: u64 = 0;
    for i in 0..n {
        let x = g64(in a, i);
        let y = g64(in b, i);
        let (d, b2) = if reverse {
            sub_borrow(y, x, borrow)
        } else {
            sub_borrow(x, y, borrow)
        };
        a.try_set(i, d);
        borrow = b2;
    }
}

fn settle_sign(inout a: Big) {
    if nat_len(in a.mag.as_slice()) == 0 {
        a.neg = false;
    }
}

fn signed_add_assign(inout a: Big, bn: bool, in b: Slice[u64]) {
    if a.neg == bn {
        nat_add_assign(inout a.mag, in b);
    } else if nat_cmp(in a.mag.as_slice(), in b) >= 0 {
        nat_sub_assign(inout a.mag, in b);
    } else {
        nat_rsub_assign(inout a.mag, in b);
        a.neg = bn;
    }
    settle_sign(inout a);
}

// `a = a + b`.
pub fn big_add_assign(inout a: Big, in b: Big) {
    signed_add_assign(inout a, b.neg, in b.mag.as_slice());
}

// `a = a - b`.
pub fn big_sub_assign(inout a: Big, in b: Big) {
    signed_add_assign(inout a, !b.neg, in b.mag.as_slice());
}

// `a = -a`.
pub fn big_neg_assign(inout a: Big) {
    a.neg = !a.neg;
    settle_sign(inout a);
}

// `a = a / 2^k` truncated toward zero (the magnitude shifted, the sign
// kept): `mul_fix`'s rounding, not `big_shr`'s floor.
pub fn big_shr_trunc_assign(inout a: Big, k: u64) {
    nat_shr_assign(inout a.mag, k);
    settle_sign(inout a);
}

// `a = a / d` truncated toward zero, for any nonzero `d < 2^64`.
pub fn big_div_u64_assign(inout a: Big, d: u64) {
    if d <= LIMB32_MASK {
        nat_div_small_assign(inout a.mag, d);
        settle_sign(inout a);
        return;
    }
    let b = big_u64(d);
    a = big_div(in a, in b);
}
