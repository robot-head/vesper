// Module fastmath of @vesper/kinetic (see lib.ves): the fdlibm `exp`,
// `log`, `sin`, `cos` and `atan2` of src/fastmath.rs, every operation one
// correctly rounded binary64 operation in the Rust order (Vesper never
// contracts to a fused multiply-add). Constants are written as their bit
// patterns (`from_bits_f64`), the values src/fastmath.rs spells in decimal.
// `sin` and `cos` take finite arguments below the fast reduction's limit
// or non-finite ones (`needs_crmath` is false); lib.ves sends the rest to
// the correctly rounded module crmath.

fn high(x: f64) -> u32 {
    wrapping_u32((to_bits_f64(x) >> 32))
}

fn with_high(x: f64, hi: u32) -> f64 {
    from_bits_f64((widen_u64(hi) << 32) | (to_bits_f64(x) & 0xffffffff))
}

// 2^k for -1022 <= k <= 1023.
fn pow2(k: i32) -> f64 {
    from_bits_f64((wrapping_u64(wrapping_add(k, 1023)) << 52))
}

// Round to nearest, ties to even, for |x| < 2^51.
fn rint(x: f64) -> f64 {
    let shift = from_bits_f64(0x4338000000000000);
    (x + shift) - shift
}

fn is_nan(x: f64) -> bool {
    x != x
}

fn is_finite(x: f64) -> bool {
    (to_bits_f64(x) & 0x7ff0000000000000) != 0x7ff0000000000000
}

fn fabs(x: f64) -> f64 {
    from_bits_f64(to_bits_f64(x) & 0x7fffffffffffffff)
}

fn infinity() -> f64 {
    from_bits_f64(0x7ff0000000000000)
}

fn ln2_hi() -> f64 {
    from_bits_f64(0x3fe62e42fee00000)
}

fn ln2_lo() -> f64 {
    from_bits_f64(0x3dea39ef35793c76)
}

pub fn exp(x: f64) -> f64 {
    if is_nan(x) {
        return x + x;
    }
    if x > from_bits_f64(0x40862e42fefa39ef) {
        return infinity();
    }
    if x < from_bits_f64(0xc0874910d52d3051) {
        return 0.0;
    }
    let ax = fabs(x);
    if ax < from_bits_f64(0x3e30000000000000) {
        return 1.0 + x;
    }
    let mut hi = x;
    let mut lo = 0.0;
    let mut k: i32 = 0;
    if !(ax <= 0.5 * ln2_hi()) {
        let kf = rint(x * from_bits_f64(0x3ff71547652b82fe));
        hi = x - kf * ln2_hi();
        lo = kf * ln2_lo();
        k = saturating_i32(kf);
    }
    let r = hi - lo;
    let t = r * r;
    let c = r
        - t
        * (
        from_bits_f64(0x3fc555555555553e)
            + t
            * (
            from_bits_f64(0xbf66c16c16bebd93)
                + t
                * (
                from_bits_f64(0x3f11566aaf25de2c)
                    + t
                    * (from_bits_f64(0xbebbbd41c5d26bf1) + t * from_bits_f64(0x3e66376972bea4d0))
            )
        )
    );
    let y = 1.0 - ((lo - (r * c) / (2.0 - c)) - hi);
    if k == 0 {
        y
    } else if k >= -1021 {
        if k == 1024 {
            y * 2.0 * pow2(1023)
        } else {
            y * pow2(k)
        }
    } else {
        y * pow2(wrapping_add(k, 1000)) * pow2(-1000)
    }
}

pub fn log(x0: f64) -> f64 {
    if is_nan(x0) {
        return x0 + x0;
    }
    if x0 == 0.0 {
        return from_bits_f64(0xfff0000000000000);
    }
    if x0 < 0.0 {
        return from_bits_f64(0x7ff8000000000000);
    }
    if x0 == infinity() {
        return x0;
    }
    let mut x = x0;
    let mut k: i32 = 0;
    let mut hx = wrapping_i32(high(x));
    if hx < 0x00100000 {
        k = wrapping_sub(k, 54);
        x = x * from_bits_f64(0x4350000000000000);
        hx = wrapping_i32(high(x));
    }
    k = wrapping_add(k, wrapping_sub((hx >> 20), 1023));
    hx = hx & 0x000fffff;
    let i = wrapping_add(hx, 0x95f64) & 0x100000;
    x = with_high(x, wrapping_u32(hx | (i ^ 0x3ff00000)));
    k = wrapping_add(k, (i >> 20));
    let f = x - 1.0;
    let dk = widen_f64(k);
    if (0x000fffff & wrapping_add(2, hx)) < 3 {
        if f == 0.0 {
            if k == 0 {
                return 0.0;
            }
            return dk * ln2_hi() + dk * ln2_lo();
        }
        let r = f * f * (0.5 - from_bits_f64(0x3fd5555555555555) * f);
        if k == 0 {
            return f - r;
        }
        return dk * ln2_hi() - ((r - dk * ln2_lo()) - f);
    }
    let s = f / (2.0 + f);
    let z = s * s;
    let mut ii = wrapping_sub(hx, 0x6147a);
    let w = z * z;
    let j = wrapping_sub(0x6b851, hx);
    let t1 = w
        * (
        from_bits_f64(0x3fd999999997fa04)
            + w
            * (from_bits_f64(0x3fcc71c51d8e78af) + w * from_bits_f64(0x3fc39a09d078c69f))
    );
    let t2 = z
        * (
        from_bits_f64(0x3fe5555555555593)
            + w
            * (
            from_bits_f64(0x3fd2492494229359)
                + w
                * (from_bits_f64(0x3fc7466496cb03de) + w * from_bits_f64(0x3fc2f112df3e5244))
        )
    );
    ii = ii | j;
    let r = t2 + t1;
    if ii > 0 {
        let hfsq = 0.5 * f * f;
        if k == 0 {
            f - (hfsq - s * (hfsq + r))
        } else {
            dk * ln2_hi() - ((hfsq - (s * (hfsq + r) + dk * ln2_lo())) - f)
        }
    } else if k == 0 {
        f - s * (f - r)
    } else {
        dk * ln2_hi() - ((s * (f - r) - dk * ln2_lo()) - f)
    }
}

fn k_sin(x: f64, y: f64, has_tail: bool) -> f64 {
    let z = x * x;
    let w = z * z;
    let r = from_bits_f64(0x3f8111111110f8a6)
        + z
        * (from_bits_f64(0xbf2a01a019c161d5) + z * from_bits_f64(0x3ec71de357b1fe7d))
        + z
        * w
        * (from_bits_f64(0xbe5ae5e68a2b9ceb) + z * from_bits_f64(0x3de5d93a5acfd57c));
    let v = z * x;
    let s1 = from_bits_f64(0xbfc5555555555549);
    if !has_tail {
        x + v * (s1 + z * r)
    } else {
        x - ((z * (0.5 * y - v * r) - y) - v * s1)
    }
}

fn k_cos(x: f64, y: f64) -> f64 {
    let z = x * x;
    let w = z * z;
    let r = z
        * (
        from_bits_f64(0x3fa555555555554c)
            + z
            * (from_bits_f64(0xbf56c16c16c15177) + z * from_bits_f64(0x3efa01a019cb1590))
    )
        + w
        * w
        * (
        from_bits_f64(0xbe927e4f809c52ad)
            + z
            * (from_bits_f64(0x3e21ee9ebdb4b1c4) + z * from_bits_f64(0xbda8fae9be8838d4))
    );
    let hz = 0.5 * z;
    let w2 = 1.0 - hz;
    w2 + (((1.0 - w2) - hz) + (z * r - x * y))
}

fn exp_of(v: f64) -> i32 {
    wrapping_i32((high(v) >> 20) & 0x7ff)
}

copy struct Reduced {
    n: i32,
    y0: f64,
    y1: f64
}

fn rem_pio2_medium(x: f64) -> Reduced {
    let fnum = rint(x * from_bits_f64(0x3fe45f306dc9c883));
    let n = saturating_i32(fnum);
    let mut r = x - fnum * from_bits_f64(0x3ff921fb54400000);
    let mut w = fnum * from_bits_f64(0x3dd0b4611a626331);
    let j = exp_of(x);
    let mut y0 = r - w;
    if wrapping_sub(j, exp_of(y0)) > 16 {
        let t = r;
        w = fnum * from_bits_f64(0x3dd0b4611a600000);
        r = t - w;
        w = fnum * from_bits_f64(0x3ba3198a2e037073) - ((t - r) - w);
        y0 = r - w;
        if wrapping_sub(j, exp_of(y0)) > 49 {
            let t2 = r;
            w = fnum * from_bits_f64(0x3ba3198a2e000000);
            r = t2 - w;
            w = fnum * from_bits_f64(0x397b839a252049c1) - ((t2 - r) - w);
            y0 = r - w;
        }
    }
    let y1 = (r - y0) - w;
    Reduced {
        n: n,
        y0: y0,
        y1: y1
    }
}

pub fn sin(x: f64) -> f64 {
    if !is_finite(x) {
        return x - x;
    }
    let ax = fabs(x);
    if ax <= from_bits_f64(0x3fe921fb54442d18) {
        if ax < from_bits_f64(0x3e40000000000000) {
            return x;
        }
        return k_sin(x, 0.0, false);
    }
    let red = rem_pio2_medium(x);
    let q = red.n & 3;
    if q == 0 {
        k_sin(red.y0, red.y1, true)
    } else if q == 1 {
        k_cos(red.y0, red.y1)
    } else if q == 2 {
        -k_sin(red.y0, red.y1, true)
    } else {
        -k_cos(red.y0, red.y1)
    }
}

pub fn cos(x: f64) -> f64 {
    if !is_finite(x) {
        return x - x;
    }
    let ax = fabs(x);
    if ax <= from_bits_f64(0x3fe921fb54442d18) {
        if ax < from_bits_f64(0x3e40000000000000) {
            return 1.0;
        }
        return k_cos(x, 0.0);
    }
    let red = rem_pio2_medium(x);
    let q = red.n & 3;
    if q == 0 {
        k_cos(red.y0, red.y1)
    } else if q == 1 {
        -k_sin(red.y0, red.y1, true)
    } else if q == 2 {
        -k_cos(red.y0, red.y1)
    } else {
        k_sin(red.y0, red.y1, true)
    }
}

fn atan_hi(id: u64) -> f64 {
    if id == 0 {
        from_bits_f64(0x3fddac670561bb4f)
    } else if id == 1 {
        from_bits_f64(0x3fe921fb54442d18)
    } else if id == 2 {
        from_bits_f64(0x3fef730bd281f69b)
    } else {
        from_bits_f64(0x3ff921fb54442d18)
    }
}

fn atan_lo(id: u64) -> f64 {
    if id == 0 {
        from_bits_f64(0x3c7a2b7f222f65e2)
    } else if id == 1 {
        from_bits_f64(0x3c81a62633145c07)
    } else if id == 2 {
        from_bits_f64(0x3c7007887af0cbbd)
    } else {
        from_bits_f64(0x3c91a62633145c07)
    }
}

fn atan(x0: f64) -> f64 {
    let hx = high(x0);
    let ix = hx & 0x7fffffff;
    let negative = (hx >> 31) == 1;
    if ix >= 0x44100000 {
        if is_nan(x0) {
            return x0 + x0;
        }
        let z = atan_hi(3) + atan_lo(3);
        if negative {
            return -z;
        }
        return z;
    }
    // id 4 is fdlibm's "no reduction".
    let mut id: u64 = 4;
    let mut x = x0;
    if ix < 0x3fdc0000 {
        if ix < 0x3e400000 {
            return x0;
        }
    } else {
        let a = fabs(x0);
        if ix < 0x3ff30000 {
            if ix < 0x3fe60000 {
                id = 0;
                x = (2.0 * a - 1.0) / (2.0 + a);
            } else {
                id = 1;
                x = (a - 1.0) / (a + 1.0);
            }
        } else if ix < 0x40038000 {
            id = 2;
            x = (a - 1.5) / (1.0 + 1.5 * a);
        } else {
            id = 3;
            x = -1.0 / a;
        }
    }
    let z = x * x;
    let w = z * z;
    let s1 = z
        * (
        from_bits_f64(0x3fd555555555550d)
            + w
            * (
            from_bits_f64(0x3fc24924920083ff)
                + w
                * (
                from_bits_f64(0x3fb745cdc54c206e)
                    + w
                    * (
                    from_bits_f64(0x3fb10d66a0d03d51)
                        + w
                        * (
                        from_bits_f64(0x3fa97b4b24760deb) + w * from_bits_f64(0x3f90ad3ae322da11)
                    )
                )
            )
        )
    );
    let s2 = w
        * (
        from_bits_f64(0xbfc999999998ebc4)
            + w
            * (
            from_bits_f64(0xbfbc71c6fe231671)
                + w
                * (
                from_bits_f64(0xbfb3b0f2af749a6d)
                    + w
                    * (from_bits_f64(0xbfadde2d52defd9a) + w * from_bits_f64(0xbfa2b4442c6a6c2f))
            )
        )
    );
    if id == 4 {
        return x - x * (s1 + s2);
    }
    let z2 = atan_hi(id) - ((x * (s1 + s2) - atan_lo(id)) - x);
    if negative {
        -z2
    } else {
        z2
    }
}

// Whether `sin`/`cos` of `x` takes the correctly rounded path.
pub fn needs_crmath(x: f64) -> bool {
    is_finite(x) && fabs(x) >= from_bits_f64(0x413921fb00000000)
}

fn sign_negative(x: f64) -> bool {
    (to_bits_f64(x) >> 63) == 1
}

fn is_infinite(x: f64) -> bool {
    (to_bits_f64(x) & 0x7fffffffffffffff) == 0x7ff0000000000000
}

pub fn atan2(y: f64, x: f64) -> f64 {
    let pi_o_4 = from_bits_f64(0x3fe921fb54442d18);
    let pi_o_2 = from_bits_f64(0x3ff921fb54442d18);
    let pi = from_bits_f64(0x400921fb54442d18);
    let pi_lo = from_bits_f64(0x3ca1a62633145c07);
    if is_nan(x) || is_nan(y) {
        return x + y;
    }
    if x == 1.0 {
        return atan(y);
    }
    let y_neg = sign_negative(y);
    let x_neg = sign_negative(x);
    let mut m: u64 = 0;
    if y_neg {
        m = m | 1;
    }
    if x_neg {
        m = m | 2;
    }
    if y == 0.0 {
        if m <= 1 {
            return y;
        } else if m == 2 {
            return pi;
        }
        return -pi;
    }
    if x == 0.0 {
        if y_neg {
            return -pi_o_2;
        }
        return pi_o_2;
    }
    if is_infinite(x) {
        if is_infinite(y) {
            if m == 0 {
                return pi_o_4;
            } else if m == 1 {
                return -pi_o_4;
            } else if m == 2 {
                return 3.0 * pi_o_4;
            }
            return -3.0 * pi_o_4;
        }
        if m == 0 {
            return 0.0;
        } else if m == 1 {
            return -0.0;
        } else if m == 2 {
            return pi;
        }
        return -pi;
    }
    if is_infinite(y) {
        if y_neg {
            return -pi_o_2;
        }
        return pi_o_2;
    }
    let k = wrapping_shr_i32(
        wrapping_sub(wrapping_i32(high(y) & 0x7fffffff), wrapping_i32(high(x) & 0x7fffffff)),
        20
    );
    let mut z = 0.0;
    if k > 60 {
        z = pi_o_2 + 0.5 * pi_lo;
        m = m & 1;
    } else if x_neg && k < -60 {
        z = 0.0;
    } else {
        z = atan(fabs(y / x));
    }
    if m == 0 {
        z
    } else if m == 1 {
        -z
    } else if m == 2 {
        pi - (z - pi_lo)
    } else {
        (z - pi_lo) - pi
    }
}

pub fn expf(x: f32) -> f32 {
    nearest_f32(exp(widen_f64(x)))
}

pub fn logf(x: f32) -> f32 {
    nearest_f32(log(widen_f64(x)))
}

pub fn atan2f(y: f32, x: f32) -> f32 {
    nearest_f32(atan2(widen_f64(y), widen_f64(x)))
}
