// Module sap of @vesper/kinetic (see lib.ves): the sort-and-sweep
// broadphase of src/sap.rs. Boxes are six f32 bit patterns each, as in
// module lbvh. The Rust build runs each kernel over workgroups of 256 items
// in a GPU's shape; their outputs do not depend on the grouping, so here
// each kernel is one loop (the radix sort's per-group histograms become one
// histogram per pass, which scatters to the same positions).
use self::{
    SapError
};
use self::util::{
    box_valid,
    dec,
    g32,
    g64,
    gf,
    inc,
    shr_u64,
    u
};

// IEEE 754 binary32: the sign bit and +-infinity.
const F32_SIGN_BIT: u32 = 0x80000000;
const F32_INFINITY_BITS: u32 = 0x7f800000;
const F32_NEG_INFINITY_BITS: u32 = 0xff800000;
// LSD radix sort, a byte a pass; a pair key takes eight passes, or four
// once indices fit in 16 bits (at most 65,536 of them).
const RADIX_BITS: u64 = 8;
const RADIX_BUCKETS: u64 = 256;
const RADIX_MASK: u64 = 255;
const PAIR_PASSES: u64 = 8;
const SMALL_PAIR_PASSES: u64 = 4;
const SMALL_INDEX_COUNT: u64 = 0x10000;
const SMALL_INDEX_MASK: u64 = 0xffff;
// A saturated overlap count.
const U32_MAX: u32 = 0xffffffff;

fn raise_sap(e: SapError) -> u64 eff [Fail[SapError]] {
    Fail::raise(e);
    0
}

// Order-preserving map from f32 to u32 (src/sap.rs `sortable`).
pub fn sortable(bits: u32) -> u32 {
    if (bits >> 31) == 1 {
        ~bits
    } else {
        bits | F32_SIGN_BIT
    }
}

// One LSD radix pass over `sk[0..n]` -> `dk[0..n]` (and `sv` -> `dv`), using
// `hist[0..256]` without redundant histogram reloads or inner branches.
fn radix_pass_vals(
    in sk: Slice[u64],
    in sv: Slice[u32],
    inout dk: Slice[u64],
    inout dv: Slice[u32],
    n: u64,
    shift: u32,
    inout hist: Slice[u32]
) {
    for d in 0..u(RADIX_BUCKETS) {
        hist.try_set(d, 0);
    }
    for i in 0..n {
        let k = g64(in sk, i);
        let d = shr_u64(k, shift) & RADIX_MASK;
        hist.try_set(d, wrapping_add(g32(in hist, d), 1));
    }
    let mut run: u32 = 0;
    for d in 0..u(RADIX_BUCKETS) {
        let c = g32(in hist, d);
        hist.try_set(d, run);
        run = wrapping_add(run, c);
    }
    for i in 0..n {
        let k = g64(in sk, i);
        let d = shr_u64(k, shift) & RADIX_MASK;
        let cur = g32(in hist, d);
        let at = widen_u64(cur);
        hist.try_set(d, wrapping_add(cur, 1));
        dk.try_set(at, k);
        dv.try_set(at, g32(in sv, i));
    }
}

fn radix_pass_keys(
    in sk: Slice[u64],
    inout dk: Slice[u64],
    n: u64,
    shift: u32,
    inout hist: Slice[u32]
) {
    for d in 0..u(RADIX_BUCKETS) {
        hist.try_set(d, 0);
    }
    for i in 0..n {
        let k = g64(in sk, i);
        let d = shr_u64(k, shift) & RADIX_MASK;
        hist.try_set(d, wrapping_add(g32(in hist, d), 1));
    }
    let mut run: u32 = 0;
    for d in 0..u(RADIX_BUCKETS) {
        let c = g32(in hist, d);
        hist.try_set(d, run);
        run = wrapping_add(run, c);
    }
    for i in 0..n {
        let k = g64(in sk, i);
        let d = shr_u64(k, shift) & RADIX_MASK;
        let cur = g32(in hist, d);
        let at = widen_u64(cur);
        hist.try_set(d, wrapping_add(cur, 1));
        dk.try_set(at, k);
    }
}

// Stable LSD radix sort of `keys[0..n]` (with `vals` when `with_vals`) on
// the low `passes * 8` bits, through `tk`/`tv` and the 256-slot `hist`.
// Even pass counts leave the result in `keys`/`vals`.
pub fn radix_sort(
    inout keys: Slice[u64],
    inout vals: Slice[u32],
    with_vals: bool,
    n: u64,
    passes: u64,
    inout tk: Slice[u64],
    inout tv: Slice[u32],
    inout hist: Slice[u32]
) {
    let mut pass: u64 = 0;
    loop {
        if !(pass < passes) {
            break;
        }
        let shift0 = wrapping_u32(wrapping_mul(pass, RADIX_BITS));
        let shift1 = wrapping_u32(wrapping_mul(inc(pass), RADIX_BITS));
        if with_vals {
            radix_pass_vals(in keys, in vals, inout tk, inout tv, n, shift0, inout hist);
            radix_pass_vals(in tk, in tv, inout keys, inout vals, n, shift1, inout hist);
        } else {
            radix_pass_keys(in keys, inout tk, n, shift0, inout hist);
            radix_pass_keys(in tk, inout keys, n, shift1, inout hist);
        }
        pass = wrapping_add(pass, 2);
    }
}

// SweepAndPrune::build kernels 1-5 over `n` boxes (the wrapper checked the
// capacity): validate, choose the axis, compute keys, sort, gather the
// sorted bounds into `smin`/`smax` (three f32 lanes per box). Returns the
// sweep axis.
pub fn build(
    in boxes: Slice[u32],
    inout keys: Slice[u64],
    inout order: Slice[u32],
    inout smin: Slice[u32],
    inout smax: Slice[u32],
    inout tk: Slice[u64],
    inout tv: Slice[u32],
    inout hist: Slice[u32]
) -> u64 eff [Fail[SapError]] {
    let n = boxes.len() / 6;
    for i in 0..n {
        if !box_valid(in boxes, i) {
            return raise_sap(
                SapError::InvalidBox {
                    index: wrapping_usize(i)
                }
            );
        }
    }
    let inf = from_bits_f32(F32_INFINITY_BITS);
    let ninf = from_bits_f32(F32_NEG_INFINITY_BITS);
    let mut lo0 = inf;
    let mut lo1 = inf;
    let mut lo2 = inf;
    let mut hi0 = ninf;
    let mut hi1 = ninf;
    let mut hi2 = ninf;
    for i in 0..n {
        let b = wrapping_mul(i, 6);
        let c0 = (gf(in boxes, b) + gf(in boxes, wrapping_add(b, 3))) * 0.5;
        let c1 = (gf(in boxes, wrapping_add(b, 1)) + gf(in boxes, wrapping_add(b, 4))) * 0.5;
        let c2 = (gf(in boxes, wrapping_add(b, 2)) + gf(in boxes, wrapping_add(b, 5))) * 0.5;
        if c0 < lo0 {
            lo0 = c0;
        }
        if c0 > hi0 {
            hi0 = c0;
        }
        if c1 < lo1 {
            lo1 = c1;
        }
        if c1 > hi1 {
            hi1 = c1;
        }
        if c2 < lo2 {
            lo2 = c2;
        }
        if c2 > hi2 {
            hi2 = c2;
        }
    }
    let mut axis: u64 = 0;
    if n > 0 {
        let x0 = widen_f64(hi0) - widen_f64(lo0);
        let x1 = widen_f64(hi1) - widen_f64(lo1);
        let x2 = widen_f64(hi2) - widen_f64(lo2);
        let mut best = x0;
        if x1 > best {
            axis = 1;
            best = x1;
        }
        if x2 > best {
            axis = 2;
        }
    }
    for i in 0..n {
        keys.try_set(i, widen_u64(sortable(g32(in boxes, wrapping_add(wrapping_mul(i, 6), axis)))));
        order.try_set(i, wrapping_u32(i));
    }
    radix_sort(inout keys, inout order, true, n, 4, inout tk, inout tv, inout hist);
    for s in 0..n {
        let b = wrapping_mul(widen_u64(g32(in order, s)), 6);
        let at = wrapping_mul(s, 3);
        for a in 0..u(3) {
            smin.try_set(wrapping_add(at, a), g32(in boxes, wrapping_add(b, a)));
            smax.try_set(wrapping_add(at, a), g32(in boxes, wrapping_add(b, wrapping_add(a, 3))));
        }
    }
    axis
}

// SweepAndPrune::overlapping_pairs kernels 6 and 7: each sorted box's
// pair count, scanned in place to its output offset. Returns the total,
// which the wrapper checks against `max_pairs` and sizes `out` by.
pub fn pair_total(in smin: Slice[u32], in smax: Slice[u32], axis: u64, inout counts: Slice[u32])
    -> u64 {
    let n = counts.len();
    let mut total: u64 = 0;
    for s in 0..n {
        let mut c: u32 = 0;
        let mut t = inc(s);
        // Box `s`'s bounds, read once per row.
        let bs = wrapping_mul(s, 3);
        let min0 = gf(in smin, bs);
        let min1 = gf(in smin, wrapping_add(bs, 1));
        let min2 = gf(in smin, wrapping_add(bs, 2));
        let max0 = gf(in smax, bs);
        let max1 = gf(in smax, wrapping_add(bs, 1));
        let max2 = gf(in smax, wrapping_add(bs, 2));
        let up = gf(in smax, wrapping_add(bs, axis));
        let mut bt = wrapping_add(bs, 3);
        loop {
            if !(t < n && gf(in smin, wrapping_add(bt, axis)) <= up) {
                break;
            }
            if min0 <= gf(in smax, bt)
                && gf(in smin, bt) <= max0
                && min1 <= gf(in smax, wrapping_add(bt, 1))
                && gf(in smin, wrapping_add(bt, 1)) <= max1
                && min2 <= gf(in smax, wrapping_add(bt, 2))
                && gf(in smin, wrapping_add(bt, 2)) <= max2
                && c != U32_MAX {
                c = wrapping_add(c, 1);
            }
            t = inc(t);
            bt = wrapping_add(bt, 3);
        }
        counts.try_set(s, wrapping_u32(total));
        total = wrapping_add(total, widen_u64(c));
    }
    total
}

// Kernels 8 and 9: the pair keys `(a << 32) | b` at their offsets, sorted,
// into `out` (exactly the total long; `tk` as long, `tv` and `novals`
// empty).
pub fn write_pairs(
    in order: Slice[u32],
    in smin: Slice[u32],
    in smax: Slice[u32],
    axis: u64,
    in counts: Slice[u32],
    inout out: Slice[u64],
    inout tk: Slice[u64],
    inout novals: Slice[u32],
    inout tv: Slice[u32],
    inout hist: Slice[u32]
) {
    let n = counts.len();
    let total = out.len();
    for s in 0..n {
        let mut at = widen_u64(g32(in counts, s));
        let mut t = inc(s);
        let bs = wrapping_mul(s, 3);
        let min0 = gf(in smin, bs);
        let min1 = gf(in smin, wrapping_add(bs, 1));
        let min2 = gf(in smin, wrapping_add(bs, 2));
        let max0 = gf(in smax, bs);
        let max1 = gf(in smax, wrapping_add(bs, 1));
        let max2 = gf(in smax, wrapping_add(bs, 2));
        let up = gf(in smax, wrapping_add(bs, axis));
        let mut bt = wrapping_add(bs, 3);
        let a = widen_u64(g32(in order, s));
        loop {
            if !(t < n && gf(in smin, wrapping_add(bt, axis)) <= up) {
                break;
            }
            if min0 <= gf(in smax, bt)
                && gf(in smin, bt) <= max0
                && min1 <= gf(in smax, wrapping_add(bt, 1))
                && gf(in smin, wrapping_add(bt, 1)) <= max1
                && min2 <= gf(in smax, wrapping_add(bt, 2))
                && gf(in smin, wrapping_add(bt, 2)) <= max2 {
                let b = widen_u64(g32(in order, t));
                if a < b {
                    out.try_set(at, (a << 32) | b);
                } else {
                    out.try_set(at, (b << 32) | a);
                }
                at = inc(at);
            }
            t = inc(t);
            bt = wrapping_add(bt, 3);
        }
    }
    radix_sort_pairs(inout out, total, n, inout tk, inout novals, inout tv, inout hist);
}

// Sort packed `(a << 32) | b` pairs (`0..len`) for `n` items, compressing to
// 4 passes when indices fit in 16 bits (`n <= 65,536`).
pub fn radix_sort_pairs(
    inout keys: Slice[u64],
    len: u64,
    n: u64,
    inout tk: Slice[u64],
    inout novals: Slice[u32],
    inout tv: Slice[u32],
    inout hist: Slice[u32]
) {
    let mut passes: u64 = PAIR_PASSES;
    if n <= SMALL_INDEX_COUNT {
        // Indices fit in 16 bits: compress each key so four passes sort it.
        passes = SMALL_PAIR_PASSES;
        for i in 0..len {
            let k = g64(in keys, i);
            keys.try_set(i, ((k >> 32) << 16) | (k & SMALL_INDEX_MASK));
        }
    }
    radix_sort(inout keys, inout novals, false, len, passes, inout tk, inout tv, inout hist);
    if passes == SMALL_PAIR_PASSES {
        for i in 0..len {
            let k = g64(in keys, i);
            keys.try_set(i, ((k >> 16) << 32) | (k & SMALL_INDEX_MASK));
        }
    }
}
