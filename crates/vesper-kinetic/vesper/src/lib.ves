// @vesper/kinetic: Vesper port of vesper-kinetic (port wave P3b lane 8,
// #1070): Morton codes (src/morton.rs, the 63-bit codes of src/lbvh.rs),
// the fdlibm fast path (src/fastmath.rs), the correctly rounded
// src/crmath.rs (modules crmath and bignum), colouring and both broadphases.
//
// The export ABI has no f32, so an f32 crosses the boundary as its bit
// pattern (a `u32`), as in @vesper/tensor.
use self::morton::{
    compact as m_compact,
    compact21 as m_compact21,
    encode_masked as m_encode_masked,
    morton64 as m_morton64,
    spread as m_spread,
    spread21 as m_spread21
};
use self::coloring::{
    color_pairs as c_color_pairs,
    color_sets as c_color_sets
};
use self::lbvh::{
    build as l_build,
    pairs as l_pairs
};
use self::sap::{
    build as s_build,
    pair_total as s_pair_total,
    sortable as s_sortable,
    write_pairs as s_write_pairs
};
use self::crmath::{
    atan2_bits as c_atan2_bits,
    exp_bits as c_exp_bits,
    log_bits as c_log_bits,
    sin_cos_bits as c_sin_cos_bits
};
use self::gjk::{
    separation as g_separation
};
use self::fastmath::{
    atan2 as f_atan2,
    atan2f as f_atan2f,
    cos as f_cos,
    exp as f_exp,
    expf as f_expf,
    log as f_log,
    logf as f_logf,
    needs_crmath,
    sin as f_sin
};

// ---------------------------------------------------------------------------
// morton.rs

pub copy enum MortonError {
    AxisOutOfRange {
        axis: u8,
        value: u16
    },
    CodeOutOfRange(u32)
}

// A 30-bit Morton code: three 10-bit axes; a code with bit 30 or 31 set
// is out of range.
const AXIS_MAX: u16 = 1023;
const MORTON30_HIGH_BITS: u32 = 0xc0000000;

pub fn morton_spread(v: u32) -> u32 {
    m_spread(v)
}

pub fn morton_compact(v: u32) -> u32 {
    m_compact(v)
}

pub fn morton_encode_masked(x: u16, y: u16, z: u16) -> u32 {
    m_encode_masked(x, y, z)
}

pub fn morton_encode(x: u16, y: u16, z: u16) -> u32 eff [Fail[MortonError]] {
    if x > AXIS_MAX {
        Fail::raise(
            MortonError::AxisOutOfRange {
                axis: 0,
                value: x
            }
        );
    }
    if y > AXIS_MAX {
        Fail::raise(
            MortonError::AxisOutOfRange {
                axis: 1,
                value: y
            }
        );
    }
    if z > AXIS_MAX {
        Fail::raise(
            MortonError::AxisOutOfRange {
                axis: 2,
                value: z
            }
        );
    }
    m_encode_masked(x, y, z)
}

pub fn morton_decode_masked(code: u32) -> (u16, u16, u16) {
    (
        wrapping_u16(m_compact(code)),
        wrapping_u16(m_compact((code >> 1))),
        wrapping_u16(m_compact((code >> 2)))
    )
}

pub fn morton_decode(code: u32) -> (u16, u16, u16) eff [Fail[MortonError]] {
    if (code & MORTON30_HIGH_BITS) != 0 {
        Fail::raise(MortonError::CodeOutOfRange(code));
    }
    morton_decode_masked(code)
}

// lbvh.rs
pub fn lbvh_spread21(v: u32) -> u64 {
    m_spread21(v)
}

pub fn lbvh_compact21(code: u64) -> u32 {
    m_compact21(code)
}

pub fn lbvh_morton64(x: u32, y: u32, z: u32) -> u64 {
    m_morton64(x, y, z)
}

// ---------------------------------------------------------------------------
// fastmath.rs

pub fn fastmath_exp(x: f64) -> f64 {
    f_exp(x)
}

pub fn fastmath_log(x: f64) -> f64 {
    f_log(x)
}

pub fn fastmath_sin(x: f64) -> f64 {
    if needs_crmath(x) {
        let mut cache: ChunkSeq[u32] = ChunkSeq::new[u32]();
        return from_bits_f64(
            c_sin_cos_bits(inout cache.as_slice_mut(), to_bits_f64(x), true, false)
        );
    }
    f_sin(x)
}

pub fn fastmath_cos(x: f64) -> f64 {
    if needs_crmath(x) {
        let mut cache: ChunkSeq[u32] = ChunkSeq::new[u32]();
        return from_bits_f64(
            c_sin_cos_bits(inout cache.as_slice_mut(), to_bits_f64(x), true, true)
        );
    }
    f_cos(x)
}

pub fn fastmath_atan2(y: f64, x: f64) -> f64 {
    f_atan2(y, x)
}

pub fn fastmath_expf(x: u32) -> u32 {
    to_bits_f32(f_expf(from_bits_f32(x)))
}

pub fn fastmath_logf(x: u32) -> u32 {
    to_bits_f32(f_logf(from_bits_f32(x)))
}

pub fn fastmath_sinf(x: u32) -> u32 {
    to_bits_f32(nearest_f32(fastmath_sin(widen_f64(from_bits_f32(x)))))
}

pub fn fastmath_cosf(x: u32) -> u32 {
    to_bits_f32(nearest_f32(fastmath_cos(widen_f64(from_bits_f32(x)))))
}

pub fn fastmath_atan2f(y: u32, x: u32) -> u32 {
    to_bits_f32(f_atan2f(from_bits_f32(y), from_bits_f32(x)))
}

// ---------------------------------------------------------------------------
// crmath.rs: binary64 functions take and return f64; binary32 ones take and
// return f32 bit patterns (evaluated from the exact f64 widening). `cache`
// is the caller's pi / ln 2 cache (see crmath.ves `constant`); the fast
// path's fallback above passes an empty one, which is never filled.

pub fn crmath_sin(x: f64, inout cache: Slice[u32]) -> f64 {
    from_bits_f64(c_sin_cos_bits(inout cache, to_bits_f64(x), true, false))
}

pub fn crmath_cos(x: f64, inout cache: Slice[u32]) -> f64 {
    from_bits_f64(c_sin_cos_bits(inout cache, to_bits_f64(x), true, true))
}

pub fn crmath_exp(x: f64, inout cache: Slice[u32]) -> f64 {
    from_bits_f64(c_exp_bits(inout cache, to_bits_f64(x), true))
}

pub fn crmath_log(x: f64, inout cache: Slice[u32]) -> f64 {
    from_bits_f64(c_log_bits(inout cache, to_bits_f64(x), true))
}

pub fn crmath_atan2(y: f64, x: f64, inout cache: Slice[u32]) -> f64 {
    from_bits_f64(c_atan2_bits(inout cache, to_bits_f64(y), to_bits_f64(x), true))
}

fn wide_bits(x: u32) -> u64 {
    to_bits_f64(widen_f64(from_bits_f32(x)))
}

pub fn crmath_sinf(x: u32, inout cache: Slice[u32]) -> u32 {
    wrapping_u32(c_sin_cos_bits(inout cache, wide_bits(x), false, false))
}

pub fn crmath_cosf(x: u32, inout cache: Slice[u32]) -> u32 {
    wrapping_u32(c_sin_cos_bits(inout cache, wide_bits(x), false, true))
}

pub fn crmath_expf(x: u32, inout cache: Slice[u32]) -> u32 {
    wrapping_u32(c_exp_bits(inout cache, wide_bits(x), false))
}

pub fn crmath_logf(x: u32, inout cache: Slice[u32]) -> u32 {
    wrapping_u32(c_log_bits(inout cache, wide_bits(x), false))
}

pub fn crmath_atan2f(y: u32, x: u32, inout cache: Slice[u32]) -> u32 {
    wrapping_u32(c_atan2_bits(inout cache, wide_bits(y), wide_bits(x), false))
}

// ---------------------------------------------------------------------------
// coloring.rs

pub copy enum ColoringError {
    BodyOutOfRange {
        constraint: usize,
        body: u32
    },
    SelfConstraint {
        constraint: usize,
        body: u32
    },
    TooManyColors {
        constraint: usize
    },
    CapacityExceeded {
        constraints: usize,
        capacity: usize
    },
    BadArity {
        constraint: usize
    }
}

// Colorer::color; `b[i]` above u32::MAX is None, `masks` has one word per
// body, `keys`, `order`, `colors` and `sorted` one slot per constraint and
// `offsets` MAX_COLORS + 1. Returns the colour count.
pub fn colorer_color(
    in a: Slice[u32],
    in b: Slice[u64],
    capacity: u64,
    inout masks: Slice[u64],
    inout keys: Slice[u64],
    inout order: Slice[u32],
    inout colors: Slice[u8],
    inout offsets: Slice[u32],
    inout sorted: Slice[u32]
) -> u64 eff [Fail[ColoringError]] {
    c_color_pairs(
        in a,
        in b,
        capacity,
        inout masks,
        inout keys,
        inout order,
        inout colors,
        inout offsets,
        inout sorted
    )
}

// MultiColorer::color, with the same buffers.
pub fn multi_colorer_color(
    in bodies: Slice[u32],
    in offs: Slice[u32],
    capacity: u64,
    inout masks: Slice[u64],
    inout keys: Slice[u64],
    inout order: Slice[u32],
    inout colors: Slice[u8],
    inout offsets: Slice[u32],
    inout sorted: Slice[u32]
) -> u64 eff [Fail[ColoringError]] {
    c_color_sets(
        in bodies,
        in offs,
        capacity,
        inout masks,
        inout keys,
        inout order,
        inout colors,
        inout offsets,
        inout sorted
    )
}

// ---------------------------------------------------------------------------
// lbvh.rs and sap.rs. A box is six f32 bit patterns (min x, y, z, max x,
// y, z); a pair is `(a << 32) | b` with `a < b`.

pub copy enum LbvhError {
    InvalidBox {
        index: usize
    },
    CapacityExceeded {
        primitives: usize,
        capacity: usize
    },
    PairOverflow {
        capacity: usize
    }
}

pub copy enum SapError {
    InvalidBox {
        index: usize
    },
    CapacityExceeded {
        boxes: usize,
        capacity: usize
    },
    PairOverflow {
        capacity: usize
    }
}

// Lbvh::build (module lbvh): `codes`, `prims` n slots, `leaf` 6n, `left`,
// `right` n - 1, `node_box` 6(n - 1), `order` n and `stack` n + 1.
pub fn lbvh_build(
    in boxes: Slice[u32],
    inout codes: Slice[u64],
    inout prims: Slice[u32],
    inout leaf: Slice[u32],
    inout left: Slice[u64],
    inout right: Slice[u64],
    inout node_box: Slice[u32],
    inout order: Slice[u32],
    inout stack: Slice[u64]
) eff [Fail[LbvhError]] {
    l_build(
        in boxes,
        inout codes,
        inout prims,
        inout leaf,
        inout left,
        inout right,
        inout node_box,
        inout order,
        inout stack
    );
}

// Lbvh::overlapping_pairs (module lbvh): returns the pair count, or
// `max_pairs + 1` for too many pairs, or `out.len() + 1` (below
// `max_pairs`) to ask for a larger `out`.
pub fn lbvh_pairs(
    in codes: Slice[u64],
    in prims: Slice[u32],
    in leaf: Slice[u32],
    in left: Slice[u64],
    in right: Slice[u64],
    in node_box: Slice[u32],
    inout stack: Slice[u64],
    inout out: Slice[u64],
    max_pairs: u64
) -> u64 {
    l_pairs(
        in codes,
        in prims,
        in leaf,
        in left,
        in right,
        in node_box,
        inout stack,
        inout out,
        max_pairs
    )
}

// SweepAndPrune::build (module sap): `keys`, `order` n slots, `smin`,
// `smax` 3n, `tk`, `tv` n, `hist` 256. Returns the sweep axis.
pub fn sap_build(
    in boxes: Slice[u32],
    inout keys: Slice[u64],
    inout order: Slice[u32],
    inout smin: Slice[u32],
    inout smax: Slice[u32],
    inout tk: Slice[u64],
    inout tv: Slice[u32],
    inout hist: Slice[u32]
) -> u64 eff [Fail[SapError]] {
    s_build(
        in boxes,
        inout keys,
        inout order,
        inout smin,
        inout smax,
        inout tk,
        inout tv,
        inout hist
    )
}

pub fn sap_pair_total(in smin: Slice[u32], in smax: Slice[u32], axis: u64, inout counts: Slice[u32])
    -> u64 {
    s_pair_total(in smin, in smax, axis, inout counts)
}

pub fn sap_write_pairs(
    in order: Slice[u32],
    in smin: Slice[u32],
    in smax: Slice[u32],
    axis: u64,
    in counts: Slice[u32],
    inout out: Slice[u64],
    inout tk: Slice[u64],
    inout novals: Slice[u32],
    inout tv: Slice[u32],
    inout hist: Slice[u32]
) {
    s_write_pairs(
        in order,
        in smin,
        in smax,
        axis,
        in counts,
        inout out,
        inout tk,
        inout novals,
        inout tv,
        inout hist
    );
}

pub fn sap_sortable(bits: u32) -> u32 {
    s_sortable(bits)
}

// ---------------------------------------------------------------------------
// gjk.rs. A shape is a kind (0 sphere, 1 capsule, 2 polytope) and its
// numbers (see module gjk); `out` gets distance, normal, point a, point b.

pub copy enum GjkError {
    InvalidShape,
    NoConvergence,
    Degenerate
}

pub fn gjk_separation(
    ka: u32,
    in da: Slice[f64],
    kb: u32,
    in db: Slice[f64],
    inout out: Slice[f64]
) eff [Fail[GjkError]] {
    let status = g_separation(ka, in da, kb, in db, inout out);
    if status == 1 {
        Fail::raise(GjkError::InvalidShape);
    }
    if status == 2 {
        Fail::raise(GjkError::NoConvergence);
    }
    if status == 3 {
        Fail::raise(GjkError::Degenerate);
    }
}
