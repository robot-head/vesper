const SPACE_LO: [u64; 10] = [9, 32, 133, 160, 5760, 8192, 8232, 8239, 8287, 12288];
const SPACE_HI: [u64; 10] = [13, 32, 133, 160, 5760, 8202, 8233, 8239, 8287, 12288];

// The last run whose first code point is at most `c`, or the run count.
fn width_run(c: u64) -> u64 {
    let mut lo: u64 = 0;
    let mut hi: u64 = 497;
    loop {
        if lo >= hi {
            break;
        }
        let mid = wrapping_add(lo, wrapping_sub(hi, lo) >> 1);
        let first = if mid < 497 {
            WIDTH_LO[mid]
        } else {
            0
        };
        if first <= c {
            lo = wrapping_add(mid, 1);
        } else {
            hi = mid;
        }
    }
    if lo == 0 {
        497
    } else {
        wrapping_sub(lo, 1)
    }
}

// `UnicodeWidthChar::width(c).unwrap_or(1)` for the char `c`.
pub fn char_width(c: u64) -> u64 {
    let i = width_run(c);
    if i < 497 {
        if c <= WIDTH_HI[i] {
            WIDTH_W[i]
        } else {
            1
        }
    } else {
        1
    }
}

// `char::is_whitespace` for the char `c`.
pub fn is_space(c: u64) -> bool {
    let mut i: u64 = 0;
    loop {
        if i >= 10 {
            break;
        }
        let lo = if i < 10 {
            SPACE_LO[i]
        } else {
            0
        };
        let hi = if i < 10 {
            SPACE_HI[i]
        } else {
            0
        };
        if c < lo {
            return false;
        }
        if c <= hi {
            return true;
        }
        i = wrapping_add(i, 1);
    }
    false
}
