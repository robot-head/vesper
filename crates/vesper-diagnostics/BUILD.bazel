load("//tools/bazel:defs.bzl", "vesper_crate")
load("//tools/bazel:vesper_port.bzl", "VESPER_TARGET", "vesper_package", "vesper_port_object")

# The port-backed package (seed-copy rule, docs/maintenance/porting-a-crate.md;
# self-hosting SH1 lane 1, #1128): build.rs links the object built here from
# the Loom package in vesper/ and checks port/binding.rs against the
# generated binding. The compiler links the Rust seed copy,
# //crates/vesper-diagnostics/seed, instead.
vesper_package(
    name = "port_package",
    srcs = glob(["vesper/src/**/*.ves"]),
    manifest = "vesper/Loom.toml",
)

vesper_port_object(
    name = "diagnostics_vesper",
    library = "diagnostics",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

filegroup(
    name = "diagnostics_vesper_binding",
    srcs = [":diagnostics_vesper"],
    output_group = "rust_binding",
)

# The divergent builds, one per ported area: the same edits as the Cargo
# feature `vesper-port-divergent` (EDITS in build.rs). They must build; the
# Cargo run in port/test-port.sh (scripts/test-port-harness.sh) asserts that
# the tests catch each edit.
vesper_port_object(
    name = "diagnostics_vesper_divergent_prepare",
    edit_src = "vesper/src/lib.ves",
    edits = {"    bound(line_count(in t), caps.max_lines, Res::Lines);": "    bound(1, caps.max_lines, Res::Lines);"},
    library = "diagnostics",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

vesper_port_object(
    name = "diagnostics_vesper_divergent_lsp",
    edit_src = "vesper/src/lib.ves",
    edits = {"            units = if b >= 240 {": "            units = if b >= 248 {"},
    library = "diagnostics",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

vesper_port_object(
    name = "diagnostics_vesper_divergent_terminal",
    edit_src = "vesper/src/lib.ves",
    edits = {"        wrapping_sub(wrapping_mul(wrapping_add(col / TAB_WIDTH, 1), TAB_WIDTH), col)": "        wrapping_sub(wrapping_mul(wrapping_add(col / 3, 1), 3), col)"},
    library = "diagnostics",
    package = ":port_package",
    rust_types = "crate::port",
    target = VESPER_TARGET,
)

# Pure Rust tests apart from the prebuilt port object: no external tools or
# host services.
vesper_crate(
    build_script_data = [
        ":diagnostics_vesper",
        ":diagnostics_vesper_binding",
    ],
    build_script_env = {
        # rules_rust already makes these execpaths absolute.
        "VESPER_PORT_OBJECT": "$(execpath :diagnostics_vesper)",
        "VESPER_PORT_GENERATED_BINDING": "$(execpath :diagnostics_vesper_binding)",
    },
    remote_tests = ["*"],
)

# The seed package (seed/) builds these same Rust sources without the port.
exports_files(glob([
    "src/**/*.rs",
    "tests/**/*.rs",
    "examples/**/*.rs",
    "vesper/src/**/*.ves",
    "README.md",
]))

filegroup(
    name = "rust_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/vesper-diagnostics/seed:__pkg__"],
)
