load(":vesper_port.bzl", "stage2_port_tools")

# Host triples for `vesper build --lib` objects (vesper_port.bzl).
[
    config_setting(
        name = "vesper_" + os + "_" + cpu,
        constraint_values = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + cpu,
        ],
    )
    for os in [
        "linux",
        "macos",
        "windows",
    ]
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]

# `--config=stage2-ports` (.bazelrc) points this at :stage2_port_tools, so
# vesper_port_object builds each port with the Stage 2 port builder
# (`//:vesper-port-builder.wasm`) and falls back to `//:bin/vesper` for the
# ports it declines (#2666). The default has no builder, so queries over a
# port object's dependencies (the closure guard) never reach it.
label_flag(
    name = "stage2_ports",
    build_setting_default = ":no_stage2_ports",
    visibility = ["//visibility:public"],
)

stage2_port_tools(name = "no_stage2_ports")

stage2_port_tools(
    name = "stage2_port_tools",
    builder = "//:vesper-port-builder.wasm",
    tool = "//crates/vesper-port-harness:bin/vesper-port-build",
    wasmtime = "@wasmtime//:wasmtime",
)
