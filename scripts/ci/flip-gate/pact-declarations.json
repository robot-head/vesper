{
  "notes": [
    "Flip gate for the pact declaration pass (`pact_frontend::rust_declaration_diagnostics`),",
    "ported as @vesper/check-pact and installed as the hybrid's `declaration_pass` swap",
    "(crates/vesper-hybrid/src/swap/pact.rs). A compiler module: its Rust goes at the",
    "Rust compiler's retirement (SH6 lane 2), not by this flip. The",
    "`declarations-swap-point-with-encode-and-decode` workload times",
    "`rust_declaration_diagnostics` against the swap's full path (declaration_input,",
    "Vesper check_pact_declarations, decode_declarations) over the corpus worlds."
  ],
  "name": "pact-declarations",
  "lane": "SH2-11",
  "rust": [
    "src/pact_frontend.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_check_pact",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_check_pact"
      ]
    }
  ],
  "differential": {
    "run": {
      "argv": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_check_pact",
        "--",
        "--nocapture"
      ]
    }
  },
  "abba": [
    {
      "workload": "declarations-swap-point-with-encode-and-decode",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_check_pact",
          "declaration_pass_speed",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "CHECK_HARNESS_SPEED": "1"
        }
      }
    }
  ]
}
