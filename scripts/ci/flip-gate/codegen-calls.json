{
  "notes": [
    "Flip gate for codegen calls (`codegen_calls::capability_abi_functions`),",
    "ported as @vesper/codegen-calls and installed as the hybrid's `call` swap",
    "(crates/vesper-hybrid/src/swap/codegen_calls.rs). A compiler module: its",
    "Rust goes at the Rust compiler's retirement (SH6 lane 2), not by this flip."
  ],
  "name": "codegen-calls",
  "lane": "SH4-5",
  "rust": [
    "src/native.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_codegen_calls",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_codegen_calls"
      ]
    }
  ],
  "differential": {
    "run": {
      "argv": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_codegen_calls",
        "--",
        "--nocapture"
      ]
    }
  },
  "abba": [
    {
      "workload": "discovery-entry",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_codegen_calls",
          "codegen_calls_speed",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "CHECK_HARNESS_SPEED": "1"
        }
      }
    }
  ]
}
