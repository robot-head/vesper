{
  "notes": [
    "Flip gate for the freestanding image builder (`freestanding::link`),",
    "ported as @vesper/codegen-freestanding (SH4 lane 14, #1288) and installed",
    "as the hybrid's `freestanding` swap (crates/vesper-hybrid/src/swap/freestanding.rs).",
    "A compiler module: its Rust goes at the Rust compiler's retirement (SH6 lane 2),",
    "not by this flip."
  ],
  "name": "freestanding",
  "lane": "SH4-14",
  "rust": [
    "src/native_freestanding.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_freestanding",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_freestanding"
      ]
    }
  ],
  "differential": {
    "run": {
      "argv": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_freestanding",
        "--",
        "--nocapture"
      ]
    }
  },
  "abba": [
    {
      "workload": "freestanding-link",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_freestanding",
          "link_cost",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1"
        }
      }
    }
  ]
}
