{
  "notes": [
    "Flip gate for the FIP checker (`fip::check_world`), ported as @vesper/check-fip",
    "and installed as the hybrid's `fip` swap (crates/vesper-hybrid/src/swap/fip.rs).",
    "A compiler module: its Rust goes at the Rust compiler's retirement (SH6 lane 2).",
    "The `fip-with-encoding-*` workloads time `check_world` against the swap's path",
    "(fip_words::encode_world, the Vesper entry) over the corpus and cases, without",
    "and with mutants.",
    "The tests run one at a time (RUST_TEST_THREADS=1): the mutant corpus needs most of a 16 GB host.",
    "The timing takes every 2nd corpus world (CHECK_HARNESS_STRIDE=2): the mutant worlds and their inputs held at once did not fit a 16 GB host."
  ],
  "name": "fip",
  "lane": "SH2-12",
  "rust": [
    "src/fip.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0",
    "RUST_TEST_THREADS": "1"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_check_fip",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_check_fip"
      ]
    }
  ],
  "differential": {
    "run": {
      "sequence": [
        [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_check_fip",
          "checker_cases_match_rust",
          "--",
          "--exact",
          "--nocapture"
        ],
        [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_check_fip",
          "corpus_and_mutants_match_rust",
          "--",
          "--exact",
          "--nocapture"
        ]
      ]
    }
  },
  "abba": [
    {
      "workload": "fip-with-encoding-corpus-and-cases",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_check_fip",
          "abba_check_fip",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "CHECK_HARNESS_SPEED": "1",
          "CHECK_HARNESS_STRIDE": "2"
        }
      }
    },
    {
      "workload": "fip-with-encoding-with-mutants",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_check_fip",
          "abba_check_fip",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "CHECK_HARNESS_SPEED": "1",
          "CHECK_HARNESS_STRIDE": "2"
        }
      }
    }
  ]
}
