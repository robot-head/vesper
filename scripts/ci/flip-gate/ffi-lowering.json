{
  "notes": [
    "Flip gate for FFI lowering (`ffi_lowering`),",
    "ported as @vesper/ffi-lowering and installed as the hybrid's `ffi` swap",
    "(crates/vesper-hybrid/src/swap/ffi_lowering.rs). A compiler module: its",
    "Rust goes at the Rust compiler's retirement (SH6 lane 2), not by this flip."
  ],
  "name": "ffi-lowering",
  "lane": "SH4-10",
  "rust": [
    "src/ffi_lowering.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_ffi_lowering",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_ffi_lowering"
      ]
    }
  ],
  "differential": {
    "run": {
      "argv": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_ffi_lowering",
        "--",
        "--nocapture"
      ]
    }
  },
  "abba": [
    {
      "workload": "ffi-type-mapping",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_ffi_lowering",
          "type_mapping_speed",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "CHECK_HARNESS_SPEED": "1"
        }
      }
    }
  ]
}
