{
  "notes": [
    "Flip gate for `builtin_traits::wanted`, ported in @vesper/check-pact and installed",
    "as the hybrid's `builtin_wanted` swap. The `builtin-wanted-swap-path` workload",
    "times Rust's scan against the swap's path (encode_builtin_wanted, the Vesper",
    "entry) over every corpus module."
  ],
  "name": "pact-builtin-wanted",
  "lane": "SH2-13",
  "rust": [
    "src/pact_frontend/builtin_traits.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_check_pact",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_check_pact"
      ]
    }
  ],
  "differential": {
    "run": [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_check_pact",
      "builtin_wanted_agrees_with_rust",
      "--",
      "--exact",
      "--nocapture"
    ]
  },
  "abba": [
    {
      "workload": "builtin-wanted-swap-path",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_check_pact",
          "builtin_wanted_speed",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "CHECK_HARNESS_SPEED": "1"
        }
      }
    }
  ]
}
