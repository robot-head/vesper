{
  "notes": [
    "Flip gate for the stack-bound report (`stack_bound::stack_bound_report`),",
    "ported as @vesper/check-loops-atomics (SH2 lane 10, #1182) and installed",
    "as the hybrid's `stack_bound` swap (crates/vesper-hybrid/src/swap/stack_bound.rs).",
    "A compiler module: its Rust goes at the Rust compiler's retirement (SH6 lane 2),",
    "not by this flip. The `stack-bound-hybrid-path` workload times",
    "`rust_stack_bound_report` against the swap's full path (stack_input, Vesper",
    "report_words, decode_stack_report) over the corpus call graphs."
  ],
  "name": "stack-bound",
  "lane": "SH2-10",
  "rust": [
    "src/stack_bound.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_check_loops_atomics",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_check_loops_atomics"
      ]
    }
  ],
  "differential": {
    "run": {
      "sequence": [
        [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_check_loops_atomics",
          "stack_bound_matches_rust",
          "--",
          "--exact",
          "--nocapture"
        ],
        [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_check_loops_atomics",
          "stack_bound_words_match_rust",
          "--",
          "--exact",
          "--nocapture"
        ],
        [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_check_loops_atomics",
          "stack_bound_words_match_rust_on_large_graphs",
          "--",
          "--exact",
          "--nocapture"
        ],
        [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_check_loops_atomics",
          "stack_words_decode_truncated_streams",
          "--",
          "--exact",
          "--nocapture"
        ]
      ]
    }
  },
  "abba": [
    {
      "workload": "stack-bound-hybrid-path",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_check_loops_atomics",
          "stack_bound_speed",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "CHECK_HARNESS_SPEED": "1"
        }
      }
    }
  ]
}
