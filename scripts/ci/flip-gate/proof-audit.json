{
  "notes": [
    "Flip gate for `vesper proof-audit`, ported to the driver module (#1341, #2091)",
    "and installed as the hybrid's `proof_audit` swap. Needs Lean 4.35.0 (`lean` on",
    "PATH or VESPER_LEAN). The `audit` workload runs every Lean audit case, Rust's",
    "`vesper proof-audit` against the Vesper port binary.",
    "Lean dominates both sides (about 37 s a side), so the gate runs 6 epochs (FLIP_GATE_EPOCHS)."
  ],
  "name": "proof-audit",
  "lane": "SH5-18",
  "rust": [
    "src/proof_commands.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_proof_audit",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_proof_audit"
      ]
    }
  ],
  "differential": {
    "run": [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_proof_audit",
      "vesper_port_matches_rust_proof_audit",
      "--",
      "--exact",
      "--nocapture"
    ]
  },
  "abba": [
    {
      "workload": "audit",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_proof_audit",
          "vesper_port_matches_rust_proof_audit",
          "--",
          "--exact",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "FLIP_GATE_EPOCHS": "6"
        }
      }
    }
  ]
}
