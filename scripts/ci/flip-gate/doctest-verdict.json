{
  "notes": [
    "Flip gate for doctest wrappers and verdicts of `vesper test`, ported in @vesper/test-runner (SH5 lane 14, #1337)",
    "and installed as the hybrid's `doctest_verdict` swap (src/swap/test_runner.rs).",
    "A compiler module: its Rust goes at the Rust compiler's retirement (SH6 lane 2).",
    "The `verdict` workload times Rust against the optimized Vesper build, with the",
    "swap's word encoding and decoding, over the corpus."
  ],
  "name": "doctest-verdict",
  "lane": "SH5-14",
  "rust": [
    "src/doctest_verdict.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_doctest_verdict",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_doctest_verdict"
      ]
    }
  ],
  "differential": {
    "run": {
      "sequence": [
        [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_doctest_verdict",
          "doctest_verdict_matches_rust_on_the_corpus",
          "--",
          "--exact",
          "--nocapture"
        ],
        [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_doctest_verdict",
          "doctest_verdict_matches_rust_unoptimized",
          "--",
          "--exact",
          "--nocapture"
        ]
      ]
    }
  },
  "abba": [
    {
      "workload": "verdict",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_doctest_verdict",
          "doctest_verdict_speed",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "CHECK_HARNESS_SPEED": "1",
          "DOCTEST_VERDICT_SPEED": "1"
        }
      }
    }
  ]
}
