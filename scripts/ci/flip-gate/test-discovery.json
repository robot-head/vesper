{
  "notes": [
    "Flip gate for test discovery (`test_discovery::{rust_case_rows, rust_discover}`),",
    "ported as @vesper/test-runner (SH5 lane 14, #1337) and installed as the",
    "hybrid's `test_discovery` swap (crates/vesper-hybrid/src/swap/test_runner.rs).",
    "A compiler module: its Rust goes at the Rust compiler's retirement (SH6 lane 2),",
    "not by this flip."
  ],
  "name": "test-discovery",
  "lane": "SH5-14",
  "rust": [
    "src/test_discovery.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_test_runner",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_test_runner"
      ]
    }
  ],
  "differential": {
    "run": {
      "argv": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_test_runner",
        "--",
        "--nocapture"
      ]
    }
  },
  "abba": [
    {
      "workload": "test-discovery",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_test_runner",
          "discovery_speed",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "TEST_RUNNER_SPEED": "1"
        }
      }
    }
  ]
}
