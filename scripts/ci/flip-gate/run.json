{
  "notes": [
    "Flip gate for the `vesper run` evaluator (`Runtime::run`), ported as",
    "@vesper/run (Stage 2 retirement #1397, claim #2053) and installed as the",
    "hybrid's `run` swap (crates/vesper-hybrid/src/swap/run.rs).",
    "A compiler module: its Rust goes at the Rust compiler's retirement,",
    "not by this flip."
  ],
  "name": "run",
  "lane": "#2053",
  "rust": [
    "src/runtime.rs",
    "src/regions/eval.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_run",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_run"
      ]
    }
  ],
  "differential": {
    "run": {
      "argv": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_run",
        "run_matches_rust",
        "--",
        "--exact",
        "--nocapture"
      ]
    }
  },
  "abba": [
    {
      "workload": "run",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_run",
          "run_cost",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "CHECK_HARNESS_SPEED": "1"
        }
      }
    }
  ]
}
