{
  "notes": [
    "Flip gate for `vesper verify --format`, ported as @vesper/verify (#1341) and",
    "installed as the hybrid's `verify` swap. Needs Lean 4.35.0 for the kernel cases.",
    "The `format` workload runs every case, Rust's `vesper verify` against the Vesper",
    "port binary.",
    "Lean dominates both sides (about 37 s a side), so the gate runs 6 epochs (FLIP_GATE_EPOCHS)."
  ],
  "name": "verify",
  "lane": "SH5-18",
  "rust": [
    "src/verify_commands.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_verify_format",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_verify_format"
      ]
    }
  ],
  "differential": {
    "run": [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_verify_format",
      "vesper_port_matches_rust_verify_format",
      "--",
      "--exact",
      "--nocapture"
    ]
  },
  "abba": [
    {
      "workload": "format",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_verify_format",
          "vesper_port_matches_rust_verify_format",
          "--",
          "--exact",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "FLIP_GATE_EPOCHS": "6"
        }
      }
    }
  ]
}
