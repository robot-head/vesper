{
  "notes": [
    "Flip gate for the IR inliner (`ir_inline`), ported as @vesper/ir-inline and",
    "installed as the hybrid's `inline` swap. The `inline-with-encoding` workload",
    "times Rust's inliner against the swap's path (inline_words input, the Vesper",
    "entry, decode)."
  ],
  "name": "inline",
  "lane": "SH3-11",
  "rust": [
    "src/ir_inline.rs",
    "src/ir_inline/site.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_ir_inline",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_ir_inline"
      ]
    }
  ],
  "differential": {
    "run": {
      "sequence": [
        [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_ir_inline",
          "decisions_match_rust",
          "--",
          "--exact",
          "--nocapture"
        ],
        [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_ir_inline",
          "inlined_programs_match_rust",
          "--",
          "--exact",
          "--nocapture"
        ],
        [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_ir_inline",
          "tight_budgets_match_rust",
          "--",
          "--exact",
          "--nocapture"
        ]
      ]
    }
  },
  "abba": [
    {
      "workload": "inline-with-encoding",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_ir_inline",
          "inline_speed",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "CHECK_HARNESS_SPEED": "1"
        }
      }
    }
  ]
}
