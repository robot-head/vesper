{
  "notes": [
    "Flip gate for the parser (`vesper_syntax::parser::parse`),",
    "ported as @vesper/front + @vesper/ast (#1155) and installed as the",
    "hybrid's `parse` swap (crates/vesper-hybrid/src/swap/parse.rs).",
    "A compiler module: its Rust goes at the Rust compiler's retirement (SH6 lane 2),",
    "not by this flip."
  ],
  "name": "parse",
  "lane": "SH1-12",
  "rust": [
    "crates/vesper-syntax/src/parser.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_front_v2",
      "--test",
      "self_host_front_v2_bench",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_front_v2"
      ]
    }
  ],
  "differential": {
    "run": {
      "argv": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_front_v2",
        "--",
        "--nocapture"
      ]
    }
  },
  "abba": [
    {
      "workload": "parse",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_front_v2_bench",
          "abba_against_the_rust_parser",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1"
        }
      }
    }
  ]
}
