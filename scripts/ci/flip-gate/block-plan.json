{
  "notes": [
    "Flip gate for native walk block planning (`codegen_swap::block_plan`),",
    "ported as @vesper/codegen-walk and installed as the hybrid's `block_plan` swap",
    "(crates/vesper-hybrid/src/swap/codegen_walk.rs). A compiler module: its Rust",
    "goes at the Rust compiler's retirement (SH6 lane 2), not by this flip."
  ],
  "name": "block-plan",
  "lane": "SH4-11",
  "rust": [
    "src/native.rs"
  ],
  "env": {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_PROFILE_RELEASE_DEBUG": "0"
  },
  "build": [
    [
      "cargo",
      "test",
      "--locked",
      "--release",
      "--test",
      "self_host_native_walk_blocks",
      "--no-run"
    ]
  ],
  "tests": [
    {
      "run": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_native_walk_blocks"
      ]
    }
  ],
  "differential": {
    "run": {
      "argv": [
        "cargo",
        "test",
        "--locked",
        "--release",
        "--test",
        "self_host_native_walk_blocks",
        "--",
        "--nocapture"
      ]
    }
  },
  "abba": [
    {
      "workload": "block-plans",
      "run": {
        "argv": [
          "cargo",
          "test",
          "--locked",
          "--release",
          "--test",
          "self_host_native_walk_blocks",
          "block_plan_speed",
          "--",
          "--exact",
          "--ignored",
          "--nocapture"
        ],
        "env": {
          "FLIP_GATE": "1",
          "CHECK_HARNESS_SPEED": "1"
        }
      }
    }
  ]
}
