        "src/stylus*",
        "src/proof*",
        "src/proof/**",
        "src/snapshot*",
        "src/snapshot/**",
        "tests/common/lean4lean_proof_packet.rs",
        "scripts/check-format-proof.py",
        "scripts/test-format-proof.sh",
        "tools/logos42/**",
        "src/bin/logos42*"
