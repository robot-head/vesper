      "source": "crates/vesper-flux/tests/recovery.rs",
      "skip_tests": [
        "whole_cluster_crash_at_every_step_and_every_phase",
        "single_worker_crash_at_every_step_and_every_phase",
        "coordinator_failover_at_every_step_and_every_phase"
