{
  "version": 1,
  "shared_paths": [
    "Cargo.toml",
    "Cargo.lock",
    "MODULE.bazel",
    "MODULE.bazel.lock",
    ".bazel*",
    "rust-toolchain*",
    "lean-toolchain",
    ".github/**",
    "scripts/ci/**",
    "tools/bazel/**",
    "BUILD.bazel"
