        "crates/vesper-core/**"
      ]
    },
    "frontend_corpus": {
      "paths": [
        "*.ves",
        "packages/vesper-compiler/**",
        "crates/vesper-syntax/**",
        "crates/vesper-span/**",
        "crates/vesper-core/**",
        "src/lex*",
        "src/parse*",
        "src/parse/**",
        "src/ast*",
        "src/check*",
        "src/check/**",
        "src/eval*",
        "src/runtime*",
        "src/world*",
        "src/resolve*",
        "src/mono*",
        "src/layout*",
        "src/type*",
        "src/ir*",
        "src/native*",
        "src/native/**",
        "src/*_lowering/**",
        "src/*_lowering.rs"
      ]
    }
  },
