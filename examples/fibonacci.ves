// Checked arithmetic: `+` and `-` raise Fail[ArithOverflow] on overflow.
fn fib(n: i64) -> i64 eff [Fail[ArithOverflow]] {
    if n < 2 {
        n
    } else {
        fib(n - 1) + fib(n - 2)
    }
}

fn main() -> i64 {
    handle Fail[ArithOverflow] in {
        fib(10)
    } with {
        return value => value,
        raise(error, resume) => -1,
    }
}
