// Traits with an associated type, a canonical impl and two named models.
struct Point { x: i64, y: i64 }
struct Counter { n: i64 }

trait Score {
    type Out: mod copy;
    fn score(in self) -> Self::Out;
}

impl Score for Point {
    type Out = i64;
    fn score(in self) -> i64 { wrapping_add(self.x, self.y) }
}

model ByX: Score for Point {
    type Out = i64;
    fn score(in self) -> i64 { self.x }
}

model ByY: Score for Point {
    type Out = i64;
    fn score(in self) -> Self::Out { self.y }
}

trait Source {
    type Item: mod copy;
    fn next(inout self) -> Option[Self::Item];
}

impl Source for Counter {
    type Item = i64;
    fn next(inout self) -> Option[i64] {
        if self.n == 0 { None } else { self.n = wrapping_sub(self.n, 1); Some(self.n) }
    }
}

fn total(in p: Point) -> <Point as Score>::Out {
    let canonical = p.score();
    let by_x = {
        use model ByX;
        let a = p.score();
        let b = {
            use model ByY;
            p.score()
        };
        wrapping_add(wrapping_mul(a, 100), b)
    };
    let explicit = ByY::score(p);
    wrapping_add(wrapping_add(wrapping_mul(canonical, 10000), by_x), wrapping_mul(explicit, 1000000))
}

fn drain(inout c: Counter) -> i64 {
    let first: Counter::Item = match c.next() { Some(v) => v, None => 0 };
    let second = match Source::next(inout c) { Some(v) => v, None => 0 };
    wrapping_add(wrapping_mul(first, 10), second)
}

fn main() -> i64 {
    let p = Point { x: 3, y: 4 };
    let c = Counter { n: 5 };
    wrapping_add(total(p), wrapping_mul(drain(inout c), 100000000))
}
